                        ; ============================================================================
                        ; diskutil.s -- standalone RAM-disk maintenance utility for the Brevia2 Z80.
                        ;
                        ; Runs entirely OUTSIDE of CP/M. Loaded via GWMON-80 'L', run via 'G 1000'.
                        ; Uses the console UART (0x80 status / 0x81 data) for BOTH the menu and the
                        ; XMODEM file transfer, and the RAM-disk controller (0x20 DATA auto-inc,
                        ; 0x21 ADDR lo, 0x22 ADDR hi) for the CP/M disk layout in bank B.
                        ;
                        ; Commands:
                        ;   F  -- format drive A: (write 0xE5 to the 2K directory area)
                        ;   U  -- XMODEM upload (checksum mode): receive a file from the host PC and
                        ;         write it to the RAM disk as a CP/M file (multi-extent for >16K).
                        ;   D  -- XMODEM download: send a file from the RAM disk to the host PC.
                        ;   H  -- help
                        ;
                        ; XMODEM receive retries the initiating NAK with a ~1.5s timeout each cycle,
                        ; so the host (Tera Term / minicom) picks it up even if it starts the transfer
                        ; AFTER we began waiting. Supports checksum blocks (SOH) and CRC blocks (STX).
                        ;
                        ; Assembled with the Glitch Works a85 8085 cross-assembler (same as cbios.asm).
                        ; ============================================================================
                        
   1000                         ORG     1000H
                        
                        ; ---------------- Processor I/O ports ----------------
   0080                 USTAT   EQU     80H                     ; UART status (bit0 tx_busy, bit1 rx_avail)
   0081                 UDATA   EQU     81H                     ; UART data (read=RX char, write=TX char)
   0020                 RDDATA  EQU     20H                     ; RAM disk DATA (read/write, auto-increment)
   0021                 RDADRL  EQU     21H                     ; RAM disk ADDR low
   0022                 RDADRH  EQU     22H                     ; RAM disk ADDR high
                        
                        ; ---------------- CP/M drive A: disk layout (bank B) ----------------
   2000                 DIRBASE EQU     2000H                   ; directory area base (2K = 64 entries)
   2800                 DBLOCK0 EQU     2800H                   ; first USER data block (block 2) base
   0400                 BLKSZ   EQU     1024                    ; block size (1K)
   0080                 RECSZ   EQU     128                     ; CP/M record size
                        
                        ; ---------------- XMODEM control bytes ----------------
   0001                 XM_SOH  EQU     01H
   0002                 XM_STX  EQU     02H
   0004                 XM_EOT  EQU     04H
   0006                 XM_ACK  EQU     06H
   0015                 XM_NAK  EQU     15H
   0018                 XM_CAN  EQU     18H
   00fe                 XM_TO   EQU     0FEH                    ; internal: RX timeout marker
                        
                        ; ---------------- Workspace (bank A SRAM, well below the CCP at 0xE400) ----------------
   2000                 XMBUF   EQU     2000H                   ; 128-byte XMODEM block buffer
   2100                 FCB     EQU     2100H                   ; 32-byte FCB (extent 0) in RAM
   2120                 FCB2    EQU     2120H                   ; 32-byte FCB (extent 1) in RAM
   2160                 RCNT_L  EQU     2160H                   ; total records received (16-bit, L then H)
   2180                 FNAME   EQU     2180H                   ; 12-byte user filename buffer (8.3)
                        
                        ; ============================================================================
   1000   c3 6b 10              JMP     START
                        
                        ; ---------------- UART primitives ----------------
                        ; TXCHAR: output char in A; poll tx_busy(bit0) low.
   1003   f5            TXCHAR: PUSH    PSW
   1004   db 80         TXCH1:  IN      USTAT
   1006   e6 01                 ANI     01H
   1008   c2 04 10              JNZ     TXCH1
   100b   f1                    POP     PSW
   100c   d3 81                 OUT     UDATA
   100e   c9                    RET
                        
                        ; RXCHAR: block until a char, return it in A.
   100f   db 80         RXCHAR: IN      USTAT
   1011   e6 02                 ANI     02H
   1013   ca 0f 10              JZ      RXCHAR
   1016   db 81                 IN      UDATA
   1018   c9                    RET
                        
                        ; RXCHAR_T: receive a char with a ~1.5s timeout.
                        ;   Returns: carry CLEAR + A=char if a char arrived; carry SET if timeout.
   1019                 RXCHAR_T:
   1019   06 b0                 MVI     B,0B0H                  ; outer count
   101b   0e b0         RT_L2:  MVI     C,0B0H                  ; mid count
   101d   16 b0         RT_L1:  MVI     D,0B0H                  ; inner count
   101f   db 80         RT_L0:  IN      USTAT
   1021   e6 02                 ANI     02H
   1023   c2 34 10              JNZ     RT_HAVE
   1026   15                    DCR     D
   1027   c2 1f 10              JNZ     RT_L0
   102a   0d                    DCR     C
   102b   c2 1d 10              JNZ     RT_L1
   102e   05                    DCR     B
   102f   c2 1b 10              JNZ     RT_L2
   1032   37                    STC                             ; timeout
   1033   c9                    RET
   1034                 RT_HAVE:
   1034   db 81                 IN      UDATA                   ; char
   1036   37                    STC
   1037   3f                    CMC                             ; carry clear (char read)
   1038   c9                    RET
                        
                        ; CRLF: send CR + LF.
   1039   3e 0d         CRLF:   MVI     A,0DH
   103b   cd 03 10              CALL    TXCHAR
   103e   3e 0a                 MVI     A,0AH
   1040   cd 03 10              CALL    TXCHAR
   1043   c9                    RET
                        
                        ; PRTSTR: print NUL-terminated string at HL.
   1044   7e            PRTSTR: MOV     A,M
   1045   b7                    ORA     A
   1046   c8                    RZ
   1047   cd 03 10              CALL    TXCHAR
   104a   23                    INX     H
   104b   c3 44 10              JMP     PRTSTR
                        
                        ; PRTBYTE: print A as two hex digits.
   104e   f5            PRTBYTE: PUSH    PSW
   104f   e6 f0                 ANI     0F0H
   1051   0f                    RRC
   1052   0f                    RRC
   1053   0f                    RRC
   1054   0f                    RRC
   1055   cd 5b 10              CALL    PRTH1
   1058   f1                    POP     PSW
   1059   e6 0f                 ANI     0FH
   105b   c6 90         PRTH1:  ADI     90H
   105d   27                    DAA
   105e   ce 40                 ACI     40H                     ; add carry (ACI) so 0xA-0xF print A-F
   1060   27                    DAA
   1061   c3 03 10              JMP     TXCHAR
                        
                        ; ---------------- RAM-disk primitives (bank B) ----------------
   1064   7d            RDSETA: MOV     A,L
   1065   d3 21                 OUT     RDADRL
   1067   7c                    MOV     A,H
   1068   d3 22                 OUT     RDADRH
   106a   c9                    RET
                        
                        ; ============================================================================
                        ; START
                        ; ============================================================================
   106b   31 00 e0      START:  LXI     SP,0E000H               ; stack in the TPA, BELOW the BDOS/CCP (0xE400+)
                                                                ; 0xF000 sat INSIDE the BDOS (0xEC00-0xFFFF), so
                                                                ;  diskutil's CALL/PUSH frames clobbered CP/M's
                                                                ;  in-RAM image; cold boot then ran the corrupted
                                                                ;  code. The CBIOS itself uses 0xDC00 for the same
                                                                ;  reason. TPA is 0x0100-0xE3FF; 0xE000 grows down
                                                                ;  into free space clear of code/buffers (0x1000+).
   106e   21 c7 14              LXI     H,MSGBANNER
   1071   cd 44 10              CALL    PRTSTR
   1074   21 e6 14      MENU:   LXI     H,MSGMENU
   1077   cd 44 10              CALL    PRTSTR
   107a   cd 0f 10              CALL    RXCHAR                  ; wait for a command char
   107d   e6 df                 ANI     0DFH                    ; force uppercase (accept lowercase)
   107f   fe 46                 CPI     'F'
   1081   ca a0 10              JZ      DO_FMT
   1084   fe 55                 CPI     'U'
   1086   ca cc 10              JZ      DO_UPLOAD
   1089   fe 44                 CPI     'D'
   108b   ca 9d 13              JZ      DO_DOWNLOAD
   108e   fe 48                 CPI     'H'
   1090   ca c3 10              JZ      DO_HELP
   1093   fe 42                 CPI     'B'
   1095   ca 32 14              JZ      DO_DUMP
   1098   fe 4d                 CPI     'M'
   109a   ca 5a 14              JZ      DO_MDUMP
   109d   c3 74 10              JMP     MENU
                        
                        ; ---------------- command: format ----------------
   10a0   21 40 15      DO_FMT: LXI     H,MSGFMT
   10a3   cd 44 10              CALL    PRTSTR
   10a6   21 00 00              LXI     H,0000H                 ; start at byte 0 of the RAM disk
   10a9   cd 64 10              CALL    RDSETA
   10ac   01 00 00              LXI     B,65536                 ; erase the ENTIRE 64K bank-B RAM disk
   10af   16 e5                 MVI     D,0E5H                  ; keep the fill value in D (A is clobbered below)
   10b1   7a            FMTW:   MOV     A,D
   10b2   d3 20                 OUT     RDDATA                  ; write 0xE5 (auto-increment)
   10b4   0b                    DCX     B
   10b5   78                    MOV     A,B
   10b6   b1                    ORA     C
   10b7   c2 b1 10              JNZ     FMTW
   10ba   21 50 15              LXI     H,MSGFMTOK
   10bd   cd 44 10              CALL    PRTSTR
   10c0   c3 74 10              JMP     MENU
                        
   10c3   21 09 15      DO_HELP: LXI     H,MSGHELP
   10c6   cd 44 10              CALL    PRTSTR
   10c9   c3 74 10              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_UPLOAD -- XMODEM (checksum/CRC) receive a file, write it as a CP/M file.
                        ; ============================================================================
   10cc                 DO_UPLOAD:
   10cc   21 5d 15              LXI     H,MSGPROMPT
   10cf   cd 44 10              CALL    PRTSTR
   10d2   cd e3 12              CALL    READNAME                ; read "name.ext" into FNAME (echoed)
   10d5   21 00 00              LXI     H,0000H
   10d8   22 60 21              SHLD    RCNT_L                  ; init record counter
   10db   21 76 15              LXI     H,MSGRECV
   10de   cd 44 10              CALL    PRTSTR
   10e1   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   10e3   cd 03 10              CALL    TXCHAR
                        
   10e6   cd 37 11      UPLOOP: CALL    GETBLK                  ; A=TO(timeout),01 good,FF bad,00 EOT,02 CAN
   10e9   fe fe                 CPI     XM_TO
   10eb   ca 0d 11              JZ      UP_NAK                  ; timeout -> resend NAK, keep waiting
   10ee   fe 02                 CPI     02H
   10f0   ca 0d 11              JZ      UP_NAK                  ; CAN
   10f3   fe 00                 CPI     00H
   10f5   ca 15 11              JZ      UP_EOT
   10f8   fe ff                 CPI     0FFH
   10fa   ca 0d 11              JZ      UP_NAK                  ; bad block -> NAK
                                ; good block -> write it to the disk
   10fd   cd fb 11              CALL    WRITEBLK
   1100   3e 06                 MVI     A,XM_ACK
   1102   cd 03 10              CALL    TXCHAR
   1105   3e 2e                 MVI     A,'.'
   1107   cd 03 10              CALL    TXCHAR
   110a   c3 e6 10              JMP     UPLOOP
   110d   3e 15         UP_NAK: MVI     A,XM_NAK
   110f   cd 03 10              CALL    TXCHAR
   1112   c3 e6 10              JMP     UPLOOP
                        
   1115   3e 06         UP_EOT: MVI     A,XM_ACK
   1117   cd 03 10              CALL    TXCHAR
   111a   cd 39 10              CALL    CRLF
   111d   cd 28 12              CALL    WRITEFCB                ; write directory entries
   1120   21 8e 15              LXI     H,MSGDONE
   1123   cd 44 10              CALL    PRTSTR
   1126   2a 60 21              LHLD    RCNT_L
   1129   7c                    MOV     A,H
   112a   cd 4e 10              CALL    PRTBYTE
   112d   7d                    MOV     A,L
   112e   cd 4e 10              CALL    PRTBYTE
   1131   cd 39 10              CALL    CRLF
   1134   c3 74 10              JMP     MENU
                        
                        ; ============================================================================
                        ; GETBLK -- receive one XMODEM block into XMBUF.
                        ; Returns A: XM_TO(timeout), 00=EOT, 01=good, FF=bad, 02=CAN.
                        ; (First byte uses the timed read so we can retry the NAK on timeout; the rest
                        ;  of the block uses blocking reads because the host sends them back-to-back.)
                        ; ============================================================================
   1137   cd 19 10      GETBLK: CALL    RXCHAR_T
   113a   da 54 11              JC      GT_TIMEOUT              ; carry set = timeout
   113d   fe 04                 CPI     XM_EOT
   113f   ca 57 11              JZ      GT_EOT
   1142   fe 18                 CPI     XM_CAN
   1144   ca 59 11              JZ      GT_CAN
   1147   fe 01                 CPI     XM_SOH
   1149   ca 5c 11              JZ      GT_SOH
   114c   fe 02                 CPI     XM_STX
   114e   ca 85 11              JZ      GT_STX
   1151   c3 37 11              JMP     GETBLK                  ; stray byte (e.g. 'rx name'), ignore
                        
   1154                 GT_TIMEOUT:
   1154   3e fe                 MVI     A,XM_TO
   1156   c9                    RET
   1157   af            GT_EOT: XRA     A
   1158   c9                    RET
   1159   3e 02         GT_CAN: MVI     A,02H
   115b   c9                    RET
                        
                        ; ---- SOH: checksum block (blkno, ~blkno, 128 data, 1-byte checksum) ----
   115c   cd 0f 10      GT_SOH: CALL    RXCHAR
   115f   47                    MOV     B,A                     ; blkno
   1160   cd 0f 10              CALL    RXCHAR
   1163   a8                    XRA     B                       ; ~blkno ^ blkno
   1164   fe ff                 CPI     0FFH
   1166   c2 f8 11              JNZ     GT_BAD
   1169   21 00 20              LXI     H,XMBUF
   116c   1e 00                 MVI     E,00H
   116e   0e 80                 MVI     C,128
   1170   cd 0f 10      GT_LP:  CALL    RXCHAR
   1173   77                    MOV     M,A
   1174   83                    ADD     E
   1175   5f                    MOV     E,A
   1176   23                    INX     H
   1177   0d                    DCR     C
   1178   c2 70 11              JNZ     GT_LP
   117b   cd 0f 10              CALL    RXCHAR                  ; checksum byte
   117e   bb                    CMP     E
   117f   c2 f8 11              JNZ     GT_BAD
   1182   3e 01                 MVI     A,01H
   1184   c9                    RET
                        
                        ; ---- STX: CRC block (blkno, ~blkno, 128 data, 2-byte CRC-16) ----
   1185   cd 0f 10      GT_STX: CALL    RXCHAR
   1188   47                    MOV     B,A                     ; blkno
   1189   cd 0f 10              CALL    RXCHAR
   118c   a8                    XRA     B
   118d   fe ff                 CPI     0FFH
   118f   c2 f8 11              JNZ     GT_BAD
   1192   21 00 20              LXI     H,XMBUF
   1195   0e 80                 MVI     C,128
   1197   cd 0f 10      GT_LP2: CALL    RXCHAR
   119a   77                    MOV     M,A
   119b   23                    INX     H
   119c   0d                    DCR     C
   119d   c2 97 11              JNZ     GT_LP2
                                ; compute CRC-16 XMODEM over XMBUF -> D: E (D high, E low)
   11a0   21 00 20              LXI     H,XMBUF
   11a3   11 00 00              LXI     D,0000H                 ; crc = 0
   11a6   0e 80                 MVI     C,128
   11a8   7e            GT_CRC: MOV     A,M
   11a9   47                    MOV     B,A
   11aa   7a                    MOV     A,D
   11ab   a8                    XRA     B                       ; crc_hi ^= byte
   11ac   57                    MOV     D,A
   11ad   06 08                 MVI     B,08H
   11af   7a            GTCB:   MOV     A,D
   11b0   e6 80                 ANI     80H                     ; crc & 0x8000 ?
   11b2   ca d0 11              JZ      GTCS
   11b5   a7                    ANA     A                       ; clear carry
   11b6   7b                    MOV     A,E
   11b7   17                    RAL                             ; E = E<<1 (carry = old E bit7)
   11b8   5f                    MOV     E,A
   11b9   7a                    MOV     A,D
   11ba   17                    RAL                             ; D = D<<1 | old E bit7
   11bb   57                    MOV     D,A
   11bc   7a                    MOV     A,D
   11bd   ee 10                 XRI     10H                     ; crc ^= 0x1021 (hi)
   11bf   57                    MOV     D,A
   11c0   7b                    MOV     A,E
   11c1   ee 21                 XRI     21H                     ; crc ^= 0x1021 (lo)
   11c3   5f                    MOV     E,A
   11c4   05                    DCR     B
   11c5   c2 af 11              JNZ     GTCB
   11c8   23                    INX     H
   11c9   0d                    DCR     C
   11ca   c2 a8 11              JNZ     GT_CRC
   11cd   c3 e0 11              JMP     GT_CHK
   11d0   a7            GTCS:   ANA     A                       ; clear carry
   11d1   7b                    MOV     A,E
   11d2   17                    RAL
   11d3   5f                    MOV     E,A
   11d4   7a                    MOV     A,D
   11d5   17                    RAL
   11d6   57                    MOV     D,A
   11d7   05                    DCR     B
   11d8   c2 af 11              JNZ     GTCB
   11db   23                    INX     H
   11dc   0d                    DCR     C
   11dd   c2 a8 11              JNZ     GT_CRC
   11e0                 GT_CHK:
   11e0   23                    INX     H
   11e1   0d                    DCR     C
   11e2   c2 a8 11              JNZ     GT_CRC
                                ; read 2 CRC bytes (high, low), compare
   11e5   cd 0f 10              CALL    RXCHAR
   11e8   47                    MOV     B,A                     ; received crc hi
   11e9   cd 0f 10              CALL    RXCHAR
   11ec   bb                    CMP     E                       ; compare low
   11ed   c2 f8 11              JNZ     GT_BAD
   11f0   78                    MOV     A,B
   11f1   ba                    CMP     D                       ; compare high
   11f2   c2 f8 11              JNZ     GT_BAD
   11f5   3e 01                 MVI     A,01H
   11f7   c9                    RET
                        
   11f8   3e ff         GT_BAD: MVI     A,0FFH
   11fa   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEBLK -- write the 128 good bytes in XMBUF to the RAM disk at the current
                        ;   file position. Position = DBLOCK0 + RCNT_L*128. (Blocks contiguous; block #
                        ;   = RCNT/8 + 2.)
                        ; ============================================================================
   11fb                 WRITEBLK:
   11fb   2a 60 21              LHLD    RCNT_L
   11fe   54                    MOV     D,H
   11ff   5d                    MOV     E,L
   1200   06 07                 MVI     B,07H
   1202                 WBLK_SHL:
   1202   7b                    MOV     A,E
   1203   87                    ADD     A
   1204   5f                    MOV     E,A
   1205   7a                    MOV     A,D
   1206   17                    RAL
   1207   57                    MOV     D,A
   1208   05                    DCR     B
   1209   c2 02 12              JNZ     WBLK_SHL
   120c   21 00 28              LXI     H,DBLOCK0
   120f   19                    DAD     D
   1210   cd 64 10              CALL    RDSETA
   1213   21 00 20              LXI     H,XMBUF
   1216   0e 80                 MVI     C,128
   1218   7e            WBLK:   MOV     A,M
   1219   d3 20                 OUT     RDDATA
   121b   23                    INX     H
   121c   0d                    DCR     C
   121d   c2 18 12              JNZ     WBLK
   1220   2a 60 21              LHLD    RCNT_L
   1223   23                    INX     H
   1224   22 60 21              SHLD    RCNT_L
   1227   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEFCB -- write the FCB directory entry/entries for the received file.
                        ;   Single extent (<=16K) -> one slot; >16K -> two slots (extents 0 and 1).
                        ; ============================================================================
   1228                 WRITEFCB:
   1228   cd 27 13              CALL    BUILD_FCB               ; builds FCB (and FCB2 copy) with name/ext
   122b   2a 60 21              LHLD    RCNT_L
   122e   7c                    MOV     A,H
   122f   b7                    ORA     A
   1230   c2 52 12              JNZ     WFC_TWO
   1233   7d                    MOV     A,L
   1234   fe 81                 CPI     129
   1236   d2 52 12              JNC     WFC_TWO
                                ; ---- single extent (<=16K) ----
   1239   3e 00                 MVI     A,00H
   123b   32 0c 21              STA     FCB+12                  ; EX=0
   123e   32 0d 21              STA     FCB+13                  ; S1=0
   1241   32 0e 21              STA     FCB+14                  ; S2=0
   1244   2a 60 21              LHLD    RCNT_L
   1247   7d                    MOV     A,L
   1248   32 0f 21              STA     FCB+15                  ; RC = records
   124b   cd af 12              CALL    SETALLO                 ; fill FCB+16..31 (blocks from 2)
   124e   cd 9b 12              CALL    WDIRFCB
   1251   c9                    RET
                        
   1252                 WFC_TWO:
   1252   3e 00                 MVI     A,00H
   1254   32 0c 21              STA     FCB+12
   1257   32 0d 21              STA     FCB+13
   125a   32 0e 21              STA     FCB+14
   125d   3e 80                 MVI     A,128
   125f   32 0f 21              STA     FCB+15
   1262   cd af 12              CALL    SETALLO
   1265   2a 60 21              LHLD    RCNT_L
   1268   7d                    MOV     A,L
   1269   d6 80                 SUI     128
   126b   6f                    MOV     L,A
   126c   7c                    MOV     A,H
   126d   de 00                 SBI     00H
   126f   67                    MOV     H,A
   1270   7d                    MOV     A,L
   1271   32 2f 21              STA     FCB2+15                 ; RC extent 1
   1274   3e 01                 MVI     A,01H
   1276   32 2c 21              STA     FCB2+12                 ; EX=1
   1279   3e 00                 MVI     A,00H
   127b   32 2d 21              STA     FCB2+13                 ; S1=0
   127e   32 2e 21              STA     FCB2+14                 ; S2=0
   1281   cd c9 12              CALL    SETALLO2
   1284   cd 9b 12              CALL    WDIRFCB
   1287   21 20 20              LXI     H,DIRBASE+32
   128a   cd 64 10              CALL    RDSETA
   128d   21 20 21              LXI     H,FCB2
   1290   0e 20                 MVI     C,32
   1292   7e            WFC2B:  MOV     A,M
   1293   d3 20                 OUT     RDDATA
   1295   23                    INX     H
   1296   0d                    DCR     C
   1297   c2 92 12              JNZ     WFC2B
   129a   c9                    RET
                        
   129b   21 00 20      WDIRFCB: LXI     H,DIRBASE
   129e   cd 64 10              CALL    RDSETA
   12a1   21 00 21              LXI     H,FCB
   12a4   0e 20                 MVI     C,32
   12a6   7e            WDF:    MOV     A,M
   12a7   d3 20                 OUT     RDDATA
   12a9   23                    INX     H
   12aa   0d                    DCR     C
   12ab   c2 a6 12              JNZ     WDF
   12ae   c9                    RET
                        
   12af                 SETALLO:
   12af   3a 0f 21              LDA     FCB+15
   12b2   b7                    ORA     A
   12b3   c8                    RZ                              ; RC=0 -> no blocks to allocate
   12b4   c6 07                 ADI     07H
   12b6   0f                    RRC
   12b7   0f                    RRC
   12b8   0f                    RRC
   12b9   e6 1f                 ANI     1FH
   12bb   47                    MOV     B,A
   12bc   21 10 21              LXI     H,FCB+16
   12bf   3e 02                 MVI     A,02H
   12c1   77            SA1:    MOV     M,A
   12c2   23                    INX     H
   12c3   3c                    INR     A
   12c4   05                    DCR     B
   12c5   c2 c1 12              JNZ     SA1
   12c8   c9                    RET
                        
   12c9                 SETALLO2:
   12c9   3a 2f 21              LDA     FCB2+15
   12cc   b7                    ORA     A
   12cd   c8                    RZ                              ; RC=0 -> no blocks to allocate
   12ce   c6 07                 ADI     07H
   12d0   0f                    RRC
   12d1   0f                    RRC
   12d2   0f                    RRC
   12d3   e6 1f                 ANI     1FH
   12d5   47                    MOV     B,A
   12d6   21 30 21              LXI     H,FCB2+16
   12d9   3e 12                 MVI     A,12H                   ; extent 1 starts at block 18 (2 + 16)
   12db   77            SA21:   MOV     M,A
   12dc   23                    INX     H
   12dd   3c                    INR     A
   12de   05                    DCR     B
   12df   c2 db 12              JNZ     SA21
   12e2   c9                    RET
                        
                        ; ============================================================================
                        ; READNAME -- read "name.ext" (max 9 chars) from console into FNAME, echoing.
                        ; ============================================================================
   12e3                 READNAME:
   12e3   21 80 21              LXI     H,FNAME
   12e6   06 0c                 MVI     B,12
   12e8   cd 0f 10      RN1:    CALL    RXCHAR
   12eb   fe 0d                 CPI     0DH
   12ed   ca 20 13              JZ      RN_DONE
   12f0   fe 08                 CPI     08H                     ; ^H backspace
   12f2   ca 06 13              JZ      RN_BS
   12f5   fe 7f                 CPI     7FH                     ; DEL backspace
   12f7   ca 06 13              JZ      RN_BS
   12fa   77                    MOV     M,A
   12fb   cd 03 10              CALL    TXCHAR                  ; ECHO the char
   12fe   23                    INX     H
   12ff   05                    DCR     B
   1300   c2 e8 12              JNZ     RN1
   1303   c3 20 13              JMP     RN_DONE
   1306                 RN_BS:  ; backspace: erase from the screen and back the buffer up (if possible)
   1306   3e 08                 MVI     A,08H
   1308   cd 03 10              CALL    TXCHAR
   130b   3e 20                 MVI     A,20H
   130d   cd 03 10              CALL    TXCHAR
   1310   3e 08                 MVI     A,08H
   1312   cd 03 10              CALL    TXCHAR
   1315   78                    MOV     A,B
   1316   fe 09                 CPI     9
   1318   ca e8 12              JZ      RN1                     ; buffer full, at start -> nothing to back up
   131b   2b                    DCX     H
   131c   04                    INR     B
   131d   c3 e8 12              JMP     RN1
   1320   3e 00         RN_DONE: MVI     A,00H
   1322   77                    MOV     M,A                     ; NUL terminate
   1323   cd 39 10              CALL    CRLF
   1326   c9                    RET
                        
                        ; ============================================================================
                        ; BUILD_FCB -- parse FNAME into the 32-byte FCB (and copy into FCB2).
                        ; ============================================================================
   1327                 BUILD_FCB:
   1327   21 00 21              LXI     H,FCB
   132a   06 40                 MVI     B,64                    ; zero both FCBs (2 x 32)
   132c   3e 00         BF_Z:   MVI     A,00H
   132e   77                    MOV     M,A
   132f   23                    INX     H
   1330   05                    DCR     B
   1331   c2 2c 13              JNZ     BF_Z
   1334   11 80 21              LXI     D,FNAME
   1337   21 01 21              LXI     H,FCB+1
   133a   06 08                 MVI     B,8
   133c   1a            BF_N:   LDAX    D
   133d   fe 00                 CPI     00H
   133f   ca 58 13              JZ      BF_NPAD
   1342   fe 2e                 CPI     '.'
   1344   ca 58 13              JZ      BF_GOTEXT
   1347   77                    MOV     M,A
   1348   23                    INX     H
   1349   13                    INX     D
   134a   05                    DCR     B
   134b   c2 3c 13              JNZ     BF_N
   134e   1a                    LDAX    D
   134f   fe 2e                 CPI     '.'
   1351   c2 87 13              JNZ     BF_EXT0
   1354   13                    INX     D
   1355   c3 61 13              JMP     BF_EXT
   1358                 BF_GOTEXT:
   1358   3e 20         BF_NPAD: MVI     A,' '
   135a   77                    MOV     M,A
   135b   23                    INX     H
   135c   05                    DCR     B
   135d   c2 58 13              JNZ     BF_NPAD
   1360   13                    INX     D                       ; skip '.'
   1361   21 09 21      BF_EXT: LXI     H,FCB+9
   1364   06 03                 MVI     B,3
   1366   1a            BF_E:   LDAX    D
   1367   fe 00                 CPI     00H
   1369   ca 7f 13              JZ      BF_EXT_PAD
   136c   fe 2e                 CPI     '.'
   136e   ca 7b 13              JZ      BF_EXT_SKIP
   1371   77                    MOV     M,A
   1372   23                    INX     H
   1373   13                    INX     D
   1374   05                    DCR     B
   1375   c2 66 13              JNZ     BF_E
   1378   c3 87 13              JMP     BF_EXT0
   137b                 BF_EXT_SKIP:
   137b   13                    INX     D
   137c   c3 66 13              JMP     BF_E
   137f                 BF_EXT_PAD:
   137f   3e 20                 MVI     A,' '
   1381   77                    MOV     M,A
   1382   23                    INX     H
   1383   05                    DCR     B
   1384   c2 7f 13              JNZ     BF_EXT_PAD
   1387                 BF_EXT0:
   1387   21 00 21              LXI     H,FCB
   138a   36 00                 MVI     M,00H                   ; dir entry byte0 = USER number (0), not drive
   138c   21 00 21              LXI     H,FCB
   138f   11 20 21              LXI     D,FCB2
   1392   06 20                 MVI     B,32
   1394   7e            BF_C:   MOV     A,M
   1395   12                    STAX    D
   1396   23                    INX     H
   1397   13                    INX     D
   1398   05                    DCR     B
   1399   c2 94 13              JNZ     BF_C
   139c   c9                    RET
                        
                        ; ============================================================================
                        ; DO_DOWNLOAD -- XMODEM send dir-slot-0 file's extent 0 to the host (checksum).
                        ; ============================================================================
   139d                 DO_DOWNLOAD:
   139d   21 ee 15              LXI     H,MSGDL
   13a0   cd 44 10              CALL    PRTSTR
   13a3   21 0f 20              LXI     H,DIRBASE+15
   13a6   cd 64 10              CALL    RDSETA
   13a9   db 20                 IN      RDDATA                  ; A = RC (extent 0)
   13ab   32 2e 14              STA     SEND_RC
   13ae   cd 0f 10              CALL    RXCHAR                  ; wait for NAK/'C' from host
   13b1   cd b7 13              CALL    XM_SENDFILE
   13b4   c3 74 10              JMP     MENU
                        
   13b7                 XM_SENDFILE:
   13b7   3a 2e 14              LDA     SEND_RC
   13ba   47                    MOV     B,A                     ; B = records to send
   13bb   3e 01                 MVI     A,01H
   13bd   32 2f 14              STA     XS_BLK
   13c0   21 00 28              LXI     H,DBLOCK0
   13c3   22 30 14              SHLD    XS_ADDR
   13c6   78            XS_LOOP: MOV     A,B
   13c7   b7                    ORA     A
   13c8   ca 10 14              JZ      XS_DONE
   13cb   3e 01                 MVI     A,XM_SOH
   13cd   cd 03 10              CALL    TXCHAR
   13d0   3a 2f 14              LDA     XS_BLK
   13d3   cd 03 10              CALL    TXCHAR
   13d6   4f                    MOV     C,A
   13d7   2f                    CMA
   13d8   cd 03 10              CALL    TXCHAR
   13db   2a 30 14              LHLD    XS_ADDR
   13de   cd 64 10              CALL    RDSETA
   13e1   1e 00                 MVI     E,00H
   13e3   0e 80                 MVI     C,128
   13e5   db 20         XS_DATA: IN      RDDATA
   13e7   83                    ADD     E
   13e8   5f                    MOV     E,A
   13e9   0d                    DCR     C
   13ea   c2 e5 13              JNZ     XS_DATA
   13ed   7b                    MOV     A,E
   13ee   cd 03 10              CALL    TXCHAR                  ; checksum
   13f1   2a 30 14              LHLD    XS_ADDR
   13f4   11 28 01              LXI     D,0128H
   13f7   19                    DAD     D
   13f8   22 30 14              SHLD    XS_ADDR
   13fb   cd 0f 10              CALL    RXCHAR
   13fe   fe 06                 CPI     XM_ACK
   1400   c2 c6 13              JNZ     XS_LOOP                 ; NAK/unknown -> resend
   1403   3a 2f 14              LDA     XS_BLK
   1406   3c                    INR     A
   1407   32 2f 14              STA     XS_BLK
   140a   78                    MOV     A,B
   140b   3d                    DCR     A
   140c   47                    MOV     B,A
   140d   c2 c6 13              JNZ     XS_LOOP
   1410                 XS_DONE:
   1410   3e 04                 MVI     A,XM_EOT
   1412   cd 03 10              CALL    TXCHAR
   1415   cd 0f 10              CALL    RXCHAR
   1418   fe 06                 CPI     XM_ACK
   141a   ca 25 14              JZ      XS_END
   141d   3e 04                 MVI     A,XM_EOT
   141f   cd 03 10              CALL    TXCHAR
   1422   cd 0f 10              CALL    RXCHAR
   1425   21 04 16      XS_END: LXI     H,MSGDLDONE
   1428   cd 44 10              CALL    PRTSTR
   142b   c3 74 10              JMP     MENU
                        
   142e                 SEND_RC: DS     1
   142f                 XS_BLK:  DS     1
   1430                 XS_ADDR: DS     2
                        
                        ; ============================================================================
                        ; DO_DUMP -- dump 256 bytes from the RAM disk at a hex address, as hex (16/line).
                        ; ============================================================================
   1432                 DO_DUMP:
   1432   21 a9 15              LXI     H,MSGDUMP
   1435   cd 44 10              CALL    PRTSTR
   1438   cd 7f 14              CALL    READHEX                 ; HL = start address
   143b   cd 64 10              CALL    RDSETA
   143e   06 10                 MVI     B,16                    ; 16 lines
   1440   16 10         DUMP_L1: MVI     D,16                    ; 16 bytes per line
   1442   db 20         DUMP_B: IN      RDDATA
   1444   cd 4e 10              CALL    PRTBYTE
   1447   3e 20                 MVI     A,' '
   1449   cd 03 10              CALL    TXCHAR
   144c   15                    DCR     D
   144d   c2 42 14              JNZ     DUMP_B
   1450   cd 39 10              CALL    CRLF
   1453   05                    DCR     B
   1454   c2 40 14              JNZ     DUMP_L1
   1457   c3 74 10              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_MDUMP -- dump 128 bytes of CPU (bank A) memory at a hex address.
                        ; Runs with the monitor banked out; reads bank A RAM directly. Useful for
                        ; inspecting CBIOS/BDOS variable state AFTER a CP/M session (reset -> G 1000).
                        ; ============================================================================
   145a                 DO_MDUMP:
   145a   21 c6 15              LXI     H,MSGMD
   145d   cd 44 10              CALL    PRTSTR
   1460   cd 7f 14              CALL    READHEX                 ; HL = start address
   1463   06 08                 MVI     B,8                     ; 8 lines
   1465   16 10         MD_L1:  MVI     D,16                    ; 16 bytes per line
   1467   7e            MD_B:   MOV     A,M
   1468   cd 4e 10              CALL    PRTBYTE
   146b   3e 20                 MVI     A,' '
   146d   cd 03 10              CALL    TXCHAR
   1470   23                    INX     H
   1471   15                    DCR     D
   1472   c2 67 14              JNZ     MD_B
   1475   cd 39 10              CALL    CRLF
   1478   05                    DCR     B
   1479   c2 65 14              JNZ     MD_L1
   147c   c3 74 10              JMP     MENU
                        
                        ; ---------------------------------------------------------------------------
                        ; READHEX -- read up to 4 hex digits from the console into HL (echoed).
                        ; ---------------------------------------------------------------------------
   147f                 READHEX:
   147f   21 00 00              LXI     H,0000H
   1482   06 04                 MVI     B,4
   1484   cd 0f 10      RH1:    CALL    RXCHAR
   1487   fe 0d                 CPI     0DH
   1489   ca c0 14              JZ      RH_DONE                 ; Enter ends
                                ; determine hex digit value 0-15 in A
   148c   fe 30                 CPI     '0'
   148e   da c4 14              JC      RH_NEXT                 ; < '0' -> ignore
   1491   fe 3a                 CPI     '9'+1
   1493   da a7 14              JC      RH_DIG                  ; '0'-'9'
   1496   e6 df                 ANI     0DFH                    ; uppercase
   1498   fe 41                 CPI     'A'
   149a   da c4 14              JC      RH_NEXT                 ; < 'A' -> ignore
   149d   fe 47                 CPI     'F'+1
   149f   d2 c4 14              JNC     RH_NEXT                 ; > 'F' -> ignore
   14a2   d6 37                 SUI     'A'-10                  ; 'A'-'F' -> 10-15
   14a4   c3 a9 14              JMP     RH_ADD
   14a7   d6 30         RH_DIG: SUI     '0'                     ; '0'-'9' -> 0-9
   14a9   cd 03 10      RH_ADD: CALL    TXCHAR                  ; echo the digit
   14ac   4f                    MOV     C,A                     ; C = digit value
                                ; HL = (HL << 4) | C
   14ad   16 04                 MVI     D,04H
   14af   7d            RH_SHL: MOV     A,L
   14b0   87                    ADD     A
   14b1   6f                    MOV     L,A
   14b2   7c                    MOV     A,H
   14b3   17                    RAL
   14b4   67                    MOV     H,A
   14b5   15                    DCR     D
   14b6   c2 af 14              JNZ     RH_SHL
   14b9   7d                    MOV     A,L
   14ba   b1                    ORA     C
   14bb   6f                    MOV     L,A
   14bc   05                    DCR     B
   14bd   c2 84 14              JNZ     RH1
   14c0                 RH_DONE:
   14c0   cd 39 10              CALL    CRLF
   14c3   c9                    RET
   14c4   c3 84 14      RH_NEXT: JMP     RH1
                        
