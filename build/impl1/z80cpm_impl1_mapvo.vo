module pll_inst_PLLInst_0 ( input CLKI, CLKFB, output CLKOP );
  wire   GNDI;

  EHXPLLE_B \pll_inst/PLLInst_0_EHXPLLE ( .CLKI(CLKI), .CLKFB(CLKFB), 
    .RST(GNDI), .RSTK(GNDI), .WRDEL(GNDI), .DRPAI3(GNDI), .DRPAI2(GNDI), 
    .DRPAI1(GNDI), .DRPAI0(GNDI), .DFPAI3(GNDI), .DFPAI2(GNDI), .DFPAI1(GNDI), 
    .DFPAI0(GNDI), .PWD(GNDI), .CLKOP(CLKOP), .CLKOS(), .CLKOK(), .CLKOK2(), 
    .LOCK(), .CLKINTFB());
  gnd DRIVEGND( .PWR0(GNDI));

  specify
    (CLKI => CLKOP) = (0:0:0,0:0:0);
    (CLKFB => CLKOP) = (0:0:0,0:0:0);
  endspecify

endmodule

module EHXPLLE_B ( input CLKI, CLKFB, RST, RSTK, WRDEL, DRPAI3, DRPAI2, DRPAI1, 
    DRPAI0, DFPAI3, DFPAI2, DFPAI1, DFPAI0, PWD, output CLKOP, CLKOS, CLKOK, 
    CLKOK2, LOCK, CLKINTFB );

  EHXPLLE1 INST10( .RST(RST), .RSTK(RSTK), .CLKI(CLKI), .CLKFB(CLKFB), 
    .WRDEL(WRDEL), .DRPAI3(DRPAI3), .DRPAI2(DRPAI2), .DRPAI1(DRPAI1), 
    .DRPAI0(DRPAI0), .DFPAI3(DFPAI3), .DFPAI2(DFPAI2), .DFPAI1(DFPAI1), 
    .DFPAI0(DFPAI0), .PWD(PWD), .CLKOP(CLKOP), .CLKOK(CLKOK), .CLKOK2(CLKOK2), 
    .CLKOS(CLKOS), .LOCK(LOCK), .CLKINTFB(CLKINTFB));
  defparam INST10.CLKFB_DIV = 1;
  defparam INST10.CLKI_DIV = 2;
  defparam INST10.CLKOK_BYPASS = "DISABLED";
  defparam INST10.CLKOK_DIV = 2;
  defparam INST10.CLKOP_BYPASS = "DISABLED";
  defparam INST10.CLKOP_DIV = 32;
  defparam INST10.CLKOP_TRIM_DELAY = 0;
  defparam INST10.CLKOP_TRIM_POL = "FALLING";
  defparam INST10.CLKOS_BYPASS = "DISABLED";
  defparam INST10.CLKOS_TRIM_DELAY = 0;
  defparam INST10.CLKOS_TRIM_POL = "RISING";
  defparam INST10.DUTY = 8;
  defparam INST10.FIN = "50.000000";
  defparam INST10.PHASEADJ = "0.0";
  defparam INST10.PHASE_CNTL = "STATIC";
endmodule
