                        ; SDPROBE.COM -- Brevia2 SD-card probe (SPI mode), bare-metal driver demo.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port wired to pins 31/32/35/36:
                        ;   IN  0x53 = SD SPI data        (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl   bit0 = CS# (0 = select, 1 = release)
                        ;                           bit1 = slow clock (1 = ~390 kHz for card init)
                        ;   IN  0x55 = SD SPI status bit0 = transfer-busy
                        ;
                        ; The on-board flash SPI pins are not broken out, so the SD breakout has its
                        ; OWN SPI port (implemented as a second instance of the generic byte engine in
                        ; rtl/z80cpm_brevia2.v).
                        ;
                        ; What it does:
                        ;   1. Full SPI-mode init handshake (power-up clocks, CMD0, CMD8, CMD55/ACMD41,
                        ;      CMD58, CMD16) -- proves the card initializes on real silicon.
                        ;   2. Reads the CID (CMD9) and prints manufacturer ID, product name, serial.
                        ;   3. Reads block 0 (CMD17) and reports whether an MBR (55AA) is present,
                        ;      printing the first partition entry (type / LBA / size) -- the first
                        ;      step toward partitioning support.
                        ;
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 49 03              LXI     H,BANNER
   0103   cd da 02              CALL    PSTR
                        
                                ; ---------------- 1. init the card ----------------
   0106   cd f6 01              CALL    SDINIT          ; A = 0 if init OK (CMD0 idle + ACMD41 ready), 0FFh if not
   0109   b7                    ORA     A
   010a   ca 17 01              JZ      INI_OK
   010d   21 82 03              LXI     H,MSG_NOCARD
   0110   cd da 02              CALL    PSTR
   0113   cd e8 02              CALL    CRLF
   0116   c9                    RET
   0117                 INI_OK:
   0117   21 70 03              LXI     H,MSG_INI
   011a   cd da 02              CALL    PSTR
   011d   3a 61 04              LDA     CMDR1           ; show the CMD0 R1 (01h = idle) for hardware diagnostics
   0120   cd f3 02              CALL    PRHEX2
   0123   cd e8 02              CALL    CRLF
                        
                                ; ---- detect card type (CMD58 -> OCR CCS bit30) ----
   0126   cd 79 02              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0129   b7                    ORA     A
   012a   ca 36 01              JZ      IS_SC
   012d   21 9a 03              LXI     H,MSG_SDHC
   0130   cd da 02              CALL    PSTR
   0133   c3 3c 01              JMP     AFTER_TYPE
   0136                 IS_SC:
   0136   21 bf 03              LXI     H,MSG_SDSC
   0139   cd da 02              CALL    PSTR
   013c                 AFTER_TYPE:
   013c   cd e8 02              CALL    CRLF
                        
                                ; ---------------- 2. read CID ----------------
   013f   cd 8c 02              CALL    SD_CID          ; A = 1 ok / 0 err
   0142   b7                    ORA     A
   0143   ca 52 01              JZ      CID_OK
   0146   21 f3 03              LXI     H,MSG_CIDERR
   0149   cd da 02              CALL    PSTR
   014c   cd e8 02              CALL    CRLF
   014f   c3 95 01              JMP     AFTER_CID
   0152                 CID_OK:
   0152   21 de 03              LXI     H,MSG_CID
   0155   cd da 02              CALL    PSTR
                                ; manufacturer ID (CID[0])
   0158   3a 62 04              LDA     CIDBUF
   015b   cd f3 02              CALL    PRHEX2
   015e   1e 20                 MVI     E,' '
   0160   cd e2 02              CALL    CPUTC
                                ; product name (CID[3..7], 5 ASCII bytes)
   0163   21 65 04              LXI     H,CIDBUF+3
   0166   06 05                 MVI     B,5
   0168                 CID_NM:
   0168   5e                    MOV     E,M
   0169   cd e2 02              CALL    CPUTC
   016c   23                    INX     H
   016d   05                    DCR     B
   016e   c2 68 01              JNZ     CID_NM
   0171   cd e8 02              CALL    CRLF
                                ; serial number (CID[9..12])
   0174   21 e9 03              LXI     H,MSG_SN
   0177   cd da 02              CALL    PSTR
   017a   3a 6b 04              LDA     CIDBUF+9
   017d   cd f3 02              CALL    PRHEX2
   0180   3a 6c 04              LDA     CIDBUF+10
   0183   cd f3 02              CALL    PRHEX2
   0186   3a 6d 04              LDA     CIDBUF+11
   0189   cd f3 02              CALL    PRHEX2
   018c   3a 6e 04              LDA     CIDBUF+12
   018f   cd f3 02              CALL    PRHEX2
   0192   cd e8 02              CALL    CRLF
   0195                 AFTER_CID:
                        
                                ; ---------------- 3. read block 0 + MBR check ----------------
   0195   cd b3 02              CALL    SD_BLK0         ; A = 1 ok / 0 err
   0198   b7                    ORA     A
   0199   ca a8 01              JZ      BLK_OK
   019c   21 05 04              LXI     H,MSG_BLKERR
   019f   cd da 02              CALL    PSTR
   01a2   cd e8 02              CALL    CRLF
   01a5   c3 ec 01              JMP     AFTER_BLK
   01a8                 BLK_OK:
                                ; check MBR signature 55AA at DBUF+510
   01a8   21 70 06              LXI     H,DBUF+510
   01ab   7e                    MOV     A,M
   01ac   fe 55                 CPI     55H
   01ae   c2 e3 01              JNZ     NO_MBR
   01b1   23                    INX     H
   01b2   7e                    MOV     A,M
   01b3   fe aa                 CPI     0AAH
   01b5   c2 e3 01              JNZ     NO_MBR
                                ; MBR present -> print partition 1 info
   01b8   21 1b 04              LXI     H,MSG_MBR
   01bb   cd da 02              CALL    PSTR
                                ; type byte at DBUF+446+4
   01be   21 34 06              LXI     H,DBUF+446+4
   01c1   7e                    MOV     A,M
   01c2   cd f3 02              CALL    PRHEX2
   01c5   1e 20                 MVI     E,' '
   01c7   cd e2 02              CALL    CPUTC
                                ; LBA start (bytes +8..+11, little-endian); size (+12..+15)
   01ca   21 38 06              LXI     H,DBUF+446+8
   01cd   06 08                 MVI     B,8             ; 4 LBA bytes + 4 size bytes
   01cf                 MBR_LP:
   01cf   7e                    MOV     A,M
   01d0   cd f3 02              CALL    PRHEX2
   01d3   1e 20                 MVI     E,' '
   01d5   cd e2 02              CALL    CPUTC
   01d8   23                    INX     H
   01d9   05                    DCR     B
   01da   c2 cf 01              JNZ     MBR_LP
   01dd   cd e8 02              CALL    CRLF
   01e0   c3 ec 01              JMP     AFTER_BLK
   01e3                 NO_MBR:
   01e3   21 47 04              LXI     H,MSG_NOMBR
   01e6   cd da 02              CALL    PSTR
   01e9   cd e8 02              CALL    CRLF
   01ec                 AFTER_BLK:
                        
   01ec   21 59 04              LXI     H,MSG_DONE
   01ef   cd da 02              CALL    PSTR
   01f2   cd e8 02              CALL    CRLF
   01f5   c9                    RET
                        
                        ; ================= SD card driver subroutines =================
                        
                        ; SDINIT: full SPI-mode initialization.  Returns A = R1 of CMD0 (01h = idle).
                        ;   CS# high + slow clock, 10x 0xFF = 80 power-up clocks, then CMD0.
   01f6                 SDINIT:
   01f6   3e 03                 MVI     A,03H           ; bit0=1 (CS high), bit1=1 (slow)
   01f8   d3 54                 OUT     SDCTL
   01fa   06 0a                 MVI     B,10            ; 10 byte-writes = 80 clock pulses
   01fc                 SDI_CK:
   01fc   3e ff                 MVI     A,0FFH
   01fe   d3 53                 OUT     SDDAT
   0200   05                    DCR     B
   0201   c2 fc 01              JNZ     SDI_CK
   0204   3e 02                 MVI     A,02H           ; select card (CS low), stay slow
   0206   d3 54                 OUT     SDCTL
   0208   21 19 03              LXI     H,CMD0
   020b   cd 33 02              CALL    SD_SEND6        ; A = R1 (01h = idle)
   020e   32 61 04              STA     CMDR1
   0211   fe 01                 CPI     01H             ; must be in idle state to proceed
   0213   c2 2d 02              JNZ     SDI_FAIL
                                ; poll CMD55+ACMD41 until out of idle
   0216   16 28                 MVI     D,40            ; max 40 iterations
   0218                 SDI_READY:
   0218   21 25 03              LXI     H,CMD55
   021b   cd 33 02              CALL    SD_SEND6
   021e   21 2b 03              LXI     H,ACMD41
   0221   cd 33 02              CALL    SD_SEND6        ; A = R1
   0224   fe 00                 CPI     00H
   0226   ca 30 02              JZ      SDI_OK
   0229   15                    DCR     D
   022a   c2 18 02              JNZ     SDI_READY
   022d                 SDI_FAIL:
   022d   3e ff                 MVI     A,0FFH
   022f   c9                    RET
   0230                 SDI_OK:
   0230   3e 00                 MVI     A,00H
   0232   c9                    RET
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Assumes the card is already selected (CS low).  Returns A = R1 (0FFh = no
                        ;   valid response after 16 bytes of clocking).
   0233                 SD_SEND6:
   0233   06 06                 MVI     B,6
   0235                 SD6_TX:
   0235   7e                    MOV     A,M
   0236   d3 53                 OUT     SDDAT
   0238   23                    INX     H
   0239   05                    DCR     B
   023a   c2 35 02              JNZ     SD6_TX
   023d   06 10                 MVI     B,16            ; clock up to 16 bytes looking for the response
   023f                 SD6_RX:
   023f   db 53                 IN      SDDAT           ; clocks out FFh, returns the MISO byte
   0241   fe ff                 CPI     0FFH
   0243   c2 4a 02              JNZ     SD6_DONE
   0246   05                    DCR     B
   0247   c2 3f 02              JNZ     SD6_RX
   024a                 SD6_DONE:
   024a   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success; CY=1 if 255 bytes pass with no token.
   024b                 SD_WAITTKN:
   024b   06 ff                 MVI     B,0FFH
   024d                 SD_WT:
   024d   db 53                 IN      SDDAT
   024f   fe fe                 CPI     0FEH
   0251   ca 5a 02              JZ      SD_WT_OK
   0254   05                    DCR     B
   0255   c2 4d 02              JNZ     SD_WT
   0258   37                    STC
   0259   c9                    RET
   025a                 SD_WT_OK:
   025a   b7                    ORA     A               ; clear CY
   025b   c9                    RET
                        
                        ; SD_READBLK: read a 512-byte data block into the buffer at (HL) after a
                        ;   command has returned R1=0 and the 0FEh token; discard 2 CRC bytes.
                        ;   Returns A = 1 ok / 0 err (CY used internally).
   025c                 SD_READBLK:
   025c   cd 4b 02              CALL    SD_WAITTKN
   025f   da 76 02              JC      SDRB_FAIL
   0262   01 00 02              LXI     B,512
   0265                 SDRB_LP:
   0265   db 53                 IN      SDDAT
   0267   77                    MOV     M,A
   0268   23                    INX     H
   0269   0b                    DCX     B
   026a   78                    MOV     A,B
   026b   b1                    ORA     C
   026c   c2 65 02              JNZ     SDRB_LP
   026f   db 53                 IN      SDDAT           ; discard 2 CRC bytes
   0271   db 53                 IN      SDDAT
   0273   3e 01                 MVI     A,1
   0275   c9                    RET
   0276                 SDRB_FAIL:
   0276   3e 00                 MVI     A,0
   0278   c9                    RET
                        
                        ; SDCCS: read the OCR (CMD58) and return the Card Capacity Status bit.
                        ;   Returns A = 40h (SDHC/SDXC, block addressing) or 00h (SDSC, byte addressing).
                        ;   Assumes card selected (CS low).
   0279                 SDCCS:
   0279   21 31 03              LXI     H,CMD58
   027c   cd 33 02              CALL    SD_SEND6        ; A = R1
   027f   db 53                 IN      SDDAT           ; OCR byte0 (bits31..24); CCS=bit30 => bit6
   0281   e6 40                 ANI     40H
   0283   4f                    MOV     C,A
   0284   db 53                 IN      SDDAT           ; consume OCR bytes 1..3
   0286   db 53                 IN      SDDAT
   0288   db 53                 IN      SDDAT
   028a   79                    MOV     A,C
   028b   c9                    RET
                        
                        ; SD_CID: read the 16-byte CID (CMD9) into CIDBUF.
                        ;   Returns A = 1 ok / 0 err.  Manages CS low -> read -> release high.
   028c                 SD_CID:
   028c   3e 00                 MVI     A,00H
   028e   d3 54                 OUT     SDCTL           ; select, fast
   0290   21 3d 03              LXI     H,CMD9
   0293   cd 33 02              CALL    SD_SEND6        ; A = R1
   0296   fe 00                 CPI     00H
   0298   c2 ac 02              JNZ     SDCID_TE
   029b   21 62 04              LXI     H,CIDBUF
   029e   cd 5c 02              CALL    SD_READBLK      ; A = 1 ok / 0 err
   02a1   b7                    ORA     A
   02a2   ca ac 02              JZ      SDCID_TE        ; read failed
   02a5   3e 01                 MVI     A,01H
   02a7   d3 54                 OUT     SDCTL           ; release CS
   02a9   3e 00                 MVI     A,00H           ; success (matches SDINIT: 0 = ok)
   02ab   c9                    RET
   02ac                 SDCID_TE:
   02ac   3e 01                 MVI     A,01H
   02ae   d3 54                 OUT     SDCTL           ; release CS
   02b0   3e ff                 MVI     A,0FFH          ; error
   02b2   c9                    RET
                        
                        ; SD_BLK0: read block 0 (CMD17) into DBUF.
                        ;   Returns A = 1 ok / 0 err.
   02b3                 SD_BLK0:
   02b3   3e 00                 MVI     A,00H
   02b5   d3 54                 OUT     SDCTL           ; select, fast
   02b7   21 43 03              LXI     H,CMD17
   02ba   cd 33 02              CALL    SD_SEND6        ; A = R1
   02bd   fe 00                 CPI     00H
   02bf   c2 d3 02              JNZ     SDBLK_TE
   02c2   21 72 04              LXI     H,DBUF
   02c5   cd 5c 02              CALL    SD_READBLK      ; A = 1 ok / 0 err
   02c8   b7                    ORA     A
   02c9   ca d3 02              JZ      SDBLK_TE
   02cc   3e 01                 MVI     A,01H
   02ce   d3 54                 OUT     SDCTL           ; release CS
   02d0   3e 00                 MVI     A,00H           ; success
   02d2   c9                    RET
   02d3                 SDBLK_TE:
   02d3   3e 01                 MVI     A,01H
   02d5   d3 54                 OUT     SDCTL           ; release CS
   02d7   3e ff                 MVI     A,0FFH          ; error
   02d9   c9                    RET
                        
                        ; ---------------- console / numeric helpers (as in SWLED) ----------------
   02da                 PSTR:
   02da   54                    MOV     D,H
   02db   5d                    MOV     E,L
   02dc   0e 09                 MVI     C,9
   02de   cd 05 00              CALL    5
   02e1   c9                    RET
                        
   02e2                 CPUTC:
   02e2   0e 02                 MVI     C,2
   02e4   cd 05 00              CALL    5
   02e7   c9                    RET
                        
   02e8                 CRLF:
   02e8   1e 0d                 MVI     E,13
   02ea   cd e2 02              CALL    CPUTC
   02ed   1e 0a                 MVI     E,10
   02ef   cd e2 02              CALL    CPUTC
   02f2   c9                    RET
                        
                        ; PRHEX2 -- print the byte in A as two uppercase hex digits.
   02f3                 PRHEX2:
   02f3   32 60 04              STA     HEXV
   02f6   3a 60 04              LDA     HEXV
   02f9   0f                    RRC
   02fa   0f                    RRC
   02fb   0f                    RRC
   02fc   0f                    RRC
   02fd   e6 0f                 ANI     0FH
   02ff   cd 0b 03              CALL    PRNIB
   0302   3a 60 04              LDA     HEXV
   0305   e6 0f                 ANI     0FH
   0307   cd 0b 03              CALL    PRNIB
   030a   c9                    RET
                        
   030b                 PRNIB:
   030b   fe 0a                 CPI     0AH
   030d   da 12 03              JC      PRNIB_NUM
   0310   c6 07                 ADI     07H
   0312                 PRNIB_NUM:
   0312   c6 30                 ADI     '0'
   0314   5f                    MOV     E,A
   0315   cd e2 02              CALL    CPUTC
   0318   c9                    RET
                        
                        ; ---------------- data ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   0319   40 00 00 00   CMD0:   DB      40H,00H,00H,00H,00H,95H
   031d   00 95         
   031f   48 00 00 01   CMD8:   DB      48H,00H,00H,01H,0AAH,87H
   0323   aa 87         
   0325   77 00 00 00   CMD55:  DB      77H,00H,00H,00H,00H,65H
   0329   00 65         
   032b   69 40 00 00   ACMD41: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   032f   00 77         
   0331   7a 00 00 00   CMD58:  DB      7AH,00H,00H,00H,00H,0FDH
   0335   00 fd         
   0337   50 00 00 02   CMD16:  DB      50H,00H,00H,02H,00H,0FFH  ; set block length = 512
   033b   00 ff         
   033d   49 00 00 00   CMD9:   DB      49H,00H,00H,00H,00H,0FFH  ; read CID
   0341   00 ff         
   0343   51 00 00 00   CMD17:  DB      51H,00H,00H,00H,00H,0FFH  ; read single block (block 0)
   0347   00 ff         
                        
   0349   53 44 50 52   BANNER: DB      'SDPROBE v0.1 - Brevia2 SD card probe',13,10,'$'
   034d   4f 42 45 20   
   0351   76 30 2e 31   
   0355   20 2d 20 42   
   0359   72 65 76 69   
   035d   61 32 20 53   
   0361   44 20 63 61   
   0365   72 64 20 70   
   0369   72 6f 62 65   
   036d   0d 0a 24      
   0370   49 4e 49 54   MSG_INI: DB      'INIT: CMD0 ok R1=','$'
   0374   3a 20 43 4d   
   0378   44 30 20 6f   
   037c   6b 20 52 31   
   0380   3d 24         
   0382   0d 0a 4e 4f   MSG_NOCARD: DB  13,10,'NO CARD / init failed','$'
   0386   20 43 41 52   
   038a   44 20 2f 20   
   038e   69 6e 69 74   
   0392   20 66 61 69   
   0396   6c 65 64 24   
   039a   0d 0a 54 59   MSG_SDHC: DB    13,10,'TYPE: SDHC/SDXC (block addressing)','$'
   039e   50 45 3a 20   
   03a2   53 44 48 43   
   03a6   2f 53 44 58   
   03aa   43 20 28 62   
   03ae   6c 6f 63 6b   
   03b2   20 61 64 64   
   03b6   72 65 73 73   
   03ba   69 6e 67 29   
   03be   24            
   03bf   0d 0a 54 59   MSG_SDSC: DB    13,10,'TYPE: SDSC (byte addressing)','$'
   03c3   50 45 3a 20   
   03c7   53 44 53 43   
   03cb   20 28 62 79   
   03cf   74 65 20 61   
   03d3   64 64 72 65   
   03d7   73 73 69 6e   
   03db   67 29 24      
   03de   0d 0a 43 49   MSG_CID: DB     13,10,'CID: ID=','$'
   03e2   44 3a 20 49   
   03e6   44 3d 24      
   03e9   0d 0a 20 20   MSG_SN:  DB     13,10,'    SN=','$'
   03ed   20 20 53 4e   
   03f1   3d 24         
   03f3   0d 0a 43 49   MSG_CIDERR: DB  13,10,'CID read failed','$'
   03f7   44 20 72 65   
   03fb   61 64 20 66   
   03ff   61 69 6c 65   
   0403   64 24         
   0405   0d 0a 62 6c   MSG_BLKERR: DB  13,10,'block 0 read failed','$'
   0409   6f 63 6b 20   
   040d   30 20 72 65   
   0411   61 64 20 66   
   0415   61 69 6c 65   
   0419   64 24         
   041b   0d 0a 4d 42   MSG_MBR: DB     13,10,'MBR: present (55AA)  PART1 type/lba/size=','$'
   041f   52 3a 20 70   
   0423   72 65 73 65   
   0427   6e 74 20 28   
   042b   35 35 41 41   
   042f   29 20 20 50   
   0433   41 52 54 31   
   0437   20 74 79 70   
   043b   65 2f 6c 62   
   043f   61 2f 73 69   
   0443   7a 65 3d 24   
   0447   0d 0a 4d 42   MSG_NOMBR: DB   13,10,'MBR: none (raw)','$'
   044b   52 3a 20 6e   
   044f   6f 6e 65 20   
   0453   28 72 61 77   
   0457   29 24         
   0459   0d 0a 44 4f   MSG_DONE: DB    13,10,'DONE','$'
   045d   4e 45 24      
                        
   0460                 HEXV:   DS      1
   0461                 CMDR1:  DS      1
   0462                 CIDBUF: DS      16
   0472                 DBUF:   DS      512
   0672                         END
032b  ACMD41        01ec  AFTER_BLK     0195  AFTER_CID     013c  AFTER_TYPE
0349  BANNER        01a8  BLK_OK        0462  CIDBUF        0168  CID_NM    
0152  CID_OK        0319  CMD0          0337  CMD16         0343  CMD17     
0325  CMD55         0331  CMD58         031f  CMD8          033d  CMD9      
0461  CMDR1         02e2  CPUTC         02e8  CRLF          0472  DBUF      
0460  HEXV          0117  INI_OK        0136  IS_SC         01cf  MBR_LP    
0405  MSG_BLKERR    03de  MSG_CID       03f3  MSG_CIDERR    0459  MSG_DONE  
0370  MSG_INI       041b  MSG_MBR       0382  MSG_NOCARD    0447  MSG_NOMBR 
039a  MSG_SDHC      03bf  MSG_SDSC      03e9  MSG_SN        01e3  NO_MBR    
02f3  PRHEX2        030b  PRNIB         0312  PRNIB_NUM     02da  PSTR      
024a  SD6_DONE      023f  SD6_RX        0235  SD6_TX        02d3  SDBLK_TE  
0279  SDCCS         02ac  SDCID_TE      0054  SDCTL         0053  SDDAT     
01f6  SDINIT        01fc  SDI_CK        022d  SDI_FAIL      0230  SDI_OK    
0218  SDI_READY     0276  SDRB_FAIL     0265  SDRB_LP       0055  SDSTAT    
02b3  SD_BLK0       028c  SD_CID        025c  SD_READBLK    0233  SD_SEND6  
024b  SD_WAITTKN    024d  SD_WT         025a  SD_WT_OK      0100  START     
