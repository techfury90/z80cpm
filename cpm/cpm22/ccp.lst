   51/D000 :                            
   52/D000 :                            ;	********************************************************
   53/D000 :                            ;	*	Base of CCP contains the following code/data   *
   54/D000 :                            ;	*	ccp:	jmp ccpstart	(start with command)   *
   55/D000 :                            ;	*		jmp ccpclear    (start, clear command) *
   56/D000 :                            ;	*	ccp+6	127		(max command length)   *
   57/D000 :                            ;	*	ccp+7	comlen		(command length = 00)  *
   58/D000 :                            ;	*	ccp+8	' ... '		(16 blanks)	       *
   59/D000 :                            ;	********************************************************
   60/D000 :                            ;	* Normal entry is at ccp, where the command line given *
