                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xE600 (BIOS base) so the image is loaded
                        ;   exactly at 0xE600 by the GWMON-80 'L' command and entered with 'G E600'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xCFFF  TPA
                        ;       0xD000-0xD7FF  CCP  (already loaded by the combined HEX)
                        ;       0xD800-0xE5FF  BDOS (already loaded by the combined HEX)
                        ;       0xE600-0xEFFF  THIS CBIOS
                        ;       0xEF00-0xFEFF  drive A: 4KB RMW buffer (ABOVE the whole CP/M system, so
                        ;                     no transient program can ever load over it)
                        ;       0xFF00-0xFFFF  reserved for GWMON (its stack / banked-out area; CP/M
                        ;                     must stay strictly below 0xFF00 so the monitor cannot
                        ;                     clobber a running system image -- do not use this region).
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 115200)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;   drive A:  the on-board ISSI IS25LD040 SPI flash (512 KB, persistent boot drive).
                        ;   drive B:  the 64K I/O-mapped RAM disk (volatile scratch).
                        ;                             0x50 = DATA (read clocks a byte in / write clocks
                        ;                                     a byte out, MSB first)
                        ;                             0x51 = CTL (bit0 = CS#: 0=select low, 1=release)
                        ;                             0x52 = STATUS (bit0 = transfer busy; poll OPTIONAL
                        ;                                     because the RTL byte engine stretches the
                        ;                                     CPU wait on every 0x50 access)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive B:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   e600                         ORG     0E600H
                        
                        ; ---- build configuration (SPI-primary vs SD-primary) ----------------------
                        ;   Selects the drive-letter map and the BOOT/WBOOT persist target.  Swap
                        ;   cpm/cbios_cfg.inc (or use scripts/build_cbios.sh {sd|spi}) to build the
                        ;   other variant.  a85 has no -D flag, so the mode is a source-level config.
                                INCL    "cpm/cbios_cfg.inc"
                        ; ============================================================================
                        ;   CBIOS BUILD CONFIGURATION -- SPI-FLASH-PRIMARY build
                        ;   --------------------------------------------------------------------------
                        ;   This is the legacy/original configuration.  Drive-letter map:
                        ;
                        ;       A: (SELDSK 0)  on-board ISSI IS25LD040 SPI flash  -- the boot drive
                        ;       B: (SELDSK 1)  64K I/O-mapped RAM disk (volatile)
                        ;       C: (SELDSK 2)  SD card, partition region 0  (data, not bootable)
                        ;       D: (SELDSK 3)  SD card, partition region 1  (data, not bootable)
                        ;
                        ;   COLD/WARM boot persist & reload the CCP/BDOS to/from the RAM disk system
                        ;   tracks (the legacy behaviour -- the flash is the power-on boot store).
                        ;
                        ;   Copy this file over cbios_cfg.inc (or build via scripts/build_cbios.sh spi)
                        ;   to assemble the SPI-primary CBIOS.
                        ; ============================================================================
   0000                 CFG_SD_BUILD    EQU     0               ; 0 = SPI-primary (A:=flash, B:=RAM, C/D:=SD)
   0001                 CFG_BOOT_DEVICE EQU     1               ; boot device for BOOT/WBOOT persist: 1 = RAM disk (legacy)
                        
                        
                        ; ---- constants ------------------------------------------------------------
   e600                 BIOS    EQU     0E600H          ; BIOS base (jump table origin)
   d000                 CCP     EQU     0D000H          ; CCP origin
   2000                 CPMIMGLEN EQU   2000H           ; bytes of the boot image (CCP+BDOS+CBIOS, padded).
                                                        ;  MUST be a multiple of 512 (the SD sector size) so BOOT/WBOOT
                                                        ;  can persist/reload it in whole SD sectors, and MUST agree with
                                                        ;  make_combined_hex.py, programs/diskutil.s and gwmon/smbrevia.asm
                                                        ;  (the load/burn length).  This is the full system image
                                                        ;  INCLUDING the CBIOS -- the SD system area (SDSYS_OFF) must be
                                                        ;  large enough to hold all of it.  The image runs 0xD000-0xEFFF;
                                                        ;  the last 0x100 bytes overlap the head of RMWBUF (0xEF00) with
                                                        ;  0x00 padding, which is overwritten on the first disk RMW.
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xE603.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   d800                 BDOSL   EQU     0D800H          ; BDOS origin
   d806                 BDOSENT EQU     0D806H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
   0040                 LEDPORT EQU     40H             ; drive-activity LEDs (write bit = drive; MSB = drive A).
                                                        ;  Port 40h is shared read-only with the DIP switches.
                        ;
                        ; ---- ISSI IS25LD040 SPI flash ports (drive B:) — same map as diskutil ---- 
   0050                 SPI_DATA EQU    50H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0051                 SPI_CTL  EQU    51H             ; write bit0 = CS# (0=select low, 1=release high)
   0052                 SPI_STAT EQU    52H             ; read bit0 = transfer busy (poll OPTIONAL)
                        ;
                        ; ---- drive B: flash geometry (must match the DPB AND diskutil's formatter) ----
   ef00                 RMWBUF  EQU     0EF00H          ; 4KB read-modify-write buffer ABOVE the CP/M system
                                                        ;  (0xEF00-0xFEFF, just below GWMON's reserved 0xFF00).
                                                        ;  It is above the CCP/BDOS/CBIOS, so no transient program
                                                        ;  (bounded by the CCP at 0xD000) can ever load over it --
                                                        ;  this is the whole point of moving the system down.
                        ; ---- SD card (drive C:) dedicated SPI port, pins 31/32/35/36 ----
   0053                 SD_DATA EQU     53H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0054                 SD_CTL  EQU     54H             ; write bit0 = CS# (0=select low, 1=release high);
                                                        ;        bit1 = slow clock (1 = ~390 kHz for card init)
   0055                 SD_STAT EQU     55H             ; read bit0 = transfer busy (poll OPTIONAL; the engine
                                                        ;        wait-stretches the CPU so no polling is needed)
   0001                 SDPLBA  EQU     1               ; SD partition LBA start (from the sdtool-created MBR, LBA=1).
                                                        ; Drive A:/B: are SD CP/M drives (DPBA/DPBB below);
                                                        ; the deblock buffer ALIASES the RMWBUF region (drive C flash
                                                        ; writes and drive A/B SD accesses NEVER happen at the same time
                                                        ; -- the BDOS drives one disk at a time).
                        ; ---- SD reserved system area (per SD drive/region) -------------------------
                        ;   Each SD logical volume reserves a system area at its region start to hold a
                        ;   bootable CP/M system image (CCP+BDOS+CBIOS).  The image is CPMIMGLEN =
                        ;   0x1E00 = 7680 B = 15 SD 512B sectors, so 16 sectors (OFF=2 tracks worth, 8KB)
                        ;   leaves 1 sector of headroom.  The system-area offset is added at the CBIOS
                        ;   SDMAP layer (the BDOS does NOT reliably apply the DPB OFF field here), and
                        ;   the formatter must write the directory/data area PAST this offset.
                        ;   NOTE: the system lanes must cover the FULL image INCLUDING the CBIOS, so a
                        ;   cold boot can reload CCP+BDOS+CBIOS from the SD -- not just CCP+BDOS.
   0010                 SDSYS_OFF EQU    16              ; SD 512B sectors reserved for the system area per volume
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xE600
                        ; ============================================================================
   e600   c3 33 e6              JMP     BOOT            ; 0  BIOS+0   cold start
   e603   c3 6a e6              JMP     WBOOT           ; 1  BIOS+3   warm start
   e606   c3 b1 e6              JMP     CONST           ; 2  BIOS+6   console status
   e609   c3 bd e6              JMP     CONIN           ; 3  BIOS+9   console input
   e60c   c3 c7 e6              JMP     CONOUT          ; 4  BIOS+12  console output
   e60f   c3 eb e6              JMP     LIST            ; 5  BIOS+15  list device output
   e612   c3 ee e6              JMP     PUNCH           ; 6  BIOS+18  punch device output
   e615   c3 f1 e6              JMP     READER          ; 7  BIOS+21  reader device input
   e618   c3 24 e7              JMP     HOME            ; 8  BIOS+24  home the disk
   e61b   c3 f7 e6              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   e61e   c3 2f e7              JMP     SETTRK          ; 10 BIOS+30  set current track
   e621   c3 38 e7              JMP     SETSEC          ; 11 BIOS+33  set current sector
   e624   c3 3d e7              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   e627   c3 90 e7              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   e62a   c3 c5 e7              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   e62d   c3 f4 e6              JMP     LISTST          ; 15 BIOS+45  list device status
   e630   c3 46 e7              JMP     SECTRAN         ; 16 BIOS+48  sector translate (identity)
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xE600 via 'G E600')
                        ; ============================================================================
   e633                 BOOT:
   e633   31 00 ce              LXI     SP,0CE00H       ; establish a stack in the TPA (below CCP@D000);
                                                        ; it must sit BELOW the system (D000+) so the boot's
                                                        ;  stack use cannot clobber CCP/BDOS/CBIOS code.
   e636   3e 01                 MVI     A,01H
   e638   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   e63a   cd 92 e6              CALL    SETVEC
                        ;
                        ; ---- initialize the SD card (drives A:/B:) before anything touches it ------
   e63d   cd 15 ea              CALL    SD_INIT
                        ;
   0000                         IF      CFG_SD_BUILD
                        ; ---- persist the CP/M system image to the SD system area -------------------
                        ;   The SD is the power-on boot store.  Write the FULL image (CCP+BDOS+CBIOS,
                        ;   CPMIMGLEN bytes) to drive A:'s reserved SD system area so a cold boot can
                        ;   reload the entire system from the SD -- the system tracks must cover the
                        ;   CBIOS, not just the CCP/BDOS (SDSYS_OFF is sized for the whole image).
                                CALL    SD_SETBLK0      ; BLKN = SDPLBA (region 0 system area start)
                                LXI     H,CCP           ; source = the in-RAM system image (0xD000+)
                                LXI     B,CPMIMGLEN     ; full CCP+BDOS+CBIOS image length
                                CALL    SDWRIMG         ; write it to the SD system area
   ffff                         ELSE
                        ; ---- legacy SPI-primary: persist CCP/BDOS to the RAM disk SYSTEM tracks ----
   e640   21 00 00              LXI     H,SYSCPP        ; disk byte 0 (system track 0)
   e643   11 00 d0              LXI     D,CCP           ; source = CCP image
   e646   01 00 08              LXI     B,2048          ; 2048 bytes
   e649   cd 28 eb              CALL    RAMWR
   e64c   21 00 08              LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
   e64f   11 00 d8              LXI     D,BDOSL         ; source = BDOS image
   e652   01 00 0e              LXI     B,3584          ; 3584 bytes
   e655   cd 28 eb              CALL    RAMWR
                                ENDIF
                        ;
                        ; ---- the user DATA area is NOT formatted here --------------------------------
                        ; The formatter (sdtool, or diskutil for the RAM disk) formats the disk
                        ; explicitly.  The cold boot leaves the directory untouched so files written
                        ; to the volume PERSIST across CP/M cold boots.
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   e658   21 89 ec              LXI     H,BANNER
   e65b   cd de e6              CALL    PRTSTR
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   e65e   21 80 00              LXI     H,DMA0
   e661   22 be ec              SHLD    DMA
   e664   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   e667   c3 00 d0              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   e66a                 WBOOT:
   e66a   31 00 ce              LXI     SP,0CE00H
   e66d   3e 01                 MVI     A,01H
   e66f   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM (same as cold boot:
                                                        ;  'G E603' from the monitor after a reset must swap
                                                        ;  the ROM out too, else page-zero/CCP reads hit ROM)
                        ;
   0000                         IF      CFG_SD_BUILD
                        ; ---- reload CCP+BDOS from the SD A: system area ------------------------------
                                ; The SD is the boot store, so a warm start reads the system back from
                                ; the SD (persistent across power cycles) instead of the volatile RAM
                                ; disk.  The system area holds the full image; only CCP+BDOS need to be
                                ; reloaded (the CBIOS is the code currently running and stays in RAM).
                                CALL    SD_INIT
                                CALL    SD_SETBLK0      ; BLKN = SDPLBA (region 0 system area)
                                LXI     H,CCP           ; destination = CCP (SDREADIMG loads into HL)
                                LXI     B,1600H         ; CCP+BDOS = 0x800 + 0xE00 = 0x1600 bytes (11 sectors)
                                CALL    SDREADIMG
   ffff                         ELSE
                        ; ---- legacy SPI-primary: reload CCP and BDOS from the RAM disk SYSTEM tracks -
   e671   21 00 00              LXI     H,SYSCPP
   e674   11 00 d0              LXI     D,CCP
   e677   01 00 08              LXI     B,2048
   e67a   cd 36 eb              CALL    RAMRD
   e67d   21 00 08              LXI     H,SYSBDS
   e680   11 00 d8              LXI     D,BDOSL
   e683   01 00 0e              LXI     B,3584
   e686   cd 36 eb              CALL    RAMRD
                                ENDIF
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   e689   cd 92 e6              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   e68c   01 00 00              LXI     B,0000H
   e68f   c3 00 d0              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xE603), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xD806)
                        ; ============================================================================
   e692                 SETVEC:
   e692   21 00 00              LXI     H,0000H
   e695   36 c3                 MVI     M,0C3H          ; JP
   e697   23                    INX     H
   e698   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xE603 (the WBOOT table entry)
   e69a   23                    INX     H
   e69b   36 e6                 MVI     M,HIGH(BIOS)
   e69d   21 03 00              LXI     H,0003H
   e6a0   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   e6a2   23                    INX     H
   e6a3   36 00                 MVI     M,00H
   e6a5   21 05 00              LXI     H,0005H
   e6a8   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   e6aa   23                    INX     H
   e6ab   36 06                 MVI     M,LOW(BDOSENT)
   e6ad   23                    INX     H
   e6ae   36 d8                 MVI     M,HIGH(BDOSENT)
   e6b0   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   e6b1                 CONST:
   e6b1   db 80                 IN      80H
   e6b3   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6b5   3e 00                 MVI     A,00H           ; default: no char
   e6b7   ca bc e6              JZ      CONST2
   e6ba   3e ff                 MVI     A,0FFH          ; char ready
   e6bc                 CONST2:
   e6bc   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   e6bd                 CONIN:
   e6bd   db 80                 IN      80H
   e6bf   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6c1   ca bd e6              JZ      CONIN           ; wait for a character
   e6c4   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   e6c6   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   e6c7                 CONOUT:
   e6c7   db 80                 IN      80H
   e6c9   e6 01                 ANI     01H             ; tx_busy (bit0)
   e6cb   c2 c7 e6              JNZ     CONOUT          ; wait until transmitter is idle
   e6ce   79                    MOV     A,C
   e6cf   d3 81                 OUT     81H
   e6d1   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   e6d2                 PUTC:
   e6d2   f5                    PUSH    PSW
   e6d3                 PUTC1:
   e6d3   db 80                 IN      80H
   e6d5   e6 01                 ANI     01H
   e6d7   c2 d3 e6              JNZ     PUTC1
   e6da   f1                    POP     PSW
   e6db   d3 81                 OUT     81H
   e6dd   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   e6de                 PRTSTR:
   e6de   7e                    MOV     A,M
   e6df   b7                    ORA     A
   e6e0   ca ea e6              JZ      PRTEND
   e6e3   cd d2 e6              CALL    PUTC
   e6e6   23                    INX     H
   e6e7   c3 de e6              JMP     PRTSTR
   e6ea                 PRTEND:
   e6ea   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   e6eb                 LIST:
   e6eb   c3 c7 e6              JMP     CONOUT          ; char in C
   e6ee                 PUNCH:
   e6ee   c3 c7 e6              JMP     CONOUT          ; char in C
   e6f1                 READER:
   e6f1   c3 bd e6              JMP     CONIN           ; returns char in A
   e6f4                 LISTST:
   e6f4   3e ff                 MVI     A,0FFH          ; list device always "ready"
   e6f6   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ;   The drive-letter -> media map depends on the build configuration (see
                        ;   cpm/cbios_cfg.inc):
                        ;     SD build (CFG_SD_BUILD=1):  A=SD region0, B=SD region1, C=flash, D=RAM.
                        ;     SPI build (CFG_SD_BUILD=0): A=flash,     B=RAM,      C=SD r0, D=SD r1.
   e6f7                 SELDSK:
   e6f7   79                    MOV     A,C
   e6f8   32 ba ec              STA     SELBL           ; remember the selected drive number
   e6fb   b7                    ORA     A
   e6fc   ca 14 e7              JZ      SELD0
   e6ff   fe 01                 CPI     01H
   e701   ca 18 e7              JZ      SELD1
   e704   fe 02                 CPI     02H
   e706   ca 1c e7              JZ      SELD2
   e709   fe 03                 CPI     03H
   e70b   ca 20 e7              JZ      SELD3
   e70e                 SELERR:
   e70e   21 00 00              LXI     H,0000H         ; error return: HL=0
   e711   3e ff                 MVI     A,0FFH
   e713   c9                    RET
   0000                         IF      CFG_SD_BUILD
                        SELD0:
                                LXI     H,DPHSD0        ; drive A disk parameter header (SD region 0)
                                RET
                        SELD1:
                                LXI     H,DPHSD1        ; drive B disk parameter header (SD region 1)
                                RET
                        SELD2:
                                LXI     H,DPHFLASH      ; drive C disk parameter header (SPI flash)
                                RET
                        SELD3:
                                LXI     H,DPHRAM        ; drive D disk parameter header (RAM disk)
                                RET
   ffff                         ELSE
   e714                 SELD0:
   e714   21 c4 ec              LXI     H,DPHFLASH      ; drive A disk parameter header (SPI flash)
   e717   c9                    RET
   e718                 SELD1:
   e718   21 06 ed              LXI     H,DPHRAM        ; drive B disk parameter header (RAM disk)
   e71b   c9                    RET
   e71c                 SELD2:
   e71c   21 ae ed              LXI     H,DPHSD0        ; drive C disk parameter header (SD region 0)
   e71f   c9                    RET
   e720                 SELD3:
   e720   21 4e ee              LXI     H,DPHSD1        ; drive D disk parameter header (SD region 1)
   e723   c9                    RET
                                ENDIF
                        
                        ; HOME: move to track 0, sector 0.
   e724                 HOME:
   e724   af                    XRA     A
   e725   32 bb ec              STA     TRK             ; track low byte
   e728   32 bc ec              STA     TRK+1           ; track high byte -- MUST clear both, or a stale
                                                        ; high byte left by a prior drive-C access would
                                                        ; survive a HOME on a small drive A/B and corrupt
                                                        ; the track address
   e72b   32 bd ec              STA     SECN
   e72e   c9                    RET
                        
                        ; SETTRK: set the current track.  CP/M 2 passes the track as a WORD in BC (DRI
                        ;   manual Table 6-5: "Register BC contains the track number ... 0-65535 for
                        ;   nonstandard disk subsystems"; seasip: "a word under CP/M 2").  Store BOTH
                        ;   bytes -- the high byte is what lets us address >256 tracks (an 8 MB drive at
                        ;   SPT=32 needs tracks up to 2047).
   e72f                 SETTRK:
   e72f   79                    MOV     A,C
   e730   32 bb ec              STA     TRK             ; track low byte
   e733   78                    MOV     A,B
   e734   32 bc ec              STA     TRK+1           ; track high byte
   e737   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   e738                 SETSEC:
   e738   79                    MOV     A,C
   e739   32 bd ec              STA     SECN
   e73c   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   e73d                 SETDMA:
   e73d   79                    MOV     A,C
   e73e   32 be ec              STA     DMA
   e741   78                    MOV     A,B
   e742   32 bf ec              STA     DMA+1
   e745   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   e746                 SECTRAN:
   e746   69                    MOV     L,C
   e747   60                    MOV     H,B
   e748   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   e749                 CALC:
   e749   3a bb ec              LDA     TRK
   e74c   6f                    MOV     L,A
   e74d   26 00                 MVI     H,00H           ; HL = TRK
   e74f   29                    DAD     H               ; *2
   e750   29                    DAD     H               ; *4
   e751   29                    DAD     H               ; *8
   e752   29                    DAD     H               ; *16
   e753   29                    DAD     H               ; *32
   e754   29                    DAD     H               ; *64
   e755   29                    DAD     H               ; *128
   e756   29                    DAD     H               ; *256
   e757   29                    DAD     H               ; *512
   e758   29                    DAD     H               ; *1024
   e759   29                    DAD     H               ; *2048
   e75a   29                    DAD     H               ; *4096  -> HL = TRK*4096
   e75b   44                    MOV     B,H
   e75c   4d                    MOV     C,L             ; BC = TRK*4096
   e75d   3a bd ec              LDA     SECN
   e760   6f                    MOV     L,A
   e761   26 00                 MVI     H,00H           ; HL = SECN
   e763   29                    DAD     H               ; *2
   e764   29                    DAD     H               ; *4
   e765   29                    DAD     H               ; *8
   e766   29                    DAD     H               ; *16
   e767   29                    DAD     H               ; *32
   e768   29                    DAD     H               ; *64
   e769   29                    DAD     H               ; *128  -> HL = SECN*128
   e76a   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   e76b   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   e76c                 RAMPTR:
   e76c   7d                    MOV     A,L
   e76d   d3 21                 OUT     21H             ; address low byte
   e76f   7c                    MOV     A,H
   e770   d3 22                 OUT     22H             ; address high byte
   e772   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE-ACTIVITY LEDS.  Port 40h carries the drive LEDs (write-only; the DIP
                        ;   switches share the port read-only).  On every disk READ/WRITE we light the
                        ;   LED for the selected drive, then write 00h to extinguish before returning.
                        ;   Bit assignment (user spec): MSB / pin37 / D8 = drive A, D7 = drive B,
                        ;   D6 = drive C, D5 = drive D  =>  bit = 7 - SELBL.
                        ; ============================================================================
   e773                 LIGHT:
   e773   3a ba ec              LDA     SELBL           ; A = drive number (0..3)
   e776   4f                    MOV     C,A             ; C = shift count
   e777   06 80                 MVI     B,80H           ; B = MSB mask (drive A)
   e779                 LIGHT_LP:
   e779   79                    MOV     A,C
   e77a   b7                    ORA     A
   e77b   ca 85 e7              JZ      LIGHT_OUT
   e77e   78                    MOV     A,B
   e77f   0f                    RRC
   e780   47                    MOV     B,A
   e781   0d                    DCR     C
   e782   c3 79 e7              JMP     LIGHT_LP
   e785                 LIGHT_OUT:
   e785   78                    MOV     A,B
   e786   d3 40                 OUT     LEDPORT
   e788   c9                    RET
                        
                        ; LEDOFF: write 00h to the LED port (all drives off).  Preserves ALL registers,
                        ;   so the disk status in A survives unchanged to the BDOS caller.
   e789                 LEDOFF:
   e789   f5                    PUSH    PSW
   e78a   3e 00                 MVI     A,00H
   e78c   d3 40                 OUT     LEDPORT
   e78e   f1                    POP     PSW
   e78f   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   e790                 READ:
   e790   cd 73 e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e793   3a ba ec              LDA     SELBL
   0000                         IF      CFG_SD_BUILD
                                ; SD build: SELBL 0/1 -> SD deblock, SELBL 2 -> SPI flash, SELBL 3 -> RAM disk
                                CPI     02H
                                JZ      READ_FLASH
                                CPI     03H
                                JZ      READ_RAM
                                CALL    READC           ; drive A/B SD read (retry); RET here with A = status
                                JMP     LEDOFF
   ffff                         ELSE
                                ; SPI build: SELBL 0 -> SPI flash, SELBL 1 -> RAM disk, SELBL 2/3 -> SD deblock
   e796   b7                    ORA     A
   e797   ca a5 e7              JZ      READ_FLASH
   e79a   fe 01                 CPI     01H
   e79c   ca ab e7              JZ      READ_RAM
   e79f   cd 54 e8              CALL    READC           ; drive C/D SD read (retry); RET here with A = status
   e7a2   c3 89 e7              JMP     LEDOFF
                                ENDIF
   e7a5                 READ_FLASH:
   e7a5   cd 1c ec              CALL    READB           ; SPI flash read; RET here with A = status
   e7a8   c3 89 e7              JMP     LEDOFF
   e7ab                 READ_RAM:
                                ; ---- RAM disk path ----
   e7ab   cd 49 e7              CALL    CALC            ; HL = RAM-disk byte address
   e7ae   cd 6c e7              CALL    RAMPTR          ; set the disk data-pointer
   e7b1   2a be ec              LHLD    DMA
   e7b4   54                    MOV     D,H
   e7b5   5d                    MOV     E,L             ; DE = DMA destination
   e7b6   06 80                 MVI     B,128
   e7b8                 READ1:
   e7b8   db 20                 IN      20H             ; read a byte (data port auto-increments)
   e7ba   12                    STAX    D
   e7bb   13                    INX     D
   e7bc   05                    DCR     B
   e7bd   c2 b8 e7              JNZ     READ1
   e7c0   3e 00                 MVI     A,00H           ; success
   e7c2   c3 89 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
                                                        ;  (LEDOFF preserves A, so the BDOS still sees 00H)
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   e7c5                 WRITE:
   e7c5   cd 73 e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e7c8   3a ba ec              LDA     SELBL
   0000                         IF      CFG_SD_BUILD
                                ; SD build: SELBL 0/1 -> SD deblock, SELBL 2 -> SPI flash, SELBL 3 -> RAM disk
                                CPI     02H
                                JZ      WRITE_FLASH
                                CPI     03H
                                JZ      WRITE_RAM
                                CALL    WRITEC          ; drive A/B SD write (retry); RET here with A = status
                                JMP     LEDOFF
   ffff                         ELSE
                                ; SPI build: SELBL 0 -> SPI flash, SELBL 1 -> RAM disk, SELBL 2/3 -> SD deblock
   e7cb   b7                    ORA     A
   e7cc   ca da e7              JZ      WRITE_FLASH
   e7cf   fe 01                 CPI     01H
   e7d1   ca e0 e7              JZ      WRITE_RAM
   e7d4   cd 68 e8              CALL    WRITEC          ; drive C/D SD write (retry); RET here with A = status
   e7d7   c3 89 e7              JMP     LEDOFF
                                ENDIF
   e7da                 WRITE_FLASH:
   e7da   cd 2d ec              CALL    WRITEB          ; SPI flash write (4KB RMW); RET here with A = status
   e7dd   c3 89 e7              JMP     LEDOFF
   e7e0                 WRITE_RAM:
                                ; ---- RAM disk path ----
   e7e0   cd 49 e7              CALL    CALC            ; HL = RAM-disk byte address
   e7e3   cd 6c e7              CALL    RAMPTR
   e7e6   2a be ec              LHLD    DMA
   e7e9   54                    MOV     D,H
   e7ea   5d                    MOV     E,L             ; DE = DMA source
   e7eb   06 80                 MVI     B,128
   e7ed                 WRITE1:
   e7ed   1a                    LDAX    D
   e7ee   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   e7f0   13                    INX     D
   e7f1   05                    DCR     B
   e7f2   c2 ed e7              JNZ     WRITE1
   e7f5   3e 00                 MVI     A,00H           ; success
   e7f7   c3 89 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
                        
                        ; ============================================================================
                        ;   SD CARD (drive C:) DRIVER + DEBLOCKING
                        ;   The SD is a 2K-block single-DM CP/M drive (DPBC, same geometry family as the
                        ;   flash drive A but OFF=0 because it is a data partition).  The BDOS operates
                        ;   on 128-byte records; the SD only transfers 512-byte sectors, so the CBIOS
                        ;   deblocks: record r -> SD sector (SDPLBA + r/4) at byte offset (r%4)*128.
                        ;   The 512-byte sector buffer ALIASES the RMWBUF region (0xEF00): drive A flash
                        ;   writes and drive C SD accesses never occur at the same time (the BDOS drives
                        ;   one disk at a time), so the two can safely share that 4KB area.
                        ; ============================================================================
                        ; SDMAP: from TRK/SECN compute the SD block number (BLKN, 32-bit, MSB first) and
                        ;   the in-sector byte offset (SDOFF, 16-bit) for the current 128-byte record.
                        ;   record = TRK*SPT + SECN = TRK*32 + SECN.
   e7fa                 SDMAP:
   e7fa   2a bb ec              LHLD    TRK             ; HL = full 16-bit TRK (CP/M 2 passes it as a word
                                                        ; in BC; an 8 MB drive at SPT=32 reaches track 2047)
   e7fd   29                    DAD     H               ; *2
   e7fe   29                    DAD     H               ; *4
   e7ff   29                    DAD     H               ; *8
   e800   29                    DAD     H               ; *16
   e801   29                    DAD     H               ; *32  -> HL = TRK*32
   e802   3a bd ec              LDA     SECN
   e805   5f                    MOV     E,A
   e806   16 00                 MVI     D,00H
   e808   19                    DAD     D               ; HL = record
                                ; SDOFF_hi = (record & 3) >> 1   [0,0,1,1]
   e809   7d                    MOV     A,L
   e80a   e6 03                 ANI     03H
   e80c   47                    MOV     B,A
   e80d   e6 02                 ANI     02H
   e80f   ca 17 e8              JZ      SDMAP_H0
   e812   3e 01                 MVI     A,01H
   e814   c3 19 e8              JMP     SDMAP_H1
   e817                 SDMAP_H0:
   e817   3e 00                 MVI     A,00H
   e819                 SDMAP_H1:
   e819   32 ef ee              STA     SDOFF+1
                                ; SDOFF_lo = ((record & 3) << 7) & 0xFF   [*128]
                                ; NOTE: RAL (rotate through carry), NOT RLC.  RLC is CIRCULAR, so bit 7
                                ; wraps back into bit 0: (record&3)=2 gave 0x01 instead of 0x00 and
                                ; (record&3)=3 gave 0x81 instead of 0x80, i.e. records 2 and 3 of every
                                ; 512-byte sector were deblocked ONE BYTE HIGH.  CP/M still round-tripped
                                ; (READ used the same offset) but the on-card sector was shifted, so the
                                ; directory/data written to the SD was silently corrupt.
   e81c   af                    XRA     A               ; clear CY (and A)
   e81d   78                    MOV     A,B
   e81e   17                    RAL                     ; *2
   e81f   17                    RAL                     ; *4
   e820   17                    RAL                     ; *8
   e821   17                    RAL                     ; *16
   e822   17                    RAL                     ; *32
   e823   17                    RAL                     ; *64
   e824   17                    RAL                     ; *128
   e825   32 ee ee              STA     SDOFF
                                ; SSEC = record >> 2 (16-bit logical right shift)
   e828   af                    XRA     A               ; A=0, CY=0
   e829   7c                    MOV     A,H
   e82a   1f                    RAR
   e82b   67                    MOV     H,A
   e82c   7d                    MOV     A,L
   e82d   1f                    RAR
   e82e   6f                    MOV     L,A
   e82f   af                    XRA     A
   e830   7c                    MOV     A,H
   e831   1f                    RAR
   e832   67                    MOV     H,A
   e833   7d                    MOV     A,L
   e834   1f                    RAR
   e835   6f                    MOV     L,A             ; HL = record >> 2 = SSEC
                                ; ---- per-drive region offset (CP/M has no partitioning) ----
                                ; The BDOS does NOT reliably apply the DPB OFF field here, so the region
                                ; offset (and, in the SD build, the reserved system-area offset) is added
                                ; at the CBIOS deblock layer.
   0000                         IF      CFG_SD_BUILD
                                ; SD build: drive B (SELBL==1) = SD region 1 (+0x4000 sectors = +8 MB);
                                ; drive A (SELBL==0) = region 0 (+0).  Both drives also reserve the
                                ; system area (SDSYS_OFF added below).
                                LDA     SELBL
                                CPI     01H
                                JNZ     SDMAP_REG0
                                LXI     D,4000H
                                DAD     D               ; SSEC += 0x4000 (into SD region 1)
   ffff                         ELSE
                                ; SPI build: drive D (SELBL==3) = SD region 1 (+0x4000 sectors = +8 MB);
                                ; drive C (SELBL==2) = region 0 (+0).  The SD drives are pure data here
                                ; (no reserved system area -- OFF-style data partition).
   e836   3a ba ec              LDA     SELBL
   e839   fe 03                 CPI     03H
   e83b   c2 42 e8              JNZ     SDMAP_REG0
   e83e   11 00 40              LXI     D,4000H
   e841   19                    DAD     D               ; SSEC += 0x4000 (into SD region 1)
                                ENDIF
   e842                 SDMAP_REG0:
   0000                         IF      CFG_SD_BUILD
                                ; SD build: add the reserved system area (each SD volume reserves
                                ; SDSYS_OFF sectors at its region start, so the data/directory begin PAST it)
                                LXI     D,SDSYS_OFF
                                DAD     D
                                ENDIF
                                ; BLKN = SDPLBA + SSEC  (SDPLBA=1)
   e842   23                    INX     H
   e843   3e 00                 MVI     A,00H
   e845   32 f0 ee              STA     BLKN+0
   e848   32 f1 ee              STA     BLKN+1
   e84b   7c                    MOV     A,H
   e84c   32 f2 ee              STA     BLKN+2
   e84f   7d                    MOV     A,L
   e850   32 f3 ee              STA     BLKN+3
   e853   c9                    RET
                        
                        ; ---- drive C: retry wrappers -------------------------------------------------
                        ; An SD transaction can fail TRANSIENTLY: a command issued while the card is
                        ; still internally busy is silently dropped (the MISO read then looks like
                        ; R1=OK or 0FFh), a response can be lost, or the boot-time handshake can fail
                        ; and leave drive C dead for the whole session.  A CP/M BIOS must not turn
                        ; those into a hard "Bad Sector" on the first try: retry the WHOLE operation up
                        ; to SDTRIES times, re-initialising the card between attempts.
   0006                 SDTRIES EQU     06H          ; attempts; each retry also WAITS before re-init
   e854                 READC:
   e854   3e 06                 MVI     A,SDTRIES
   e856   32 fa ee              STA     SDTRY
   e859                 READC1:
   e859   cd 9b e8              CALL    READS
   e85c   b7                    ORA     A
   e85d   ca 7c e8              JZ      SDOP_OK
   e860   cd 7e e8              CALL    SD_RECOVER
   e863   b7                    ORA     A
   e864   ca 59 e8              JZ      READC1
   e867   c9                    RET                     ; out of tries -> A = 0FFh (real failure)
   e868                 WRITEC:
   e868   3e 06                 MVI     A,SDTRIES
   e86a   32 fa ee              STA     SDTRY
   e86d                 WRITEC1:
   e86d   cd c8 e8              CALL    WRITES
   e870   b7                    ORA     A
   e871   ca 7c e8              JZ      SDOP_OK
   e874   cd 7e e8              CALL    SD_RECOVER
   e877   b7                    ORA     A
   e878   ca 6d e8              JZ      WRITEC1
   e87b   c9                    RET
   e87c                 SDOP_OK:
   e87c   af                    XRA     A
   e87d   c9                    RET
                        ; SD_RECOVER: another attempt allowed -> release CS, re-init the card, return
                        ;   A=0.  Out of tries -> release CS and return A=0FFh.  Clobbers A,BC,DE,HL.
   e87e                 SD_RECOVER:
   e87e   3a fa ee              LDA     SDTRY
   e881   3d                    DCR     A
   e882   32 fa ee              STA     SDTRY
   e885   ca 94 e8              JZ      SDRC_NO
   e888   3e 01                 MVI     A,01H
   e88a   d3 54                 OUT     SD_CTL          ; release CS, give the card time to finish its
   e88c   cd 6a ea              CALL    SD_RDLY         ; internal programming (~10 ms), then re-handshake
   e88f   cd 15 ea              CALL    SD_INIT
   e892   af                    XRA     A
   e893   c9                    RET
   e894                 SDRC_NO:
   e894   3e 01                 MVI     A,01H           ; release CS and report the failure
   e896   d3 54                 OUT     SD_CTL
   e898   3e ff                 MVI     A,0FFH
   e89a   c9                    RET
                        
                        ; READS: read one 128-byte CP/M record from the SD into the DMA buffer.
                        ;   Returns A=0 on success, 0FFh on error.
   e89b                 READS:
   e89b   cd fa e7              CALL    SDMAP
   e89e   21 00 ef              LXI     H,RMWBUF        ; deblock sector buffer (aliases the RMWBUF region)
   e8a1   cd ff e8              CALL    SD_READBLK      ; read the 512-byte SD sector into RMWBUF
   e8a4   b7                    ORA     A
   e8a5   c2 c7 e8              JNZ     READS_ERR
                                ; copy RMWBUF+SDOFF (128 bytes) to the DMA buffer
   e8a8   2a be ec              LHLD    DMA
   e8ab   54                    MOV     D,H
   e8ac   5d                    MOV     E,L             ; DE = DMA destination
   e8ad   21 00 ef              LXI     H,RMWBUF
   e8b0   3a ee ee              LDA     SDOFF
   e8b3   85                    ADD     L
   e8b4   6f                    MOV     L,A
   e8b5   3a ef ee              LDA     SDOFF+1
   e8b8   8c                    ADC     H
   e8b9   67                    MOV     H,A             ; HL = RMWBUF + SDOFF
   e8ba   06 80                 MVI     B,128
   e8bc                 READS1:
   e8bc   7e                    MOV     A,M
   e8bd   12                    STAX    D
   e8be   23                    INX     H
   e8bf   13                    INX     D
   e8c0   05                    DCR     B
   e8c1   c2 bc e8              JNZ     READS1
   e8c4   3e 00                 MVI     A,00H           ; success
   e8c6   c9                    RET
   e8c7                 READS_ERR:
   e8c7   c9                    RET                     ; A = 0FFh (disk read error)
                        
                        ; WRITES: write one 128-byte CP/M record from the DMA buffer to the SD
                        ;   (read-modify-write of the containing 512-byte sector).
                        ;   Returns A=0 on success, 0FFh on error.
   e8c8                 WRITES:
   e8c8   cd fa e7              CALL    SDMAP
   e8cb   21 00 ef              LXI     H,RMWBUF
   e8ce   cd ff e8              CALL    SD_READBLK      ; read the sector first (RMW)
   e8d1   b7                    ORA     A
   e8d2   c2 fe e8              JNZ     WRITES_ERR
                                ; overlay the 128-byte DMA record at RMWBUF+SDOFF
   e8d5   2a be ec              LHLD    DMA
   e8d8   54                    MOV     D,H
   e8d9   5d                    MOV     E,L             ; DE = DMA source
   e8da   21 00 ef              LXI     H,RMWBUF
   e8dd   3a ee ee              LDA     SDOFF
   e8e0   85                    ADD     L
   e8e1   6f                    MOV     L,A
   e8e2   3a ef ee              LDA     SDOFF+1
   e8e5   8c                    ADC     H
   e8e6   67                    MOV     H,A             ; HL = RMWBUF + SDOFF (in-buffer destination)
   e8e7   06 80                 MVI     B,128
   e8e9                 WRITES1:
   e8e9   1a                    LDAX    D
   e8ea   77                    MOV     M,A
   e8eb   23                    INX     H
   e8ec   13                    INX     D
   e8ed   05                    DCR     B
   e8ee   c2 e9 e8              JNZ     WRITES1
   e8f1   21 00 ef              LXI     H,RMWBUF
   e8f4   cd 57 e9              CALL    SD_WRITEBLK     ; write the modified 512-byte sector back
   e8f7   b7                    ORA     A
   e8f8   c2 fe e8              JNZ     WRITES_ERR
   e8fb   3e 00                 MVI     A,00H           ; success
   e8fd   c9                    RET
   e8fe                 WRITES_ERR:
   e8fe   c9                    RET                     ; A = 0FFh (disk write error)
                        
                        ; SD_READBLK: read the 512-byte SD block BLKN (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the destination buffer).
   e8ff                 SD_READBLK:
   e8ff   3e 00                 MVI     A,00H
   e901   d3 54                 OUT     SD_CTL          ; select the SD card (CS low), fast
   e903   3e 51                 MVI     A,51H           ; CMD17 (read single block)
   e905   32 f4 ee              STA     SDCMDB
   e908   3a f0 ee              LDA     BLKN+0
   e90b   32 f5 ee              STA     SDCMDB+1
   e90e   3a f1 ee              LDA     BLKN+1
   e911   32 f6 ee              STA     SDCMDB+2
   e914   3a f2 ee              LDA     BLKN+2
   e917   32 f7 ee              STA     SDCMDB+3
   e91a   3a f3 ee              LDA     BLKN+3
   e91d   32 f8 ee              STA     SDCMDB+4
   e920   3e ff                 MVI     A,0FFH
   e922   32 f9 ee              STA     SDCMDB+5
   e925   e5                    PUSH    H
   e926   21 f4 ee              LXI     H,SDCMDB
   e929   cd e7 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e92c   e1                    POP     H               ; restore the destination buffer
   e92d   fe 00                 CPI     00H
   e92f   c2 50 e9              JNZ     SDRB_ERR
   e932   cd 04 ea              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   e935   da 50 e9              JC      SDRB_ERR
   e938   01 00 02              LXI     B,512
   e93b                 SDRB1:
   e93b   db 53                 IN      SD_DATA
   e93d   77                    MOV     M,A
   e93e   23                    INX     H
   e93f   0b                    DCX     B
   e940   78                    MOV     A,B
   e941   b1                    ORA     C
   e942   c2 3b e9              JNZ     SDRB1
   e945   db 53                 IN      SD_DATA         ; 2 CRC bytes
   e947   db 53                 IN      SD_DATA
   e949   3e 01                 MVI     A,01H
   e94b   d3 54                 OUT     SD_CTL          ; release CS
   e94d   3e 00                 MVI     A,00H
   e94f   c9                    RET
   e950                 SDRB_ERR:
   e950   3e 01                 MVI     A,01H
   e952   d3 54                 OUT     SD_CTL          ; release CS
   e954   3e ff                 MVI     A,0FFH
   e956   c9                    RET
                        
                        ; SD_WRITEBLK: write the 512 bytes at (HL) to the SD block BLKN.
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the source buffer).
   e957                 SD_WRITEBLK:
   e957   3e 00                 MVI     A,00H
   e959   d3 54                 OUT     SD_CTL          ; select the SD card, fast
   e95b   3e 58                 MVI     A,58H           ; CMD24 (write single block)
   e95d   32 f4 ee              STA     SDCMDB
   e960   3a f0 ee              LDA     BLKN+0
   e963   32 f5 ee              STA     SDCMDB+1
   e966   3a f1 ee              LDA     BLKN+1
   e969   32 f6 ee              STA     SDCMDB+2
   e96c   3a f2 ee              LDA     BLKN+2
   e96f   32 f7 ee              STA     SDCMDB+3
   e972   3a f3 ee              LDA     BLKN+3
   e975   32 f8 ee              STA     SDCMDB+4
   e978   3e ff                 MVI     A,0FFH
   e97a   32 f9 ee              STA     SDCMDB+5
   e97d   e5                    PUSH    H
   e97e   21 f4 ee              LXI     H,SDCMDB
   e981   cd e7 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e984   e1                    POP     H               ; restore the source buffer
   e985   fe 00                 CPI     00H
   e987   c2 c3 e9              JNZ     SDWB_ERR
   e98a   3e fe                 MVI     A,0FEH          ; data start token
   e98c   d3 53                 OUT     SD_DATA
   e98e   01 00 02              LXI     B,512
   e991                 SDWB1:
   e991   7e                    MOV     A,M
   e992   d3 53                 OUT     SD_DATA
   e994   23                    INX     H
   e995   0b                    DCX     B
   e996   78                    MOV     A,B
   e997   b1                    ORA     C
   e998   c2 91 e9              JNZ     SDWB1
   e99b   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC disabled)
   e99d   d3 53                 OUT     SD_DATA
   e99f   d3 53                 OUT     SD_DATA
                                ; read the data-response token: the card clocks 0xFF for a few bytes
                                ; first, then 0bxxx00101 (0x05) = data accepted.
   e9a1   06 10                 MVI     B,16
   e9a3                 SDWB_RSP:
   e9a3   db 53                 IN      SD_DATA
   e9a5   fe ff                 CPI     0FFH
   e9a7   c2 ae e9              JNZ     SDWB_GOT
   e9aa   05                    DCR     B
   e9ab   c2 a3 e9              JNZ     SDWB_RSP
   e9ae                 SDWB_GOT:
   e9ae   e6 1f                 ANI     1FH             ; response bits 0-4; 0x05 = accepted
   e9b0   fe 05                 CPI     05H
   e9b2   c2 c3 e9              JNZ     SDWB_ERR        ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS so the
                                ; very next command is not issued into a busy card
   e9b5   cd ca e9              CALL    SD_READY
   e9b8   b7                    ORA     A
   e9b9   c2 c3 e9              JNZ     SDWB_ERR
   e9bc                 SDWB_DONE:
   e9bc   3e 01                 MVI     A,01H
   e9be   d3 54                 OUT     SD_CTL          ; release CS
   e9c0   3e 00                 MVI     A,00H
   e9c2   c9                    RET
   e9c3                 SDWB_ERR:
   e9c3   3e 01                 MVI     A,01H
   e9c5   d3 54                 OUT     SD_CTL          ; release CS
   e9c7   3e ff                 MVI     A,0FFH
   e9c9   c9                    RET
                        
                        ; SD_READY: wait until the card is NOT busy (MISO high, reads 0xFF) before a
                        ;   command is issued.  A card that is still programming a block drives MISO
                        ;   LOW, so bytes read as 0x00 -- and SD_SEND6's R1 read would accept that 0x00
                        ;   as "R1 = OK" and drop the command on the floor, leaving the card's data
                        ;   stream desynced.  That is what turned every write after the first into
                        ;   "Bad Sector".  Timeout ~260k port reads (~0.4 s at 25 MHz), which covers the
                        ;   SD spec's 250 ms worst-case block-programming time.
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   e9ca                 SD_READY:
   e9ca   d5                    PUSH    D
   e9cb   16 04                 MVI     D,04H           ; 4 x 65536 port reads
   e9cd                 SDRDY0:
   e9cd   01 00 00              LXI     B,0000H
   e9d0                 SDRDY1:
   e9d0   db 53                 IN      SD_DATA         ; 0xFF = idle, 0x00 = still programming
   e9d2   fe ff                 CPI     0FFH
   e9d4   ca e4 e9              JZ      SDRDY_OK
   e9d7   0b                    DCX     B
   e9d8   78                    MOV     A,B
   e9d9   b1                    ORA     C
   e9da   c2 d0 e9              JNZ     SDRDY1
   e9dd   15                    DCR     D
   e9de   c2 cd e9              JNZ     SDRDY0
   e9e1   d1                    POP     D
   e9e2   37                    STC
   e9e3   c9                    RET
   e9e4                 SDRDY_OK:
   e9e4   d1                    POP     D
   e9e5   af                    XRA     A               ; A=0, clear CY
   e9e6   c9                    RET
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Returns A = R1 (0FFh if no valid response after 16 bytes of clocking).
   e9e7                 SD_SEND6:
   e9e7   e5                    PUSH    H
   e9e8   cd ca e9              CALL    SD_READY        ; never issue a command into a busy card
   e9eb   e1                    POP     H
   e9ec   06 06                 MVI     B,6
   e9ee                 SD6_TX:
   e9ee   7e                    MOV     A,M
   e9ef   d3 53                 OUT     SD_DATA
   e9f1   23                    INX     H
   e9f2   05                    DCR     B
   e9f3   c2 ee e9              JNZ     SD6_TX
   e9f6   06 10                 MVI     B,16
   e9f8                 SD6_RX:
   e9f8   db 53                 IN      SD_DATA
   e9fa   fe ff                 CPI     0FFH
   e9fc   c2 03 ea              JNZ     SD6_DONE
   e9ff   05                    DCR     B
   ea00   c2 f8 e9              JNZ     SD6_RX
   ea03                 SD6_DONE:
   ea03   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success, CY=1 if 255 bytes pass with no token.
   ea04                 SD_WAITTKN:
   ea04   06 ff                 MVI     B,0FFH
   ea06                 SD_WT:
   ea06   db 53                 IN      SD_DATA
   ea08   fe fe                 CPI     0FEH
   ea0a   ca 13 ea              JZ      SD_WT_OK
   ea0d   05                    DCR     B
   ea0e   c2 06 ea              JNZ     SD_WT
   ea11   37                    STC
   ea12   c9                    RET
   ea13                 SD_WT_OK:
   ea13   b7                    ORA     A               ; clear CY
   ea14   c9                    RET
                        
                        ; SD_INIT: full SPI-mode initialization of the SD card.  Called from BOOT so a
                        ;   logged-in drive C is ready.  A = 0 on success (card entering SPI mode and
                        ;   initializing), 0FFh if no card / init failed (drive C reads will then error).
                        ;   This is the same handshake as sdprobe/sdtool (CMD0 -> CMD8 -> CMD55/ACMD41).
   ea15                 SD_INIT:
   ea15   3e 03                 MVI     A,03H           ; CS high + slow clock
   ea17   d3 54                 OUT     SD_CTL
   ea19   06 0a                 MVI     B,10            ; 10 x 0xFF = 80 power-up clocks
   ea1b                 SDI_CK:
   ea1b   3e ff                 MVI     A,0FFH
   ea1d   d3 53                 OUT     SD_DATA
   ea1f   05                    DCR     B
   ea20   c2 1b ea              JNZ     SDI_CK
   ea23   3e 02                 MVI     A,02H           ; select the card (CS low), slow clock
   ea25   d3 54                 OUT     SD_CTL
                                ; CMD0 + read R1
   ea27   21 74 ea              LXI     H,SDCMD0
   ea2a   cd e7 e9              CALL    SD_SEND6        ; A = R1 (01h = idle, or 0FFh if no response)
   ea2d   fe 01                 CPI     01H
   ea2f   c2 5a ea              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) - required before ACMD41 on SDHC/SDXC
   ea32   21 7a ea              LXI     H,SDCMD8
   ea35   cd e7 e9              CALL    SD_SEND6
   ea38   db 53                 IN      SD_DATA         ; consume the 4-byte R7 payload
   ea3a   db 53                 IN      SD_DATA
   ea3c   db 53                 IN      SD_DATA
   ea3e   db 53                 IN      SD_DATA
                                ; CMD55 + ACMD41 poll until the card leaves idle
   ea40   16 c8                 MVI     D,200
   ea42                 SDI_RDY:
   ea42   21 80 ea              LXI     H,SDCMD55
   ea45   cd e7 e9              CALL    SD_SEND6
   ea48   21 86 ea              LXI     H,SDACMD
   ea4b   cd e7 e9              CALL    SD_SEND6        ; A = R1
   ea4e   fe 00                 CPI     00H
   ea50   ca 5d ea              JZ      SDI_OK
   ea53   cd 60 ea              CALL    SD_DELAY        ; ~3ms between attempts (card init is time-based)
   ea56   15                    DCR     D
   ea57   c2 42 ea              JNZ     SDI_RDY
   ea5a                 SDI_FAIL:
   ea5a   3e ff                 MVI     A,0FFH
   ea5c   c9                    RET
   ea5d                 SDI_OK:
   ea5d   3e 00                 MVI     A,00H
   ea5f   c9                    RET
                        
                        ; SD_DELAY: approximate ~3ms busy-wait (HL only; for SD init polling).
   ea60                 SD_DELAY:
   ea60   21 d0 07              LXI     H,2000
   ea63                 SDDL:
   ea63   2b                    DCX     H
   ea64   7c                    MOV     A,H
   ea65   b5                    ORA     L
   ea66   c2 63 ea              JNZ     SDDL
   ea69   c9                    RET
                        
                        ; SD_RDLY: ~10 ms recovery delay (65536 iterations).  Used BETWEEN drive-C retry
                        ;   attempts so a card that is still programming a block has time to finish --
                        ;   SD_DELAY (~1.6 ms) is far too short for that.
   ea6a                 SD_RDLY:
   ea6a   01 00 00              LXI     B,0000H
   ea6d                 SRDL1:
   ea6d   0b                    DCX     B
   ea6e   78                    MOV     A,B
   ea6f   b1                    ORA     C
   ea70   c2 6d ea              JNZ     SRDL1
   ea73   c9                    RET
                        
   ea74   40 00 00 00   SDCMD0: DB      40H,00H,00H,00H,00H,95H
   ea78   00 95         
   ea7a   48 00 00 01   SDCMD8: DB      48H,00H,00H,01H,0AAH,87H
   ea7e   aa 87         
   ea80   77 00 00 00   SDCMD55: DB     77H,00H,00H,00H,00H,65H
   ea84   00 65         
   ea86   69 40 00 00   SDACMD: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   ea8a   00 77         
                        
                        ; ============================================================================
                        ;   SD SYSTEM-AREA IMAGE I/O  (used by BOOT/WBOOT to persist/reload the system)
                        ;   Each reserved SD volume begins with a system area (SDSYS_OFF sectors) that
                        ;   holds the CP/M boot image (CCP+BDOS+CBIOS, CPMIMGLEN bytes).  These routines
                        ;   move the image between the SD (region 0 system area, BLKN = SDPLBA) and
                        ;   machine RAM, whole 512-byte sectors at a time (CPMIMGLEN is a multiple of
                        ;   512).  They are called by BOOT (persist) and WBOOT (reload).
                        ; ============================================================================
                        ; SD_SETBLK0: set BLKN (32-bit, MSB first) to the SDPLBA region-0 system-area base.
   ea8c                 SD_SETBLK0:
   ea8c   af                    XRA     A
   ea8d   32 f0 ee              STA     BLKN+0
   ea90   32 f1 ee              STA     BLKN+1
   ea93   32 f2 ee              STA     BLKN+2
   ea96   3e 01                 MVI     A,SDPLBA        ; SDPLBA = 1 (fits in the low byte)
   ea98   32 f3 ee              STA     BLKN+3
   ea9b   c9                    RET
                        
                        ; SD_INCBLK: increment the 32-bit BLKN (MSB first) by one SD sector.
   ea9c                 SD_INCBLK:
   ea9c   3a f3 ee              LDA     BLKN+3
   ea9f   3c                    INR     A
   eaa0   32 f3 ee              STA     BLKN+3
   eaa3   c2 c1 ea              JNZ     SDINC_DONE
   eaa6   3a f2 ee              LDA     BLKN+2
   eaa9   3c                    INR     A
   eaaa   32 f2 ee              STA     BLKN+2
   eaad   c2 c1 ea              JNZ     SDINC_DONE
   eab0   3a f1 ee              LDA     BLKN+1
   eab3   3c                    INR     A
   eab4   32 f1 ee              STA     BLKN+1
   eab7   c2 c1 ea              JNZ     SDINC_DONE
   eaba   3a f0 ee              LDA     BLKN+0
   eabd   3c                    INR     A
   eabe   32 f0 ee              STA     BLKN+0
   eac1                 SDINC_DONE:
   eac1   c9                    RET
                        
                        ; SDWRIMG: write BC bytes from (HL) to the SD at the current BLKN (advancing).
                        ;   BC must be a non-zero multiple of 512 (the sector buffer size).  Returns
                        ;   A=0 if all sectors written, 0FFh if any failed.  Clobbers A,B,C,D,E,H,L.
   eac2                 SDWRIMG:
   eac2   7d                    MOV     A,L
   eac3   32 c1 ec              STA     SDIMGSRC
   eac6   7c                    MOV     A,H
   eac7   32 c2 ec              STA     SDIMGSRC+1      ; SDIMGSRC = HL (little-endian word)
   eaca   78                    MOV     A,B
   eacb   0f                    RRC                     ; sector count = BC/512 (BC is a multiple of 512, C=0)
   eacc   32 c3 ec              STA     SDIMGC
   eacf                 SDWR_LP:
   eacf   2a c1 ec              LHLD    SDIMGSRC
   ead2   cd 57 e9              CALL    SD_WRITEBLK     ; write 512 bytes from (HL) to BLKN
   ead5   b7                    ORA     A
   ead6   c2 f2 ea              JNZ     SDWR_ERR
   ead9   2a c1 ec              LHLD    SDIMGSRC
   eadc   11 00 02              LXI     D,512
   eadf   19                    DAD     D
   eae0   22 c1 ec              SHLD    SDIMGSRC
   eae3   cd 9c ea              CALL    SD_INCBLK
   eae6   3a c3 ec              LDA     SDIMGC
   eae9   3d                    DCR     A
   eaea   32 c3 ec              STA     SDIMGC
   eaed   c2 cf ea              JNZ     SDWR_LP
   eaf0   af                    XRA     A
   eaf1   c9                    RET
   eaf2                 SDWR_ERR:
   eaf2   3e ff                 MVI     A,0FFH
   eaf4   c9                    RET
                        
                        ; SDREADIMG: read BC bytes from the SD at the current BLKN (advancing) into (HL).
                        ;   BC must be a non-zero multiple of 512.  Returns A=0 ok / 0FFh err.
   eaf5                 SDREADIMG:
   eaf5   7d                    MOV     A,L
   eaf6   32 c1 ec              STA     SDIMGSRC
   eaf9   7c                    MOV     A,H
   eafa   32 c2 ec              STA     SDIMGSRC+1      ; SDIMGSRC = HL (little-endian word)
   eafd   78                    MOV     A,B
   eafe   0f                    RRC                     ; sector count = BC/512
   eaff   32 c3 ec              STA     SDIMGC
   eb02                 SDRD_LP:
   eb02   2a c1 ec              LHLD    SDIMGSRC
   eb05   cd ff e8              CALL    SD_READBLK      ; read 512 bytes from BLKN into (HL)
   eb08   b7                    ORA     A
   eb09   c2 25 eb              JNZ     SDRD_ERR
   eb0c   2a c1 ec              LHLD    SDIMGSRC
   eb0f   11 00 02              LXI     D,512
   eb12   19                    DAD     D
   eb13   22 c1 ec              SHLD    SDIMGSRC
   eb16   cd 9c ea              CALL    SD_INCBLK
   eb19   3a c3 ec              LDA     SDIMGC
   eb1c   3d                    DCR     A
   eb1d   32 c3 ec              STA     SDIMGC
   eb20   c2 02 eb              JNZ     SDRD_LP
   eb23   af                    XRA     A
   eb24   c9                    RET
   eb25                 SDRD_ERR:
   eb25   3e ff                 MVI     A,0FFH
   eb27   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   eb28                 RAMWR:
   eb28   cd 6c e7              CALL    RAMPTR
   eb2b                 RAMWR1:
   eb2b   1a                    LDAX    D
   eb2c   d3 20                 OUT     20H
   eb2e   13                    INX     D
   eb2f   0b                    DCX     B
   eb30   78                    MOV     A,B
   eb31   b1                    ORA     C
   eb32   c2 2b eb              JNZ     RAMWR1
   eb35   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   eb36                 RAMRD:
   eb36   cd 6c e7              CALL    RAMPTR
   eb39                 RAMRD1:
   eb39   db 20                 IN      20H
   eb3b   12                    STAX    D
   eb3c   13                    INX     D
   eb3d   0b                    DCX     B
   eb3e   78                    MOV     A,B
   eb3f   b1                    ORA     C
   eb40   c2 39 eb              JNZ     RAMRD1
   eb43   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   eb44                 RAMFILL:
   eb44   32 c0 ec              STA     FILLV
   eb47   cd 6c e7              CALL    RAMPTR
   eb4a                 RAMFILL1:
   eb4a   3a c0 ec              LDA     FILLV
   eb4d   d3 20                 OUT     20H
   eb4f   0b                    DCX     B
   eb50   78                    MOV     A,B
   eb51   b1                    ORA     C
   eb52   c2 4a eb              JNZ     RAMFILL1
   eb55   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE A:  SPI FLASH  (ISSI IS25LD040 as CP/M drive A:)
                        ;
                        ;   Flash layout (MUST match diskutil's 'S' formatter and the drive A: DPB):
                        ;       0x00000-0x01FFF  (8KB, tracks 0-1)   reserved system (erased 0xFF)
                        ;       0x02000-0x7FFFF  (504KB, tracks 2-127) user data area = 252 blocks
                        ;           Block 0  (0x2000-0x27FF) + Block 1 (0x2800-0x2FFF) directory
                        ;                     (2KB each, reserved via AL0=0xC0) = 128 x 32-byte entries
                        ;           Blocks 2..251 (0x3000-0x7FFFF) file data (250 blocks = 500KB)
                        ;
                        ;   Address formula (same as the drive B: RAM-disk CALC, but 24-bit -- the flash is
                        ;   512KB and exceeds 16 bits):  flash_addr = TRK*0x1000 + SECN*0x80
                        ;   (SPT=32, record=128).  The BDOS passes the absolute track (it already added
                        ;   the DPB offset), so OFF is NOT re-added here.
                        ;
                        ;   Erase-before-write is mandatory and the flash only erases at 4KB granularity
                        ;   (sector = 0x20 opcode).  With 2KB CP/M blocks a CP/M block is HALF an erase
                        ;   sector, so two CP/M blocks share one physical 4KB sector.  Writes are still
                        ;   correct: a WRITE does a 4KB read-modify-write (read the whole 4KB sector
                        ;   into RMWBUF, overlay the 128-byte record at its offset, erase the sector,
                        ;   then page-program it back 16 x 256B), which reads back and thus PRESERVES
                        ;   the other CP/M block that shares the sector.  Correctness first; a
                        ;   dirty-sector cache is a later optimization.
                        ; ============================================================================
                        
                        ; ---- shared SPI driver (physical primitives + 24-bit ops) ----
                                INCL    "spi.inc"
                        ; ============================================================================
                        ; spi.inc -- shared 24-bit-capable SPI flash driver for the ISSI IS25LD040.
                        ; Included by BOTH diskutil (ORG 1000H) and cbios (ORG FA00H) so the physical
                        ; SPI protocol cannot drift between the two consumers.  Includes only
                        ; protocol-level primitives (selection, byte transfer, WIP wait, 24-bit
                        ; address send) and the bulk operations drive B: needs (page program, bulk
                        ; read, 4K sector erase).  Higher-level logic (CP/M read-modify-write, the
                        ; format routine) lives in each including program.
                        ;
                        ; Ports (must be defined by the including program BEFORE the INCL):
                        ;   SPI_DATA = 50H   read clocks 1 byte in / write clocks 1 byte out (MSB first)
                        ;   SPI_CTL  = 51H   write bit0 = CS# (0 = select low, 1 = release high)
                        ;   SPI_STAT = 52H   read bit0 = transfer busy (poll OPTIONAL -- the RTL byte
                        ;                               engine stretches the CPU wait on every 0x50
                        ;                               access, so back-to-back 0x50 completes in-cycle)
                        ;
                        ; Convention: the 24-bit flash address for an operation is held in the FBADDR
                        ; 3-byte block declared below.  Byte order is little-endian by FIELD:
                        ;   FBADDR+0 = A7-A0  (low byte)
                        ;   FBADDR+1 = A15-A8 (mid byte)
                        ;   FBADDR+2 = A23-A16(high byte)
                        ; SPI_ADDR transmits them MSB-first (A23-A16, A15-A8, A7-A0), which is the
                        ; order the IS25LD040 command set requires.
                        ;
                        ; Each routine documents which registers it clobbers.  A85 note: this file is
                        ; assembled inline at the INCL point, so FBADDR is allocated at that location
                        ; in each including program's address space (fine -- it is referenced purely
                        ; symbolically).  Do NOT add an ORG or END to this file; a85 splices it.
                        ; ============================================================================
                        
                        ; ---------------- CS# and byte transfer primitives ----------------
                        ; SPI_SEL: pull CS# low (select the flash).  Clobbers A.
   eb56   3e 00         SPI_SEL: MVI     A,00H
   eb58   d3 51                  OUT     SPI_CTL
   eb5a   c9                     RET
                        
                        ; SPI_REL: release CS# high (deselect the flash).  Clobbers A.
   eb5b   3e 01         SPI_REL: MVI     A,01H
   eb5d   d3 51                  OUT     SPI_CTL
   eb5f   c9                     RET
                        
                        ; SPI_XMIT: clock the byte in A out to the flash; the byte returned is
                        ; discarded.  A is unchanged (OUT does not modify A).  No other regs touched.
   eb60   d3 50         SPI_XMIT: OUT     SPI_DATA
   eb62   c9                     RET
                        
                        ; SPI_WAIT: poll the RDSR (0x05) status until WIP (bit0) clears.  Re-selects
                        ; the flash and keeps CS# low across the status reads.  Clobbers A.
   eb63   cd 56 eb      SPI_WAIT: CALL    SPI_SEL
   eb66   3e 05                  MVI     A,05H
   eb68   cd 60 eb               CALL    SPI_XMIT                ; RDSR opcode
   eb6b   db 50         SPW:     IN      SPI_DATA                ; read status byte
   eb6d   e6 01                  ANI     01H                     ; WIP (bit0) still busy?
   eb6f   c2 6b eb               JNZ     SPW                     ; loop until the flash is idle
   eb72   cd 5b eb               CALL    SPI_REL
   eb75   c9                     RET
                        
                        ; ---------------- 24-bit address send ----------------
                        ; SPI_ADDR: send the three FBADDR bytes as the command address (A23-A16,
                        ; A15-A8, A7-A0, MSB first).  Must be called with CS# already selected.
                        ; Clobbers A.
   eb76   3a e9 eb      SPI_ADDR: LDA     FBADDR+2
   eb79   cd 60 eb               CALL    SPI_XMIT                ; A23-A16
   eb7c   3a e8 eb               LDA     FBADDR+1
   eb7f   cd 60 eb               CALL    SPI_XMIT                ; A15-A8
   eb82   3a e7 eb               LDA     FBADDR
   eb85   cd 60 eb               CALL    SPI_XMIT                ; A7-A0
   eb88   c9                     RET
                        
                        ; ---------------- page program (0x02) ----------------
                        ; SPI_PAGE: program a full 256-byte page from (HL) at the page-aligned FBADDR.
                        ; FBADDR must be 256-byte aligned (the flash's page program wraps within a
                        ; page if it crosses the boundary).  Issues WREN (0x06, CS# toggled to latch it
                        ; -- REQUIRED before every program/erase on the IS25LD040), then the page-
                        ; program command and 256 data bytes in one CS#-low sequence.  Clobbers A, B,
                        ; HL (HL is advanced 256 bytes / left at HL+256).
   eb89   cd 56 eb      SPI_PAGE: CALL    SPI_SEL
   eb8c   3e 06                  MVI     A,06H                   ; WREN (mandatory before every program)
   eb8e   cd 60 eb               CALL    SPI_XMIT
   eb91   cd 5b eb               CALL    SPI_REL                 ; latch WREN (CS# must toggle)
   eb94   cd 56 eb               CALL    SPI_SEL
   eb97   3e 02                  MVI     A,02H                   ; Page Program opcode
   eb99   cd 60 eb               CALL    SPI_XMIT
   eb9c   cd 76 eb               CALL    SPI_ADDR
   eb9f   06 00                  MVI     B,00H                   ; 256 bytes (0 wraps to 256 on DCR)
   eba1   7e            SPG1:    MOV     A,M
   eba2   cd 60 eb               CALL    SPI_XMIT
   eba5   23                     INX     H
   eba6   05                     DCR     B
   eba7   c2 a1 eb               JNZ     SPG1
   ebaa   cd 5b eb               CALL    SPI_REL
   ebad   cd 63 eb               CALL    SPI_WAIT                ; wait for the program to settle
   ebb0   c9                     RET
                        
                        ; ---------------- bulk read (0x03) ----------------
                        ; SPI_READBUF: read BC bytes from FBADDR into (DE), keeping CS# low across the
                        ; whole burst (this is the same pattern the proven diskutil DO_READ uses for
                        ; 16 bytes, extended to an arbitrary count).  Clobbers A, B, C, D, E (BC runs
                        ; down to 0, DE advances past the last byte read).
   ebb1   cd 56 eb      SPI_READBUF: CALL    SPI_SEL
   ebb4   3e 03                  MVI     A,03H                   ; Read opcode
   ebb6   cd 60 eb               CALL    SPI_XMIT
   ebb9   cd 76 eb               CALL    SPI_ADDR
   ebbc   db 50         SRDB:    IN      SPI_DATA                ; next byte the flash clocks out
   ebbe   12                     STAX    D
   ebbf   13                     INX     D
   ebc0   0b                     DCX     B
   ebc1   78                     MOV     A,B
   ebc2   b1                     ORA     C
   ebc3   c2 bc eb               JNZ     SRDB
   ebc6   cd 5b eb               CALL    SPI_REL
   ebc9   c9                     RET
                        
                        ; ---------------- 4KB sector erase (0x20) ----------------
                        ; SPI_ERASE_SECT: erase the 4KB sector containing FBADDR.  FBADDR must be
                        ; pre-set to the sector base (the low 12 bits clear) so only that one sector
                        ; is erased.  Issues WREN, then the sector-erase command.  Clobbers A.
   ebca   cd 56 eb      SPI_ERASE_SECT: CALL    SPI_SEL
   ebcd   3e 06                  MVI     A,06H                   ; WREN (required before every program)
   ebcf   cd 60 eb               CALL    SPI_XMIT
   ebd2   cd 5b eb               CALL    SPI_REL                 ; latch WREN
   ebd5   cd 56 eb               CALL    SPI_SEL
   ebd8   3e 20                  MVI     A,20H                   ; Sector Erase (4KB) opcode
   ebda   cd 60 eb               CALL    SPI_XMIT
   ebdd   cd 76 eb               CALL    SPI_ADDR
   ebe0   cd 5b eb               CALL    SPI_REL
   ebe3   cd 63 eb               CALL    SPI_WAIT                ; wait for the erase to finish
   ebe6   c9                     RET
                        
                        ; ---------------- FBADDR: the 24-bit address block ----------------
   ebe7                 FBADDR:  DS      3                       ; A7-A0, A15-A8, A23-A16
                        
                        
                        ; FLADDR: compute FBADDR = TRK*0x1000 + SECN*0x80, the 24-bit flash byte address
                        ; of the selected record, split (validated against 0x7FF80 for TRK=127,SEC=31):
                        ;     byte2 (A23-A16) = TRK >> 4
                        ;     byte1 (A15-A8)  = ((TRK & 0x0F) << 4) | (SECN >> 1)
                        ;     byte0 (A7-A0)   = (SECN & 1) << 7
                        ; (SECN*0x80 < 0x1000 so it never carries into the TRK*0x1000 field.)  Clobbers
                        ; A, B, C, D.
   ebea                 FLADDR:
   ebea   3a bb ec              LDA     TRK
   ebed   47                    MOV     B,A             ; B = TRK
   ebee   3a bd ec              LDA     SECN
   ebf1   4f                    MOV     C,A             ; C = SECN
                                ; byte2 (A23-A16) = TRK >> 4
   ebf2   78                    MOV     A,B
   ebf3   e6 f0                 ANI     0F0H
   ebf5   0f                    RRC
   ebf6   0f                    RRC
   ebf7   0f                    RRC
   ebf8   0f                    RRC
   ebf9   32 e9 eb              STA     FBADDR+2
                                ; byte1 (A15-A8) = ((TRK & 0x0F) << 4) | (SECN >> 1)
   ebfc   78                    MOV     A,B
   ebfd   e6 0f                 ANI     0FH
   ebff   07                    RLC
   ec00   07                    RLC
   ec01   07                    RLC
   ec02   07                    RLC
   ec03   57                    MOV     D,A
   ec04   79                    MOV     A,C
   ec05   0f                    RRC
   ec06   e6 7f                 ANI     7FH
   ec08   b2                    ORA     D
   ec09   32 e8 eb              STA     FBADDR+1
                                ; byte0 (A7-A0) = (SECN & 1) << 7
   ec0c   79                    MOV     A,C
   ec0d   e6 01                 ANI     01H
   ec0f   ca 17 ec              JZ      FLAD0
   ec12   3e 80                 MVI     A,80H
   ec14   c3 18 ec              JMP     FLADR
   ec17   af            FLAD0:  XRA     A
   ec18   32 e7 eb      FLADR:  STA     FBADDR
   ec1b   c9                    RET
                        
                        ; READB: read one 128-byte sector from the SPI flash (drive A:) into the DMA
                        ; buffer.  Returns A=0.  (A flash read is error-free.)
   ec1c                 READB:
   ec1c   cd ea eb              CALL    FLADDR          ; FBADDR = 24-bit record address
   ec1f   2a be ec              LHLD    DMA
   ec22   54                    MOV     D,H
   ec23   5d                    MOV     E,L             ; DE = DMA destination
   ec24   01 80 00              LXI     B,80H           ; 128 bytes
   ec27   cd b1 eb              CALL    SPI_READBUF
   ec2a   3e 00                 MVI     A,00H           ; success
   ec2c   c9                    RET
                        
                        ; WRITEB: write one 128-byte sector to the SPI flash (drive A:) via a 4KB
                        ; read-modify-write.  Returns A=0.  Clobbers A,B,D,E,H,L.
   ec2d                 WRITEB:
   ec2d   cd ea eb              CALL    FLADDR          ; FBADDR = 24-bit record address
                                ; ---- save the record's in-sector offset (FBADDR & 0xFFF) ----
   ec30   3a e7 eb              LDA     FBADDR
   ec33   32 04 ed              STA     RECOFF          ; offset low byte
   ec36   3a e8 eb              LDA     FBADDR+1
   ec39   e6 0f                 ANI     0FH
   ec3b   32 05 ed              STA     RECOFF+1        ; offset high nibble (0..0x0F)
                                ; ---- set FBADDR to the enclosing 4KB sector base (clear low 12 bits) ----
   ec3e   3a e8 eb              LDA     FBADDR+1
   ec41   e6 f0                 ANI     0F0H
   ec43   32 e8 eb              STA     FBADDR+1
   ec46   af                    XRA     A
   ec47   32 e7 eb              STA     FBADDR          ; low byte of the sector base = 0
                                ; ---- read the whole 4KB sector into the RMW buffer ----
   ec4a   11 00 ef              LXI     D,RMWBUF
   ec4d   01 00 10              LXI     B,1000H         ; 4096 bytes
   ec50   cd b1 eb              CALL    SPI_READBUF
                                ; ---- overlay the 128-byte DMA record at the in-sector offset ----
   ec53   2a be ec              LHLD    DMA
   ec56   11 00 ef              LXI     D,RMWBUF
   ec59   3a 04 ed              LDA     RECOFF
   ec5c   83                    ADD     E
   ec5d   5f                    MOV     E,A
   ec5e   3a 05 ed              LDA     RECOFF+1
   ec61   8a                    ADC     D
   ec62   57                    MOV     D,A             ; DE = RMWBUF + offset
   ec63   06 80                 MVI     B,128
   ec65   7e            WRCPY:  MOV     A,M
   ec66   12                    STAX    D
   ec67   23                    INX     H
   ec68   13                    INX     D
   ec69   05                    DCR     B
   ec6a   c2 65 ec              JNZ     WRCPY
                                ; ---- erase the 4KB sector (FBADDR = sector base) ----
   ec6d   cd ca eb              CALL    SPI_ERASE_SECT
                                ; ---- program the whole 4KB sector back, 16 x 256B pages ----
   ec70   21 00 ef              LXI     H,RMWBUF
   ec73   06 10                 MVI     B,16            ; 16 pages
   ec75   c5            WRPG:   PUSH    B
   ec76   cd 89 eb              CALL    SPI_PAGE        ; programs 256 bytes from (HL), advances HL by 256
   ec79   3a e8 eb              LDA     FBADDR+1
   ec7c   c6 01                 ADI     01H
   ec7e   32 e8 eb              STA     FBADDR+1        ; next page (low byte stays 00, high byte unchanged)
   ec81   c1                    POP     B
   ec82   05                    DCR     B
   ec83   c2 75 ec              JNZ     WRPG
   ec86   3e 00                 MVI     A,00H           ; success
   ec88   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   ec89                 BANNER:
   ec89   0d 0a                 DB      0DH,0AH                          ; blank line before the banner
   ec8b   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH
   ec8f   20 32 2e 32   
   ec93   20 6f 6e 20   
   ec97   42 72 65 76   
   ec9b   69 61 32 0d   
   ec9f   0a            
   eca0   43 50 2f 4d           DB      'CP/M port by Whale-Chan',0DH,0AH,0
   eca4   20 70 6f 72   
   eca8   74 20 62 79   
   ecac   20 57 68 61   
   ecb0   6c 65 2d 43   
   ecb4   68 61 6e 0d   
   ecb8   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   ecba                 SELBL:  DS      1               ; last selected drive
   ecbb                 TRK:    DS      2               ; current (absolute) track -- 16-bit!  CP/M 2 passes
                                                        ; the track as a WORD in BC (DRI manual Table 6-5),
                                                        ; and a DPB with >256 tracks (8 MB at SPT=32 needs
                                                        ; tracks up to 2047) REQUIRES the high byte.  TRK+0 =
                                                        ; low byte (from C), TRK+1 = high byte (from B).
   ecbd                 SECN:   DS      1               ; current sector
   ecbe                 DMA:    DS      2               ; current DMA address
   ecc0                 FILLV:  DS      1               ; scratch for RAMFILL
   ecc1                 SDIMGSRC: DS    2               ; SD system-area image copy: source/destination pointer
   ecc3                 SDIMGC: DS      1               ; SD system-area image copy: SD sectors remaining
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADERS / BLOCKS / VECTORS
                        ;   The BDOS builds the allocation vector itself on first drive login (never
                        ;   zero/prime it -- uninitialised DS is fine).  There are FOUR media sets:
                        ;   flash, RAM disk, SD region 0 and SD region 1.  The drive-letter -> media
                        ;   mapping is entirely in SELDSK (build-config dependent); the physical READ/
                        ;   WRITE dispatch uses SELBL to pick the path.  DIRBUF is shared by all drives
                        ;   (only one is operated at a time).
                        ;
                        ;   The SD DRIVE geometry uses OFF=0 and places the reserved system area at the
                        ;   CBIOS deblock layer (SDMAP adds SDSYS_OFF + region offset) -- the BDOS does
                        ;   NOT reliably apply the DPB OFF field, so the region/system offset cannot
                        ;   live in the DPB.
                        ; ============================================================================
                        
                        ; ---- SPI flash (on-board ISSI IS25LD040, drive A in the SPI build) ----------
                        ;   Geometry: SPT=32, 2KB allocation (BSH=4/BLM=15), OFF=2 (tracks 0-1 reserved
                        ;   for the CP/M boot image), directory = blocks 0-1 via AL0=0xC0 (128 entries),
                        ;   DSM=251 (single-DM).  MUST agree with the formatter (data at 0x3000).
   ecc4                 DPHFLASH:
   ecc4   00 00                 DW      0000H           ; XLT: no sector translation
   ecc6   00 00                 DW      0000H           ; scratch (cdrmax)
   ecc8   00 00                 DW      0000H           ; scratch (curtrk)
   ecca   00 00                 DW      0000H           ; scratch (currec)
   eccc   2e ed                 DW      DIRBUF          ; directory buffer (128 bytes)
   ecce   d4 ec                 DW      DPBFLASH        ; disk parameter block (flash 2K geometry)
   ecd0   e3 ec                 DW      CSVFLASH        ; checksum vector
   ecd2   e4 ec                 DW      ALVFLASH        ; allocation vector
   ecd4                 DPBFLASH:
   ecd4   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   ecd6   04                    DB      04H             ; BSH  = 4    (block shift -> 2KB blocks)
   ecd7   0f                    DB      0FH             ; BLM  = 15   (block mask)
   ecd8   01                    DB      01H             ; EXM  = 1    (BLS=2048 & DSM<256 -> single-DM)
   ecd9   fb 00                 DW      251             ; DSM  = 251  (252 blocks, single-DM)
   ecdb   7f 00                 DW      127             ; DRM  = 127  (128 entries)
   ecdd   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   ecde   00                    DB      00H             ; AL1  = 0x00
   ecdf   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   ece1   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   ece3                 CSVFLASH: DS    1               ; checksum vector (0 bytes used since CKS=0)
   ece4                 ALVFLASH: DS    32              ; allocation vector (DSM=251 -> (251/8)+1 = 32 bytes)
   ed04                 RECOFF: DS      2               ; in-sector byte offset for the flash RMW
                        
                        ; ---- RAM disk (bank B, 64K, volatile; drive B in the SPI build) ------------
                        ;   Geometry: SPT=32, 1K allocation (BSH=3/BLM=7), OFF=2 (tracks 0-1 system),
                        ;   DSM=55, DRM=63.  The legacy SPI build's BOOT persists CCP/BDOS to these.
   ed06                 DPHRAM:
   ed06   00 00                 DW      0000H           ; XLT
   ed08   00 00                 DW      0000H           ; scratch (cdrmax)
   ed0a   00 00                 DW      0000H           ; scratch (curtrk)
   ed0c   00 00                 DW      0000H           ; scratch (currec)
   ed0e   2e ed                 DW      DIRBUF          ; shared directory buffer
   ed10   16 ed                 DW      DPBRAM          ; disk parameter block (RAM disk 1K geometry)
   ed12   25 ed                 DW      CSVRAM          ; checksum vector
   ed14   26 ed                 DW      ALVRAM          ; allocation vector
   ed16                 DPBRAM:
   ed16   20 00                 DW      SPT             ; SPT  = 32
   ed18   03                    DB      03H             ; BSH  = 3    (1K blocks)
   ed19   07                    DB      07H             ; BLM  = 7
   ed1a   00                    DB      00H             ; EXM  = 0
   ed1b   37 00                 DW      55              ; DSM  = 55  (56 blocks)
   ed1d   3f 00                 DW      63              ; DRM  = 63  (64 entries)
   ed1f   c0                    DB      0C0H            ; AL0  = 0xC0
   ed20   00                    DB      00H             ; AL1  = 0x00
   ed21   00 00                 DW      00H             ; CKS  = 0
   ed23   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   ed25                 CSVRAM: DS      1
   ed26                 ALVRAM: DS      8               ; allocation vector (DSM=55 -> (55/8)+1 = 8 bytes)
   ed2e                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
                        ; ---- SD region 0 (drive A in the SD build; boot/system volume) -------------
                        ;   Geometry: SPT=32, 8KB allocation (BSH=6/BLM=63), DSM=1023 (double-DM, 8 MB),
                        ;   DRM=4095 (4096 entries), AL0/AL1=0xFF (16 directory blocks), OFF=0 (the
                        ;   reserved system area + region base are added in SDMAP).
   edae                 DPHSD0:
   edae   00 00                 DW      0000H           ; XLT
   edb0   00 00                 DW      0000H           ; scratch (cdrmax)
   edb2   00 00                 DW      0000H           ; scratch (curtrk)
   edb4   00 00                 DW      0000H           ; scratch (currec)
   edb6   2e ed                 DW      DIRBUF          ; shared directory buffer
   edb8   be ed                 DW      DPBSD0          ; disk parameter block (SD 8K geometry, OFF=0)
   edba   cd ed                 DW      CSVSD0          ; checksum vector (CKS=0 -> 0 bytes)
   edbc   ce ed                 DW      ALVSD0          ; allocation vector
   edbe                 DPBSD0:
   edbe   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   edc0   06                    DB      06H             ; BSH  = 6    (block shift -> 8KB blocks)
   edc1   3f                    DB      3FH             ; BLM  = 63   (block mask)
   edc2   03                    DB      03H             ; EXM  = 3    (DSM>255 & BLS=8192 -> double-DM)
   edc3   ff 03                 DW      1023            ; DSM  = 1023 (1024 blocks x 8KB = 8 MB)
   edc5   ff 0f                 DW      4095            ; DRM  = 4095 (4096 entries)
   edc7   ff                    DB      0FFH            ; AL0  = 0xFF (reserve directory blocks 0-7)
   edc8   ff                    DB      0FFH            ; AL1  = 0xFF (reserve directory blocks 8-15)
   edc9   00 00                 DW      00H             ; CKS  = 0
   edcb   00 00                 DW      00H             ; OFF  = 0    (region 0; system area via SDMAP)
   edcd                 CSVSD0: DS      1
   edce                 ALVSD0: DS      128             ; allocation vector (DSM=1023 -> (1023+1)/8 = 128 B)
                        
                        ; ---- SD region 1 (drive B in the SD build; second SD volume) ---------------
                        ;   Same geometry as region 0; the region base (+0x4000 sectors) AND the
                        ;   reserved system area (SDSYS_OFF) are added in SDMAP for SELBL==1.
   ee4e                 DPHSD1:
   ee4e   00 00                 DW      0000H           ; XLT
   ee50   00 00                 DW      0000H           ; scratch (cdrmax)
   ee52   00 00                 DW      0000H           ; scratch (curtrk)
   ee54   00 00                 DW      0000H           ; scratch (currec)
   ee56   2e ed                 DW      DIRBUF          ; shared directory buffer
   ee58   5e ee                 DW      DPBSD1          ; disk parameter block (SD 8K geometry, OFF=0)
   ee5a   6d ee                 DW      CSVSD1          ; checksum vector
   ee5c   6e ee                 DW      ALVSD1          ; allocation vector
   ee5e                 DPBSD1:
   ee5e   20 00                 DW      SPT             ; SPT  = 32
   ee60   06                    DB      06H             ; BSH  = 6    (8KB blocks)
   ee61   3f                    DB      3FH             ; BLM  = 63
   ee62   03                    DB      03H             ; EXM  = 3    (double-DM)
   ee63   ff 03                 DW      1023            ; DSM  = 1023
   ee65   ff 0f                 DW      4095            ; DRM  = 4095
   ee67   ff                    DB      0FFH            ; AL0  = 0xFF
   ee68   ff                    DB      0FFH            ; AL1  = 0xFF
   ee69   00 00                 DW      00H             ; CKS  = 0
   ee6b   00 00                 DW      00H             ; OFF  = 0    (region 1; region+system offset via SDMAP)
   ee6d                 CSVSD1: DS      1
   ee6e                 ALVSD1: DS      128             ; allocation vector (DSM=1023 -> 128 B)
                        
   eeee                 SDOFF:  DS      2               ; in-sector byte offset for the SD deblock
   eef0                 BLKN:   DS      4               ; SD block number (32-bit, MSB first); system area + record/4
   eef4                 SDCMDB: DS      6               ; SD command buffer (opcode + 4-byte arg + CRC)
   eefa                 SDTRY:  DS      1               ; SD retry counter (READC/WRITEC)
                        
   eefb                         END
