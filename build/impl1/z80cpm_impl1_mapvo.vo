module uart_rx_MGIOL ( input DI, LSR, CLK, output INFF );
  wire   VCCI, DI_dly, CLK_dly, LSR_dly;

  smuxlregsre u_rx_rxd_s0io( .D0(DI_dly), .SP(VCCI), .CK(CLK_dly), 
    .LSR(LSR_dly), .Q(INFF));
  vcc DRIVEVCC( .PWR1(VCCI));

  specify
    (LSR => INFF) = (0:0:0,0:0:0);
    (CLK => INFF) = (0:0:0,0:0:0);
    $setuphold (posedge CLK, DI, 0:0:0, 0:0:0,,,, CLK_dly, DI_dly);
    $setuphold (posedge CLK, LSR, 0:0:0, 0:0:0,,,, CLK_dly, LSR_dly);
  endspecify

endmodule

module smuxlregsre ( input D0, SP, CK, LSR, output Q );

