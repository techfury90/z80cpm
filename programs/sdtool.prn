   066f   e5                    PUSH    H
   0670   c5                    PUSH    B
   0671   cd 46 06              CALL    PRHEX2
   0674   c1                    POP     B
   0675   e1                    POP     H
   0676   23                    INX     H
   0677   05                    DCR     B
   0678   c2 6e 06              JNZ     P32_L
   067b   c9                    RET
                        
