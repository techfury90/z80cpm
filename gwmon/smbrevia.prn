01da  COUT          01db  COUT1         0000  CPMIMG        1d00  CPMIMGLEN 
000d  CR            00e3  CRLF          010e  CSERR$        000c  CSTART    
019f  CSUMER        0003  CTLC          0080  CTLPRT        0081  DATPRT    
00c9  DMPLOC        fefd  DYNIN         fefa  DYNOUT        012a  EDTCM1    
0148  EDTCM2        0127  EDTCMD        0114  ERR$          0044  ERROR     
0277  FBADDR        0056  GETADR        0062  GETHE2        005f  GETHEX    
014c  GOCMD         0119  HDCMD         0076  HEXBYT        0098  HEXDM1    
009d  HEXDM2        00ae  HEXDM3        0096  HEXDMP        0150  INPCMD    
01ca  IOSET         0000  JMPTAB        000a  LF            0162  LODCM1    
0181  LODCM2        018c  LODCM3        0196  LODCM4        015f  LODCMD    
02b1  MSGNOFLASH    000d  NEXTLOC       01c9  NULCMD        01a5  OUTCMD    
010c  PROMPT$       00b9  PRTADR        00ed  PRTCLS        0047  PRTERR    
00ca  PRTHEX        00d3  PRTNIB        00de  PRTSPC        00f0  PRTSTR    
004d  RUNCMD        00fd  SIGNON$       000c  SMSTRT        0231  SPG1      
0206  SPI_ADDR      0051  SPI_CTL       0050  SPI_DATA      025a  SPI_ERASE_SECT
0219  SPI_PAGE      0241  SPI_READBUF    01eb  SPI_REL       01e6  SPI_SEL   
0052  SPI_STAT      01f3  SPI_WAIT      01f0  SPI_XMIT      01fb  SPW       
024c  SRDB          ff00  STACK         0021  WSTART        
