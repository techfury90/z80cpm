                        ; ============================================================================
                        ; diskutil.s -- standalone RAM-disk maintenance utility for the Brevia2 Z80.
                        ;
                        ; Runs entirely OUTSIDE of CP/M. Loaded via GWMON-80 'L', run via 'G 1000'.
                        ; Uses the console UART (0x80 status / 0x81 data) for BOTH the menu and the
                        ; XMODEM file transfer, and the RAM-disk controller (0x20 DATA auto-inc,
                        ; 0x21 ADDR lo, 0x22 ADDR hi) for the CP/M disk layout in bank B.
                        ;
                        ; Commands:
                        ;   F  -- format drive A: (write 0xE5 to the 2K directory area)
                        ;   U  -- XMODEM upload (checksum mode): receive a file from the host PC and
                        ;         write it to the RAM disk as a CP/M file (multi-extent for >16K).
                        ;   D  -- XMODEM download: send a file from the RAM disk to the host PC.
                        ;   H  -- help
                        ;
                        ; XMODEM receive retries the initiating NAK with a ~1.5s timeout each cycle,
                        ; so the host (Tera Term / minicom) picks it up even if it starts the transfer
                        ; AFTER we began waiting. Supports checksum blocks (SOH) and CRC blocks (STX).
                        ;
                        ; Assembled with the Glitch Works a85 8085 cross-assembler (same as cbios.asm).
                        ; ============================================================================
                        
   1000                         ORG     1000H
                        
                        ; ---------------- Processor I/O ports ----------------
   0080                 USTAT   EQU     80H                     ; UART status (bit0 tx_busy, bit1 rx_avail)
   0081                 UDATA   EQU     81H                     ; UART data (read=RX char, write=TX char)
   0020                 RDDATA  EQU     20H                     ; RAM disk DATA (read/write, auto-increment)
   0021                 RDADRL  EQU     21H                     ; RAM disk ADDR low
   0022                 RDADRH  EQU     22H                     ; RAM disk ADDR high
                        ; ---- on-board ISSI IS25LP040E serial flash (SPI, 512 KB) ----
   0050                 SPI_DATA EQU    50H                     ; read = clock 1 byte in (returns in A), write = clock 1 byte out. MSB-first.
   0051                 SPI_CTL  EQU    51H                     ; write bit0 = CS#: 0 = select flash low, 1 = release high
   0052                 SPI_STAT EQU    52H                     ; read bit0 = transfer busy (1 while a byte is clocked; polling OPTIONAL)
                        
                        ; ---------------- CP/M drive A: disk layout (bank B) ----------------
   2000                 DIRBASE EQU     2000H                   ; directory area base (2K = 64 entries)
   2800                 DBLOCK0 EQU     2800H                   ; first USER data block (block 2) base
   0400                 BLKSZ   EQU     1024                    ; block size (1K)
   0080                 RECSZ   EQU     128                     ; CP/M record size
                        
                        ; ---------------- XMODEM control bytes ----------------
   0001                 XM_SOH  EQU     01H
   0002                 XM_STX  EQU     02H
   0004                 XM_EOT  EQU     04H
   0006                 XM_ACK  EQU     06H
   0015                 XM_NAK  EQU     15H
   0018                 XM_CAN  EQU     18H
   00fe                 XM_TO   EQU     0FEH                    ; internal: RX timeout marker
                        
                        ; ---------------- Workspace (bank A SRAM, well below the CCP at 0xE400) ----------------
   2000                 XMBUF   EQU     2000H                   ; 128-byte XMODEM block buffer
   2100                 FCB     EQU     2100H                   ; 32-byte FCB (extent 0) in RAM
   2120                 FCB2    EQU     2120H                   ; 32-byte FCB (extent 1) in RAM
   2160                 RCNT_L  EQU     2160H                   ; total records received (16-bit, L then H)
   2180                 FNAME   EQU     2180H                   ; 12-byte user filename buffer (8.3)
   2200                 F_PAT   EQU     2200H                   ; 16-byte test-pattern buffer for the flash program/verify
   2210                 F_RD    EQU     2210H                   ; 16-byte flash read-back buffer for the raw dump/verify
                        
                        ; ============================================================================
   1000   c3 1d 11              JMP     START
                        
                        ; ---------------- UART primitives ----------------
                        ; TXCHAR: output char in A; poll tx_busy(bit0) low.
   1003   f5            TXCHAR: PUSH    PSW
   1004   db 80         TXCH1:  IN      USTAT
   1006   e6 01                 ANI     01H
   1008   c2 04 10              JNZ     TXCH1
   100b   f1                    POP     PSW
   100c   d3 81                 OUT     UDATA
   100e   c9                    RET
                        
                        ; RXCHAR: block until a char, return it in A.
   100f   db 80         RXCHAR: IN      USTAT
   1011   e6 02                 ANI     02H
   1013   ca 0f 10              JZ      RXCHAR
   1016   db 81                 IN      UDATA
   1018   c9                    RET
                        
                        ; RXCHAR_T: receive a char with a ~1.5s timeout.
                        ;   Returns: carry CLEAR + A=char if a char arrived; carry SET if timeout.
   1019                 RXCHAR_T:
   1019   06 b0                 MVI     B,0B0H                  ; outer count
   101b   0e b0         RT_L2:  MVI     C,0B0H                  ; mid count
   101d   16 b0         RT_L1:  MVI     D,0B0H                  ; inner count
   101f   db 80         RT_L0:  IN      USTAT
   1021   e6 02                 ANI     02H
   1023   c2 34 10              JNZ     RT_HAVE
   1026   15                    DCR     D
   1027   c2 1f 10              JNZ     RT_L0
   102a   0d                    DCR     C
   102b   c2 1d 10              JNZ     RT_L1
   102e   05                    DCR     B
   102f   c2 1b 10              JNZ     RT_L2
   1032   37                    STC                             ; timeout
   1033   c9                    RET
   1034                 RT_HAVE:
   1034   db 81                 IN      UDATA                   ; char
   1036   37                    STC
   1037   3f                    CMC                             ; carry clear (char read)
   1038   c9                    RET
                        
                        ; CRLF: send CR + LF.
   1039   3e 0d         CRLF:   MVI     A,0DH
   103b   cd 03 10              CALL    TXCHAR
   103e   3e 0a                 MVI     A,0AH
   1040   cd 03 10              CALL    TXCHAR
   1043   c9                    RET
                        
                        ; PRTDBG: print a NUL-terminated tag string at HL, then the byte in A as two
                        ; hex digits, then a space. For on-board trace of the upload/FCB path.
                        ; PRTSTR advances/clobbers HL, so the value byte is parked in C; PRTBYTE uses
                        ; A (and itself calls TXCHAR). No registers are preserved beyond C/B/..., so
                        ; callers must not rely on B/C/D/E/H/L across a PRTDBG call (use it standalone).
   1044   4f            PRTDBG: MOV     C,A             ; park the value byte
   1045   c5                    PUSH    B
   1046   d5                    PUSH    D
   1047   e5                    PUSH    H
   1048   cd 58 10              CALL    PRTSTR          ; HL -> tag string (PRTSTR clobbers HL)
   104b   e1                    POP     H
   104c   d1                    POP     D
   104d   c1                    POP     B
   104e   79                    MOV     A,C
   104f   cd 62 10              CALL    PRTBYTE         ; value byte as 2 hex
   1052   3e 20                 MVI     A,' '
   1054   cd 03 10              CALL    TXCHAR
   1057   c9                    RET
                        
                        ; PRTSTR: print NUL-terminated string at HL.
   1058   7e            PRTSTR: MOV     A,M
   1059   b7                    ORA     A
   105a   c8                    RZ
   105b   cd 03 10              CALL    TXCHAR
   105e   23                    INX     H
   105f   c3 58 10              JMP     PRTSTR
                        
                        ; PRTBYTE: print A as two hex digits.
   1062   f5            PRTBYTE: PUSH    PSW
   1063   e6 f0                 ANI     0F0H
   1065   0f                    RRC
   1066   0f                    RRC
   1067   0f                    RRC
   1068   0f                    RRC
   1069   cd 6f 10              CALL    PRTH1
   106c   f1                    POP     PSW
   106d   e6 0f                 ANI     0FH
   106f   c6 90         PRTH1:  ADI     90H
   1071   27                    DAA
   1072   ce 40                 ACI     40H                     ; add carry (ACI) so 0xA-0xF print A-F
   1074   27                    DAA
   1075   c3 03 10              JMP     TXCHAR
                        
                        ; ---------------- RAM-disk primitives (bank B) ----------------
   1078   7d            RDSETA: MOV     A,L
   1079   d3 21                 OUT     RDADRL
   107b   7c                    MOV     A,H
   107c   d3 22                 OUT     RDADRH
   107e   c9                    RET
                        
                        ; ============================================================================
                        ; FINDFREE -- scan the directory (64 slots) for a run of `FNEED` consecutive
                        ;   EMPTY (0xE5) slots. Set FNEED=1 for a single-extent file, FNEED=2 for a
                        ;   two-extent file (extents 0 and 1 occupy two ADJACENT slots).
                        ;   Returns: A = slot index of the run start, carry CLEAR if found; carry SET
                        ;            if the directory has no such run (full).
                        ; ============================================================================
   107f                 FINDFREE:
   107f   06 40                 MVI     B,64            ; slots to examine
   1081   0e 00                 MVI     C,00H           ; candidate run-start index
   1083                 FF_LOOP:
   1083   3a 53 15              LDA     FNEED
   1086   57                    MOV     D,A             ; D = number of consecutive empties still needed
   1087   59                    MOV     E,C             ; E = running slot index
                                ; remaining slots must be >= FNEED
   1088   78                    MOV     A,B
   1089   ba                    CMP     D
   108a   da b5 10              JC      FF_FULL         ; not enough slots left for a full run
   108d                 FF_RUN:
                                ; check slot E is empty. PUSH D/E because LXI D,DIRBASE below clobbers
                                ; both, and D (remaining count) and E (running slot) are live across the
                                ; slot read. Without the push, D silently becomes 0x20 (DIRBASE hi) and E
                                ; resets each iteration, corrupting the run-scan.
   108d   d5                    PUSH    D
   108e   7b                    MOV     A,E
   108f   6f                    MOV     L,A
   1090   26 00                 MVI     H,00H
   1092   3e 05                 MVI     A,05H
   1094   29            FF_SHL: DAD     H
   1095   3d                    DCR     A
   1096   c2 94 10              JNZ     FF_SHL          ; HL = E*32
   1099   11 00 20              LXI     D,DIRBASE
   109c   19                    DAD     D               ; HL = DIRBASE + E*32
   109d   cd 78 10              CALL    RDSETA
   10a0   db 20                 IN      RDDATA          ; byte 0 (0xE5 = empty)
   10a2   d1                    POP     D               ; restore D (count), E (running slot)
   10a3   fe e5                 CPI     0E5H
   10a5   c2 b0 10              JNZ     FF_ADV          ; slot E occupied -> try next run start
   10a8   1c                    INR     E
   10a9   15                    DCR     D
   10aa   c2 8d 10              JNZ     FF_RUN          ; continue the run
                                ; found a run of FNEED consecutive empties starting at C
   10ad   79                    MOV     A,C
   10ae   b7                    ORA     A               ; clear carry
   10af   c9                    RET
   10b0                 FF_ADV:
   10b0   0c                    INR     C               ; advance run start
   10b1   05                    DCR     B
   10b2   c2 83 10              JNZ     FF_LOOP
   10b5                 FF_FULL:
   10b5   37                    STC
   10b6   c9                    RET
                        
                        ; ============================================================================
                        ; NEXTBLK -- find the first FREE data block for a new file, scanning every
                        ;   non-empty directory entry's allocation map for the highest block in use.
                        ;   Returns: A = next free block number, carry CLEAR if one exists;
                        ;            carry SET if the data area is full.
                        ;   Data blocks run from 2 (block N at 0x2000 + N*1024); DSM=55 (blocks 2-55).
                        ; ============================================================================
   10b7                 NEXTBLK:
   10b7   3e 01                 MVI     A,01H           ; start "highest used" just below block 2
   10b9   32 54 15              STA     NBMAX
   10bc   21 00 20              LXI     H,DIRBASE       ; scan base
   10bf   06 40                 MVI     B,64            ; 64 slots
   10c1   0e 00                 MVI     C,00H           ; slot index
   10c3                 NB_LOOP:
   10c3   79                    MOV     A,C
   10c4   6f                    MOV     L,A
   10c5   26 00                 MVI     H,00H
   10c7   16 05                 MVI     D,05H
   10c9   29            NB_SHL: DAD     H
   10ca   15                    DCR     D
   10cb   c2 c9 10              JNZ     NB_SHL          ; HL = slot*32
   10ce   11 00 20              LXI     D,DIRBASE
   10d1   19                    DAD     D
   10d2   cd 78 10              CALL    RDSETA
   10d5   db 20                 IN      RDDATA          ; byte 0 = user number
   10d7   fe e5                 CPI     0E5H
   10d9   ca 0a 11              JZ      NB_NEXT         ; empty slot -> no blocks to scan
                                ; non-empty: read its 16 allocation bytes and track the max block
   10dc   21 00 20              LXI     H,DIRBASE
   10df   19                    DAD     D               ; HL = DIRBASE (already have D=DIRBASE from DAD)
   10e0   79                    MOV     A,C
   10e1   6f                    MOV     L,A
   10e2   26 00                 MVI     H,00H
   10e4   16 05                 MVI     D,05H
   10e6   29            NB_SHL2: DAD     H
   10e7   15                    DCR     D
   10e8   c2 e6 10              JNZ     NB_SHL2
   10eb   11 10 20              LXI     D,DIRBASE+16    ; +16 -> start of allocation map
   10ee   19                    DAD     D
   10ef   cd 78 10              CALL    RDSETA
   10f2   16 10                 MVI     D,16            ; read 16 allocation bytes
   10f4   db 20         NB_MAP: IN      RDDATA
   10f6   b7                    ORA     A
   10f7   ca 06 11              JZ      NB_MAPC         ; block 0 = unallocated (means no block) -> skip
   10fa   5f                    MOV     E,A             ; E = this block number
   10fb   3a 54 15              LDA     NBMAX
   10fe   bb                    CMP     E
   10ff   d2 06 11              JNC     NB_MAPC         ; NBMAX >= this -> no change
   1102   7b                    MOV     A,E
   1103   32 54 15              STA     NBMAX           ; NBMAX = this block
   1106   15            NB_MAPC: DCR     D
   1107   c2 f4 10              JNZ     NB_MAP
   110a                 NB_NEXT:
   110a   0c                    INR     C
   110b   05                    DCR     B
   110c   c2 c3 10              JNZ     NB_LOOP
                                ; next free block = NBMAX + 1
   110f   3a 54 15              LDA     NBMAX
   1112   c6 01                 ADI     01H
   1114   fe 38                 CPI     56              ; block 56 would be past DSM=55
   1116   d2 1b 11              JNC     NB_FULL
   1119   b7                    ORA     A               ; clear carry (block number in A, < 56)
   111a   c9                    RET
   111b                 NB_FULL:
   111b   37                    STC
   111c   c9                    RET
                        
                        ; ============================================================================
                        ; START
                        ; ============================================================================
   111d   31 00 e0      START:  LXI     SP,0E000H               ; stack in the TPA, BELOW the BDOS/CCP (0xE400+)
                                                                ; 0xF000 sat INSIDE the BDOS (0xEC00-0xFFFF), so
                                                                ;  diskutil's CALL/PUSH frames clobbered CP/M's
                                                                ;  in-RAM image; cold boot then ran the corrupted
                                                                ;  code. The CBIOS itself uses 0xDC00 for the same
                                                                ;  reason. TPA is 0x0100-0xE3FF; 0xE000 grows down
                                                                ;  into free space clear of code/buffers (0x1000+).
   1120   21 ed 17              LXI     H,MSGBANNER
   1123   cd 58 10              CALL    PRTSTR
   1126   21 0c 18      MENU:   LXI     H,MSGMENU
   1129   cd 58 10              CALL    PRTSTR
   112c   cd 0f 10              CALL    RXCHAR                  ; wait for a command char
   112f   e6 df                 ANI     0DFH                    ; force uppercase (accept lowercase)
   1131   fe 46                 CPI     'F'
   1133   ca 6b 11              JZ      DO_FMT
   1136   fe 55                 CPI     'U'
   1138   ca 97 11              JZ      DO_UPLOAD
   113b   fe 43                 CPI     'C'
   113d   ca e8 14              JZ      DO_BOOTCPM
   1140   fe 48                 CPI     'H'
   1142   ca 8e 11              JZ      DO_HELP
   1145   fe 42                 CPI     'B'
   1147   ca 56 15              JZ      DO_DUMP
   114a   fe 4d                 CPI     'M'
   114c   ca 7e 15              JZ      DO_MDUMP
   114f   fe 49                 CPI     'I'
   1151   ca 60 16              JZ      DO_ID
   1154   fe 50                 CPI     'P'
   1156   ca b1 16              JZ      DO_PROGRAM
   1159   fe 52                 CPI     'R'
   115b   ca e3 16              JZ      DO_READ
   115e   fe 45                 CPI     'E'
   1160   ca 5d 17              JZ      DO_ERASE
   1163   fe 53                 CPI     'S'
   1165   ca b1 17              JZ      DO_FMTFLASH
   1168   c3 26 11              JMP     MENU
                        
                        ; ---------------- command: format ----------------
   116b   21 43 19      DO_FMT: LXI     H,MSGFMT
   116e   cd 58 10              CALL    PRTSTR
   1171   21 00 00              LXI     H,0000H                 ; start at byte 0 of the RAM disk
   1174   cd 78 10              CALL    RDSETA
   1177   01 00 00              LXI     B,65536                 ; erase the ENTIRE 64K bank-B RAM disk
   117a   16 e5                 MVI     D,0E5H                  ; keep the fill value in D (A is clobbered below)
   117c   7a            FMTW:   MOV     A,D
   117d   d3 20                 OUT     RDDATA                  ; write 0xE5 (auto-increment)
   117f   0b                    DCX     B
   1180   78                    MOV     A,B
   1181   b1                    ORA     C
   1182   c2 7c 11              JNZ     FMTW
   1185   21 53 19              LXI     H,MSGFMTOK
   1188   cd 58 10              CALL    PRTSTR
   118b   c3 26 11              JMP     MENU
                        
   118e   21 68 18      DO_HELP: LXI     H,MSGHELP
   1191   cd 58 10              CALL    PRTSTR
   1194   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_UPLOAD -- XMODEM (checksum/CRC) receive a file, write it as a CP/M file.
                        ; ============================================================================
   1197                 DO_UPLOAD:
   1197   21 60 19              LXI     H,MSGPROMPT
   119a   cd 58 10              CALL    PRTSTR
   119d   cd 22 14              CALL    READNAME                ; read "name.ext" into FNAME (echoed)
                                ; ---- allocate the first free data block NOW so WRITEBLK (during the
                                ;      receive, before the FCB is written) appends after existing
                                ;      files instead of overwriting block 2. The directory slot is
                                ;      allocated later in WRITEFCB, after the extent count is known.
   11a0   cd b7 10              CALL    NEXTBLK                 ; A = first free data block (carry set = full)
   11a3   da ef 11              JC      UP_NOSPC
   11a6   32 55 15              STA     BLKNO
   11a9   21 1c 1c              LXI     H,MSGT_BLK              ; DEBUG: trace the picked block
   11ac   cd 44 10              CALL    PRTDBG                  ; value was already in A (BLKNO)
   11af   21 00 00              LXI     H,0000H
   11b2   22 60 21              SHLD    RCNT_L                  ; init record counter
   11b5   21 79 19              LXI     H,MSGRECV
   11b8   cd 58 10              CALL    PRTSTR
   11bb   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   11bd   cd 03 10              CALL    TXCHAR
                        
   11c0   cd 1a 12      UPLOOP: CALL    GETBLK                  ; A=TO(timeout),01 good,FF bad,00 EOT,02 CAN
   11c3   fe fe                 CPI     XM_TO
   11c5   ca e7 11              JZ      UP_NAK                  ; timeout -> resend NAK, keep waiting
   11c8   fe 02                 CPI     02H
   11ca   ca e7 11              JZ      UP_NAK                  ; CAN
   11cd   fe 00                 CPI     00H
   11cf   ca f8 11              JZ      UP_EOT
   11d2   fe ff                 CPI     0FFH
   11d4   ca e7 11              JZ      UP_NAK                  ; bad block -> NAK
                                ; good block -> write it to the disk
   11d7   cd de 12              CALL    WRITEBLK
   11da   3e 06                 MVI     A,XM_ACK
   11dc   cd 03 10              CALL    TXCHAR
   11df   3e 2e                 MVI     A,'.'
   11e1   cd 03 10              CALL    TXCHAR
   11e4   c3 c0 11              JMP     UPLOOP
   11e7   3e 15         UP_NAK: MVI     A,XM_NAK
   11e9   cd 03 10              CALL    TXCHAR
   11ec   c3 c0 11              JMP     UPLOOP
                        ; disk full (no free data block or no free directory slot) -> report and bail
   11ef                 UP_NOSPC:
   11ef   21 3c 1a              LXI     H,MSGNOSPC
   11f2   cd 58 10              CALL    PRTSTR
   11f5   c3 26 11              JMP     MENU
                        
   11f8   3e 06         UP_EOT: MVI     A,XM_ACK
   11fa   cd 03 10              CALL    TXCHAR
   11fd   cd 39 10              CALL    CRLF
   1200   cd 1b 13              CALL    WRITEFCB                ; write directory entries
   1203   21 91 19              LXI     H,MSGDONE
   1206   cd 58 10              CALL    PRTSTR
   1209   2a 60 21              LHLD    RCNT_L
   120c   7c                    MOV     A,H
   120d   cd 62 10              CALL    PRTBYTE
   1210   7d                    MOV     A,L
   1211   cd 62 10              CALL    PRTBYTE
   1214   cd 39 10              CALL    CRLF
   1217   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; GETBLK -- receive one XMODEM block into XMBUF.
                        ; Returns A: XM_TO(timeout), 00=EOT, 01=good, FF=bad, 02=CAN.
                        ; (First byte uses the timed read so we can retry the NAK on timeout; the rest
                        ;  of the block uses blocking reads because the host sends them back-to-back.)
                        ; ============================================================================
   121a   cd 19 10      GETBLK: CALL    RXCHAR_T
   121d   da 37 12              JC      GT_TIMEOUT              ; carry set = timeout
   1220   fe 04                 CPI     XM_EOT
   1222   ca 3a 12              JZ      GT_EOT
   1225   fe 18                 CPI     XM_CAN
   1227   ca 3c 12              JZ      GT_CAN
   122a   fe 01                 CPI     XM_SOH
   122c   ca 3f 12              JZ      GT_SOH
   122f   fe 02                 CPI     XM_STX
   1231   ca 68 12              JZ      GT_STX
   1234   c3 1a 12              JMP     GETBLK                  ; stray byte (e.g. 'rx name'), ignore
                        
   1237                 GT_TIMEOUT:
   1237   3e fe                 MVI     A,XM_TO
   1239   c9                    RET
   123a   af            GT_EOT: XRA     A
   123b   c9                    RET
   123c   3e 02         GT_CAN: MVI     A,02H
   123e   c9                    RET
                        
                        ; ---- SOH: checksum block (blkno, ~blkno, 128 data, 1-byte checksum) ----
   123f   cd 0f 10      GT_SOH: CALL    RXCHAR
   1242   47                    MOV     B,A                     ; blkno
   1243   cd 0f 10              CALL    RXCHAR
   1246   a8                    XRA     B                       ; ~blkno ^ blkno
   1247   fe ff                 CPI     0FFH
   1249   c2 db 12              JNZ     GT_BAD
   124c   21 00 20              LXI     H,XMBUF
   124f   1e 00                 MVI     E,00H
   1251   0e 80                 MVI     C,128
   1253   cd 0f 10      GT_LP:  CALL    RXCHAR
   1256   77                    MOV     M,A
   1257   83                    ADD     E
   1258   5f                    MOV     E,A
   1259   23                    INX     H
   125a   0d                    DCR     C
   125b   c2 53 12              JNZ     GT_LP
   125e   cd 0f 10              CALL    RXCHAR                  ; checksum byte
   1261   bb                    CMP     E
   1262   c2 db 12              JNZ     GT_BAD
   1265   3e 01                 MVI     A,01H
   1267   c9                    RET
                        
                        ; ---- STX: CRC block (blkno, ~blkno, 128 data, 2-byte CRC-16) ----
   1268   cd 0f 10      GT_STX: CALL    RXCHAR
   126b   47                    MOV     B,A                     ; blkno
   126c   cd 0f 10              CALL    RXCHAR
   126f   a8                    XRA     B
   1270   fe ff                 CPI     0FFH
   1272   c2 db 12              JNZ     GT_BAD
   1275   21 00 20              LXI     H,XMBUF
   1278   0e 80                 MVI     C,128
   127a   cd 0f 10      GT_LP2: CALL    RXCHAR
   127d   77                    MOV     M,A
   127e   23                    INX     H
   127f   0d                    DCR     C
   1280   c2 7a 12              JNZ     GT_LP2
                                ; compute CRC-16 XMODEM over XMBUF -> D: E (D high, E low)
   1283   21 00 20              LXI     H,XMBUF
   1286   11 00 00              LXI     D,0000H                 ; crc = 0
   1289   0e 80                 MVI     C,128
   128b   7e            GT_CRC: MOV     A,M
   128c   47                    MOV     B,A
   128d   7a                    MOV     A,D
   128e   a8                    XRA     B                       ; crc_hi ^= byte
   128f   57                    MOV     D,A
   1290   06 08                 MVI     B,08H
   1292   7a            GTCB:   MOV     A,D
   1293   e6 80                 ANI     80H                     ; crc & 0x8000 ?
   1295   ca b3 12              JZ      GTCS
   1298   a7                    ANA     A                       ; clear carry
   1299   7b                    MOV     A,E
   129a   17                    RAL                             ; E = E<<1 (carry = old E bit7)
   129b   5f                    MOV     E,A
   129c   7a                    MOV     A,D
   129d   17                    RAL                             ; D = D<<1 | old E bit7
   129e   57                    MOV     D,A
   129f   7a                    MOV     A,D
   12a0   ee 10                 XRI     10H                     ; crc ^= 0x1021 (hi)
   12a2   57                    MOV     D,A
   12a3   7b                    MOV     A,E
   12a4   ee 21                 XRI     21H                     ; crc ^= 0x1021 (lo)
   12a6   5f                    MOV     E,A
   12a7   05                    DCR     B
   12a8   c2 92 12              JNZ     GTCB
   12ab   23                    INX     H
   12ac   0d                    DCR     C
   12ad   c2 8b 12              JNZ     GT_CRC
   12b0   c3 c3 12              JMP     GT_CHK
   12b3   a7            GTCS:   ANA     A                       ; clear carry
   12b4   7b                    MOV     A,E
   12b5   17                    RAL
   12b6   5f                    MOV     E,A
   12b7   7a                    MOV     A,D
   12b8   17                    RAL
   12b9   57                    MOV     D,A
   12ba   05                    DCR     B
   12bb   c2 92 12              JNZ     GTCB
   12be   23                    INX     H
   12bf   0d                    DCR     C
   12c0   c2 8b 12              JNZ     GT_CRC
   12c3                 GT_CHK:
   12c3   23                    INX     H
   12c4   0d                    DCR     C
   12c5   c2 8b 12              JNZ     GT_CRC
                                ; read 2 CRC bytes (high, low), compare
   12c8   cd 0f 10              CALL    RXCHAR
   12cb   47                    MOV     B,A                     ; received crc hi
   12cc   cd 0f 10              CALL    RXCHAR
   12cf   bb                    CMP     E                       ; compare low
   12d0   c2 db 12              JNZ     GT_BAD
   12d3   78                    MOV     A,B
   12d4   ba                    CMP     D                       ; compare high
   12d5   c2 db 12              JNZ     GT_BAD
   12d8   3e 01                 MVI     A,01H
   12da   c9                    RET
                        
   12db   3e ff         GT_BAD: MVI     A,0FFH
   12dd   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEBLK -- write the 128 good bytes in XMBUF to the RAM disk at the current
                        ;   file position. Position = 0x2000 + BLKNO*1024 + RCNT_L*128. BLKNO is the
                        ;   first free data block found by NEXTBLOCK at upload start, so a second
                        ;   upload appends after existing files instead of overwriting block 2.
                        ; ============================================================================
   12de                 WRITEBLK:
   12de   2a 60 21              LHLD    RCNT_L
   12e1   54                    MOV     D,H
   12e2   5d                    MOV     E,L
   12e3   06 07                 MVI     B,07H
   12e5                 WBLK_SHL:
   12e5   7b                    MOV     A,E
   12e6   87                    ADD     A
   12e7   5f                    MOV     E,A
   12e8   7a                    MOV     A,D
   12e9   17                    RAL
   12ea   57                    MOV     D,A
   12eb   05                    DCR     B
   12ec   c2 e5 12              JNZ     WBLK_SHL        ; DE = RCNT_L*128
   12ef   d5                    PUSH    D               ; save RCNT_L*128
   12f0   3a 55 15              LDA     BLKNO
   12f3   6f                    MOV     L,A
   12f4   26 00                 MVI     H,00H
   12f6   06 0a                 MVI     B,10            ; *1024 (2^10) -> HL = BLKNO*1024
   12f8   29            WBLK_B: DAD     H
   12f9   05                    DCR     B
   12fa   c2 f8 12              JNZ     WBLK_B
   12fd   11 00 20              LXI     D,2000H         ; data-area base (blocks are at 0x2000 + N*1024)
   1300   19                    DAD     D               ; HL = 0x2000 + BLKNO*1024
   1301   d1                    POP     D               ; DE = RCNT_L*128
   1302   19                    DAD     D               ; HL += RCNT_L*128
   1303   cd 78 10              CALL    RDSETA
   1306   21 00 20              LXI     H,XMBUF
   1309   0e 80                 MVI     C,128
   130b   7e            WBLK:   MOV     A,M
   130c   d3 20                 OUT     RDDATA
   130e   23                    INX     H
   130f   0d                    DCR     C
   1310   c2 0b 13              JNZ     WBLK
   1313   2a 60 21              LHLD    RCNT_L
   1316   23                    INX     H
   1317   22 60 21              SHLD    RCNT_L
   131a   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEFCB -- write the FCB directory entry/entries for the received file.
                        ;   BLKNO (first free data block) and FSLOT (first free dir slot) were chosen
                        ;   by NEXTBLK/FINDFREE at the START of the upload. Single extent (<=16K) ->
                        ;   one slot; >16K -> two slots (extents 0 and 1). All data blocks run
                        ;   contiguously from BLKNO, so a second upload never overwrites the first.
                        ; ============================================================================
   131b                 WRITEFCB:
   131b   cd 72 14              CALL    BUILD_FCB               ; builds FCB (and FCB2 copy) with name/ext
   131e   2a 60 21              LHLD    RCNT_L
   1321   7c                    MOV     A,H
   1322   b7                    ORA     A
   1323   c2 62 13              JNZ     WFC_TWO
   1326   7d                    MOV     A,L
   1327   fe 81                 CPI     129
   1329   d2 62 13              JNC     WFC_TWO
                                ; ---- single extent (<=16K) ----
   132c   3e 01                 MVI     A,01H
   132e   32 53 15              STA     FNEED                   ; need 1 consecutive slot
   1331   cd 7f 10              CALL    FINDFREE                ; A = free slot (carry set = dir full)
   1334   da ef 11              JC      UP_NOSPC
   1337   32 51 15              STA     FSLOT
   133a   21 21 1c              LXI     H,MSGT_SLOT             ; DEBUG: trace the picked slot
   133d   cd 44 10              CALL    PRTDBG                  ; value in A = FSLOT
   1340   3a 0f 21              LDA     FCB+15
   1343   21 27 1c              LXI     H,MSGT_RC               ; DEBUG: trace RC
   1346   cd 44 10              CALL    PRTDBG
   1349   3e 00                 MVI     A,00H
   134b   32 0c 21              STA     FCB+12                  ; EX=0
   134e   32 0d 21              STA     FCB+13                  ; S1=0
   1351   32 0e 21              STA     FCB+14                  ; S2=0
   1354   2a 60 21              LHLD    RCNT_L
   1357   7d                    MOV     A,L
   1358   32 0f 21              STA     FCB+15                  ; RC = records
   135b   cd ea 13              CALL    SETALLO                 ; fill FCB+16..31 (blocks from BLKNO)
   135e   cd c8 13              CALL    WDIRFCB
   1361   c9                    RET
                        
   1362                 WFC_TWO:
   1362   3e 02                 MVI     A,02H
   1364   32 53 15              STA     FNEED                   ; need 2 consecutive slots
   1367   cd 7f 10              CALL    FINDFREE                ; A = free slot run start
   136a   da ef 11              JC      UP_NOSPC
   136d   32 51 15              STA     FSLOT
   1370   3e 00                 MVI     A,00H
   1372   32 0c 21              STA     FCB+12
   1375   32 0d 21              STA     FCB+13
   1378   32 0e 21              STA     FCB+14
   137b   3e 80                 MVI     A,128
   137d   32 0f 21              STA     FCB+15
   1380   cd ea 13              CALL    SETALLO
   1383   2a 60 21              LHLD    RCNT_L
   1386   7d                    MOV     A,L
   1387   d6 80                 SUI     128
   1389   6f                    MOV     L,A
   138a   7c                    MOV     A,H
   138b   de 00                 SBI     00H
   138d   67                    MOV     H,A
   138e   7d                    MOV     A,L
   138f   32 2f 21              STA     FCB2+15                 ; RC extent 1
   1392   3e 01                 MVI     A,01H
   1394   32 2c 21              STA     FCB2+12                 ; EX=1
   1397   3e 00                 MVI     A,00H
   1399   32 2d 21              STA     FCB2+13                 ; S1=0
   139c   32 2e 21              STA     FCB2+14                 ; S2=0
   139f   cd 05 14              CALL    SETALLO2
   13a2   cd c8 13              CALL    WDIRFCB                 ; extent 0 at slot FSLOT
                                ; extent 1 at slot FSLOT+1
   13a5   3a 51 15              LDA     FSLOT
   13a8   3c                    INR     A
   13a9   6f                    MOV     L,A
   13aa   26 00                 MVI     H,00H
   13ac   16 05                 MVI     D,05H
   13ae   29            WFC2S:  DAD     H
   13af   15                    DCR     D
   13b0   c2 ae 13              JNZ     WFC2S                   ; HL = (FSLOT+1)*32
   13b3   11 00 20              LXI     D,DIRBASE
   13b6   19                    DAD     D
   13b7   cd 78 10              CALL    RDSETA
   13ba   21 20 21              LXI     H,FCB2
   13bd   0e 20                 MVI     C,32
   13bf   7e            WFC2B:  MOV     A,M
   13c0   d3 20                 OUT     RDDATA
   13c2   23                    INX     H
   13c3   0d                    DCR     C
   13c4   c2 bf 13              JNZ     WFC2B
   13c7   c9                    RET
                        
   13c8                 WDIRFCB:
   13c8   3a 51 15              LDA     FSLOT
   13cb   6f                    MOV     L,A
   13cc   26 00                 MVI     H,00H
   13ce   16 05                 MVI     D,05H
   13d0   29            WDFS:   DAD     H
   13d1   15                    DCR     D
   13d2   c2 d0 13              JNZ     WDFS                    ; HL = FSLOT*32
   13d5   11 00 20              LXI     D,DIRBASE
   13d8   19                    DAD     D
   13d9   cd 78 10              CALL    RDSETA
   13dc   21 00 21              LXI     H,FCB
   13df   0e 20                 MVI     C,32
   13e1   7e            WDF:    MOV     A,M
   13e2   d3 20                 OUT     RDDATA
   13e4   23                    INX     H
   13e5   0d                    DCR     C
   13e6   c2 e1 13              JNZ     WDF
   13e9   c9                    RET
                        
   13ea                 SETALLO:
   13ea   3a 0f 21              LDA     FCB+15
   13ed   b7                    ORA     A
   13ee   c8                    RZ                              ; RC=0 -> no blocks to allocate
   13ef   c6 07                 ADI     07H
   13f1   0f                    RRC
   13f2   0f                    RRC
   13f3   0f                    RRC
   13f4   e6 1f                 ANI     1FH
   13f6   47                    MOV     B,A
   13f7   21 10 21              LXI     H,FCB+16
   13fa   3a 55 15              LDA     BLKNO                   ; first free data block
   13fd   77            SA1:    MOV     M,A
   13fe   23                    INX     H
   13ff   3c                    INR     A
   1400   05                    DCR     B
   1401   c2 fd 13              JNZ     SA1
   1404   c9                    RET
                        
   1405                 SETALLO2:
   1405   3a 2f 21              LDA     FCB2+15
   1408   b7                    ORA     A
   1409   c8                    RZ                              ; RC=0 -> no blocks to allocate
   140a   c6 07                 ADI     07H
   140c   0f                    RRC
   140d   0f                    RRC
   140e   0f                    RRC
   140f   e6 1f                 ANI     1FH
   1411   47                    MOV     B,A
   1412   21 30 21              LXI     H,FCB2+16
   1415   3a 55 15              LDA     BLKNO
   1418   c6 10                 ADI     10H                     ; extent 1 starts at BLKNO + 16 (10H), NOT 16H(22)
   141a   77            SA21:   MOV     M,A
   141b   23                    INX     H
   141c   3c                    INR     A
   141d   05                    DCR     B
   141e   c2 1a 14              JNZ     SA21
   1421   c9                    RET
                        
                        ; ============================================================================
                        ; READNAME -- read "name.ext" (max 9 chars) from console into FNAME, echoing.
                        ; ============================================================================
   1422                 READNAME:
   1422   21 80 21              LXI     H,FNAME
   1425   06 0c                 MVI     B,12
   1427   cd 0f 10      RN1:    CALL    RXCHAR
   142a   fe 0d                 CPI     0DH
   142c   ca 6b 14              JZ      RN_DONE
   142f   fe 08                 CPI     08H                     ; ^H backspace
   1431   ca 51 14              JZ      RN_BS
   1434   fe 7f                 CPI     7FH                     ; DEL backspace
   1436   ca 51 14              JZ      RN_BS
                                ; coerce lowercase a-z to A-Z so the name always matches CP/M's
                                ; uppercase convention (else files with lowercase names are stored but
                                ; DIR/save lookups that uppercase won't find them)
   1439   fe 61                 CPI     'a'
   143b   da 45 14              JC      RN_STORE
   143e   fe 7b                 CPI     'z'+1
   1440   d2 45 14              JNC     RN_STORE
   1443   d6 20                 SUI     20H                     ; 'a'->'A'
   1445                 RN_STORE:
   1445   77                    MOV     M,A
   1446   cd 03 10              CALL    TXCHAR                  ; ECHO the (upper-cased) char
   1449   23                    INX     H
   144a   05                    DCR     B
   144b   c2 27 14              JNZ     RN1
   144e   c3 6b 14              JMP     RN_DONE
   1451                 RN_BS:  ; backspace: erase from the screen and back the buffer up (if possible)
   1451   3e 08                 MVI     A,08H
   1453   cd 03 10              CALL    TXCHAR
   1456   3e 20                 MVI     A,20H
   1458   cd 03 10              CALL    TXCHAR
   145b   3e 08                 MVI     A,08H
   145d   cd 03 10              CALL    TXCHAR
   1460   78                    MOV     A,B
   1461   fe 09                 CPI     9
   1463   ca 27 14              JZ      RN1                     ; buffer full, at start -> nothing to back up
   1466   2b                    DCX     H
   1467   04                    INR     B
   1468   c3 27 14              JMP     RN1
   146b   3e 00         RN_DONE: MVI     A,00H
   146d   77                    MOV     M,A                     ; NUL terminate
   146e   cd 39 10              CALL    CRLF
   1471   c9                    RET
                        
                        ; ============================================================================
                        ; BUILD_FCB -- parse FNAME into the 32-byte FCB (and copy into FCB2).
                        ; ============================================================================
   1472                 BUILD_FCB:
   1472   21 00 21              LXI     H,FCB
   1475   06 40                 MVI     B,64                    ; zero both FCBs (2 x 32)
   1477   3e 00         BF_Z:   MVI     A,00H
   1479   77                    MOV     M,A
   147a   23                    INX     H
   147b   05                    DCR     B
   147c   c2 77 14              JNZ     BF_Z
   147f   11 80 21              LXI     D,FNAME
   1482   21 01 21              LXI     H,FCB+1
   1485   06 08                 MVI     B,8
   1487   1a            BF_N:   LDAX    D
   1488   fe 00                 CPI     00H
   148a   ca a3 14              JZ      BF_NPAD
   148d   fe 2e                 CPI     '.'
   148f   ca a3 14              JZ      BF_GOTEXT
   1492   77                    MOV     M,A
   1493   23                    INX     H
   1494   13                    INX     D
   1495   05                    DCR     B
   1496   c2 87 14              JNZ     BF_N
   1499   1a                    LDAX    D
   149a   fe 2e                 CPI     '.'
   149c   c2 d2 14              JNZ     BF_EXT0
   149f   13                    INX     D
   14a0   c3 ac 14              JMP     BF_EXT
   14a3                 BF_GOTEXT:
   14a3   3e 20         BF_NPAD: MVI     A,' '
   14a5   77                    MOV     M,A
   14a6   23                    INX     H
   14a7   05                    DCR     B
   14a8   c2 a3 14              JNZ     BF_NPAD
   14ab   13                    INX     D                       ; skip '.'
   14ac   21 09 21      BF_EXT: LXI     H,FCB+9
   14af   06 03                 MVI     B,3
   14b1   1a            BF_E:   LDAX    D
   14b2   fe 00                 CPI     00H
   14b4   ca ca 14              JZ      BF_EXT_PAD
   14b7   fe 2e                 CPI     '.'
   14b9   ca c6 14              JZ      BF_EXT_SKIP
   14bc   77                    MOV     M,A
   14bd   23                    INX     H
   14be   13                    INX     D
   14bf   05                    DCR     B
   14c0   c2 b1 14              JNZ     BF_E
   14c3   c3 d2 14              JMP     BF_EXT0
   14c6                 BF_EXT_SKIP:
   14c6   13                    INX     D
   14c7   c3 b1 14              JMP     BF_E
   14ca                 BF_EXT_PAD:
   14ca   3e 20                 MVI     A,' '
   14cc   77                    MOV     M,A
   14cd   23                    INX     H
   14ce   05                    DCR     B
   14cf   c2 ca 14              JNZ     BF_EXT_PAD
   14d2                 BF_EXT0:
   14d2   21 00 21              LXI     H,FCB
   14d5   36 00                 MVI     M,00H                   ; dir entry byte0 = USER number (0), not drive
   14d7   21 00 21              LXI     H,FCB
   14da   11 20 21              LXI     D,FCB2
   14dd   06 20                 MVI     B,32
   14df   7e            BF_C:   MOV     A,M
   14e0   12                    STAX    D
   14e1   23                    INX     H
   14e2   13                    INX     D
   14e3   05                    DCR     B
   14e4   c2 df 14              JNZ     BF_C
   14e7   c9                    RET
                        
                        ; ============================================================================
                        ; DO_BOOTCPM -- receive the CP/M system image (CCP+BDOS+CBIOS, the combined
                        ;   brevia2_cpm binary) via XMODEM into MACHINE RAM at 0xE400, then cold-boot
                        ;   CP/M by jumping to the CBIOS cold-boot entry (0xFA00). The CBIOS persists
                        ;   CCP/BDOS to the RAM-disk system tracks and enters the CCP, so we reuse the
                        ;   proven boot path instead of duplicating it.
                        ;   Transfers into bank A via XMBUF, then copies each block to machine RAM.
                        ; ============================================================================
   14e8                 DO_BOOTCPM:
   14e8   21 f1 19              LXI     H,MSGBCPM
   14eb   cd 58 10              CALL    PRTSTR
   14ee   21 00 e4              LXI     H,0E400H                ; load CCP at 0xE400 (image is contiguous)
   14f1   22 4f 15              SHLD    BCPADDR
   14f4   21 79 19              LXI     H,MSGRECV
   14f7   cd 58 10              CALL    PRTSTR
   14fa   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   14fc   cd 03 10              CALL    TXCHAR
   14ff   cd 1a 12      BCPLOOP: CALL    GETBLK                  ; A=TO,01 good,FF bad,00 EOT,02 CAN
   1502   fe fe                 CPI     XM_TO
   1504   ca 36 15              JZ      BCP_NAK                 ; timeout -> resend NAK
   1507   fe 02                 CPI     02H
   1509   ca 36 15              JZ      BCP_NAK                 ; CAN
   150c   fe 00                 CPI     00H
   150e   ca 3e 15              JZ      BCP_EOT
   1511   fe ff                 CPI     0FFH
   1513   ca 36 15              JZ      BCP_NAK                 ; bad block -> NAK
                                ; good block -> copy XMBUF to machine RAM at BCPADDR, advance by 128
   1516   2a 4f 15              LHLD    BCPADDR
   1519   11 00 20              LXI     D,XMBUF
   151c   0e 80                 MVI     C,128
   151e   1a            BCPC:   LDAX    D
   151f   77                    MOV     M,A
   1520   13                    INX     D
   1521   23                    INX     H
   1522   0d                    DCR     C
   1523   c2 1e 15              JNZ     BCPC
   1526   22 4f 15              SHLD    BCPADDR                 ; advance for the next block
   1529   3e 06                 MVI     A,XM_ACK
   152b   cd 03 10              CALL    TXCHAR
   152e   3e 2e                 MVI     A,'.'
   1530   cd 03 10              CALL    TXCHAR
   1533   c3 ff 14              JMP     BCPLOOP
   1536   3e 15         BCP_NAK: MVI     A,XM_NAK
   1538   cd 03 10              CALL    TXCHAR
   153b   c3 ff 14              JMP     BCPLOOP
   153e   3e 06         BCP_EOT: MVI     A,XM_ACK
   1540   cd 03 10              CALL    TXCHAR
   1543   cd 39 10              CALL    CRLF
   1546   21 19 1a              LXI     H,MSGBCPMOK
   1549   cd 58 10              CALL    PRTSTR
   154c   c3 00 fa              JMP     0FA00H                  ; CBIOS cold boot -> enters CCP (A>)
                        
   154f                 BCPADDR: DS     2                        ; machine-RAM load address for the boot image
   1551                 FSLOT:   DS     1               ; directory slot index for the file being written
   1552                 TWOF:    DS     1               ; !=0 -> two-extent file (extents 0 AND 1 slots)
   1553                 FNEED:   DS     1               ; slots needed by FINDFREE (1 = single, 2 = two-extent)
   1554                 NBMAX:   DS     1               ; scratch: highest data block seen during NEXTBLK
   1555                 BLKNO:   DS     1               ; first free data block for the file being written
                        
                        ; ============================================================================
                        ; DO_DUMP -- dump 256 bytes from the RAM disk at a hex address, as hex (16/line).
                        ; ============================================================================
   1556                 DO_DUMP:
   1556   21 ac 19              LXI     H,MSGDUMP
   1559   cd 58 10              CALL    PRTSTR
   155c   cd a3 15              CALL    READHEX                 ; HL = start address
   155f   cd 78 10              CALL    RDSETA
   1562   06 10                 MVI     B,16                    ; 16 lines
   1564   16 10         DUMP_L1: MVI     D,16                    ; 16 bytes per line
   1566   db 20         DUMP_B: IN      RDDATA
   1568   cd 62 10              CALL    PRTBYTE
   156b   3e 20                 MVI     A,' '
   156d   cd 03 10              CALL    TXCHAR
   1570   15                    DCR     D
   1571   c2 66 15              JNZ     DUMP_B
   1574   cd 39 10              CALL    CRLF
   1577   05                    DCR     B
   1578   c2 64 15              JNZ     DUMP_L1
   157b   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_MDUMP -- dump 128 bytes of CPU (bank A) memory at a hex address.
                        ; Runs with the monitor banked out; reads bank A RAM directly. Useful for
                        ; inspecting CBIOS/BDOS variable state AFTER a CP/M session (reset -> G 1000).
                        ; ============================================================================
   157e                 DO_MDUMP:
   157e   21 c9 19              LXI     H,MSGMD
   1581   cd 58 10              CALL    PRTSTR
   1584   cd a3 15              CALL    READHEX                 ; HL = start address
   1587   06 08                 MVI     B,8                     ; 8 lines
   1589   16 10         MD_L1:  MVI     D,16                    ; 16 bytes per line
   158b   7e            MD_B:   MOV     A,M
   158c   cd 62 10              CALL    PRTBYTE
   158f   3e 20                 MVI     A,' '
   1591   cd 03 10              CALL    TXCHAR
   1594   23                    INX     H
   1595   15                    DCR     D
   1596   c2 8b 15              JNZ     MD_B
   1599   cd 39 10              CALL    CRLF
   159c   05                    DCR     B
   159d   c2 89 15              JNZ     MD_L1
   15a0   c3 26 11              JMP     MENU
                        
                        ; ---------------------------------------------------------------------------
                        ; READHEX -- read up to 4 hex digits from the console into HL (echoed).
                        ; ---------------------------------------------------------------------------
   15a3                 READHEX:
   15a3   21 00 00              LXI     H,0000H
   15a6   06 04                 MVI     B,4
   15a8   cd 0f 10      RH1:    CALL    RXCHAR
   15ab   fe 0d                 CPI     0DH
   15ad   ca e4 15              JZ      RH_DONE                 ; Enter ends
                                ; determine hex digit value 0-15 in A
   15b0   fe 30                 CPI     '0'
   15b2   da e8 15              JC      RH_NEXT                 ; < '0' -> ignore
   15b5   fe 3a                 CPI     '9'+1
   15b7   da cb 15              JC      RH_DIG                  ; '0'-'9'
   15ba   e6 df                 ANI     0DFH                    ; uppercase
   15bc   fe 41                 CPI     'A'
   15be   da e8 15              JC      RH_NEXT                 ; < 'A' -> ignore
   15c1   fe 47                 CPI     'F'+1
   15c3   d2 e8 15              JNC     RH_NEXT                 ; > 'F' -> ignore
   15c6   d6 37                 SUI     'A'-10                  ; 'A'-'F' -> 10-15
   15c8   c3 cd 15              JMP     RH_ADD
   15cb   d6 30         RH_DIG: SUI     '0'                     ; '0'-'9' -> 0-9
   15cd   cd 03 10      RH_ADD: CALL    TXCHAR                  ; echo the digit
   15d0   4f                    MOV     C,A                     ; C = digit value
                                ; HL = (HL << 4) | C
   15d1   16 04                 MVI     D,04H
   15d3   7d            RH_SHL: MOV     A,L
   15d4   87                    ADD     A
   15d5   6f                    MOV     L,A
   15d6   7c                    MOV     A,H
   15d7   17                    RAL
   15d8   67                    MOV     H,A
   15d9   15                    DCR     D
   15da   c2 d3 15              JNZ     RH_SHL
   15dd   7d                    MOV     A,L
   15de   b1                    ORA     C
   15df   6f                    MOV     L,A
   15e0   05                    DCR     B
   15e1   c2 a8 15              JNZ     RH1
   15e4                 RH_DONE:
   15e4   cd 39 10              CALL    CRLF
   15e7   c9                    RET
   15e8   c3 a8 15      RH_NEXT: JMP     RH1
                        
                        ; ============================================================================
                        ; --- ISSI IS25LP040E serial-flash routines (SPI) ---------------------------
                        ; Ports: SPI_DATA(0x50) read clocks a byte in / write clocks a byte out (MSB
                        ;        first); SPI_CTL(0x51) bit0 = CS# (0=select low, 1=release high);
                        ;        SPI_STAT(0x52) bit0 = transfer busy. The byte engine stretches the
                        ;        CPU wait state during every 0x50 access, so back-to-back 0x50
                        ;        accesses complete within the access -- a busy poll on 0x52 is OPTIONAL.
                        ; The flash is a 512 KB ISSI IS25LP040E: 128 x 4KB sectors, 256-byte pages,
                        ; byte-granular program that only CLEARS 1->0. Restoring a bit to 1 requires
                        ; erasing its whole 4KB sector (to 0xFF) first, so ERASE-BEFORE-WRITE is
                        ; mandatory unless writing into known-erased 0xFF regions.
                        ; ============================================================================
                        ; ---------------- SPI physical helpers ----------------
   15eb   3e 00         SPI_SEL: MVI     A,00H
   15ed   d3 51                  OUT     SPI_CTL                 ; CS# low -> select the flash
   15ef   c9                     RET
   15f0   3e 01         SPI_REL: MVI     A,01H
   15f2   d3 51                  OUT     SPI_CTL                 ; CS# high -> release the flash
   15f4   c9                     RET
                        
                        ; SPI_XMIT: clock the byte in A out to the flash; returned byte discarded.
   15f5   d3 50         SPI_XMIT: OUT     SPI_DATA
   15f7   c9                     RET
                        
                        ; SPI_WAIT: poll RDSR until WIP (status bit0) clears. Re-selects the flash,
                        ; sends the RDSR opcode, and keeps reading the status while CS# is low.
   15f8   cd eb 15      SPI_WAIT: CALL    SPI_SEL
   15fb   3e 05                  MVI     A,05H
   15fd   cd f5 15               CALL    SPI_XMIT                ; RDSR opcode
   1600   db 50         SPW:     IN      SPI_DATA                ; read status byte
   1602   e6 01                  ANI     01H                     ; WIP (bit0)?
   1604   c2 00 16               JNZ     SPW                     ; still busy -> keep polling
   1607   cd f0 15               CALL    SPI_REL
   160a   c9                     RET
                        
                        ; SPI_PROGBYTE: program ONE byte (in A) at the address in HL (the A23-A16
                        ; address byte is taken as 0 -- this utility only uses the <=64K flash region).
                        ; Uses the per-byte 0x02 Byte Program; issues WREN first (required before every
                        ; program). Clobbers A and C only (spares B/D/E/H/L across the call).
   160b                 SPI_PROGBYTE:
   160b   4f                     MOV     C,A                     ; park the data byte
   160c   cd eb 15               CALL    SPI_SEL
   160f   3e 06                  MVI     A,06H
   1611   cd f5 15               CALL    SPI_XMIT                ; WREN
   1614   cd f0 15               CALL    SPI_REL                 ; latch WREN (CS# must toggle)
   1617   cd eb 15               CALL    SPI_SEL
   161a   3e 02                  MVI     A,02H
   161c   cd f5 15               CALL    SPI_XMIT                ; Byte Program opcode
   161f   3e 00                  MVI     A,00H
   1621   cd f5 15               CALL    SPI_XMIT                ; A23-A16 = 0
   1624   7c                     MOV     A,H
   1625   cd f5 15               CALL    SPI_XMIT                ; A15-A8
   1628   7d                     MOV     A,L
   1629   cd f5 15               CALL    SPI_XMIT                ; A7-A0
   162c   79                     MOV     A,C
   162d   cd f5 15               CALL    SPI_XMIT                ; data byte -> flash programs it
   1630   cd f0 15               CALL    SPI_REL
   1633   cd f8 15               CALL    SPI_WAIT                ; wait for WIP to clear
   1636   c9                     RET
                        
                        ; SPI_ERASE_SECT0: WREN + Sector Erase (0x20) of the 4KB sector at 0x000000
                        ; (the sector containing the test / flash-layout region). Then wait WIP.
   1637                 SPI_ERASE_SECT0:
   1637   cd eb 15               CALL    SPI_SEL
   163a   3e 06                  MVI     A,06H
   163c   cd f5 15               CALL    SPI_XMIT                ; WREN
   163f   cd f0 15               CALL    SPI_REL
   1642   cd eb 15               CALL    SPI_SEL
   1645   3e 20                  MVI     A,20H
   1647   cd f5 15               CALL    SPI_XMIT                ; Sector Erase 4KB opcode
   164a   3e 00                  MVI     A,00H
   164c   cd f5 15               CALL    SPI_XMIT                ; A23-A16
   164f   3e 00                  MVI     A,00H
   1651   cd f5 15               CALL    SPI_XMIT                ; A15-A8
   1654   3e 00                  MVI     A,00H
   1656   cd f5 15               CALL    SPI_XMIT                ; A7-A0 -> sector 0
   1659   cd f0 15               CALL    SPI_REL
   165c   cd f8 15               CALL    SPI_WAIT
   165f   c9                     RET
                        
                        ; ---------------- command: read JEDEC ID ----------------
   1660   21 61 1a      DO_ID:   LXI     H,MSGID
   1663   cd 58 10               CALL    PRTSTR
   1666   cd eb 15               CALL    SPI_SEL
   1669   3e 9f                  MVI     A,09FH
   166b   cd f5 15               CALL    SPI_XMIT                ; JEDEC ID opcode (0x9F)
   166e   db 50                  IN      SPI_DATA                ; manufacturer id (MUST be 0xBF)
   1670   47                     MOV     B,A
   1671   db 50                  IN      SPI_DATA                ; device id byte 1
   1673   4f                     MOV     C,A
   1674   db 50                  IN      SPI_DATA                ; device id byte 2
   1676   57                     MOV     D,A
   1677   cd f0 15               CALL    SPI_REL
   167a   21 7d 1a               LXI     H,MSGIDVAL
   167d   cd 58 10               CALL    PRTSTR
   1680   78                     MOV     A,B
   1681   cd 62 10               CALL    PRTBYTE
   1684   3e 20                  MVI     A,' '
   1686   cd 03 10               CALL    TXCHAR
   1689   79                     MOV     A,C
   168a   cd 62 10               CALL    PRTBYTE
   168d   3e 20                  MVI     A,' '
   168f   cd 03 10               CALL    TXCHAR
   1692   7a                     MOV     A,D
   1693   cd 62 10               CALL    PRTBYTE
   1696   cd 39 10               CALL    CRLF
   1699   3e 9d                  MVI     A,09DH                 ; ISSI (IS25LP040E) manufacturer ID
   169b   b8                     CMP     B
   169c   c2 a8 16               JNZ     ID_FAIL
   169f   21 0e 1c               LXI     H,MSGPASS
   16a2   cd 58 10               CALL    PRTSTR
   16a5   c3 26 11               JMP     MENU
   16a8   21 15 1c      ID_FAIL: LXI     H,MSGFAIL
   16ab   cd 58 10               CALL    PRTSTR
   16ae   c3 26 11               JMP     MENU
                        
                        ; ---------------- command: program a test pattern ----------------
   16b1                 DO_PROGRAM:
   16b1   21 82 1a               LXI     H,MSGPROG
   16b4   cd 58 10               CALL    PRTSTR
   16b7   cd 37 16               CALL    SPI_ERASE_SECT0         ; known-erased 4KB sector at 0x000000
                                 ; build the 16-byte test pattern 00,01,...,0F into F_PAT
   16ba   21 00 22               LXI     H,F_PAT
   16bd   3e 00                  MVI     A,00H
   16bf   06 10                  MVI     B,16
   16c1   77            PGBLD:   MOV     M,A
   16c2   3c                     INR     A
   16c3   23                     INX     H
   16c4   05                     DCR     B
   16c5   c2 c1 16               JNZ     PGBLD
                                 ; program the pattern at flash 0x000000
   16c8   21 00 00               LXI     H,0000H                 ; target address (A23-A16 = 0)
   16cb   11 00 22               LXI     D,F_PAT                 ; pattern source
   16ce   06 10                  MVI     B,16
   16d0   1a            PGLOOP:  LDAX    D                       ; pattern byte
   16d1   cd 0b 16               CALL    SPI_PROGBYTE
   16d4   23                     INX     H
   16d5   13                     INX     D
   16d6   05                     DCR     B
   16d7   c2 d0 16               JNZ     PGLOOP
   16da   21 c1 1a               LXI     H,MSGPROGOK
   16dd   cd 58 10               CALL    PRTSTR
   16e0   c3 26 11               JMP     MENU
                        
                        ; ---------------- command: raw read-back + dump + verify ----------------
   16e3                 DO_READ:
   16e3   21 e2 1a               LXI     H,MSGREAD
   16e6   cd 58 10               CALL    PRTSTR
                                 ; read 16 bytes at flash 0x000000 into F_RD
   16e9   cd eb 15               CALL    SPI_SEL
   16ec   3e 03                  MVI     A,03H
   16ee   cd f5 15               CALL    SPI_XMIT                ; Read opcode (0x03)
   16f1   3e 00                  MVI     A,00H
   16f3   cd f5 15               CALL    SPI_XMIT                ; A23-A16
   16f6   3e 00                  MVI     A,00H
   16f8   cd f5 15               CALL    SPI_XMIT                ; A15-A8
   16fb   3e 00                  MVI     A,00H
   16fd   cd f5 15               CALL    SPI_XMIT                ; A7-A0
   1700   21 10 22               LXI     H,F_RD
   1703   06 10                  MVI     B,16
   1705   db 50         RDLP:    IN      SPI_DATA                ; next byte the flash drives out
   1707   77                     MOV     M,A
   1708   23                     INX     H
   1709   05                     DCR     B
   170a   c2 05 17               JNZ     RDLP
   170d   cd f0 15               CALL    SPI_REL
   1710   21 05 1b               LXI     H,MSGDATA
   1713   cd 58 10               CALL    PRTSTR
   1716   21 10 22               LXI     H,F_RD
   1719   06 10                  MVI     B,16
   171b   7e            RDDMP:   MOV     A,M
   171c   cd 62 10               CALL    PRTBYTE
   171f   3e 20                  MVI     A,' '
   1721   cd 03 10               CALL    TXCHAR
   1724   23                     INX     H
   1725   05                     DCR     B
   1726   c2 1b 17               JNZ     RDDMP
   1729   cd 39 10               CALL    CRLF
                                 ; verify against F_PAT
   172c   21 10 22               LXI     H,F_RD
   172f   11 00 22               LXI     D,F_PAT
   1732   06 10                  MVI     B,16
   1734   1a            RDCMP:   LDAX    D
   1735   be                     CMP     M
   1736   c2 4e 17               JNZ     RD_FAIL
   1739   23                     INX     H
   173a   13                     INX     D
   173b   05                     DCR     B
   173c   c2 34 17               JNZ     RDCMP
   173f   21 0c 1b               LXI     H,MSGREADOK
   1742   cd 58 10               CALL    PRTSTR
   1745   21 0e 1c               LXI     H,MSGPASS
   1748   cd 58 10               CALL    PRTSTR
   174b   c3 26 11               JMP     MENU
   174e   21 34 1b      RD_FAIL: LXI     H,MSGREADFAIL
   1751   cd 58 10               CALL    PRTSTR
   1754   21 15 1c               LXI     H,MSGFAIL
   1757   cd 58 10               CALL    PRTSTR
   175a   c3 26 11               JMP     MENU
                        
                        ; ---------------- command: erase sector + verify ----------------
   175d                 DO_ERASE:
   175d   21 4a 1b               LXI     H,MSGERS
   1760   cd 58 10               CALL    PRTSTR
   1763   cd 37 16               CALL    SPI_ERASE_SECT0
                                 ; read the 4KB sector (0x000000-0x000FFF) and confirm it is all 0xFF
   1766   cd eb 15               CALL    SPI_SEL
   1769   3e 03                  MVI     A,03H
   176b   cd f5 15               CALL    SPI_XMIT                ; Read opcode
   176e   3e 00                  MVI     A,00H
   1770   cd f5 15               CALL    SPI_XMIT                ; A23-A16
   1773   3e 00                  MVI     A,00H
   1775   cd f5 15               CALL    SPI_XMIT                ; A15-A8
   1778   3e 00                  MVI     A,00H
   177a   cd f5 15               CALL    SPI_XMIT                ; A7-A0
   177d   01 00 10               LXI     B,1000H                 ; 4096 bytes
   1780   db 50         ERCHK:   IN      SPI_DATA
   1782   fe ff                  CPI     0FFH
   1784   c2 9f 17               JNZ     ER_FAIL
   1787   0b                     DCX     B
   1788   78                     MOV     A,B
   1789   b1                     ORA     C
   178a   c2 80 17               JNZ     ERCHK
   178d   cd f0 15               CALL    SPI_REL
   1790   21 6e 1b               LXI     H,MSGERROK
   1793   cd 58 10               CALL    PRTSTR
   1796   21 0e 1c               LXI     H,MSGPASS
   1799   cd 58 10               CALL    PRTSTR
   179c   c3 26 11               JMP     MENU
   179f   cd f0 15      ER_FAIL: CALL    SPI_REL
   17a2   21 92 1b               LXI     H,MSGERFAIL
   17a5   cd 58 10               CALL    PRTSTR
   17a8   21 15 1c               LXI     H,MSGFAIL
   17ab   cd 58 10               CALL    PRTSTR
   17ae   c3 26 11               JMP     MENU
                        
                        ; ---------------- command: format the flash as a CP/M data disk ----------------
                        ; Flash byte-layout (documented here so the later CBIOS drive B: work reuses it).
                        ;   Offset 0x0000 - 0x07FF : Directory area (2K = 64 CP/M directory entries of
                        ;                            32 bytes each), populated with 0xE5 (the CP/M
                        ;                            empty-directory-entry marker).
                        ;   Offset 0x0800 - 0x3FFFF: Data area (247.5K), left erased (0xFF).
                        ;   Blocks are 1K; records are 128 bytes. This mirrors the RAM-disk drive A:
                        ;   layout (DIRBASE=2000H, 1K blocks) scaled onto the 512KB flash, so the CBIOS
                        ;   can reuse the same directory/block arithmetic for drive B:.
   17b1                 DO_FMTFLASH:
   17b1   21 b6 1b               LXI     H,MSGFMTFL
   17b4   cd 58 10               CALL    PRTSTR
                                 ; 1) erase the whole chip to 0xFF (clears the data area)
   17b7   cd eb 15               CALL    SPI_SEL
   17ba   3e 06                  MVI     A,06H
   17bc   cd f5 15               CALL    SPI_XMIT                ; WREN
   17bf   cd f0 15               CALL    SPI_REL
   17c2   cd eb 15               CALL    SPI_SEL
   17c5   3e 60                  MVI     A,60H
   17c7   cd f5 15               CALL    SPI_XMIT                ; Chip Erase opcode (0x60, no address)
   17ca   cd f0 15               CALL    SPI_REL
   17cd   cd f8 15               CALL    SPI_WAIT
                                 ; 2) program 0xE5 across the 2K directory area (0x0000-0x07FF)
   17d0   21 00 00               LXI     H,0000H                 ; directory area base
   17d3   01 00 08               LXI     B,0800H                 ; 2048 bytes
   17d6   c5            FMTL:    PUSH    B                       ; SPI_PROGBYTE clobbers C (the count low)
   17d7   3e e5                  MVI     A,0E5H
   17d9   cd 0b 16               CALL    SPI_PROGBYTE
   17dc   c1                     POP     B
   17dd   23                     INX     H
   17de   0b                     DCX     B
   17df   78                     MOV     A,B
   17e0   b1                     ORA     C
   17e1   c2 d6 17               JNZ     FMTL
   17e4   21 fb 1b               LXI     H,MSGFMTFOK
   17e7   cd 58 10               CALL    PRTSTR
   17ea   c3 26 11               JMP     MENU
                        
