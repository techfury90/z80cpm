    (PADDO => sramdata0) = (0:0:0,0:0:0);
    (sramdata0 => PADDI) = (0:0:0,0:0:0);
    $width (posedge sramdata0, 0:0:0);
    $width (negedge sramdata0, 0:0:0);
  endspecify

endmodule

module ec2iobuf ( input I, T, output Z, PAD, input PADI );

  IBPU INST1( .I(PADI), .O(Z));
  OBZPU INST2( .I(I), .T(T), .O(PAD));
endmodule

