                        ; SDTOOL.COM -- Brevia2 SD card partition / format / test tool for CP/M 2.2.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port (pins 31/32/35/36):
                        ;   IN  0x53 = SD SPI data (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl  bit0 = CS# (0 select, 1 release); bit1 = slow clock
                        ;   IN  0x55 = SD SPI status bit0 = busy
                        ;
                        ; Commands:
                        ;   I -- init + info: card type, CID (manufacturer/product/serial), test read.
                        ;   P -- read the MBR (block 0) and print the partition table.
                        ;   C -- create an MBR with one CP/M partition (type 0x53) and write block 0.
                        ;   F -- format the CP/M partition: write the directory area to 0xE5.
                        ;   Q -- quit.
                        ;
                        ; The SD CP/M partition geometry (MUST match the CBIOS DPB):
                        ;   128-byte records, SPT=32, 2KB allocation blocks (BSH=4/BLM=15),
                        ;   DRM=127 (128 directory entries = 4096 bytes = 2 blocks, reserved via
                        ;   AL0=0xC0), CKS=0, OFF=0 (data partition, no system tracks).  The directory
                        ;   occupies the first 4KB (8 x 512B SD sectors) of the partition and is the
                        ;   only thing a format must write (the BDOS rebuilds the allocation vector on
                        ;   login).  Partition 1 starts at LBA 1, size 0x00020000 sectors (64 MB).
                        ;
                        ; NOTE on BDOS register clobbering: every console-call loop preserves B/HL
                        ; across CPUTC/func-2 with PUSH/POP (func 2 destroys B and HL on this CBIOS).
   0100                         ORG     0100H
                        
                        ; ---------------- constants ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   0020                 SPT     EQU     32              ; sectors (128B) per track  [geometry]
   0004                 BSH     EQU     4               ; 2KB allocation blocks
   000f                 BLM     EQU     15
   0001                 EXM     EQU     1
   007f                 DRM     EQU     127             ; 128 directory entries
   00c0                 AL0V    EQU     0C0H            ; reserve directory blocks 0,1
   0000                 AL1V    EQU     00H
                        
   0053                 PMTYPE  EQU     53H             ; CP/M partition type (no standard MBR type exists)
   0001                 PARTLBA0 EQU    01H             ; partition 1 LBA start = 1 (LE byte 0)
   0000                 PARTSEC0 EQU    00H             ; partition size = 0x00020000 (LE: 00 00 02 00)
   0000                 PARTSEC1 EQU    00H
   0002                 PARTSEC2 EQU    02H
   0000                 PARTSEC3 EQU    00H
                        
   0100                 START:
   0100   21 47 06              LXI     H,BANNER
   0103   cd c7 05              CALL    PSTR
                        
   0106                 MAINLOOP:
   0106   1e 3e                 MVI     E,'>'
   0108   cd cf 05              CALL    CPUTC
   010b   cd d5 05              CALL    CIN             ; A = command char (echoed by func1)
                                ; fold lower-case a-z -> upper
   010e   fe 61                 CPI     'a'
   0110   da 1a 01              JC      ML1
   0113   fe 7b                 CPI     7BH
   0115   d2 1a 01              JNC     ML1
   0118   d6 20                 SUI     20H
   011a                 ML1:
   011a   fe 49                 CPI     'I'
   011c   c2 25 01              JNZ     ML_P
   011f   cd 55 01              CALL    CMD_INFO
   0122   c3 06 01              JMP     MAINLOOP
   0125                 ML_P:
   0125   fe 50                 CPI     'P'
   0127   c2 30 01              JNZ     ML_C
   012a   cd 01 02              CALL    CMD_PART
   012d   c3 06 01              JMP     MAINLOOP
   0130                 ML_C:
   0130   fe 43                 CPI     'C'
   0132   c2 3b 01              JNZ     ML_F
   0135   cd 9e 02              CALL    CMD_CREATE
   0138   c3 06 01              JMP     MAINLOOP
   013b                 ML_F:
   013b   fe 46                 CPI     'F'
   013d   c2 46 01              JNZ     ML_Q
   0140   cd 16 03              CALL    CMD_FORMAT
   0143   c3 06 01              JMP     MAINLOOP
   0146                 ML_Q:
   0146   fe 51                 CPI     'Q'
   0148   c2 4c 01              JNZ     ML_UNK
   014b   c9                    RET                     ; quit to CP/M (returns to the CCP)
   014c                 ML_UNK:
   014c   21 a0 06              LXI     H,MSG_UNK
   014f   cd c7 05              CALL    PSTR
   0152   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- I: init + info ----------------
   0155                 CMD_INFO:
   0155   cd ad 03              CALL    SDINIT
   0158   b7                    ORA     A
   0159   ca 66 01              JZ      CI_OK
   015c   21 a4 06              LXI     H,MSG_NOINIT
   015f   cd c7 05              CALL    PSTR
   0162   cd db 05              CALL    CRLF
   0165   c9                    RET
   0166                 CI_OK:
   0166   21 bc 06              LXI     H,MSG_INITOK
   0169   cd c7 05              CALL    PSTR
   016c   cd db 05              CALL    CRLF
                                ; card type
   016f   cd 5a 05              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0172   b7                    ORA     A
   0173   ca 7f 01              JZ      CI_SC
   0176   21 c4 06              LXI     H,MSG_SDHC
   0179   cd c7 05              CALL    PSTR
   017c   c3 85 01              JMP     CI_AFTTYPE
   017f                 CI_SC:
   017f   21 e9 06              LXI     H,MSG_SDSC
   0182   cd c7 05              CALL    PSTR
   0185                 CI_AFTTYPE:
   0185   cd db 05              CALL    CRLF
                                ; CID
   0188   cd 6d 05              CALL    SD_CID
   018b   b7                    ORA     A
   018c   ca 99 01              JZ      CI_CIDOK
   018f   21 1d 07              LXI     H,MSG_CIDERR
   0192   cd c7 05              CALL    PSTR
   0195   cd db 05              CALL    CRLF
   0198   c9                    RET
   0199                 CI_CIDOK:
   0199   21 08 07              LXI     H,MSG_CID
   019c   cd c7 05              CALL    PSTR
   019f   3a f9 07              LDA     CIDBUF
   01a2   cd e6 05              CALL    PRHEX2
   01a5   1e 20                 MVI     E,' '
   01a7   cd cf 05              CALL    CPUTC
   01aa   21 fc 07              LXI     H,CIDBUF+3
   01ad   06 05                 MVI     B,5
   01af                 CI_NM:
   01af   5e                    MOV     E,M
   01b0   e5                    PUSH    H
   01b1   c5                    PUSH    B
   01b2   cd cf 05              CALL    CPUTC
   01b5   c1                    POP     B
   01b6   e1                    POP     H
   01b7   23                    INX     H
   01b8   05                    DCR     B
   01b9   c2 af 01              JNZ     CI_NM
   01bc   cd db 05              CALL    CRLF
   01bf   21 13 07              LXI     H,MSG_SN
   01c2   cd c7 05              CALL    PSTR
   01c5   3a 02 08              LDA     CIDBUF+9
   01c8   cd e6 05              CALL    PRHEX2
   01cb   3a 03 08              LDA     CIDBUF+10
   01ce   cd e6 05              CALL    PRHEX2
   01d1   3a 04 08              LDA     CIDBUF+11
   01d4   cd e6 05              CALL    PRHEX2
   01d7   3a 05 08              LDA     CIDBUF+12
   01da   cd e6 05              CALL    PRHEX2
   01dd   cd db 05              CALL    CRLF
                                ; test read block 0
   01e0   cd 81 04              CALL    SD_SETBLK0
   01e3   21 09 08              LXI     H,BLKBUF
   01e6   cd 8f 04              CALL    SD_READBLKN
   01e9   b7                    ORA     A
   01ea   c2 f7 01              JNZ     CI_BLKERR
   01ed   21 2f 07              LXI     H,MSG_RDOK
   01f0   cd c7 05              CALL    PSTR
   01f3   cd db 05              CALL    CRLF
   01f6   c9                    RET
   01f7                 CI_BLKERR:
   01f7   21 41 07              LXI     H,MSG_RDERR
   01fa   cd c7 05              CALL    PSTR
   01fd   cd db 05              CALL    CRLF
   0200   c9                    RET
                        
                        ; ---------------- P: show MBR partitions ----------------
   0201                 CMD_PART:
   0201   cd ad 03              CALL    SDINIT
   0204   b7                    ORA     A
   0205   ca 12 02              JZ      CP_OK
   0208   21 a4 06              LXI     H,MSG_NOINIT
   020b   cd c7 05              CALL    PSTR
   020e   cd db 05              CALL    CRLF
   0211   c9                    RET
   0212                 CP_OK:
   0212   cd 81 04              CALL    SD_SETBLK0
   0215   21 09 08              LXI     H,BLKBUF
   0218   cd 8f 04              CALL    SD_READBLKN
   021b   b7                    ORA     A
   021c   ca 29 02              JZ      CP_MBROK
   021f   21 41 07              LXI     H,MSG_RDERR
   0222   cd c7 05              CALL    PSTR
   0225   cd db 05              CALL    CRLF
   0228   c9                    RET
   0229                 CP_MBROK:
                                ; check 55AA
   0229   21 07 0a              LXI     H,BLKBUF+510
   022c   7e                    MOV     A,M
   022d   fe 55                 CPI     55H
   022f   c2 94 02              JNZ     CP_NOMBR
   0232   23                    INX     H
   0233   7e                    MOV     A,M
   0234   fe aa                 CPI     0AAH
   0236   c2 94 02              JNZ     CP_NOMBR
   0239   21 55 07              LXI     H,MSG_MBR
   023c   cd c7 05              CALL    PSTR
   023f   cd db 05              CALL    CRLF
                                ; print 4 partitions
   0242   21 c7 09              LXI     H,BLKBUF+446
   0245   22 e2 07              SHLD    ENTPTR
   0248   16 04                 MVI     D,4
   024a                 CP_LP:
                                ; status (+0)
   024a   2a e2 07              LHLD    ENTPTR
   024d   7e                    MOV     A,M
   024e   cd e6 05              CALL    PRHEX2
   0251   1e 20                 MVI     E,' '
   0253   cd cf 05              CALL    CPUTC
                                ; type (+4)
   0256   2a e2 07              LHLD    ENTPTR
   0259   3e 04                 MVI     A,4
   025b   cd 1c 06              CALL    ADDH
   025e   7e                    MOV     A,M
   025f   cd e6 05              CALL    PRHEX2
   0262   1e 20                 MVI     E,' '
   0264   cd cf 05              CALL    CPUTC
                                ; LBA (+8, 4 bytes LE)
   0267   2a e2 07              LHLD    ENTPTR
   026a   3e 08                 MVI     A,8
   026c   cd 1c 06              CALL    ADDH
   026f   cd 0c 06              CALL    PRHEX32
   0272   1e 20                 MVI     E,' '
   0274   cd cf 05              CALL    CPUTC
                                ; size (+12, 4 bytes LE)
   0277   2a e2 07              LHLD    ENTPTR
   027a   3e 0c                 MVI     A,12
   027c   cd 1c 06              CALL    ADDH
   027f   cd 0c 06              CALL    PRHEX32
   0282   cd db 05              CALL    CRLF
                                ; next entry
   0285   2a e2 07              LHLD    ENTPTR
   0288   01 10 00              LXI     B,16
   028b   09                    DAD     B
   028c   22 e2 07              SHLD    ENTPTR
   028f   15                    DCR     D
   0290   c2 4a 02              JNZ     CP_LP
   0293   c9                    RET
   0294                 CP_NOMBR:
   0294   21 79 07              LXI     H,MSG_NOMBR
   0297   cd c7 05              CALL    PSTR
   029a   cd db 05              CALL    CRLF
   029d   c9                    RET
                        
                        ; ---------------- C: create an MBR with one CP/M partition ----------------
   029e                 CMD_CREATE:
   029e   cd ad 03              CALL    SDINIT
   02a1   b7                    ORA     A
   02a2   ca af 02              JZ      CC_OK
   02a5   21 a4 06              LXI     H,MSG_NOINIT
   02a8   cd c7 05              CALL    PSTR
   02ab   cd db 05              CALL    CRLF
   02ae   c9                    RET
   02af                 CC_OK:
                                ; zero BLKBUF
   02af   21 09 08              LXI     H,BLKBUF
   02b2   06 00                 MVI     B,0
   02b4                 CC_Z:
   02b4   36 00                 MVI     M,0
   02b6   23                    INX     H
   02b7   05                    DCR     B
   02b8   c2 b4 02              JNZ     CC_Z
                                ; partition 1 entry at BLKBUF+446
   02bb   21 c7 09              LXI     H,BLKBUF+446
   02be   36 80                 MVI     M,80H           ; bootable status
   02c0   23                    INX     H
   02c1   36 01                 MVI     M,01H           ; CHS start head
   02c3   23                    INX     H
   02c4   36 01                 MVI     M,01H           ; sector
   02c6   23                    INX     H
   02c7   36 00                 MVI     M,00H           ; cyl
   02c9   23                    INX     H
   02ca   36 53                 MVI     M,PMTYPE        ; type 0x53 (CP/M)
   02cc   23                    INX     H
   02cd   36 ff                 MVI     M,0FFH          ; CHS end head
   02cf   23                    INX     H
   02d0   36 fe                 MVI     M,0FEH          ; sector
   02d2   23                    INX     H
   02d3   36 ff                 MVI     M,0FFH          ; cyl
   02d5   23                    INX     H
   02d6   36 01                 MVI     M,PARTLBA0      ; LBA start LE byte0 = 1
   02d8   23                    INX     H
   02d9   36 00                 MVI     M,00H
   02db   23                    INX     H
   02dc   36 00                 MVI     M,00H
   02de   23                    INX     H
   02df   36 00                 MVI     M,00H
   02e1   23                    INX     H
   02e2   36 00                 MVI     M,PARTSEC0      ; size LE
   02e4   23                    INX     H
   02e5   36 00                 MVI     M,PARTSEC1
   02e7   23                    INX     H
   02e8   36 02                 MVI     M,PARTSEC2
   02ea   23                    INX     H
   02eb   36 00                 MVI     M,PARTSEC3
                                ; signature 55AA
   02ed   21 07 0a              LXI     H,BLKBUF+510
   02f0   36 55                 MVI     M,55H
   02f2   23                    INX     H
   02f3   36 aa                 MVI     M,0AAH
                                ; write block 0
   02f5   cd 81 04              CALL    SD_SETBLK0
   02f8   21 09 08              LXI     H,BLKBUF
   02fb   cd e7 04              CALL    SD_WRITEBLKN
   02fe   b7                    ORA     A
   02ff   ca 0c 03              JZ      CC_WOK
   0302   21 8b 07              LXI     H,MSG_WERR
   0305   cd c7 05              CALL    PSTR
   0308   cd db 05              CALL    CRLF
   030b   c9                    RET
   030c                 CC_WOK:
   030c   21 9a 07              LXI     H,MSG_WROTE
   030f   cd c7 05              CALL    PSTR
   0312   cd db 05              CALL    CRLF
   0315   c9                    RET
                        
                        ; ---------------- F: format the CP/M partition ----------------
   0316                 CMD_FORMAT:
   0316   cd ad 03              CALL    SDINIT
   0319   b7                    ORA     A
   031a   ca 27 03              JZ      CF_OK
   031d   21 a4 06              LXI     H,MSG_NOINIT
   0320   cd c7 05              CALL    PSTR
   0323   cd db 05              CALL    CRLF
   0326   c9                    RET
   0327                 CF_OK:
                                ; read MBR to find partition 1 start
   0327   cd 81 04              CALL    SD_SETBLK0
   032a   21 09 08              LXI     H,BLKBUF
   032d   cd 8f 04              CALL    SD_READBLKN
   0330   b7                    ORA     A
   0331   ca 3e 03              JZ      CF_MBROK
   0334   21 41 07              LXI     H,MSG_RDERR
   0337   cd c7 05              CALL    PSTR
   033a   cd db 05              CALL    CRLF
   033d   c9                    RET
   033e                 CF_MBROK:
   033e   21 07 0a              LXI     H,BLKBUF+510
   0341   7e                    MOV     A,M
   0342   fe 55                 CPI     55H
   0344   c2 67 03              JNZ     CF_RAW
   0347   23                    INX     H
   0348   7e                    MOV     A,M
   0349   fe aa                 CPI     0AAH
   034b   c2 67 03              JNZ     CF_RAW
                                ; partition 1 LBA start at BLKBUF+446+8 (LE, 4 bytes) -> BLKN (MSB first)
   034e   21 cf 09              LXI     H,BLKBUF+446+8
   0351   7e                    MOV     A,M             ; LBA[0] (LSB)
   0352   32 f8 07              STA     BLKN+3
   0355   23                    INX     H
   0356   7e                    MOV     A,M
   0357   32 f7 07              STA     BLKN+2
   035a   23                    INX     H
   035b   7e                    MOV     A,M
   035c   32 f6 07              STA     BLKN+1
   035f   23                    INX     H
   0360   7e                    MOV     A,M
   0361   32 f5 07              STA     BLKN+0
   0364   c3 77 03              JMP     CF_DO
   0367                 CF_RAW:
                                ; no MBR: assume partition starts at LBA 1
   0367   3e 00                 MVI     A,0
   0369   32 f5 07              STA     BLKN+0
   036c   32 f6 07              STA     BLKN+1
   036f   32 f7 07              STA     BLKN+2
   0372   3e 01                 MVI     A,1
   0374   32 f8 07              STA     BLKN+3
   0377                 CF_DO:
                                ; fill BLKBUF (512 bytes) with 0xE5 (directory marker).
                                ; NOTE: use a 16-bit count -- a `MVI B,0; DCR B; JNZ` loop wraps and
                                ; fills only 256 bytes, leaving the upper half of each written sector as
                                ; stale garbage (the old MBR tail), which CP/M reads as phantom dir entries.
   0377   21 09 08              LXI     H,BLKBUF
   037a   01 00 02              LXI     B,512
   037d                 CF_F:
   037d   36 e5                 MVI     M,0E5H
   037f   23                    INX     H
   0380   0b                    DCX     B
   0381   78                    MOV     A,B
   0382   b1                    ORA     C
   0383   c2 7d 03              JNZ     CF_F
                                ; write 8 sectors (4KB = the 2 directory blocks)
   0386   16 08                 MVI     D,8
   0388                 CF_LP:
   0388   21 09 08              LXI     H,BLKBUF
   038b   cd e7 04              CALL    SD_WRITEBLKN
   038e   b7                    ORA     A
   038f   ca 9c 03              JZ      CF_WOK
   0392   21 8b 07              LXI     H,MSG_WERR
   0395   cd c7 05              CALL    PSTR
   0398   cd db 05              CALL    CRLF
   039b   c9                    RET
   039c                 CF_WOK:
   039c   cd a1 05              CALL    INCBLK          ; advance BLKN by 1 sector
   039f   15                    DCR     D
   03a0   c2 88 03              JNZ     CF_LP
   03a3   21 c5 07              LXI     H,MSG_FMT
   03a6   cd c7 05              CALL    PSTR
   03a9   cd db 05              CALL    CRLF
   03ac   c9                    RET
                        
                        ; ---------------- SD driver ----------------
                        ; SDINIT: full init.  A=0 ok / 0FFh fail (same as sdprobe).
   03ad                 SDINIT:
   03ad   af                    XRA     A
   03ae   32 ed 07              STA     ACMDIT
   03b1   32 ee 07              STA     ACMDR1
   03b4   3e 03                 MVI     A,03H           ; CS high + slow
   03b6   d3 54                 OUT     SDCTL
   03b8   06 0a                 MVI     B,10
   03ba                 SDI_CK:
   03ba   3e ff                 MVI     A,0FFH
   03bc   d3 53                 OUT     SDDAT
   03be   05                    DCR     B
   03bf   c2 ba 03              JNZ     SDI_CK
   03c2   3e 02                 MVI     A,02H           ; select + slow
   03c4   d3 54                 OUT     SDCTL
                                ; CMD0 + capture raw
   03c6   21 23 06              LXI     H,CMD0
   03c9   06 06                 MVI     B,6
   03cb                 SDI_TX:
   03cb   7e                    MOV     A,M
   03cc   d3 53                 OUT     SDDAT
   03ce   23                    INX     H
   03cf   05                    DCR     B
   03d0   c2 cb 03              JNZ     SDI_TX
   03d3   21 e5 07              LXI     H,RBUF
   03d6   06 08                 MVI     B,8
   03d8                 SDI_RX:
   03d8   db 53                 IN      SDDAT
   03da   77                    MOV     M,A
   03db   23                    INX     H
   03dc   05                    DCR     B
   03dd   c2 d8 03              JNZ     SDI_RX
                                ; find first non-FF = R1
   03e0   21 e5 07              LXI     H,RBUF
   03e3   06 08                 MVI     B,8
   03e5                 SDI_FR1:
   03e5   7e                    MOV     A,M
   03e6   fe ff                 CPI     0FFH
   03e8   c2 f5 03              JNZ     SDI_HAVE
   03eb   23                    INX     H
   03ec   05                    DCR     B
   03ed   c2 e5 03              JNZ     SDI_FR1
   03f0   3e ff                 MVI     A,0FFH
   03f2   c3 f6 03              JMP     SDI_ST1
   03f5                 SDI_HAVE:
   03f5   7e                    MOV     A,M
   03f6                 SDI_ST1:
   03f6   32 e4 07              STA     CMDR1
   03f9   fe 01                 CPI     01H
   03fb   c2 26 04              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) required before ACMD41 on SDHC
   03fe   21 29 06              LXI     H,CMD8
   0401   cd 49 04              CALL    SD_SEND6
   0404   db 53                 IN      SDDAT
   0406   db 53                 IN      SDDAT
   0408   db 53                 IN      SDDAT
   040a   db 53                 IN      SDDAT
                                ; ACMD41 poll
   040c   16 c8                 MVI     D,200
   040e                 SDI_RDY:
   040e   21 2f 06              LXI     H,CMD55
   0411   cd 49 04              CALL    SD_SEND6
   0414   21 35 06              LXI     H,ACMD41
   0417   cd 49 04              CALL    SD_SEND6
   041a   fe 00                 CPI     00H
   041c   ca 29 04              JZ      SDI_OK
   041f   cd 77 04              CALL    DELAYMS
   0422   15                    DCR     D
   0423   c2 0e 04              JNZ     SDI_RDY
   0426                 SDI_FAIL:
   0426   3e ff                 MVI     A,0FFH
   0428   c9                    RET
   0429                 SDI_OK:
   0429   3e 00                 MVI     A,00H
   042b   c9                    RET
                        
                        ; SD_READY: clock 0FFh until the card is NOT busy (MISO high).  A card still
                        ;   programming drives MISO LOW (reads 00h); issuing a command then makes
                        ;   SD_SEND6 accept that 00h as "R1 = OK" and drop the command, desyncing the
                        ;   stream -- the cause of a write that silently no-ops and of 'F' needing a
                        ;   second pass.  Timeout ~260k reads (~0.4 s at 25 MHz).
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   042c                 SD_READY:
   042c   d5                    PUSH    D
   042d   16 04                 MVI     D,04H
   042f                 SDRDY0:
   042f   01 00 00              LXI     B,0000H
   0432                 SDRDY1:
   0432   db 53                 IN      SDDAT
   0434   fe ff                 CPI     0FFH
   0436   ca 46 04              JZ      SDRDY_OK
   0439   0b                    DCX     B
   043a   78                    MOV     A,B
   043b   b1                    ORA     C
   043c   c2 32 04              JNZ     SDRDY1
   043f   15                    DCR     D
   0440   c2 2f 04              JNZ     SDRDY0
   0443   d1                    POP     D
   0444   37                    STC
   0445   c9                    RET
   0446                 SDRDY_OK:
   0446   d1                    POP     D
   0447   af                    XRA     A
   0448   c9                    RET
                        
                        ; SD_SEND6: send 6-byte command at (HL), read R1.  A = R1 (0FFh = none).
   0449                 SD_SEND6:
   0449   e5                    PUSH    H
   044a   cd 2c 04              CALL    SD_READY        ; never issue a command into a busy card
   044d   e1                    POP     H
   044e   06 06                 MVI     B,6
   0450                 SD6_TX:
   0450   7e                    MOV     A,M
   0451   d3 53                 OUT     SDDAT
   0453   23                    INX     H
   0454   05                    DCR     B
   0455   c2 50 04              JNZ     SD6_TX
   0458   06 10                 MVI     B,16
   045a                 SD6_RX:
   045a   db 53                 IN      SDDAT
   045c   fe ff                 CPI     0FFH
   045e   c2 65 04              JNZ     SD6_DONE
   0461   05                    DCR     B
   0462   c2 5a 04              JNZ     SD6_RX
   0465                 SD6_DONE:
   0465   c9                    RET
                        
                        ; SD_WAITTKN: clock until 0FEh token.  CY=0 + A=0FEh ok, else CY=1.
   0466                 SD_WAITTKN:
   0466   06 ff                 MVI     B,0FFH
   0468                 SD_WT:
   0468   db 53                 IN      SDDAT
   046a   fe fe                 CPI     0FEH
   046c   ca 75 04              JZ      SD_WT_OK
   046f   05                    DCR     B
   0470   c2 68 04              JNZ     SD_WT
   0473   37                    STC
   0474   c9                    RET
   0475                 SD_WT_OK:
   0475   b7                    ORA     A
   0476   c9                    RET
                        
                        ; DELAYMS ~3ms busy wait.
   0477                 DELAYMS:
   0477   21 d0 07              LXI     H,2000
   047a                 DLMS:
   047a   2b                    DCX     H
   047b   7c                    MOV     A,H
   047c   b5                    ORA     L
   047d   c2 7a 04              JNZ     DLMS
   0480   c9                    RET
                        
                        ; SD_SETBLK0: set the block number to 0.
   0481                 SD_SETBLK0:
   0481   af                    XRA     A
   0482   32 f5 07              STA     BLKN+0
   0485   32 f6 07              STA     BLKN+1
   0488   32 f7 07              STA     BLKN+2
   048b   32 f8 07              STA     BLKN+3
   048e   c9                    RET
                        
                        ; SD_READBLKN: read the 512-byte block BLKN[0..3] (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the dest buffer).
   048f                 SD_READBLKN:
   048f   3e 00                 MVI     A,00H
   0491   d3 54                 OUT     SDCTL           ; select, fast
   0493   e5                    PUSH    H
                                ; build CMD17
   0494   3e 51                 MVI     A,51H
   0496   32 ef 07              STA     CMDBUF
   0499   3a f5 07              LDA     BLKN+0
   049c   32 f0 07              STA     CMDBUF+1
   049f   3a f6 07              LDA     BLKN+1
   04a2   32 f1 07              STA     CMDBUF+2
   04a5   3a f7 07              LDA     BLKN+2
   04a8   32 f2 07              STA     CMDBUF+3
   04ab   3a f8 07              LDA     BLKN+3
   04ae   32 f3 07              STA     CMDBUF+4
   04b1   3e ff                 MVI     A,0FFH
   04b3   32 f4 07              STA     CMDBUF+5
   04b6   21 ef 07              LXI     H,CMDBUF
   04b9   cd 49 04              CALL    SD_SEND6        ; A = R1
   04bc   e1                    POP     H               ; restore dest
   04bd   fe 00                 CPI     00H
   04bf   c2 e0 04              JNZ     SRB_ERR
   04c2   cd 66 04              CALL    SD_WAITTKN
   04c5   da e0 04              JC      SRB_ERR
   04c8   01 00 02              LXI     B,512
   04cb                 SRB_LP:
   04cb   db 53                 IN      SDDAT
   04cd   77                    MOV     M,A
   04ce   23                    INX     H
   04cf   0b                    DCX     B
   04d0   78                    MOV     A,B
   04d1   b1                    ORA     C
   04d2   c2 cb 04              JNZ     SRB_LP
   04d5   db 53                 IN      SDDAT           ; 2 CRC bytes
   04d7   db 53                 IN      SDDAT
   04d9   3e 01                 MVI     A,01H
   04db   d3 54                 OUT     SDCTL           ; release CS
   04dd   3e 00                 MVI     A,00H
   04df   c9                    RET
   04e0                 SRB_ERR:
   04e0   3e 01                 MVI     A,01H
   04e2   d3 54                 OUT     SDCTL
   04e4   3e ff                 MVI     A,0FFH
   04e6   c9                    RET
                        
                        ; SD_WRITEBLKN: write the 512 bytes at (HL) to block BLKN[0..3].
                        ;   A = 0 ok / 0FFh err.  Preserves HL (source buffer).
   04e7                 SD_WRITEBLKN:
   04e7   3e 00                 MVI     A,00H
   04e9   d3 54                 OUT     SDCTL           ; select, fast
   04eb   e5                    PUSH    H
                                ; build CMD24
   04ec   3e 58                 MVI     A,58H
   04ee   32 ef 07              STA     CMDBUF
   04f1   3a f5 07              LDA     BLKN+0
   04f4   32 f0 07              STA     CMDBUF+1
   04f7   3a f6 07              LDA     BLKN+1
   04fa   32 f1 07              STA     CMDBUF+2
   04fd   3a f7 07              LDA     BLKN+2
   0500   32 f2 07              STA     CMDBUF+3
   0503   3a f8 07              LDA     BLKN+3
   0506   32 f3 07              STA     CMDBUF+4
   0509   3e ff                 MVI     A,0FFH
   050b   32 f4 07              STA     CMDBUF+5
   050e   21 ef 07              LXI     H,CMDBUF
   0511   cd 49 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   0514   e1                    POP     H               ; restore source
   0515   fe 00                 CPI     00H
   0517   c2 53 05              JNZ     SWB_ERR
   051a   3e fe                 MVI     A,0FEH          ; data start token
   051c   d3 53                 OUT     SDDAT
   051e   01 00 02              LXI     B,512
   0521                 SWB_LP:
   0521   7e                    MOV     A,M
   0522   d3 53                 OUT     SDDAT
   0524   23                    INX     H
   0525   0b                    DCX     B
   0526   78                    MOV     A,B
   0527   b1                    ORA     C
   0528   c2 21 05              JNZ     SWB_LP
   052b   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC off)
   052d   d3 53                 OUT     SDDAT
   052f   d3 53                 OUT     SDDAT
                                ; data-response token: 0FFh filler first, then 0bxxx00101 (05h) = OK
   0531   06 10                 MVI     B,16
   0533                 SWB_RSP:
   0533   db 53                 IN      SDDAT
   0535   fe ff                 CPI     0FFH
   0537   c2 3e 05              JNZ     SWB_GOT
   053a   05                    DCR     B
   053b   c2 33 05              JNZ     SWB_RSP
   053e                 SWB_GOT:
   053e   e6 1f                 ANI     1FH             ; response bits 0-4; 05h = accepted
   0540   fe 05                 CPI     05H
   0542   c2 53 05              JNZ     SWB_ERR         ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS, so the
                                ; next command is not issued into a busy card
   0545   cd 2c 04              CALL    SD_READY
   0548   b7                    ORA     A
   0549   c2 53 05              JNZ     SWB_ERR
   054c                 SWB_DONE:
   054c   3e 01                 MVI     A,01H
   054e   d3 54                 OUT     SDCTL           ; release CS
   0550   3e 00                 MVI     A,00H
   0552   c9                    RET
   0553                 SWB_ERR:
   0553   3e 01                 MVI     A,01H
   0555   d3 54                 OUT     SDCTL
   0557   3e ff                 MVI     A,0FFH
   0559   c9                    RET
                        
                        ; SDCCS: read OCR (CMD58), return A = 0x40 (SDHC/SDXC) or 0 (SDSC).
   055a                 SDCCS:
   055a   21 3b 06              LXI     H,CMD58
   055d   cd 49 04              CALL    SD_SEND6
   0560   db 53                 IN      SDDAT
   0562   e6 40                 ANI     40H
   0564   4f                    MOV     C,A
   0565   db 53                 IN      SDDAT
   0567   db 53                 IN      SDDAT
   0569   db 53                 IN      SDDAT
   056b   79                    MOV     A,C
   056c   c9                    RET
                        
                        ; SD_CID: read 16-byte CID via CMD9 into CIDBUF.  A = 0 ok / 0FFh err.
   056d                 SD_CID:
   056d   3e 00                 MVI     A,00H
   056f   d3 54                 OUT     SDCTL           ; select, fast
   0571   21 41 06              LXI     H,CMD9
   0574   cd 49 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   0577   fe 00                 CPI     00H
   0579   c2 9a 05              JNZ     SDCID_TE
   057c   cd 66 04              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   057f   da 9a 05              JC      SDCID_TE
   0582   21 f9 07              LXI     H,CIDBUF
   0585   06 10                 MVI     B,16
   0587                 SDCID_L:
   0587   db 53                 IN      SDDAT
   0589   77                    MOV     M,A
   058a   23                    INX     H
   058b   05                    DCR     B
   058c   c2 87 05              JNZ     SDCID_L
   058f   db 53                 IN      SDDAT           ; 2 CRC bytes
   0591   db 53                 IN      SDDAT
   0593   3e 01                 MVI     A,01H
   0595   d3 54                 OUT     SDCTL           ; release CS
   0597   3e 00                 MVI     A,00H
   0599   c9                    RET
   059a                 SDCID_TE:
   059a   3e 01                 MVI     A,01H
   059c   d3 54                 OUT     SDCTL           ; release CS
   059e   3e ff                 MVI     A,0FFH
   05a0   c9                    RET
                        
                        ; INCBLK: increment the 32-bit block number BLKN[0..3] by 1.
   05a1                 INCBLK:
   05a1   3a f8 07              LDA     BLKN+3
   05a4   3c                    INR     A
   05a5   32 f8 07              STA     BLKN+3
   05a8   c2 c6 05              JNZ     INCD
   05ab   3a f7 07              LDA     BLKN+2
   05ae   3c                    INR     A
   05af   32 f7 07              STA     BLKN+2
   05b2   c2 c6 05              JNZ     INCD
   05b5   3a f6 07              LDA     BLKN+1
   05b8   3c                    INR     A
   05b9   32 f6 07              STA     BLKN+1
   05bc   c2 c6 05              JNZ     INCD
   05bf   3a f5 07              LDA     BLKN+0
   05c2   3c                    INR     A
   05c3   32 f5 07              STA     BLKN+0
   05c6                 INCD:
   05c6   c9                    RET
                        
                        ; ---------------- console / numeric helpers ----------------
   05c7                 PSTR:
   05c7   54                    MOV     D,H
   05c8   5d                    MOV     E,L
   05c9   0e 09                 MVI     C,9
   05cb   cd 05 00              CALL    5
   05ce   c9                    RET
   05cf                 CPUTC:
   05cf   0e 02                 MVI     C,2
   05d1   cd 05 00              CALL    5
   05d4   c9                    RET
   05d5                 CIN:
   05d5   0e 01                 MVI     C,1
   05d7   cd 05 00              CALL    5
   05da   c9                    RET
   05db                 CRLF:
   05db   1e 0d                 MVI     E,13
   05dd   cd cf 05              CALL    CPUTC
   05e0   1e 0a                 MVI     E,10
   05e2   cd cf 05              CALL    CPUTC
   05e5   c9                    RET
   05e6                 PRHEX2:                         ; print A as 2 hex digits
   05e6   32 e1 07              STA     HEXV
   05e9   3a e1 07              LDA     HEXV
   05ec   0f                    RRC
   05ed   0f                    RRC
   05ee   0f                    RRC
   05ef   0f                    RRC
   05f0   e6 0f                 ANI     0FH
   05f2   cd fe 05              CALL    PRNIB
   05f5   3a e1 07              LDA     HEXV
   05f8   e6 0f                 ANI     0FH
   05fa   cd fe 05              CALL    PRNIB
   05fd   c9                    RET
   05fe                 PRNIB:
   05fe   fe 0a                 CPI     0AH
   0600   da 05 06              JC      PRI_NUM
   0603   c6 07                 ADI     07H
   0605                 PRI_NUM:
   0605   c6 30                 ADI     '0'
   0607   5f                    MOV     E,A
   0608   cd cf 05              CALL    CPUTC
   060b   c9                    RET
                        ; PRHEX32: print 4 bytes at (HL) as 8 hex digits (little-endian display order).
   060c                 PRHEX32:
   060c   06 04                 MVI     B,4
   060e                 P32_L:
   060e   7e                    MOV     A,M
   060f   e5                    PUSH    H
   0610   c5                    PUSH    B
   0611   cd e6 05              CALL    PRHEX2
   0614   c1                    POP     B
   0615   e1                    POP     H
   0616   23                    INX     H
   0617   05                    DCR     B
   0618   c2 0e 06              JNZ     P32_L
   061b   c9                    RET
                        
                        ; ADDH: HL = HL + A (small offset; uses B, no BDOS call).
   061c                 ADDH:
   061c   47                    MOV     B,A
   061d                 ADDH_L:
   061d   23                    INX     H
   061e   05                    DCR     B
   061f   c2 1d 06              JNZ     ADDH_L
   0622   c9                    RET
                        
