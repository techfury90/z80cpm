                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xE600 (BIOS base) so the image is loaded
                        ;   exactly at 0xE600 by the GWMON-80 'L' command and entered with 'G E600'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xCFFF  TPA
                        ;       0xD000-0xD7FF  CCP  (already loaded by the combined HEX)
                        ;       0xD800-0xE5FF  BDOS (already loaded by the combined HEX)
                        ;       0xE600-0xEFFF  THIS CBIOS
                        ;       0xEF00-0xFEFF  drive A: 4KB RMW buffer (ABOVE the whole CP/M system, so
                        ;                     no transient program can ever load over it)
                        ;       0xFF00-0xFFFF  reserved for GWMON (its stack / banked-out area; CP/M
                        ;                     must stay strictly below 0xFF00 so the monitor cannot
                        ;                     clobber a running system image -- do not use this region).
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 115200)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;   drive A:  the on-board ISSI IS25LD040 SPI flash (512 KB, persistent boot drive).
                        ;   drive B:  the 64K I/O-mapped RAM disk (volatile scratch).
                        ;                             0x50 = DATA (read clocks a byte in / write clocks
                        ;                                     a byte out, MSB first)
                        ;                             0x51 = CTL (bit0 = CS#: 0=select low, 1=release)
                        ;                             0x52 = STATUS (bit0 = transfer busy; poll OPTIONAL
                        ;                                     because the RTL byte engine stretches the
                        ;                                     CPU wait on every 0x50 access)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive B:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   e600                         ORG     0E600H
                        
                        ; ---- build configuration (SPI-primary vs SD-primary) ----------------------
                        ;   Selects the drive-letter map and the BOOT/WBOOT persist target.  Swap
                        ;   cpm/cbios_cfg.inc (or use scripts/build_cbios.sh {sd|spi}) to build the
                        ;   other variant.  a85 has no -D flag, so the mode is a source-level config.
                                INCL    "cpm/cbios_cfg.inc"
                        ; ============================================================================
                        ;   CBIOS BUILD CONFIGURATION -- SD-PRIMARY build
                        ;   --------------------------------------------------------------------------
                        ;   This is the SD-boot configuration.  Drive-letter map (SELDSK codes ->
                        ;   physical media):
                        ;
                        ;       A: (SELDSK 0)  SD card, partition region 0  -- the boot/system volume
                        ;       B: (SELDSK 1)  SD card, partition region 1  -- second SD volume
                        ;       C: (SELDSK 2)  on-board ISSI IS25LD040 SPI flash
                        ;       D: (SELDSK 3)  64K I/O-mapped RAM disk (volatile)
                        ;
                        ;   COLD/WARM boot persist & reload the CP/M system image (CCP+BDOS+CBIOS) to
                        ;   and from the SD card's reserved system area (region 0), NOT the RAM disk.
                        ;
                        ;   Copy this file over cbios_cfg.inc (or build via scripts/build_cbios.sh sd)
                        ;   to assemble the SD-primary CBIOS.
                        ; ============================================================================
   0001                 CFG_SD_BUILD    EQU     1               ; 1 = SD-primary (A:/B:=SD, C:=flash, D:=RAM)
   0000                 CFG_BOOT_DEVICE EQU     0               ; boot device for BOOT/WBOOT persist: 0 = SD system area
                        
                        
                        ; ---- constants ------------------------------------------------------------
   e600                 BIOS    EQU     0E600H          ; BIOS base (jump table origin)
   d000                 CCP     EQU     0D000H          ; CCP origin
   2000                 CPMIMGLEN EQU   2000H           ; bytes of the boot image (CCP+BDOS+CBIOS, padded).
                                                        ;  MUST be a multiple of 512 (the SD sector size) so BOOT/WBOOT
                                                        ;  can persist/reload it in whole SD sectors, and MUST agree with
                                                        ;  make_combined_hex.py, programs/diskutil.s and gwmon/smbrevia.asm
                                                        ;  (the load/burn length).  This is the full system image
                                                        ;  INCLUDING the CBIOS -- the SD system area (SDSYS_OFF) must be
                                                        ;  large enough to hold all of it.  The image runs 0xD000-0xEFFF;
                                                        ;  the last 0x100 bytes overlap the head of RMWBUF (0xEF00) with
                                                        ;  0x00 padding, which is overwritten on the first disk RMW.
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xE603.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   d800                 BDOSL   EQU     0D800H          ; BDOS origin
   d806                 BDOSENT EQU     0D806H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
   0040                 LEDPORT EQU     40H             ; drive-activity LEDs (write bit = drive; MSB = drive A).
                                                        ;  Port 40h is shared read-only with the DIP switches.
                        ;
                        ; ---- ISSI IS25LD040 SPI flash ports (drive B:) — same map as diskutil ---- 
   0050                 SPI_DATA EQU    50H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0051                 SPI_CTL  EQU    51H             ; write bit0 = CS# (0=select low, 1=release high)
   0052                 SPI_STAT EQU    52H             ; read bit0 = transfer busy (poll OPTIONAL)
                        ;
                        ; ---- drive B: flash geometry (must match the DPB AND diskutil's formatter) ----
   ef00                 RMWBUF  EQU     0EF00H          ; 4KB read-modify-write buffer ABOVE the CP/M system
                                                        ;  (0xEF00-0xFEFF, just below GWMON's reserved 0xFF00).
                                                        ;  It is above the CCP/BDOS/CBIOS, so no transient program
                                                        ;  (bounded by the CCP at 0xD000) can ever load over it --
                                                        ;  this is the whole point of moving the system down.
                        ; ---- SD card (drive C:) dedicated SPI port, pins 31/32/35/36 ----
   0053                 SD_DATA EQU     53H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0054                 SD_CTL  EQU     54H             ; write bit0 = CS# (0=select low, 1=release high);
                                                        ;        bit1 = slow clock (1 = ~390 kHz for card init)
   0055                 SD_STAT EQU     55H             ; read bit0 = transfer busy (poll OPTIONAL; the engine
                                                        ;        wait-stretches the CPU so no polling is needed)
   0001                 SDPLBA  EQU     1               ; SD partition LBA start (from the sdtool-created MBR, LBA=1).
                                                        ; Drive A:/B: are SD CP/M drives (DPBA/DPBB below);
                                                        ; the deblock buffer ALIASES the RMWBUF region (drive C flash
                                                        ; writes and drive A/B SD accesses NEVER happen at the same time
                                                        ; -- the BDOS drives one disk at a time).
                        ; ---- SD reserved system area (per SD drive/region) -------------------------
                        ;   Each SD logical volume reserves a system area at its region start to hold a
                        ;   bootable CP/M system image (CCP+BDOS+CBIOS).  The image is CPMIMGLEN =
                        ;   0x1E00 = 7680 B = 15 SD 512B sectors, so 16 sectors (OFF=2 tracks worth, 8KB)
                        ;   leaves 1 sector of headroom.  The system-area offset is added at the CBIOS
                        ;   SDMAP layer (the BDOS does NOT reliably apply the DPB OFF field here), and
                        ;   the formatter must write the directory/data area PAST this offset.
                        ;   NOTE: the system lanes must cover the FULL image INCLUDING the CBIOS, so a
                        ;   cold boot can reload CCP+BDOS+CBIOS from the SD -- not just CCP+BDOS.
   0010                 SDSYS_OFF EQU    16              ; SD 512B sectors reserved for the system area per volume
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xE600
                        ; ============================================================================
   e600   c3 33 e6              JMP     BOOT            ; 0  BIOS+0   cold start
   e603   c3 5e e6              JMP     WBOOT           ; 1  BIOS+3   warm start
   e606   c3 9c e6              JMP     CONST           ; 2  BIOS+6   console status
   e609   c3 a8 e6              JMP     CONIN           ; 3  BIOS+9   console input
   e60c   c3 b2 e6              JMP     CONOUT          ; 4  BIOS+12  console output
   e60f   c3 d6 e6              JMP     LIST            ; 5  BIOS+15  list device output
   e612   c3 d9 e6              JMP     PUNCH           ; 6  BIOS+18  punch device output
   e615   c3 dc e6              JMP     READER          ; 7  BIOS+21  reader device input
   e618   c3 0f e7              JMP     HOME            ; 8  BIOS+24  home the disk
   e61b   c3 e2 e6              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   e61e   c3 1a e7              JMP     SETTRK          ; 10 BIOS+30  set current track
   e621   c3 23 e7              JMP     SETSEC          ; 11 BIOS+33  set current sector
   e624   c3 28 e7              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   e627   c3 7b e7              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   e62a   c3 b1 e7              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   e62d   c3 df e6              JMP     LISTST          ; 15 BIOS+45  list device status
   e630   c3 31 e7              JMP     SECTRAN         ; 16 BIOS+48  sector translate (identity)
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xE600 via 'G E600')
                        ; ============================================================================
   e633                 BOOT:
   e633   31 00 ce              LXI     SP,0CE00H       ; establish a stack in the TPA (below CCP@D000);
                                                        ; it must sit BELOW the system (D000+) so the boot's
                                                        ;  stack use cannot clobber CCP/BDOS/CBIOS code.
   e636   3e 01                 MVI     A,01H
   e638   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   e63a   cd 7d e6              CALL    SETVEC
                        ;
                        ; ---- initialize the SD card (drives A:/B:) before anything touches it ------
   e63d   cd 06 ea              CALL    SD_INIT
                        ;
   0001                         IF      CFG_SD_BUILD
                        ; ---- persist the CP/M system image to the SD system area -------------------
                        ;   The SD is the power-on boot store.  Write the FULL image (CCP+BDOS+CBIOS,
                        ;   CPMIMGLEN bytes) to drive A:'s reserved SD system area so a cold boot can
                        ;   reload the entire system from the SD -- the system tracks must cover the
                        ;   CBIOS, not just the CCP/BDOS (SDSYS_OFF is sized for the whole image).
   e640   cd 7d ea              CALL    SD_SETBLK0      ; BLKN = SDPLBA (region 0 system area start)
   e643   21 00 d0              LXI     H,CCP           ; source = the in-RAM system image (0xD000+)
   e646   01 00 20              LXI     B,CPMIMGLEN     ; full CCP+BDOS+CBIOS image length
   e649   cd b3 ea              CALL    SDWRIMG         ; write it to the SD system area
                                ELSE
                        ; ---- legacy SPI-primary: persist CCP/BDOS to the RAM disk SYSTEM tracks ----
                                LXI     H,SYSCPP        ; disk byte 0 (system track 0)
                                LXI     D,CCP           ; source = CCP image
                                LXI     B,2048          ; 2048 bytes
                                CALL    RAMWR
                                LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
                                LXI     D,BDOSL         ; source = BDOS image
                                LXI     B,3584          ; 3584 bytes
                                CALL    RAMWR
                                ENDIF
                        ;
                        ; ---- the user DATA area is NOT formatted here --------------------------------
                        ; The formatter (sdtool, or diskutil for the RAM disk) formats the disk
                        ; explicitly.  The cold boot leaves the directory untouched so files written
                        ; to the volume PERSIST across CP/M cold boots.
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   e64c   21 7a ec              LXI     H,BANNER
   e64f   cd c9 e6              CALL    PRTSTR
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   e652   21 80 00              LXI     H,DMA0
   e655   22 af ec              SHLD    DMA
   e658   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   e65b   c3 00 d0              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   e65e                 WBOOT:
   e65e   31 00 ce              LXI     SP,0CE00H
   e661   3e 01                 MVI     A,01H
   e663   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM (same as cold boot:
                                                        ;  'G E603' from the monitor after a reset must swap
                                                        ;  the ROM out too, else page-zero/CCP reads hit ROM)
                        ;
   0001                         IF      CFG_SD_BUILD
                        ; ---- reload CCP+BDOS from the SD A: system area ------------------------------
                                ; The SD is the boot store, so a warm start reads the system back from
                                ; the SD (persistent across power cycles) instead of the volatile RAM
                                ; disk.  The system area holds the full image; only CCP+BDOS need to be
                                ; reloaded (the CBIOS is the code currently running and stays in RAM).
   e665   cd 06 ea              CALL    SD_INIT
   e668   cd 7d ea              CALL    SD_SETBLK0      ; BLKN = SDPLBA (region 0 system area)
   e66b   21 00 d0              LXI     H,CCP           ; destination = CCP (SDREADIMG loads into HL)
   e66e   01 00 16              LXI     B,1600H         ; CCP+BDOS = 0x800 + 0xE00 = 0x1600 bytes (11 sectors)
   e671   cd e6 ea              CALL    SDREADIMG
                                ELSE
                        ; ---- legacy SPI-primary: reload CCP and BDOS from the RAM disk SYSTEM tracks -
                                LXI     H,SYSCPP
                                LXI     D,CCP
                                LXI     B,2048
                                CALL    RAMRD
                                LXI     H,SYSBDS
                                LXI     D,BDOSL
                                LXI     B,3584
                                CALL    RAMRD
                                ENDIF
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   e674   cd 7d e6              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   e677   01 00 00              LXI     B,0000H
   e67a   c3 00 d0              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xE603), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xD806)
                        ; ============================================================================
   e67d                 SETVEC:
   e67d   21 00 00              LXI     H,0000H
   e680   36 c3                 MVI     M,0C3H          ; JP
   e682   23                    INX     H
   e683   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xE603 (the WBOOT table entry)
   e685   23                    INX     H
   e686   36 e6                 MVI     M,HIGH(BIOS)
   e688   21 03 00              LXI     H,0003H
   e68b   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   e68d   23                    INX     H
   e68e   36 00                 MVI     M,00H
   e690   21 05 00              LXI     H,0005H
   e693   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   e695   23                    INX     H
   e696   36 06                 MVI     M,LOW(BDOSENT)
   e698   23                    INX     H
   e699   36 d8                 MVI     M,HIGH(BDOSENT)
   e69b   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   e69c                 CONST:
   e69c   db 80                 IN      80H
   e69e   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6a0   3e 00                 MVI     A,00H           ; default: no char
   e6a2   ca a7 e6              JZ      CONST2
   e6a5   3e ff                 MVI     A,0FFH          ; char ready
   e6a7                 CONST2:
   e6a7   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   e6a8                 CONIN:
   e6a8   db 80                 IN      80H
   e6aa   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6ac   ca a8 e6              JZ      CONIN           ; wait for a character
   e6af   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   e6b1   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   e6b2                 CONOUT:
   e6b2   db 80                 IN      80H
   e6b4   e6 01                 ANI     01H             ; tx_busy (bit0)
   e6b6   c2 b2 e6              JNZ     CONOUT          ; wait until transmitter is idle
   e6b9   79                    MOV     A,C
   e6ba   d3 81                 OUT     81H
   e6bc   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   e6bd                 PUTC:
   e6bd   f5                    PUSH    PSW
   e6be                 PUTC1:
   e6be   db 80                 IN      80H
   e6c0   e6 01                 ANI     01H
   e6c2   c2 be e6              JNZ     PUTC1
   e6c5   f1                    POP     PSW
   e6c6   d3 81                 OUT     81H
   e6c8   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   e6c9                 PRTSTR:
   e6c9   7e                    MOV     A,M
   e6ca   b7                    ORA     A
   e6cb   ca d5 e6              JZ      PRTEND
   e6ce   cd bd e6              CALL    PUTC
   e6d1   23                    INX     H
   e6d2   c3 c9 e6              JMP     PRTSTR
   e6d5                 PRTEND:
   e6d5   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   e6d6                 LIST:
   e6d6   c3 b2 e6              JMP     CONOUT          ; char in C
   e6d9                 PUNCH:
   e6d9   c3 b2 e6              JMP     CONOUT          ; char in C
   e6dc                 READER:
   e6dc   c3 a8 e6              JMP     CONIN           ; returns char in A
   e6df                 LISTST:
   e6df   3e ff                 MVI     A,0FFH          ; list device always "ready"
   e6e1   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ;   The drive-letter -> media map depends on the build configuration (see
                        ;   cpm/cbios_cfg.inc):
                        ;     SD build (CFG_SD_BUILD=1):  A=SD region0, B=SD region1, C=flash, D=RAM.
                        ;     SPI build (CFG_SD_BUILD=0): A=flash,     B=RAM,      C=SD r0, D=SD r1.
   e6e2                 SELDSK:
   e6e2   79                    MOV     A,C
   e6e3   32 ab ec              STA     SELBL           ; remember the selected drive number
   e6e6   b7                    ORA     A
   e6e7   ca ff e6              JZ      SELD0
   e6ea   fe 01                 CPI     01H
   e6ec   ca 03 e7              JZ      SELD1
   e6ef   fe 02                 CPI     02H
   e6f1   ca 07 e7              JZ      SELD2
   e6f4   fe 03                 CPI     03H
   e6f6   ca 0b e7              JZ      SELD3
   e6f9                 SELERR:
   e6f9   21 00 00              LXI     H,0000H         ; error return: HL=0
   e6fc   3e ff                 MVI     A,0FFH
   e6fe   c9                    RET
   0001                         IF      CFG_SD_BUILD
   e6ff                 SELD0:
   e6ff   21 9f ed              LXI     H,DPHSD0        ; drive A disk parameter header (SD region 0)
   e702   c9                    RET
   e703                 SELD1:
   e703   21 3f ee              LXI     H,DPHSD1        ; drive B disk parameter header (SD region 1)
   e706   c9                    RET
   e707                 SELD2:
   e707   21 b5 ec              LXI     H,DPHFLASH      ; drive C disk parameter header (SPI flash)
   e70a   c9                    RET
   e70b                 SELD3:
   e70b   21 f7 ec              LXI     H,DPHRAM        ; drive D disk parameter header (RAM disk)
   e70e   c9                    RET
                                ELSE
                        SELD0:
                                LXI     H,DPHFLASH      ; drive A disk parameter header (SPI flash)
                                RET
                        SELD1:
                                LXI     H,DPHRAM        ; drive B disk parameter header (RAM disk)
                                RET
                        SELD2:
                                LXI     H,DPHSD0        ; drive C disk parameter header (SD region 0)
                                RET
                        SELD3:
                                LXI     H,DPHSD1        ; drive D disk parameter header (SD region 1)
                                RET
                                ENDIF
                        
                        ; HOME: move to track 0, sector 0.
   e70f                 HOME:
   e70f   af                    XRA     A
   e710   32 ac ec              STA     TRK             ; track low byte
   e713   32 ad ec              STA     TRK+1           ; track high byte -- MUST clear both, or a stale
                                                        ; high byte left by a prior drive-C access would
                                                        ; survive a HOME on a small drive A/B and corrupt
                                                        ; the track address
   e716   32 ae ec              STA     SECN
   e719   c9                    RET
                        
                        ; SETTRK: set the current track.  CP/M 2 passes the track as a WORD in BC (DRI
                        ;   manual Table 6-5: "Register BC contains the track number ... 0-65535 for
                        ;   nonstandard disk subsystems"; seasip: "a word under CP/M 2").  Store BOTH
                        ;   bytes -- the high byte is what lets us address >256 tracks (an 8 MB drive at
                        ;   SPT=32 needs tracks up to 2047).
   e71a                 SETTRK:
   e71a   79                    MOV     A,C
   e71b   32 ac ec              STA     TRK             ; track low byte
   e71e   78                    MOV     A,B
   e71f   32 ad ec              STA     TRK+1           ; track high byte
   e722   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   e723                 SETSEC:
   e723   79                    MOV     A,C
   e724   32 ae ec              STA     SECN
   e727   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   e728                 SETDMA:
   e728   79                    MOV     A,C
   e729   32 af ec              STA     DMA
   e72c   78                    MOV     A,B
   e72d   32 b0 ec              STA     DMA+1
   e730   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   e731                 SECTRAN:
   e731   69                    MOV     L,C
   e732   60                    MOV     H,B
   e733   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   e734                 CALC:
   e734   3a ac ec              LDA     TRK
   e737   6f                    MOV     L,A
   e738   26 00                 MVI     H,00H           ; HL = TRK
   e73a   29                    DAD     H               ; *2
   e73b   29                    DAD     H               ; *4
   e73c   29                    DAD     H               ; *8
   e73d   29                    DAD     H               ; *16
   e73e   29                    DAD     H               ; *32
   e73f   29                    DAD     H               ; *64
   e740   29                    DAD     H               ; *128
   e741   29                    DAD     H               ; *256
   e742   29                    DAD     H               ; *512
   e743   29                    DAD     H               ; *1024
   e744   29                    DAD     H               ; *2048
   e745   29                    DAD     H               ; *4096  -> HL = TRK*4096
   e746   44                    MOV     B,H
   e747   4d                    MOV     C,L             ; BC = TRK*4096
   e748   3a ae ec              LDA     SECN
   e74b   6f                    MOV     L,A
   e74c   26 00                 MVI     H,00H           ; HL = SECN
   e74e   29                    DAD     H               ; *2
   e74f   29                    DAD     H               ; *4
   e750   29                    DAD     H               ; *8
   e751   29                    DAD     H               ; *16
   e752   29                    DAD     H               ; *32
   e753   29                    DAD     H               ; *64
   e754   29                    DAD     H               ; *128  -> HL = SECN*128
   e755   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   e756   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   e757                 RAMPTR:
   e757   7d                    MOV     A,L
   e758   d3 21                 OUT     21H             ; address low byte
   e75a   7c                    MOV     A,H
   e75b   d3 22                 OUT     22H             ; address high byte
   e75d   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE-ACTIVITY LEDS.  Port 40h carries the drive LEDs (write-only; the DIP
                        ;   switches share the port read-only).  On every disk READ/WRITE we light the
                        ;   LED for the selected drive, then write 00h to extinguish before returning.
                        ;   Bit assignment (user spec): MSB / pin37 / D8 = drive A, D7 = drive B,
                        ;   D6 = drive C, D5 = drive D  =>  bit = 7 - SELBL.
                        ; ============================================================================
   e75e                 LIGHT:
   e75e   3a ab ec              LDA     SELBL           ; A = drive number (0..3)
   e761   4f                    MOV     C,A             ; C = shift count
   e762   06 80                 MVI     B,80H           ; B = MSB mask (drive A)
   e764                 LIGHT_LP:
   e764   79                    MOV     A,C
   e765   b7                    ORA     A
   e766   ca 70 e7              JZ      LIGHT_OUT
   e769   78                    MOV     A,B
   e76a   0f                    RRC
   e76b   47                    MOV     B,A
   e76c   0d                    DCR     C
   e76d   c3 64 e7              JMP     LIGHT_LP
   e770                 LIGHT_OUT:
   e770   78                    MOV     A,B
   e771   d3 40                 OUT     LEDPORT
   e773   c9                    RET
                        
                        ; LEDOFF: write 00h to the LED port (all drives off).  Preserves ALL registers,
                        ;   so the disk status in A survives unchanged to the BDOS caller.
   e774                 LEDOFF:
   e774   f5                    PUSH    PSW
   e775   3e 00                 MVI     A,00H
   e777   d3 40                 OUT     LEDPORT
   e779   f1                    POP     PSW
   e77a   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   e77b                 READ:
   e77b   cd 5e e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e77e   3a ab ec              LDA     SELBL
   0001                         IF      CFG_SD_BUILD
                                ; SD build: SELBL 0/1 -> SD deblock, SELBL 2 -> SPI flash, SELBL 3 -> RAM disk
   e781   fe 02                 CPI     02H
   e783   ca 91 e7              JZ      READ_FLASH
   e786   fe 03                 CPI     03H
   e788   ca 97 e7              JZ      READ_RAM
   e78b   cd 45 e8              CALL    READC           ; drive A/B SD read (retry); RET here with A = status
   e78e   c3 74 e7              JMP     LEDOFF
                                ELSE
                                ; SPI build: SELBL 0 -> SPI flash, SELBL 1 -> RAM disk, SELBL 2/3 -> SD deblock
                                ORA     A
                                JZ      READ_FLASH
                                CPI     01H
                                JZ      READ_RAM
                                CALL    READC           ; drive C/D SD read (retry); RET here with A = status
                                JMP     LEDOFF
                                ENDIF
   e791                 READ_FLASH:
   e791   cd 0d ec              CALL    READB           ; SPI flash read; RET here with A = status
   e794   c3 74 e7              JMP     LEDOFF
   e797                 READ_RAM:
                                ; ---- RAM disk path ----
   e797   cd 34 e7              CALL    CALC            ; HL = RAM-disk byte address
   e79a   cd 57 e7              CALL    RAMPTR          ; set the disk data-pointer
   e79d   2a af ec              LHLD    DMA
   e7a0   54                    MOV     D,H
   e7a1   5d                    MOV     E,L             ; DE = DMA destination
   e7a2   06 80                 MVI     B,128
   e7a4                 READ1:
   e7a4   db 20                 IN      20H             ; read a byte (data port auto-increments)
   e7a6   12                    STAX    D
   e7a7   13                    INX     D
   e7a8   05                    DCR     B
   e7a9   c2 a4 e7              JNZ     READ1
   e7ac   3e 00                 MVI     A,00H           ; success
   e7ae   c3 74 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
                                                        ;  (LEDOFF preserves A, so the BDOS still sees 00H)
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   e7b1                 WRITE:
   e7b1   cd 5e e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e7b4   3a ab ec              LDA     SELBL
   0001                         IF      CFG_SD_BUILD
                                ; SD build: SELBL 0/1 -> SD deblock, SELBL 2 -> SPI flash, SELBL 3 -> RAM disk
   e7b7   fe 02                 CPI     02H
   e7b9   ca c7 e7              JZ      WRITE_FLASH
   e7bc   fe 03                 CPI     03H
   e7be   ca cd e7              JZ      WRITE_RAM
   e7c1   cd 59 e8              CALL    WRITEC          ; drive A/B SD write (retry); RET here with A = status
   e7c4   c3 74 e7              JMP     LEDOFF
                                ELSE
                                ; SPI build: SELBL 0 -> SPI flash, SELBL 1 -> RAM disk, SELBL 2/3 -> SD deblock
                                ORA     A
                                JZ      WRITE_FLASH
                                CPI     01H
                                JZ      WRITE_RAM
                                CALL    WRITEC          ; drive C/D SD write (retry); RET here with A = status
                                JMP     LEDOFF
                                ENDIF
   e7c7                 WRITE_FLASH:
   e7c7   cd 1e ec              CALL    WRITEB          ; SPI flash write (4KB RMW); RET here with A = status
   e7ca   c3 74 e7              JMP     LEDOFF
   e7cd                 WRITE_RAM:
                                ; ---- RAM disk path ----
   e7cd   cd 34 e7              CALL    CALC            ; HL = RAM-disk byte address
   e7d0   cd 57 e7              CALL    RAMPTR
   e7d3   2a af ec              LHLD    DMA
   e7d6   54                    MOV     D,H
   e7d7   5d                    MOV     E,L             ; DE = DMA source
   e7d8   06 80                 MVI     B,128
   e7da                 WRITE1:
   e7da   1a                    LDAX    D
   e7db   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   e7dd   13                    INX     D
   e7de   05                    DCR     B
   e7df   c2 da e7              JNZ     WRITE1
   e7e2   3e 00                 MVI     A,00H           ; success
   e7e4   c3 74 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
                        
                        ; ============================================================================
                        ;   SD CARD (drive C:) DRIVER + DEBLOCKING
                        ;   The SD is a 2K-block single-DM CP/M drive (DPBC, same geometry family as the
                        ;   flash drive A but OFF=0 because it is a data partition).  The BDOS operates
                        ;   on 128-byte records; the SD only transfers 512-byte sectors, so the CBIOS
                        ;   deblocks: record r -> SD sector (SDPLBA + r/4) at byte offset (r%4)*128.
                        ;   The 512-byte sector buffer ALIASES the RMWBUF region (0xEF00): drive A flash
                        ;   writes and drive C SD accesses never occur at the same time (the BDOS drives
                        ;   one disk at a time), so the two can safely share that 4KB area.
                        ; ============================================================================
                        ; SDMAP: from TRK/SECN compute the SD block number (BLKN, 32-bit, MSB first) and
                        ;   the in-sector byte offset (SDOFF, 16-bit) for the current 128-byte record.
                        ;   record = TRK*SPT + SECN = TRK*32 + SECN.
   e7e7                 SDMAP:
   e7e7   2a ac ec              LHLD    TRK             ; HL = full 16-bit TRK (CP/M 2 passes it as a word
                                                        ; in BC; an 8 MB drive at SPT=32 reaches track 2047)
   e7ea   29                    DAD     H               ; *2
   e7eb   29                    DAD     H               ; *4
   e7ec   29                    DAD     H               ; *8
   e7ed   29                    DAD     H               ; *16
   e7ee   29                    DAD     H               ; *32  -> HL = TRK*32
   e7ef   3a ae ec              LDA     SECN
   e7f2   5f                    MOV     E,A
   e7f3   16 00                 MVI     D,00H
   e7f5   19                    DAD     D               ; HL = record
                                ; SDOFF_hi = (record & 3) >> 1   [0,0,1,1]
   e7f6   7d                    MOV     A,L
   e7f7   e6 03                 ANI     03H
   e7f9   47                    MOV     B,A
   e7fa   e6 02                 ANI     02H
   e7fc   ca 04 e8              JZ      SDMAP_H0
   e7ff   3e 01                 MVI     A,01H
   e801   c3 06 e8              JMP     SDMAP_H1
   e804                 SDMAP_H0:
   e804   3e 00                 MVI     A,00H
   e806                 SDMAP_H1:
   e806   32 e0 ee              STA     SDOFF+1
                                ; SDOFF_lo = ((record & 3) << 7) & 0xFF   [*128]
                                ; NOTE: RAL (rotate through carry), NOT RLC.  RLC is CIRCULAR, so bit 7
                                ; wraps back into bit 0: (record&3)=2 gave 0x01 instead of 0x00 and
                                ; (record&3)=3 gave 0x81 instead of 0x80, i.e. records 2 and 3 of every
                                ; 512-byte sector were deblocked ONE BYTE HIGH.  CP/M still round-tripped
                                ; (READ used the same offset) but the on-card sector was shifted, so the
                                ; directory/data written to the SD was silently corrupt.
   e809   af                    XRA     A               ; clear CY (and A)
   e80a   78                    MOV     A,B
   e80b   17                    RAL                     ; *2
   e80c   17                    RAL                     ; *4
   e80d   17                    RAL                     ; *8
   e80e   17                    RAL                     ; *16
   e80f   17                    RAL                     ; *32
   e810   17                    RAL                     ; *64
   e811   17                    RAL                     ; *128
   e812   32 df ee              STA     SDOFF
                                ; SSEC = record >> 2 (16-bit logical right shift)
   e815   af                    XRA     A               ; A=0, CY=0
   e816   7c                    MOV     A,H
   e817   1f                    RAR
   e818   67                    MOV     H,A
   e819   7d                    MOV     A,L
   e81a   1f                    RAR
   e81b   6f                    MOV     L,A
   e81c   af                    XRA     A
   e81d   7c                    MOV     A,H
   e81e   1f                    RAR
   e81f   67                    MOV     H,A
   e820   7d                    MOV     A,L
   e821   1f                    RAR
   e822   6f                    MOV     L,A             ; HL = record >> 2 = SSEC
                                ; ---- per-drive region offset (CP/M has no partitioning) ----
                                ; The BDOS does NOT reliably apply the DPB OFF field here, so the region
                                ; offset (and, in the SD build, the reserved system-area offset) is added
                                ; at the CBIOS deblock layer.
   0001                         IF      CFG_SD_BUILD
                                ; SD build: drive B (SELBL==1) = SD region 1 (+0x4000 sectors = +8 MB);
                                ; drive A (SELBL==0) = region 0 (+0).  Both drives also reserve the
                                ; system area (SDSYS_OFF added below).
   e823   3a ab ec              LDA     SELBL
   e826   fe 01                 CPI     01H
   e828   c2 2f e8              JNZ     SDMAP_REG0
   e82b   11 00 40              LXI     D,4000H
   e82e   19                    DAD     D               ; SSEC += 0x4000 (into SD region 1)
                                ELSE
                                ; SPI build: drive D (SELBL==3) = SD region 1 (+0x4000 sectors = +8 MB);
                                ; drive C (SELBL==2) = region 0 (+0).  The SD drives are pure data here
                                ; (no reserved system area -- OFF-style data partition).
                                LDA     SELBL
                                CPI     03H
                                JNZ     SDMAP_REG0
                                LXI     D,4000H
                                DAD     D               ; SSEC += 0x4000 (into SD region 1)
                                ENDIF
   e82f                 SDMAP_REG0:
   0001                         IF      CFG_SD_BUILD
                                ; SD build: add the reserved system area (each SD volume reserves
                                ; SDSYS_OFF sectors at its region start, so the data/directory begin PAST it)
   e82f   11 10 00              LXI     D,SDSYS_OFF
   e832   19                    DAD     D
                                ENDIF
                                ; BLKN = SDPLBA + SSEC  (SDPLBA=1)
   e833   23                    INX     H
   e834   3e 00                 MVI     A,00H
   e836   32 e1 ee              STA     BLKN+0
   e839   32 e2 ee              STA     BLKN+1
   e83c   7c                    MOV     A,H
   e83d   32 e3 ee              STA     BLKN+2
   e840   7d                    MOV     A,L
   e841   32 e4 ee              STA     BLKN+3
   e844   c9                    RET
                        
                        ; ---- drive C: retry wrappers -------------------------------------------------
                        ; An SD transaction can fail TRANSIENTLY: a command issued while the card is
                        ; still internally busy is silently dropped (the MISO read then looks like
                        ; R1=OK or 0FFh), a response can be lost, or the boot-time handshake can fail
                        ; and leave drive C dead for the whole session.  A CP/M BIOS must not turn
                        ; those into a hard "Bad Sector" on the first try: retry the WHOLE operation up
                        ; to SDTRIES times, re-initialising the card between attempts.
   0006                 SDTRIES EQU     06H          ; attempts; each retry also WAITS before re-init
   e845                 READC:
   e845   3e 06                 MVI     A,SDTRIES
   e847   32 eb ee              STA     SDTRY
   e84a                 READC1:
   e84a   cd 8c e8              CALL    READS
   e84d   b7                    ORA     A
   e84e   ca 6d e8              JZ      SDOP_OK
   e851   cd 6f e8              CALL    SD_RECOVER
   e854   b7                    ORA     A
   e855   ca 4a e8              JZ      READC1
   e858   c9                    RET                     ; out of tries -> A = 0FFh (real failure)
   e859                 WRITEC:
   e859   3e 06                 MVI     A,SDTRIES
   e85b   32 eb ee              STA     SDTRY
   e85e                 WRITEC1:
   e85e   cd b9 e8              CALL    WRITES
   e861   b7                    ORA     A
   e862   ca 6d e8              JZ      SDOP_OK
   e865   cd 6f e8              CALL    SD_RECOVER
   e868   b7                    ORA     A
   e869   ca 5e e8              JZ      WRITEC1
   e86c   c9                    RET
   e86d                 SDOP_OK:
   e86d   af                    XRA     A
   e86e   c9                    RET
                        ; SD_RECOVER: another attempt allowed -> release CS, re-init the card, return
                        ;   A=0.  Out of tries -> release CS and return A=0FFh.  Clobbers A,BC,DE,HL.
   e86f                 SD_RECOVER:
   e86f   3a eb ee              LDA     SDTRY
   e872   3d                    DCR     A
   e873   32 eb ee              STA     SDTRY
   e876   ca 85 e8              JZ      SDRC_NO
   e879   3e 01                 MVI     A,01H
   e87b   d3 54                 OUT     SD_CTL          ; release CS, give the card time to finish its
   e87d   cd 5b ea              CALL    SD_RDLY         ; internal programming (~10 ms), then re-handshake
   e880   cd 06 ea              CALL    SD_INIT
   e883   af                    XRA     A
   e884   c9                    RET
   e885                 SDRC_NO:
   e885   3e 01                 MVI     A,01H           ; release CS and report the failure
   e887   d3 54                 OUT     SD_CTL
   e889   3e ff                 MVI     A,0FFH
   e88b   c9                    RET
                        
                        ; READS: read one 128-byte CP/M record from the SD into the DMA buffer.
                        ;   Returns A=0 on success, 0FFh on error.
   e88c                 READS:
   e88c   cd e7 e7              CALL    SDMAP
   e88f   21 00 ef              LXI     H,RMWBUF        ; deblock sector buffer (aliases the RMWBUF region)
   e892   cd f0 e8              CALL    SD_READBLK      ; read the 512-byte SD sector into RMWBUF
   e895   b7                    ORA     A
   e896   c2 b8 e8              JNZ     READS_ERR
                                ; copy RMWBUF+SDOFF (128 bytes) to the DMA buffer
   e899   2a af ec              LHLD    DMA
   e89c   54                    MOV     D,H
   e89d   5d                    MOV     E,L             ; DE = DMA destination
   e89e   21 00 ef              LXI     H,RMWBUF
   e8a1   3a df ee              LDA     SDOFF
   e8a4   85                    ADD     L
   e8a5   6f                    MOV     L,A
   e8a6   3a e0 ee              LDA     SDOFF+1
   e8a9   8c                    ADC     H
   e8aa   67                    MOV     H,A             ; HL = RMWBUF + SDOFF
   e8ab   06 80                 MVI     B,128
   e8ad                 READS1:
   e8ad   7e                    MOV     A,M
   e8ae   12                    STAX    D
   e8af   23                    INX     H
   e8b0   13                    INX     D
   e8b1   05                    DCR     B
   e8b2   c2 ad e8              JNZ     READS1
   e8b5   3e 00                 MVI     A,00H           ; success
   e8b7   c9                    RET
   e8b8                 READS_ERR:
   e8b8   c9                    RET                     ; A = 0FFh (disk read error)
                        
                        ; WRITES: write one 128-byte CP/M record from the DMA buffer to the SD
                        ;   (read-modify-write of the containing 512-byte sector).
                        ;   Returns A=0 on success, 0FFh on error.
   e8b9                 WRITES:
   e8b9   cd e7 e7              CALL    SDMAP
   e8bc   21 00 ef              LXI     H,RMWBUF
   e8bf   cd f0 e8              CALL    SD_READBLK      ; read the sector first (RMW)
   e8c2   b7                    ORA     A
   e8c3   c2 ef e8              JNZ     WRITES_ERR
                                ; overlay the 128-byte DMA record at RMWBUF+SDOFF
   e8c6   2a af ec              LHLD    DMA
   e8c9   54                    MOV     D,H
   e8ca   5d                    MOV     E,L             ; DE = DMA source
   e8cb   21 00 ef              LXI     H,RMWBUF
   e8ce   3a df ee              LDA     SDOFF
   e8d1   85                    ADD     L
   e8d2   6f                    MOV     L,A
   e8d3   3a e0 ee              LDA     SDOFF+1
   e8d6   8c                    ADC     H
   e8d7   67                    MOV     H,A             ; HL = RMWBUF + SDOFF (in-buffer destination)
   e8d8   06 80                 MVI     B,128
   e8da                 WRITES1:
   e8da   1a                    LDAX    D
   e8db   77                    MOV     M,A
   e8dc   23                    INX     H
   e8dd   13                    INX     D
   e8de   05                    DCR     B
   e8df   c2 da e8              JNZ     WRITES1
   e8e2   21 00 ef              LXI     H,RMWBUF
   e8e5   cd 48 e9              CALL    SD_WRITEBLK     ; write the modified 512-byte sector back
   e8e8   b7                    ORA     A
   e8e9   c2 ef e8              JNZ     WRITES_ERR
   e8ec   3e 00                 MVI     A,00H           ; success
   e8ee   c9                    RET
   e8ef                 WRITES_ERR:
   e8ef   c9                    RET                     ; A = 0FFh (disk write error)
                        
                        ; SD_READBLK: read the 512-byte SD block BLKN (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the destination buffer).
   e8f0                 SD_READBLK:
   e8f0   3e 00                 MVI     A,00H
   e8f2   d3 54                 OUT     SD_CTL          ; select the SD card (CS low), fast
   e8f4   3e 51                 MVI     A,51H           ; CMD17 (read single block)
   e8f6   32 e5 ee              STA     SDCMDB
   e8f9   3a e1 ee              LDA     BLKN+0
   e8fc   32 e6 ee              STA     SDCMDB+1
   e8ff   3a e2 ee              LDA     BLKN+1
   e902   32 e7 ee              STA     SDCMDB+2
   e905   3a e3 ee              LDA     BLKN+2
   e908   32 e8 ee              STA     SDCMDB+3
   e90b   3a e4 ee              LDA     BLKN+3
   e90e   32 e9 ee              STA     SDCMDB+4
   e911   3e ff                 MVI     A,0FFH
   e913   32 ea ee              STA     SDCMDB+5
   e916   e5                    PUSH    H
   e917   21 e5 ee              LXI     H,SDCMDB
   e91a   cd d8 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e91d   e1                    POP     H               ; restore the destination buffer
   e91e   fe 00                 CPI     00H
   e920   c2 41 e9              JNZ     SDRB_ERR
   e923   cd f5 e9              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   e926   da 41 e9              JC      SDRB_ERR
   e929   01 00 02              LXI     B,512
   e92c                 SDRB1:
   e92c   db 53                 IN      SD_DATA
   e92e   77                    MOV     M,A
   e92f   23                    INX     H
   e930   0b                    DCX     B
   e931   78                    MOV     A,B
   e932   b1                    ORA     C
   e933   c2 2c e9              JNZ     SDRB1
   e936   db 53                 IN      SD_DATA         ; 2 CRC bytes
   e938   db 53                 IN      SD_DATA
   e93a   3e 01                 MVI     A,01H
   e93c   d3 54                 OUT     SD_CTL          ; release CS
   e93e   3e 00                 MVI     A,00H
   e940   c9                    RET
   e941                 SDRB_ERR:
   e941   3e 01                 MVI     A,01H
   e943   d3 54                 OUT     SD_CTL          ; release CS
   e945   3e ff                 MVI     A,0FFH
   e947   c9                    RET
                        
                        ; SD_WRITEBLK: write the 512 bytes at (HL) to the SD block BLKN.
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the source buffer).
   e948                 SD_WRITEBLK:
   e948   3e 00                 MVI     A,00H
   e94a   d3 54                 OUT     SD_CTL          ; select the SD card, fast
   e94c   3e 58                 MVI     A,58H           ; CMD24 (write single block)
   e94e   32 e5 ee              STA     SDCMDB
   e951   3a e1 ee              LDA     BLKN+0
   e954   32 e6 ee              STA     SDCMDB+1
   e957   3a e2 ee              LDA     BLKN+1
   e95a   32 e7 ee              STA     SDCMDB+2
   e95d   3a e3 ee              LDA     BLKN+2
   e960   32 e8 ee              STA     SDCMDB+3
   e963   3a e4 ee              LDA     BLKN+3
   e966   32 e9 ee              STA     SDCMDB+4
   e969   3e ff                 MVI     A,0FFH
   e96b   32 ea ee              STA     SDCMDB+5
   e96e   e5                    PUSH    H
   e96f   21 e5 ee              LXI     H,SDCMDB
   e972   cd d8 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e975   e1                    POP     H               ; restore the source buffer
   e976   fe 00                 CPI     00H
   e978   c2 b4 e9              JNZ     SDWB_ERR
   e97b   3e fe                 MVI     A,0FEH          ; data start token
   e97d   d3 53                 OUT     SD_DATA
   e97f   01 00 02              LXI     B,512
   e982                 SDWB1:
   e982   7e                    MOV     A,M
   e983   d3 53                 OUT     SD_DATA
   e985   23                    INX     H
   e986   0b                    DCX     B
   e987   78                    MOV     A,B
   e988   b1                    ORA     C
   e989   c2 82 e9              JNZ     SDWB1
   e98c   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC disabled)
   e98e   d3 53                 OUT     SD_DATA
   e990   d3 53                 OUT     SD_DATA
                                ; read the data-response token: the card clocks 0xFF for a few bytes
                                ; first, then 0bxxx00101 (0x05) = data accepted.
   e992   06 10                 MVI     B,16
   e994                 SDWB_RSP:
   e994   db 53                 IN      SD_DATA
   e996   fe ff                 CPI     0FFH
   e998   c2 9f e9              JNZ     SDWB_GOT
   e99b   05                    DCR     B
   e99c   c2 94 e9              JNZ     SDWB_RSP
   e99f                 SDWB_GOT:
   e99f   e6 1f                 ANI     1FH             ; response bits 0-4; 0x05 = accepted
   e9a1   fe 05                 CPI     05H
   e9a3   c2 b4 e9              JNZ     SDWB_ERR        ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS so the
                                ; very next command is not issued into a busy card
   e9a6   cd bb e9              CALL    SD_READY
   e9a9   b7                    ORA     A
   e9aa   c2 b4 e9              JNZ     SDWB_ERR
   e9ad                 SDWB_DONE:
   e9ad   3e 01                 MVI     A,01H
   e9af   d3 54                 OUT     SD_CTL          ; release CS
   e9b1   3e 00                 MVI     A,00H
   e9b3   c9                    RET
   e9b4                 SDWB_ERR:
   e9b4   3e 01                 MVI     A,01H
   e9b6   d3 54                 OUT     SD_CTL          ; release CS
   e9b8   3e ff                 MVI     A,0FFH
   e9ba   c9                    RET
                        
                        ; SD_READY: wait until the card is NOT busy (MISO high, reads 0xFF) before a
                        ;   command is issued.  A card that is still programming a block drives MISO
                        ;   LOW, so bytes read as 0x00 -- and SD_SEND6's R1 read would accept that 0x00
                        ;   as "R1 = OK" and drop the command on the floor, leaving the card's data
                        ;   stream desynced.  That is what turned every write after the first into
                        ;   "Bad Sector".  Timeout ~260k port reads (~0.4 s at 25 MHz), which covers the
                        ;   SD spec's 250 ms worst-case block-programming time.
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   e9bb                 SD_READY:
   e9bb   d5                    PUSH    D
   e9bc   16 04                 MVI     D,04H           ; 4 x 65536 port reads
   e9be                 SDRDY0:
   e9be   01 00 00              LXI     B,0000H
   e9c1                 SDRDY1:
   e9c1   db 53                 IN      SD_DATA         ; 0xFF = idle, 0x00 = still programming
   e9c3   fe ff                 CPI     0FFH
   e9c5   ca d5 e9              JZ      SDRDY_OK
   e9c8   0b                    DCX     B
   e9c9   78                    MOV     A,B
   e9ca   b1                    ORA     C
   e9cb   c2 c1 e9              JNZ     SDRDY1
   e9ce   15                    DCR     D
   e9cf   c2 be e9              JNZ     SDRDY0
   e9d2   d1                    POP     D
   e9d3   37                    STC
   e9d4   c9                    RET
   e9d5                 SDRDY_OK:
   e9d5   d1                    POP     D
   e9d6   af                    XRA     A               ; A=0, clear CY
   e9d7   c9                    RET
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Returns A = R1 (0FFh if no valid response after 16 bytes of clocking).
   e9d8                 SD_SEND6:
   e9d8   e5                    PUSH    H
   e9d9   cd bb e9              CALL    SD_READY        ; never issue a command into a busy card
   e9dc   e1                    POP     H
   e9dd   06 06                 MVI     B,6
   e9df                 SD6_TX:
   e9df   7e                    MOV     A,M
   e9e0   d3 53                 OUT     SD_DATA
   e9e2   23                    INX     H
   e9e3   05                    DCR     B
   e9e4   c2 df e9              JNZ     SD6_TX
   e9e7   06 10                 MVI     B,16
   e9e9                 SD6_RX:
   e9e9   db 53                 IN      SD_DATA
   e9eb   fe ff                 CPI     0FFH
   e9ed   c2 f4 e9              JNZ     SD6_DONE
   e9f0   05                    DCR     B
   e9f1   c2 e9 e9              JNZ     SD6_RX
   e9f4                 SD6_DONE:
   e9f4   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success, CY=1 if 255 bytes pass with no token.
   e9f5                 SD_WAITTKN:
   e9f5   06 ff                 MVI     B,0FFH
   e9f7                 SD_WT:
   e9f7   db 53                 IN      SD_DATA
   e9f9   fe fe                 CPI     0FEH
   e9fb   ca 04 ea              JZ      SD_WT_OK
   e9fe   05                    DCR     B
   e9ff   c2 f7 e9              JNZ     SD_WT
   ea02   37                    STC
   ea03   c9                    RET
   ea04                 SD_WT_OK:
   ea04   b7                    ORA     A               ; clear CY
   ea05   c9                    RET
                        
                        ; SD_INIT: full SPI-mode initialization of the SD card.  Called from BOOT so a
                        ;   logged-in drive C is ready.  A = 0 on success (card entering SPI mode and
                        ;   initializing), 0FFh if no card / init failed (drive C reads will then error).
                        ;   This is the same handshake as sdprobe/sdtool (CMD0 -> CMD8 -> CMD55/ACMD41).
   ea06                 SD_INIT:
   ea06   3e 03                 MVI     A,03H           ; CS high + slow clock
   ea08   d3 54                 OUT     SD_CTL
   ea0a   06 0a                 MVI     B,10            ; 10 x 0xFF = 80 power-up clocks
   ea0c                 SDI_CK:
   ea0c   3e ff                 MVI     A,0FFH
   ea0e   d3 53                 OUT     SD_DATA
   ea10   05                    DCR     B
   ea11   c2 0c ea              JNZ     SDI_CK
   ea14   3e 02                 MVI     A,02H           ; select the card (CS low), slow clock
   ea16   d3 54                 OUT     SD_CTL
                                ; CMD0 + read R1
   ea18   21 65 ea              LXI     H,SDCMD0
   ea1b   cd d8 e9              CALL    SD_SEND6        ; A = R1 (01h = idle, or 0FFh if no response)
   ea1e   fe 01                 CPI     01H
   ea20   c2 4b ea              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) - required before ACMD41 on SDHC/SDXC
   ea23   21 6b ea              LXI     H,SDCMD8
   ea26   cd d8 e9              CALL    SD_SEND6
   ea29   db 53                 IN      SD_DATA         ; consume the 4-byte R7 payload
   ea2b   db 53                 IN      SD_DATA
   ea2d   db 53                 IN      SD_DATA
   ea2f   db 53                 IN      SD_DATA
                                ; CMD55 + ACMD41 poll until the card leaves idle
   ea31   16 c8                 MVI     D,200
   ea33                 SDI_RDY:
   ea33   21 71 ea              LXI     H,SDCMD55
   ea36   cd d8 e9              CALL    SD_SEND6
   ea39   21 77 ea              LXI     H,SDACMD
   ea3c   cd d8 e9              CALL    SD_SEND6        ; A = R1
   ea3f   fe 00                 CPI     00H
   ea41   ca 4e ea              JZ      SDI_OK
   ea44   cd 51 ea              CALL    SD_DELAY        ; ~3ms between attempts (card init is time-based)
   ea47   15                    DCR     D
   ea48   c2 33 ea              JNZ     SDI_RDY
   ea4b                 SDI_FAIL:
   ea4b   3e ff                 MVI     A,0FFH
   ea4d   c9                    RET
   ea4e                 SDI_OK:
   ea4e   3e 00                 MVI     A,00H
   ea50   c9                    RET
                        
                        ; SD_DELAY: approximate ~3ms busy-wait (HL only; for SD init polling).
   ea51                 SD_DELAY:
   ea51   21 d0 07              LXI     H,2000
   ea54                 SDDL:
   ea54   2b                    DCX     H
   ea55   7c                    MOV     A,H
   ea56   b5                    ORA     L
   ea57   c2 54 ea              JNZ     SDDL
   ea5a   c9                    RET
                        
                        ; SD_RDLY: ~10 ms recovery delay (65536 iterations).  Used BETWEEN drive-C retry
                        ;   attempts so a card that is still programming a block has time to finish --
                        ;   SD_DELAY (~1.6 ms) is far too short for that.
   ea5b                 SD_RDLY:
   ea5b   01 00 00              LXI     B,0000H
   ea5e                 SRDL1:
   ea5e   0b                    DCX     B
   ea5f   78                    MOV     A,B
   ea60   b1                    ORA     C
   ea61   c2 5e ea              JNZ     SRDL1
   ea64   c9                    RET
                        
   ea65   40 00 00 00   SDCMD0: DB      40H,00H,00H,00H,00H,95H
   ea69   00 95         
   ea6b   48 00 00 01   SDCMD8: DB      48H,00H,00H,01H,0AAH,87H
   ea6f   aa 87         
   ea71   77 00 00 00   SDCMD55: DB     77H,00H,00H,00H,00H,65H
   ea75   00 65         
   ea77   69 40 00 00   SDACMD: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   ea7b   00 77         
                        
                        ; ============================================================================
                        ;   SD SYSTEM-AREA IMAGE I/O  (used by BOOT/WBOOT to persist/reload the system)
                        ;   Each reserved SD volume begins with a system area (SDSYS_OFF sectors) that
                        ;   holds the CP/M boot image (CCP+BDOS+CBIOS, CPMIMGLEN bytes).  These routines
                        ;   move the image between the SD (region 0 system area, BLKN = SDPLBA) and
                        ;   machine RAM, whole 512-byte sectors at a time (CPMIMGLEN is a multiple of
                        ;   512).  They are called by BOOT (persist) and WBOOT (reload).
                        ; ============================================================================
                        ; SD_SETBLK0: set BLKN (32-bit, MSB first) to the SDPLBA region-0 system-area base.
   ea7d                 SD_SETBLK0:
   ea7d   af                    XRA     A
   ea7e   32 e1 ee              STA     BLKN+0
   ea81   32 e2 ee              STA     BLKN+1
   ea84   32 e3 ee              STA     BLKN+2
   ea87   3e 01                 MVI     A,SDPLBA        ; SDPLBA = 1 (fits in the low byte)
   ea89   32 e4 ee              STA     BLKN+3
   ea8c   c9                    RET
                        
                        ; SD_INCBLK: increment the 32-bit BLKN (MSB first) by one SD sector.
   ea8d                 SD_INCBLK:
   ea8d   3a e4 ee              LDA     BLKN+3
   ea90   3c                    INR     A
   ea91   32 e4 ee              STA     BLKN+3
   ea94   c2 b2 ea              JNZ     SDINC_DONE
   ea97   3a e3 ee              LDA     BLKN+2
   ea9a   3c                    INR     A
   ea9b   32 e3 ee              STA     BLKN+2
   ea9e   c2 b2 ea              JNZ     SDINC_DONE
   eaa1   3a e2 ee              LDA     BLKN+1
   eaa4   3c                    INR     A
   eaa5   32 e2 ee              STA     BLKN+1
   eaa8   c2 b2 ea              JNZ     SDINC_DONE
   eaab   3a e1 ee              LDA     BLKN+0
   eaae   3c                    INR     A
   eaaf   32 e1 ee              STA     BLKN+0
   eab2                 SDINC_DONE:
   eab2   c9                    RET
                        
                        ; SDWRIMG: write BC bytes from (HL) to the SD at the current BLKN (advancing).
                        ;   BC must be a non-zero multiple of 512 (the sector buffer size).  Returns
                        ;   A=0 if all sectors written, 0FFh if any failed.  Clobbers A,B,C,D,E,H,L.
   eab3                 SDWRIMG:
   eab3   7d                    MOV     A,L
   eab4   32 b2 ec              STA     SDIMGSRC
   eab7   7c                    MOV     A,H
   eab8   32 b3 ec              STA     SDIMGSRC+1      ; SDIMGSRC = HL (little-endian word)
   eabb   78                    MOV     A,B
   eabc   0f                    RRC                     ; sector count = BC/512 (BC is a multiple of 512, C=0)
   eabd   32 b4 ec              STA     SDIMGC
   eac0                 SDWR_LP:
   eac0   2a b2 ec              LHLD    SDIMGSRC
   eac3   cd 48 e9              CALL    SD_WRITEBLK     ; write 512 bytes from (HL) to BLKN
   eac6   b7                    ORA     A
   eac7   c2 e3 ea              JNZ     SDWR_ERR
   eaca   2a b2 ec              LHLD    SDIMGSRC
   eacd   11 00 02              LXI     D,512
   ead0   19                    DAD     D
   ead1   22 b2 ec              SHLD    SDIMGSRC
   ead4   cd 8d ea              CALL    SD_INCBLK
   ead7   3a b4 ec              LDA     SDIMGC
   eada   3d                    DCR     A
   eadb   32 b4 ec              STA     SDIMGC
   eade   c2 c0 ea              JNZ     SDWR_LP
   eae1   af                    XRA     A
   eae2   c9                    RET
   eae3                 SDWR_ERR:
   eae3   3e ff                 MVI     A,0FFH
   eae5   c9                    RET
                        
                        ; SDREADIMG: read BC bytes from the SD at the current BLKN (advancing) into (HL).
                        ;   BC must be a non-zero multiple of 512.  Returns A=0 ok / 0FFh err.
   eae6                 SDREADIMG:
   eae6   7d                    MOV     A,L
   eae7   32 b2 ec              STA     SDIMGSRC
   eaea   7c                    MOV     A,H
   eaeb   32 b3 ec              STA     SDIMGSRC+1      ; SDIMGSRC = HL (little-endian word)
   eaee   78                    MOV     A,B
   eaef   0f                    RRC                     ; sector count = BC/512
   eaf0   32 b4 ec              STA     SDIMGC
   eaf3                 SDRD_LP:
   eaf3   2a b2 ec              LHLD    SDIMGSRC
   eaf6   cd f0 e8              CALL    SD_READBLK      ; read 512 bytes from BLKN into (HL)
   eaf9   b7                    ORA     A
   eafa   c2 16 eb              JNZ     SDRD_ERR
   eafd   2a b2 ec              LHLD    SDIMGSRC
   eb00   11 00 02              LXI     D,512
   eb03   19                    DAD     D
   eb04   22 b2 ec              SHLD    SDIMGSRC
   eb07   cd 8d ea              CALL    SD_INCBLK
   eb0a   3a b4 ec              LDA     SDIMGC
   eb0d   3d                    DCR     A
   eb0e   32 b4 ec              STA     SDIMGC
   eb11   c2 f3 ea              JNZ     SDRD_LP
   eb14   af                    XRA     A
   eb15   c9                    RET
   eb16                 SDRD_ERR:
   eb16   3e ff                 MVI     A,0FFH
   eb18   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   eb19                 RAMWR:
   eb19   cd 57 e7              CALL    RAMPTR
   eb1c                 RAMWR1:
   eb1c   1a                    LDAX    D
   eb1d   d3 20                 OUT     20H
   eb1f   13                    INX     D
   eb20   0b                    DCX     B
   eb21   78                    MOV     A,B
   eb22   b1                    ORA     C
   eb23   c2 1c eb              JNZ     RAMWR1
   eb26   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   eb27                 RAMRD:
   eb27   cd 57 e7              CALL    RAMPTR
   eb2a                 RAMRD1:
   eb2a   db 20                 IN      20H
   eb2c   12                    STAX    D
   eb2d   13                    INX     D
   eb2e   0b                    DCX     B
   eb2f   78                    MOV     A,B
   eb30   b1                    ORA     C
   eb31   c2 2a eb              JNZ     RAMRD1
   eb34   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   eb35                 RAMFILL:
   eb35   32 b1 ec              STA     FILLV
   eb38   cd 57 e7              CALL    RAMPTR
   eb3b                 RAMFILL1:
   eb3b   3a b1 ec              LDA     FILLV
   eb3e   d3 20                 OUT     20H
   eb40   0b                    DCX     B
   eb41   78                    MOV     A,B
   eb42   b1                    ORA     C
   eb43   c2 3b eb              JNZ     RAMFILL1
   eb46   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE A:  SPI FLASH  (ISSI IS25LD040 as CP/M drive A:)
                        ;
                        ;   Flash layout (MUST match diskutil's 'S' formatter and the drive A: DPB):
                        ;       0x00000-0x01FFF  (8KB, tracks 0-1)   reserved system (erased 0xFF)
                        ;       0x02000-0x7FFFF  (504KB, tracks 2-127) user data area = 252 blocks
                        ;           Block 0  (0x2000-0x27FF) + Block 1 (0x2800-0x2FFF) directory
                        ;                     (2KB each, reserved via AL0=0xC0) = 128 x 32-byte entries
                        ;           Blocks 2..251 (0x3000-0x7FFFF) file data (250 blocks = 500KB)
                        ;
                        ;   Address formula (same as the drive B: RAM-disk CALC, but 24-bit -- the flash is
                        ;   512KB and exceeds 16 bits):  flash_addr = TRK*0x1000 + SECN*0x80
                        ;   (SPT=32, record=128).  The BDOS passes the absolute track (it already added
                        ;   the DPB offset), so OFF is NOT re-added here.
                        ;
                        ;   Erase-before-write is mandatory and the flash only erases at 4KB granularity
                        ;   (sector = 0x20 opcode).  With 2KB CP/M blocks a CP/M block is HALF an erase
                        ;   sector, so two CP/M blocks share one physical 4KB sector.  Writes are still
                        ;   correct: a WRITE does a 4KB read-modify-write (read the whole 4KB sector
                        ;   into RMWBUF, overlay the 128-byte record at its offset, erase the sector,
                        ;   then page-program it back 16 x 256B), which reads back and thus PRESERVES
                        ;   the other CP/M block that shares the sector.  Correctness first; a
                        ;   dirty-sector cache is a later optimization.
                        ; ============================================================================
                        
                        ; ---- shared SPI driver (physical primitives + 24-bit ops) ----
                                INCL    "spi.inc"
                        ; ============================================================================
                        ; spi.inc -- shared 24-bit-capable SPI flash driver for the ISSI IS25LD040.
                        ; Included by BOTH diskutil (ORG 1000H) and cbios (ORG FA00H) so the physical
                        ; SPI protocol cannot drift between the two consumers.  Includes only
                        ; protocol-level primitives (selection, byte transfer, WIP wait, 24-bit
                        ; address send) and the bulk operations drive B: needs (page program, bulk
                        ; read, 4K sector erase).  Higher-level logic (CP/M read-modify-write, the
                        ; format routine) lives in each including program.
                        ;
                        ; Ports (must be defined by the including program BEFORE the INCL):
                        ;   SPI_DATA = 50H   read clocks 1 byte in / write clocks 1 byte out (MSB first)
                        ;   SPI_CTL  = 51H   write bit0 = CS# (0 = select low, 1 = release high)
                        ;   SPI_STAT = 52H   read bit0 = transfer busy (poll OPTIONAL -- the RTL byte
                        ;                               engine stretches the CPU wait on every 0x50
                        ;                               access, so back-to-back 0x50 completes in-cycle)
                        ;
                        ; Convention: the 24-bit flash address for an operation is held in the FBADDR
                        ; 3-byte block declared below.  Byte order is little-endian by FIELD:
                        ;   FBADDR+0 = A7-A0  (low byte)
                        ;   FBADDR+1 = A15-A8 (mid byte)
                        ;   FBADDR+2 = A23-A16(high byte)
                        ; SPI_ADDR transmits them MSB-first (A23-A16, A15-A8, A7-A0), which is the
                        ; order the IS25LD040 command set requires.
                        ;
                        ; Each routine documents which registers it clobbers.  A85 note: this file is
                        ; assembled inline at the INCL point, so FBADDR is allocated at that location
                        ; in each including program's address space (fine -- it is referenced purely
                        ; symbolically).  Do NOT add an ORG or END to this file; a85 splices it.
                        ; ============================================================================
                        
                        ; ---------------- CS# and byte transfer primitives ----------------
                        ; SPI_SEL: pull CS# low (select the flash).  Clobbers A.
   eb47   3e 00         SPI_SEL: MVI     A,00H
   eb49   d3 51                  OUT     SPI_CTL
   eb4b   c9                     RET
                        
                        ; SPI_REL: release CS# high (deselect the flash).  Clobbers A.
   eb4c   3e 01         SPI_REL: MVI     A,01H
   eb4e   d3 51                  OUT     SPI_CTL
   eb50   c9                     RET
                        
                        ; SPI_XMIT: clock the byte in A out to the flash; the byte returned is
                        ; discarded.  A is unchanged (OUT does not modify A).  No other regs touched.
   eb51   d3 50         SPI_XMIT: OUT     SPI_DATA
   eb53   c9                     RET
                        
                        ; SPI_WAIT: poll the RDSR (0x05) status until WIP (bit0) clears.  Re-selects
                        ; the flash and keeps CS# low across the status reads.  Clobbers A.
   eb54   cd 47 eb      SPI_WAIT: CALL    SPI_SEL
   eb57   3e 05                  MVI     A,05H
   eb59   cd 51 eb               CALL    SPI_XMIT                ; RDSR opcode
   eb5c   db 50         SPW:     IN      SPI_DATA                ; read status byte
   eb5e   e6 01                  ANI     01H                     ; WIP (bit0) still busy?
   eb60   c2 5c eb               JNZ     SPW                     ; loop until the flash is idle
   eb63   cd 4c eb               CALL    SPI_REL
   eb66   c9                     RET
                        
                        ; ---------------- 24-bit address send ----------------
                        ; SPI_ADDR: send the three FBADDR bytes as the command address (A23-A16,
                        ; A15-A8, A7-A0, MSB first).  Must be called with CS# already selected.
                        ; Clobbers A.
   eb67   3a da eb      SPI_ADDR: LDA     FBADDR+2
   eb6a   cd 51 eb               CALL    SPI_XMIT                ; A23-A16
   eb6d   3a d9 eb               LDA     FBADDR+1
   eb70   cd 51 eb               CALL    SPI_XMIT                ; A15-A8
   eb73   3a d8 eb               LDA     FBADDR
   eb76   cd 51 eb               CALL    SPI_XMIT                ; A7-A0
   eb79   c9                     RET
                        
                        ; ---------------- page program (0x02) ----------------
                        ; SPI_PAGE: program a full 256-byte page from (HL) at the page-aligned FBADDR.
                        ; FBADDR must be 256-byte aligned (the flash's page program wraps within a
                        ; page if it crosses the boundary).  Issues WREN (0x06, CS# toggled to latch it
                        ; -- REQUIRED before every program/erase on the IS25LD040), then the page-
                        ; program command and 256 data bytes in one CS#-low sequence.  Clobbers A, B,
                        ; HL (HL is advanced 256 bytes / left at HL+256).
   eb7a   cd 47 eb      SPI_PAGE: CALL    SPI_SEL
   eb7d   3e 06                  MVI     A,06H                   ; WREN (mandatory before every program)
   eb7f   cd 51 eb               CALL    SPI_XMIT
   eb82   cd 4c eb               CALL    SPI_REL                 ; latch WREN (CS# must toggle)
   eb85   cd 47 eb               CALL    SPI_SEL
   eb88   3e 02                  MVI     A,02H                   ; Page Program opcode
   eb8a   cd 51 eb               CALL    SPI_XMIT
   eb8d   cd 67 eb               CALL    SPI_ADDR
   eb90   06 00                  MVI     B,00H                   ; 256 bytes (0 wraps to 256 on DCR)
   eb92   7e            SPG1:    MOV     A,M
   eb93   cd 51 eb               CALL    SPI_XMIT
   eb96   23                     INX     H
   eb97   05                     DCR     B
   eb98   c2 92 eb               JNZ     SPG1
   eb9b   cd 4c eb               CALL    SPI_REL
   eb9e   cd 54 eb               CALL    SPI_WAIT                ; wait for the program to settle
   eba1   c9                     RET
                        
                        ; ---------------- bulk read (0x03) ----------------
                        ; SPI_READBUF: read BC bytes from FBADDR into (DE), keeping CS# low across the
                        ; whole burst (this is the same pattern the proven diskutil DO_READ uses for
                        ; 16 bytes, extended to an arbitrary count).  Clobbers A, B, C, D, E (BC runs
                        ; down to 0, DE advances past the last byte read).
   eba2   cd 47 eb      SPI_READBUF: CALL    SPI_SEL
   eba5   3e 03                  MVI     A,03H                   ; Read opcode
   eba7   cd 51 eb               CALL    SPI_XMIT
   ebaa   cd 67 eb               CALL    SPI_ADDR
   ebad   db 50         SRDB:    IN      SPI_DATA                ; next byte the flash clocks out
   ebaf   12                     STAX    D
   ebb0   13                     INX     D
   ebb1   0b                     DCX     B
   ebb2   78                     MOV     A,B
   ebb3   b1                     ORA     C
   ebb4   c2 ad eb               JNZ     SRDB
   ebb7   cd 4c eb               CALL    SPI_REL
   ebba   c9                     RET
                        
                        ; ---------------- 4KB sector erase (0x20) ----------------
                        ; SPI_ERASE_SECT: erase the 4KB sector containing FBADDR.  FBADDR must be
                        ; pre-set to the sector base (the low 12 bits clear) so only that one sector
                        ; is erased.  Issues WREN, then the sector-erase command.  Clobbers A.
   ebbb   cd 47 eb      SPI_ERASE_SECT: CALL    SPI_SEL
   ebbe   3e 06                  MVI     A,06H                   ; WREN (required before every program)
   ebc0   cd 51 eb               CALL    SPI_XMIT
   ebc3   cd 4c eb               CALL    SPI_REL                 ; latch WREN
   ebc6   cd 47 eb               CALL    SPI_SEL
   ebc9   3e 20                  MVI     A,20H                   ; Sector Erase (4KB) opcode
   ebcb   cd 51 eb               CALL    SPI_XMIT
   ebce   cd 67 eb               CALL    SPI_ADDR
   ebd1   cd 4c eb               CALL    SPI_REL
   ebd4   cd 54 eb               CALL    SPI_WAIT                ; wait for the erase to finish
   ebd7   c9                     RET
                        
                        ; ---------------- FBADDR: the 24-bit address block ----------------
   ebd8                 FBADDR:  DS      3                       ; A7-A0, A15-A8, A23-A16
                        
                        
                        ; FLADDR: compute FBADDR = TRK*0x1000 + SECN*0x80, the 24-bit flash byte address
                        ; of the selected record, split (validated against 0x7FF80 for TRK=127,SEC=31):
                        ;     byte2 (A23-A16) = TRK >> 4
                        ;     byte1 (A15-A8)  = ((TRK & 0x0F) << 4) | (SECN >> 1)
                        ;     byte0 (A7-A0)   = (SECN & 1) << 7
                        ; (SECN*0x80 < 0x1000 so it never carries into the TRK*0x1000 field.)  Clobbers
                        ; A, B, C, D.
   ebdb                 FLADDR:
   ebdb   3a ac ec              LDA     TRK
   ebde   47                    MOV     B,A             ; B = TRK
   ebdf   3a ae ec              LDA     SECN
   ebe2   4f                    MOV     C,A             ; C = SECN
                                ; byte2 (A23-A16) = TRK >> 4
   ebe3   78                    MOV     A,B
   ebe4   e6 f0                 ANI     0F0H
   ebe6   0f                    RRC
   ebe7   0f                    RRC
   ebe8   0f                    RRC
   ebe9   0f                    RRC
   ebea   32 da eb              STA     FBADDR+2
                                ; byte1 (A15-A8) = ((TRK & 0x0F) << 4) | (SECN >> 1)
   ebed   78                    MOV     A,B
   ebee   e6 0f                 ANI     0FH
   ebf0   07                    RLC
   ebf1   07                    RLC
   ebf2   07                    RLC
   ebf3   07                    RLC
   ebf4   57                    MOV     D,A
   ebf5   79                    MOV     A,C
   ebf6   0f                    RRC
   ebf7   e6 7f                 ANI     7FH
   ebf9   b2                    ORA     D
   ebfa   32 d9 eb              STA     FBADDR+1
                                ; byte0 (A7-A0) = (SECN & 1) << 7
   ebfd   79                    MOV     A,C
   ebfe   e6 01                 ANI     01H
   ec00   ca 08 ec              JZ      FLAD0
   ec03   3e 80                 MVI     A,80H
   ec05   c3 09 ec              JMP     FLADR
   ec08   af            FLAD0:  XRA     A
   ec09   32 d8 eb      FLADR:  STA     FBADDR
   ec0c   c9                    RET
                        
                        ; READB: read one 128-byte sector from the SPI flash (drive A:) into the DMA
                        ; buffer.  Returns A=0.  (A flash read is error-free.)
   ec0d                 READB:
   ec0d   cd db eb              CALL    FLADDR          ; FBADDR = 24-bit record address
   ec10   2a af ec              LHLD    DMA
   ec13   54                    MOV     D,H
   ec14   5d                    MOV     E,L             ; DE = DMA destination
   ec15   01 80 00              LXI     B,80H           ; 128 bytes
   ec18   cd a2 eb              CALL    SPI_READBUF
   ec1b   3e 00                 MVI     A,00H           ; success
   ec1d   c9                    RET
                        
                        ; WRITEB: write one 128-byte sector to the SPI flash (drive A:) via a 4KB
                        ; read-modify-write.  Returns A=0.  Clobbers A,B,D,E,H,L.
   ec1e                 WRITEB:
   ec1e   cd db eb              CALL    FLADDR          ; FBADDR = 24-bit record address
                                ; ---- save the record's in-sector offset (FBADDR & 0xFFF) ----
   ec21   3a d8 eb              LDA     FBADDR
   ec24   32 f5 ec              STA     RECOFF          ; offset low byte
   ec27   3a d9 eb              LDA     FBADDR+1
   ec2a   e6 0f                 ANI     0FH
   ec2c   32 f6 ec              STA     RECOFF+1        ; offset high nibble (0..0x0F)
                                ; ---- set FBADDR to the enclosing 4KB sector base (clear low 12 bits) ----
   ec2f   3a d9 eb              LDA     FBADDR+1
   ec32   e6 f0                 ANI     0F0H
   ec34   32 d9 eb              STA     FBADDR+1
   ec37   af                    XRA     A
   ec38   32 d8 eb              STA     FBADDR          ; low byte of the sector base = 0
                                ; ---- read the whole 4KB sector into the RMW buffer ----
   ec3b   11 00 ef              LXI     D,RMWBUF
   ec3e   01 00 10              LXI     B,1000H         ; 4096 bytes
   ec41   cd a2 eb              CALL    SPI_READBUF
                                ; ---- overlay the 128-byte DMA record at the in-sector offset ----
   ec44   2a af ec              LHLD    DMA
   ec47   11 00 ef              LXI     D,RMWBUF
   ec4a   3a f5 ec              LDA     RECOFF
   ec4d   83                    ADD     E
   ec4e   5f                    MOV     E,A
   ec4f   3a f6 ec              LDA     RECOFF+1
   ec52   8a                    ADC     D
   ec53   57                    MOV     D,A             ; DE = RMWBUF + offset
   ec54   06 80                 MVI     B,128
   ec56   7e            WRCPY:  MOV     A,M
   ec57   12                    STAX    D
   ec58   23                    INX     H
   ec59   13                    INX     D
   ec5a   05                    DCR     B
   ec5b   c2 56 ec              JNZ     WRCPY
                                ; ---- erase the 4KB sector (FBADDR = sector base) ----
   ec5e   cd bb eb              CALL    SPI_ERASE_SECT
                                ; ---- program the whole 4KB sector back, 16 x 256B pages ----
   ec61   21 00 ef              LXI     H,RMWBUF
   ec64   06 10                 MVI     B,16            ; 16 pages
   ec66   c5            WRPG:   PUSH    B
   ec67   cd 7a eb              CALL    SPI_PAGE        ; programs 256 bytes from (HL), advances HL by 256
   ec6a   3a d9 eb              LDA     FBADDR+1
   ec6d   c6 01                 ADI     01H
   ec6f   32 d9 eb              STA     FBADDR+1        ; next page (low byte stays 00, high byte unchanged)
   ec72   c1                    POP     B
   ec73   05                    DCR     B
   ec74   c2 66 ec              JNZ     WRPG
   ec77   3e 00                 MVI     A,00H           ; success
   ec79   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   ec7a                 BANNER:
   ec7a   0d 0a                 DB      0DH,0AH                          ; blank line before the banner
   ec7c   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH
   ec80   20 32 2e 32   
   ec84   20 6f 6e 20   
   ec88   42 72 65 76   
   ec8c   69 61 32 0d   
   ec90   0a            
   ec91   43 50 2f 4d           DB      'CP/M port by Whale-Chan',0DH,0AH,0
   ec95   20 70 6f 72   
   ec99   74 20 62 79   
   ec9d   20 57 68 61   
   eca1   6c 65 2d 43   
   eca5   68 61 6e 0d   
   eca9   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   ecab                 SELBL:  DS      1               ; last selected drive
   ecac                 TRK:    DS      2               ; current (absolute) track -- 16-bit!  CP/M 2 passes
                                                        ; the track as a WORD in BC (DRI manual Table 6-5),
                                                        ; and a DPB with >256 tracks (8 MB at SPT=32 needs
                                                        ; tracks up to 2047) REQUIRES the high byte.  TRK+0 =
                                                        ; low byte (from C), TRK+1 = high byte (from B).
   ecae                 SECN:   DS      1               ; current sector
   ecaf                 DMA:    DS      2               ; current DMA address
   ecb1                 FILLV:  DS      1               ; scratch for RAMFILL
   ecb2                 SDIMGSRC: DS    2               ; SD system-area image copy: source/destination pointer
   ecb4                 SDIMGC: DS      1               ; SD system-area image copy: SD sectors remaining
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADERS / BLOCKS / VECTORS
                        ;   The BDOS builds the allocation vector itself on first drive login (never
                        ;   zero/prime it -- uninitialised DS is fine).  There are FOUR media sets:
                        ;   flash, RAM disk, SD region 0 and SD region 1.  The drive-letter -> media
                        ;   mapping is entirely in SELDSK (build-config dependent); the physical READ/
                        ;   WRITE dispatch uses SELBL to pick the path.  DIRBUF is shared by all drives
                        ;   (only one is operated at a time).
                        ;
                        ;   The SD DRIVE geometry uses OFF=0 and places the reserved system area at the
                        ;   CBIOS deblock layer (SDMAP adds SDSYS_OFF + region offset) -- the BDOS does
                        ;   NOT reliably apply the DPB OFF field, so the region/system offset cannot
                        ;   live in the DPB.
                        ; ============================================================================
                        
                        ; ---- SPI flash (on-board ISSI IS25LD040, drive A in the SPI build) ----------
                        ;   Geometry: SPT=32, 2KB allocation (BSH=4/BLM=15), OFF=2 (tracks 0-1 reserved
                        ;   for the CP/M boot image), directory = blocks 0-1 via AL0=0xC0 (128 entries),
                        ;   DSM=251 (single-DM).  MUST agree with the formatter (data at 0x3000).
   ecb5                 DPHFLASH:
   ecb5   00 00                 DW      0000H           ; XLT: no sector translation
   ecb7   00 00                 DW      0000H           ; scratch (cdrmax)
   ecb9   00 00                 DW      0000H           ; scratch (curtrk)
   ecbb   00 00                 DW      0000H           ; scratch (currec)
   ecbd   1f ed                 DW      DIRBUF          ; directory buffer (128 bytes)
   ecbf   c5 ec                 DW      DPBFLASH        ; disk parameter block (flash 2K geometry)
   ecc1   d4 ec                 DW      CSVFLASH        ; checksum vector
   ecc3   d5 ec                 DW      ALVFLASH        ; allocation vector
   ecc5                 DPBFLASH:
   ecc5   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   ecc7   04                    DB      04H             ; BSH  = 4    (block shift -> 2KB blocks)
   ecc8   0f                    DB      0FH             ; BLM  = 15   (block mask)
   ecc9   01                    DB      01H             ; EXM  = 1    (BLS=2048 & DSM<256 -> single-DM)
   ecca   fb 00                 DW      251             ; DSM  = 251  (252 blocks, single-DM)
   eccc   7f 00                 DW      127             ; DRM  = 127  (128 entries)
   ecce   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   eccf   00                    DB      00H             ; AL1  = 0x00
   ecd0   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   ecd2   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   ecd4                 CSVFLASH: DS    1               ; checksum vector (0 bytes used since CKS=0)
   ecd5                 ALVFLASH: DS    32              ; allocation vector (DSM=251 -> (251/8)+1 = 32 bytes)
   ecf5                 RECOFF: DS      2               ; in-sector byte offset for the flash RMW
                        
                        ; ---- RAM disk (bank B, 64K, volatile; drive B in the SPI build) ------------
                        ;   Geometry: SPT=32, 1K allocation (BSH=3/BLM=7), OFF=2 (tracks 0-1 system),
                        ;   DSM=55, DRM=63.  The legacy SPI build's BOOT persists CCP/BDOS to these.
   ecf7                 DPHRAM:
   ecf7   00 00                 DW      0000H           ; XLT
   ecf9   00 00                 DW      0000H           ; scratch (cdrmax)
   ecfb   00 00                 DW      0000H           ; scratch (curtrk)
   ecfd   00 00                 DW      0000H           ; scratch (currec)
   ecff   1f ed                 DW      DIRBUF          ; shared directory buffer
   ed01   07 ed                 DW      DPBRAM          ; disk parameter block (RAM disk 1K geometry)
   ed03   16 ed                 DW      CSVRAM          ; checksum vector
   ed05   17 ed                 DW      ALVRAM          ; allocation vector
   ed07                 DPBRAM:
   ed07   20 00                 DW      SPT             ; SPT  = 32
   ed09   03                    DB      03H             ; BSH  = 3    (1K blocks)
   ed0a   07                    DB      07H             ; BLM  = 7
   ed0b   00                    DB      00H             ; EXM  = 0
   ed0c   37 00                 DW      55              ; DSM  = 55  (56 blocks)
   ed0e   3f 00                 DW      63              ; DRM  = 63  (64 entries)
   ed10   c0                    DB      0C0H            ; AL0  = 0xC0
   ed11   00                    DB      00H             ; AL1  = 0x00
   ed12   00 00                 DW      00H             ; CKS  = 0
   ed14   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   ed16                 CSVRAM: DS      1
   ed17                 ALVRAM: DS      8               ; allocation vector (DSM=55 -> (55/8)+1 = 8 bytes)
   ed1f                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
                        ; ---- SD region 0 (drive A in the SD build; boot/system volume) -------------
                        ;   Geometry: SPT=32, 8KB allocation (BSH=6/BLM=63), DSM=1023 (double-DM, 8 MB),
                        ;   DRM=4095 (4096 entries), AL0/AL1=0xFF (16 directory blocks), OFF=0 (the
                        ;   reserved system area + region base are added in SDMAP).
   ed9f                 DPHSD0:
   ed9f   00 00                 DW      0000H           ; XLT
   eda1   00 00                 DW      0000H           ; scratch (cdrmax)
   eda3   00 00                 DW      0000H           ; scratch (curtrk)
   eda5   00 00                 DW      0000H           ; scratch (currec)
   eda7   1f ed                 DW      DIRBUF          ; shared directory buffer
   eda9   af ed                 DW      DPBSD0          ; disk parameter block (SD 8K geometry, OFF=0)
   edab   be ed                 DW      CSVSD0          ; checksum vector (CKS=0 -> 0 bytes)
   edad   bf ed                 DW      ALVSD0          ; allocation vector
   edaf                 DPBSD0:
   edaf   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   edb1   06                    DB      06H             ; BSH  = 6    (block shift -> 8KB blocks)
   edb2   3f                    DB      3FH             ; BLM  = 63   (block mask)
   edb3   03                    DB      03H             ; EXM  = 3    (DSM>255 & BLS=8192 -> double-DM)
   edb4   ff 03                 DW      1023            ; DSM  = 1023 (1024 blocks x 8KB = 8 MB)
   edb6   ff 0f                 DW      4095            ; DRM  = 4095 (4096 entries)
   edb8   ff                    DB      0FFH            ; AL0  = 0xFF (reserve directory blocks 0-7)
   edb9   ff                    DB      0FFH            ; AL1  = 0xFF (reserve directory blocks 8-15)
   edba   00 00                 DW      00H             ; CKS  = 0
   edbc   00 00                 DW      00H             ; OFF  = 0    (region 0; system area via SDMAP)
   edbe                 CSVSD0: DS      1
   edbf                 ALVSD0: DS      128             ; allocation vector (DSM=1023 -> (1023+1)/8 = 128 B)
                        
                        ; ---- SD region 1 (drive B in the SD build; second SD volume) ---------------
                        ;   Same geometry as region 0; the region base (+0x4000 sectors) AND the
                        ;   reserved system area (SDSYS_OFF) are added in SDMAP for SELBL==1.
   ee3f                 DPHSD1:
   ee3f   00 00                 DW      0000H           ; XLT
   ee41   00 00                 DW      0000H           ; scratch (cdrmax)
   ee43   00 00                 DW      0000H           ; scratch (curtrk)
   ee45   00 00                 DW      0000H           ; scratch (currec)
   ee47   1f ed                 DW      DIRBUF          ; shared directory buffer
   ee49   4f ee                 DW      DPBSD1          ; disk parameter block (SD 8K geometry, OFF=0)
   ee4b   5e ee                 DW      CSVSD1          ; checksum vector
   ee4d   5f ee                 DW      ALVSD1          ; allocation vector
   ee4f                 DPBSD1:
   ee4f   20 00                 DW      SPT             ; SPT  = 32
   ee51   06                    DB      06H             ; BSH  = 6    (8KB blocks)
   ee52   3f                    DB      3FH             ; BLM  = 63
   ee53   03                    DB      03H             ; EXM  = 3    (double-DM)
   ee54   ff 03                 DW      1023            ; DSM  = 1023
   ee56   ff 0f                 DW      4095            ; DRM  = 4095
   ee58   ff                    DB      0FFH            ; AL0  = 0xFF
   ee59   ff                    DB      0FFH            ; AL1  = 0xFF
   ee5a   00 00                 DW      00H             ; CKS  = 0
   ee5c   00 00                 DW      00H             ; OFF  = 0    (region 1; region+system offset via SDMAP)
   ee5e                 CSVSD1: DS      1
   ee5f                 ALVSD1: DS      128             ; allocation vector (DSM=1023 -> 128 B)
                        
   eedf                 SDOFF:  DS      2               ; in-sector byte offset for the SD deblock
   eee1                 BLKN:   DS      4               ; SD block number (32-bit, MSB first); system area + record/4
   eee5                 SDCMDB: DS      6               ; SD command buffer (opcode + 4-byte arg + CRC)
   eeeb                 SDTRY:  DS      1               ; SD retry counter (READC/WRITEC)
                        
   eeec                         END
