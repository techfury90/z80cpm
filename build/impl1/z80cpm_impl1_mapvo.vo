module uart_tx_MGIOL ( output IOLDO, input ONEG0, CE, LSR, CLK );
  wire   ONEG0_dly, CLK_dly, CE_dly, LSR_dly;

  mfflsre u_tx_txdio( .D0(ONEG0_dly), .SP(CE_dly), .CK(CLK_dly), .LSR(LSR_dly), 
    .Q(IOLDO));

  specify
    (LSR => IOLDO) = (0:0:0,0:0:0);
    (CLK => IOLDO) = (0:0:0,0:0:0);
    $setuphold (posedge CLK, ONEG0, 0:0:0, 0:0:0,,,, CLK_dly, ONEG0_dly);
    $setuphold (posedge CLK, CE, 0:0:0, 0:0:0,,,, CLK_dly, CE_dly);
    $setuphold (posedge CLK, LSR, 0:0:0, 0:0:0,,,, CLK_dly, LSR_dly);
  endspecify

endmodule

module mfflsre ( input D0, SP, CK, LSR, output Q );

  FD1P3BX INST01( .D(D0), .SP(SP), .CK(CK), .PD(LSR), .Q(Q));
  defparam INST01.GSR = "DISABLED";
endmodule

