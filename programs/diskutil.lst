                        ; ============================================================================
                        ; diskutil.s -- standalone RAM-disk maintenance utility for the Brevia2 Z80.
                        ;
                        ; Runs entirely OUTSIDE of CP/M. Loaded via GWMON-80 'L', run via 'G 1000'.
                        ; Uses the console UART (0x80 status / 0x81 data) for BOTH the menu and the
                        ; XMODEM file transfer, and the RAM-disk controller (0x20 DATA auto-inc,
                        ; 0x21 ADDR lo, 0x22 ADDR hi) for the CP/M disk layout in bank B.
                        ;
                        ; Commands:
                        ;   F  -- format drive A: (write 0xE5 to the 2K directory area)
                        ;   U  -- XMODEM upload (checksum mode): receive a file from the host PC and
                        ;         write it to the RAM disk as a CP/M file (multi-extent for >16K).
                        ;   D  -- XMODEM download: send a file from the RAM disk to the host PC.
                        ;   H  -- help
                        ;
                        ; XMODEM receive retries the initiating NAK with a ~1.5s timeout each cycle,
                        ; so the host (Tera Term / minicom) picks it up even if it starts the transfer
                        ; AFTER we began waiting. Supports checksum blocks (SOH) and CRC blocks (STX).
                        ;
                        ; Assembled with the Glitch Works a85 8085 cross-assembler (same as cbios.asm).
                        ; ============================================================================
                        
   1000                         ORG     1000H
                        
                        ; ---------------- Processor I/O ports ----------------
   0080                 USTAT   EQU     80H                     ; UART status (bit0 tx_busy, bit1 rx_avail)
   0081                 UDATA   EQU     81H                     ; UART data (read=RX char, write=TX char)
   0020                 RDDATA  EQU     20H                     ; RAM disk DATA (read/write, auto-increment)
   0021                 RDADRL  EQU     21H                     ; RAM disk ADDR low
   0022                 RDADRH  EQU     22H                     ; RAM disk ADDR high
                        
                        ; ---------------- CP/M drive A: disk layout (bank B) ----------------
   2000                 DIRBASE EQU     2000H                   ; directory area base (2K = 64 entries)
   2800                 DBLOCK0 EQU     2800H                   ; first USER data block (block 2) base
   0400                 BLKSZ   EQU     1024                    ; block size (1K)
   0080                 RECSZ   EQU     128                     ; CP/M record size
                        
                        ; ---------------- XMODEM control bytes ----------------
   0001                 XM_SOH  EQU     01H
   0002                 XM_STX  EQU     02H
   0004                 XM_EOT  EQU     04H
   0006                 XM_ACK  EQU     06H
   0015                 XM_NAK  EQU     15H
   0018                 XM_CAN  EQU     18H
   00fe                 XM_TO   EQU     0FEH                    ; internal: RX timeout marker
                        
                        ; ---------------- Workspace (bank A SRAM, well below the CCP at 0xE400) ----------------
   2000                 XMBUF   EQU     2000H                   ; 128-byte XMODEM block buffer
   2100                 FCB     EQU     2100H                   ; 32-byte FCB (extent 0) in RAM
   2120                 FCB2    EQU     2120H                   ; 32-byte FCB (extent 1) in RAM
   2160                 RCNT_L  EQU     2160H                   ; total records received (16-bit, L then H)
   2180                 FNAME   EQU     2180H                   ; 12-byte user filename buffer (8.3)
                        
                        ; ============================================================================
   1000   c3 1d 11              JMP     START
                        
                        ; ---------------- UART primitives ----------------
                        ; TXCHAR: output char in A; poll tx_busy(bit0) low.
   1003   f5            TXCHAR: PUSH    PSW
   1004   db 80         TXCH1:  IN      USTAT
   1006   e6 01                 ANI     01H
   1008   c2 04 10              JNZ     TXCH1
   100b   f1                    POP     PSW
   100c   d3 81                 OUT     UDATA
   100e   c9                    RET
                        
                        ; RXCHAR: block until a char, return it in A.
   100f   db 80         RXCHAR: IN      USTAT
   1011   e6 02                 ANI     02H
   1013   ca 0f 10              JZ      RXCHAR
   1016   db 81                 IN      UDATA
   1018   c9                    RET
                        
                        ; RXCHAR_T: receive a char with a ~1.5s timeout.
                        ;   Returns: carry CLEAR + A=char if a char arrived; carry SET if timeout.
   1019                 RXCHAR_T:
   1019   06 b0                 MVI     B,0B0H                  ; outer count
   101b   0e b0         RT_L2:  MVI     C,0B0H                  ; mid count
   101d   16 b0         RT_L1:  MVI     D,0B0H                  ; inner count
   101f   db 80         RT_L0:  IN      USTAT
   1021   e6 02                 ANI     02H
   1023   c2 34 10              JNZ     RT_HAVE
   1026   15                    DCR     D
   1027   c2 1f 10              JNZ     RT_L0
   102a   0d                    DCR     C
   102b   c2 1d 10              JNZ     RT_L1
   102e   05                    DCR     B
   102f   c2 1b 10              JNZ     RT_L2
   1032   37                    STC                             ; timeout
   1033   c9                    RET
   1034                 RT_HAVE:
   1034   db 81                 IN      UDATA                   ; char
   1036   37                    STC
   1037   3f                    CMC                             ; carry clear (char read)
   1038   c9                    RET
                        
                        ; CRLF: send CR + LF.
   1039   3e 0d         CRLF:   MVI     A,0DH
   103b   cd 03 10              CALL    TXCHAR
   103e   3e 0a                 MVI     A,0AH
   1040   cd 03 10              CALL    TXCHAR
   1043   c9                    RET
                        
                        ; PRTDBG: print a NUL-terminated tag string at HL, then the byte in A as two
                        ; hex digits, then a space. For on-board trace of the upload/FCB path.
                        ; PRTSTR advances/clobbers HL, so the value byte is parked in C; PRTBYTE uses
                        ; A (and itself calls TXCHAR). No registers are preserved beyond C/B/..., so
                        ; callers must not rely on B/C/D/E/H/L across a PRTDBG call (use it standalone).
   1044   4f            PRTDBG: MOV     C,A             ; park the value byte
   1045   c5                    PUSH    B
   1046   d5                    PUSH    D
   1047   e5                    PUSH    H
   1048   cd 58 10              CALL    PRTSTR          ; HL -> tag string (PRTSTR clobbers HL)
   104b   e1                    POP     H
   104c   d1                    POP     D
   104d   c1                    POP     B
   104e   79                    MOV     A,C
   104f   cd 62 10              CALL    PRTBYTE         ; value byte as 2 hex
   1052   3e 20                 MVI     A,' '
   1054   cd 03 10              CALL    TXCHAR
   1057   c9                    RET
                        
                        ; PRTSTR: print NUL-terminated string at HL.
   1058   7e            PRTSTR: MOV     A,M
   1059   b7                    ORA     A
   105a   c8                    RZ
   105b   cd 03 10              CALL    TXCHAR
   105e   23                    INX     H
   105f   c3 58 10              JMP     PRTSTR
                        
                        ; PRTBYTE: print A as two hex digits.
   1062   f5            PRTBYTE: PUSH    PSW
   1063   e6 f0                 ANI     0F0H
   1065   0f                    RRC
   1066   0f                    RRC
   1067   0f                    RRC
   1068   0f                    RRC
   1069   cd 6f 10              CALL    PRTH1
   106c   f1                    POP     PSW
   106d   e6 0f                 ANI     0FH
   106f   c6 90         PRTH1:  ADI     90H
   1071   27                    DAA
   1072   ce 40                 ACI     40H                     ; add carry (ACI) so 0xA-0xF print A-F
   1074   27                    DAA
   1075   c3 03 10              JMP     TXCHAR
                        
                        ; ---------------- RAM-disk primitives (bank B) ----------------
   1078   7d            RDSETA: MOV     A,L
   1079   d3 21                 OUT     RDADRL
   107b   7c                    MOV     A,H
   107c   d3 22                 OUT     RDADRH
   107e   c9                    RET
                        
                        ; ============================================================================
                        ; FINDFREE -- scan the directory (64 slots) for a run of `FNEED` consecutive
                        ;   EMPTY (0xE5) slots. Set FNEED=1 for a single-extent file, FNEED=2 for a
                        ;   two-extent file (extents 0 and 1 occupy two ADJACENT slots).
                        ;   Returns: A = slot index of the run start, carry CLEAR if found; carry SET
                        ;            if the directory has no such run (full).
                        ; ============================================================================
   107f                 FINDFREE:
   107f   06 40                 MVI     B,64            ; slots to examine
   1081   0e 00                 MVI     C,00H           ; candidate run-start index
   1083                 FF_LOOP:
   1083   3a 3a 15              LDA     FNEED
   1086   57                    MOV     D,A             ; D = number of consecutive empties still needed
   1087   59                    MOV     E,C             ; E = running slot index
                                ; remaining slots must be >= FNEED
   1088   78                    MOV     A,B
   1089   ba                    CMP     D
   108a   da b5 10              JC      FF_FULL         ; not enough slots left for a full run
   108d                 FF_RUN:
                                ; check slot E is empty. PUSH D/E because LXI D,DIRBASE below clobbers
                                ; both, and D (remaining count) and E (running slot) are live across the
                                ; slot read. Without the push, D silently becomes 0x20 (DIRBASE hi) and E
                                ; resets each iteration, corrupting the run-scan.
   108d   d5                    PUSH    D
   108e   7b                    MOV     A,E
   108f   6f                    MOV     L,A
   1090   26 00                 MVI     H,00H
   1092   3e 05                 MVI     A,05H
   1094   29            FF_SHL: DAD     H
   1095   3d                    DCR     A
   1096   c2 94 10              JNZ     FF_SHL          ; HL = E*32
   1099   11 00 20              LXI     D,DIRBASE
   109c   19                    DAD     D               ; HL = DIRBASE + E*32
   109d   cd 78 10              CALL    RDSETA
   10a0   db 20                 IN      RDDATA          ; byte 0 (0xE5 = empty)
   10a2   d1                    POP     D               ; restore D (count), E (running slot)
   10a3   fe e5                 CPI     0E5H
   10a5   c2 b0 10              JNZ     FF_ADV          ; slot E occupied -> try next run start
   10a8   1c                    INR     E
   10a9   15                    DCR     D
   10aa   c2 8d 10              JNZ     FF_RUN          ; continue the run
                                ; found a run of FNEED consecutive empties starting at C
   10ad   79                    MOV     A,C
   10ae   b7                    ORA     A               ; clear carry
   10af   c9                    RET
   10b0                 FF_ADV:
   10b0   0c                    INR     C               ; advance run start
   10b1   05                    DCR     B
   10b2   c2 83 10              JNZ     FF_LOOP
   10b5                 FF_FULL:
   10b5   37                    STC
   10b6   c9                    RET
                        
                        ; ============================================================================
                        ; NEXTBLK -- find the first FREE data block for a new file, scanning every
                        ;   non-empty directory entry's allocation map for the highest block in use.
                        ;   Returns: A = next free block number, carry CLEAR if one exists;
                        ;            carry SET if the data area is full.
                        ;   Data blocks run from 2 (block N at 0x2000 + N*1024); DSM=55 (blocks 2-55).
                        ; ============================================================================
   10b7                 NEXTBLK:
   10b7   3e 01                 MVI     A,01H           ; start "highest used" just below block 2
   10b9   32 3b 15              STA     NBMAX
   10bc   21 00 20              LXI     H,DIRBASE       ; scan base
   10bf   06 40                 MVI     B,64            ; 64 slots
   10c1   0e 00                 MVI     C,00H           ; slot index
   10c3                 NB_LOOP:
   10c3   79                    MOV     A,C
   10c4   6f                    MOV     L,A
   10c5   26 00                 MVI     H,00H
   10c7   16 05                 MVI     D,05H
   10c9   29            NB_SHL: DAD     H
   10ca   15                    DCR     D
   10cb   c2 c9 10              JNZ     NB_SHL          ; HL = slot*32
   10ce   11 00 20              LXI     D,DIRBASE
   10d1   19                    DAD     D
   10d2   cd 78 10              CALL    RDSETA
   10d5   db 20                 IN      RDDATA          ; byte 0 = user number
   10d7   fe e5                 CPI     0E5H
   10d9   ca 0a 11              JZ      NB_NEXT         ; empty slot -> no blocks to scan
                                ; non-empty: read its 16 allocation bytes and track the max block
   10dc   21 00 20              LXI     H,DIRBASE
   10df   19                    DAD     D               ; HL = DIRBASE (already have D=DIRBASE from DAD)
   10e0   79                    MOV     A,C
   10e1   6f                    MOV     L,A
   10e2   26 00                 MVI     H,00H
   10e4   16 05                 MVI     D,05H
   10e6   29            NB_SHL2: DAD     H
   10e7   15                    DCR     D
   10e8   c2 e6 10              JNZ     NB_SHL2
   10eb   11 10 20              LXI     D,DIRBASE+16    ; +16 -> start of allocation map
   10ee   19                    DAD     D
   10ef   cd 78 10              CALL    RDSETA
   10f2   16 10                 MVI     D,16            ; read 16 allocation bytes
   10f4   db 20         NB_MAP: IN      RDDATA
   10f6   b7                    ORA     A
   10f7   ca 06 11              JZ      NB_MAPC         ; block 0 = unallocated (means no block) -> skip
   10fa   5f                    MOV     E,A             ; E = this block number
   10fb   3a 3b 15              LDA     NBMAX
   10fe   bb                    CMP     E
   10ff   d2 06 11              JNC     NB_MAPC         ; NBMAX >= this -> no change
   1102   7b                    MOV     A,E
   1103   32 3b 15              STA     NBMAX           ; NBMAX = this block
   1106   15            NB_MAPC: DCR     D
   1107   c2 f4 10              JNZ     NB_MAP
   110a                 NB_NEXT:
   110a   0c                    INR     C
   110b   05                    DCR     B
   110c   c2 c3 10              JNZ     NB_LOOP
                                ; next free block = NBMAX + 1
   110f   3a 3b 15              LDA     NBMAX
   1112   c6 01                 ADI     01H
   1114   fe 38                 CPI     56              ; block 56 would be past DSM=55
   1116   d2 1b 11              JNC     NB_FULL
   1119   b7                    ORA     A               ; clear carry (block number in A, < 56)
   111a   c9                    RET
   111b                 NB_FULL:
   111b   37                    STC
   111c   c9                    RET
                        
                        ; ============================================================================
                        ; START
                        ; ============================================================================
   111d   31 00 e0      START:  LXI     SP,0E000H               ; stack in the TPA, BELOW the BDOS/CCP (0xE400+)
                                                                ; 0xF000 sat INSIDE the BDOS (0xEC00-0xFFFF), so
                                                                ;  diskutil's CALL/PUSH frames clobbered CP/M's
                                                                ;  in-RAM image; cold boot then ran the corrupted
                                                                ;  code. The CBIOS itself uses 0xDC00 for the same
                                                                ;  reason. TPA is 0x0100-0xE3FF; 0xE000 grows down
                                                                ;  into free space clear of code/buffers (0x1000+).
   1120   21 d2 15              LXI     H,MSGBANNER
   1123   cd 58 10              CALL    PRTSTR
   1126   21 f1 15      MENU:   LXI     H,MSGMENU
   1129   cd 58 10              CALL    PRTSTR
   112c   cd 0f 10              CALL    RXCHAR                  ; wait for a command char
   112f   e6 df                 ANI     0DFH                    ; force uppercase (accept lowercase)
   1131   fe 46                 CPI     'F'
   1133   ca 52 11              JZ      DO_FMT
   1136   fe 55                 CPI     'U'
   1138   ca 7e 11              JZ      DO_UPLOAD
   113b   fe 43                 CPI     'C'
   113d   ca cf 14              JZ      DO_BOOTCPM
   1140   fe 48                 CPI     'H'
   1142   ca 75 11              JZ      DO_HELP
   1145   fe 42                 CPI     'B'
   1147   ca 3d 15              JZ      DO_DUMP
   114a   fe 4d                 CPI     'M'
   114c   ca 65 15              JZ      DO_MDUMP
   114f   c3 26 11              JMP     MENU
                        
                        ; ---------------- command: format ----------------
   1152   21 68 16      DO_FMT: LXI     H,MSGFMT
   1155   cd 58 10              CALL    PRTSTR
   1158   21 00 00              LXI     H,0000H                 ; start at byte 0 of the RAM disk
   115b   cd 78 10              CALL    RDSETA
   115e   01 00 00              LXI     B,65536                 ; erase the ENTIRE 64K bank-B RAM disk
   1161   16 e5                 MVI     D,0E5H                  ; keep the fill value in D (A is clobbered below)
   1163   7a            FMTW:   MOV     A,D
   1164   d3 20                 OUT     RDDATA                  ; write 0xE5 (auto-increment)
   1166   0b                    DCX     B
   1167   78                    MOV     A,B
   1168   b1                    ORA     C
   1169   c2 63 11              JNZ     FMTW
   116c   21 78 16              LXI     H,MSGFMTOK
   116f   cd 58 10              CALL    PRTSTR
   1172   c3 26 11              JMP     MENU
                        
   1175   21 25 16      DO_HELP: LXI     H,MSGHELP
   1178   cd 58 10              CALL    PRTSTR
   117b   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_UPLOAD -- XMODEM (checksum/CRC) receive a file, write it as a CP/M file.
                        ; ============================================================================
   117e                 DO_UPLOAD:
   117e   21 85 16              LXI     H,MSGPROMPT
   1181   cd 58 10              CALL    PRTSTR
   1184   cd 09 14              CALL    READNAME                ; read "name.ext" into FNAME (echoed)
                                ; ---- allocate the first free data block NOW so WRITEBLK (during the
                                ;      receive, before the FCB is written) appends after existing
                                ;      files instead of overwriting block 2. The directory slot is
                                ;      allocated later in WRITEFCB, after the extent count is known.
   1187   cd b7 10              CALL    NEXTBLK                 ; A = first free data block (carry set = full)
   118a   da d6 11              JC      UP_NOSPC
   118d   32 3c 15              STA     BLKNO
   1190   21 86 17              LXI     H,MSGT_BLK              ; DEBUG: trace the picked block
   1193   cd 44 10              CALL    PRTDBG                  ; value was already in A (BLKNO)
   1196   21 00 00              LXI     H,0000H
   1199   22 60 21              SHLD    RCNT_L                  ; init record counter
   119c   21 9e 16              LXI     H,MSGRECV
   119f   cd 58 10              CALL    PRTSTR
   11a2   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   11a4   cd 03 10              CALL    TXCHAR
                        
   11a7   cd 01 12      UPLOOP: CALL    GETBLK                  ; A=TO(timeout),01 good,FF bad,00 EOT,02 CAN
   11aa   fe fe                 CPI     XM_TO
   11ac   ca ce 11              JZ      UP_NAK                  ; timeout -> resend NAK, keep waiting
   11af   fe 02                 CPI     02H
   11b1   ca ce 11              JZ      UP_NAK                  ; CAN
   11b4   fe 00                 CPI     00H
   11b6   ca df 11              JZ      UP_EOT
   11b9   fe ff                 CPI     0FFH
   11bb   ca ce 11              JZ      UP_NAK                  ; bad block -> NAK
                                ; good block -> write it to the disk
   11be   cd c5 12              CALL    WRITEBLK
   11c1   3e 06                 MVI     A,XM_ACK
   11c3   cd 03 10              CALL    TXCHAR
   11c6   3e 2e                 MVI     A,'.'
   11c8   cd 03 10              CALL    TXCHAR
   11cb   c3 a7 11              JMP     UPLOOP
   11ce   3e 15         UP_NAK: MVI     A,XM_NAK
   11d0   cd 03 10              CALL    TXCHAR
   11d3   c3 a7 11              JMP     UPLOOP
                        ; disk full (no free data block or no free directory slot) -> report and bail
   11d6                 UP_NOSPC:
   11d6   21 61 17              LXI     H,MSGNOSPC
   11d9   cd 58 10              CALL    PRTSTR
   11dc   c3 26 11              JMP     MENU
                        
   11df   3e 06         UP_EOT: MVI     A,XM_ACK
   11e1   cd 03 10              CALL    TXCHAR
   11e4   cd 39 10              CALL    CRLF
   11e7   cd 02 13              CALL    WRITEFCB                ; write directory entries
   11ea   21 b6 16              LXI     H,MSGDONE
   11ed   cd 58 10              CALL    PRTSTR
   11f0   2a 60 21              LHLD    RCNT_L
   11f3   7c                    MOV     A,H
   11f4   cd 62 10              CALL    PRTBYTE
   11f7   7d                    MOV     A,L
   11f8   cd 62 10              CALL    PRTBYTE
   11fb   cd 39 10              CALL    CRLF
   11fe   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; GETBLK -- receive one XMODEM block into XMBUF.
                        ; Returns A: XM_TO(timeout), 00=EOT, 01=good, FF=bad, 02=CAN.
                        ; (First byte uses the timed read so we can retry the NAK on timeout; the rest
                        ;  of the block uses blocking reads because the host sends them back-to-back.)
                        ; ============================================================================
   1201   cd 19 10      GETBLK: CALL    RXCHAR_T
   1204   da 1e 12              JC      GT_TIMEOUT              ; carry set = timeout
   1207   fe 04                 CPI     XM_EOT
   1209   ca 21 12              JZ      GT_EOT
   120c   fe 18                 CPI     XM_CAN
   120e   ca 23 12              JZ      GT_CAN
   1211   fe 01                 CPI     XM_SOH
   1213   ca 26 12              JZ      GT_SOH
   1216   fe 02                 CPI     XM_STX
   1218   ca 4f 12              JZ      GT_STX
   121b   c3 01 12              JMP     GETBLK                  ; stray byte (e.g. 'rx name'), ignore
                        
   121e                 GT_TIMEOUT:
   121e   3e fe                 MVI     A,XM_TO
   1220   c9                    RET
   1221   af            GT_EOT: XRA     A
   1222   c9                    RET
   1223   3e 02         GT_CAN: MVI     A,02H
   1225   c9                    RET
                        
                        ; ---- SOH: checksum block (blkno, ~blkno, 128 data, 1-byte checksum) ----
   1226   cd 0f 10      GT_SOH: CALL    RXCHAR
   1229   47                    MOV     B,A                     ; blkno
   122a   cd 0f 10              CALL    RXCHAR
   122d   a8                    XRA     B                       ; ~blkno ^ blkno
   122e   fe ff                 CPI     0FFH
   1230   c2 c2 12              JNZ     GT_BAD
   1233   21 00 20              LXI     H,XMBUF
   1236   1e 00                 MVI     E,00H
   1238   0e 80                 MVI     C,128
   123a   cd 0f 10      GT_LP:  CALL    RXCHAR
   123d   77                    MOV     M,A
   123e   83                    ADD     E
   123f   5f                    MOV     E,A
   1240   23                    INX     H
   1241   0d                    DCR     C
   1242   c2 3a 12              JNZ     GT_LP
   1245   cd 0f 10              CALL    RXCHAR                  ; checksum byte
   1248   bb                    CMP     E
   1249   c2 c2 12              JNZ     GT_BAD
   124c   3e 01                 MVI     A,01H
   124e   c9                    RET
                        
                        ; ---- STX: CRC block (blkno, ~blkno, 128 data, 2-byte CRC-16) ----
   124f   cd 0f 10      GT_STX: CALL    RXCHAR
   1252   47                    MOV     B,A                     ; blkno
   1253   cd 0f 10              CALL    RXCHAR
   1256   a8                    XRA     B
   1257   fe ff                 CPI     0FFH
   1259   c2 c2 12              JNZ     GT_BAD
   125c   21 00 20              LXI     H,XMBUF
   125f   0e 80                 MVI     C,128
   1261   cd 0f 10      GT_LP2: CALL    RXCHAR
   1264   77                    MOV     M,A
   1265   23                    INX     H
   1266   0d                    DCR     C
   1267   c2 61 12              JNZ     GT_LP2
                                ; compute CRC-16 XMODEM over XMBUF -> D: E (D high, E low)
   126a   21 00 20              LXI     H,XMBUF
   126d   11 00 00              LXI     D,0000H                 ; crc = 0
   1270   0e 80                 MVI     C,128
   1272   7e            GT_CRC: MOV     A,M
   1273   47                    MOV     B,A
   1274   7a                    MOV     A,D
   1275   a8                    XRA     B                       ; crc_hi ^= byte
   1276   57                    MOV     D,A
   1277   06 08                 MVI     B,08H
   1279   7a            GTCB:   MOV     A,D
   127a   e6 80                 ANI     80H                     ; crc & 0x8000 ?
   127c   ca 9a 12              JZ      GTCS
   127f   a7                    ANA     A                       ; clear carry
   1280   7b                    MOV     A,E
   1281   17                    RAL                             ; E = E<<1 (carry = old E bit7)
   1282   5f                    MOV     E,A
   1283   7a                    MOV     A,D
   1284   17                    RAL                             ; D = D<<1 | old E bit7
   1285   57                    MOV     D,A
   1286   7a                    MOV     A,D
   1287   ee 10                 XRI     10H                     ; crc ^= 0x1021 (hi)
   1289   57                    MOV     D,A
   128a   7b                    MOV     A,E
   128b   ee 21                 XRI     21H                     ; crc ^= 0x1021 (lo)
   128d   5f                    MOV     E,A
   128e   05                    DCR     B
   128f   c2 79 12              JNZ     GTCB
   1292   23                    INX     H
   1293   0d                    DCR     C
   1294   c2 72 12              JNZ     GT_CRC
   1297   c3 aa 12              JMP     GT_CHK
   129a   a7            GTCS:   ANA     A                       ; clear carry
   129b   7b                    MOV     A,E
   129c   17                    RAL
   129d   5f                    MOV     E,A
   129e   7a                    MOV     A,D
   129f   17                    RAL
   12a0   57                    MOV     D,A
   12a1   05                    DCR     B
   12a2   c2 79 12              JNZ     GTCB
   12a5   23                    INX     H
   12a6   0d                    DCR     C
   12a7   c2 72 12              JNZ     GT_CRC
   12aa                 GT_CHK:
   12aa   23                    INX     H
   12ab   0d                    DCR     C
   12ac   c2 72 12              JNZ     GT_CRC
                                ; read 2 CRC bytes (high, low), compare
   12af   cd 0f 10              CALL    RXCHAR
   12b2   47                    MOV     B,A                     ; received crc hi
   12b3   cd 0f 10              CALL    RXCHAR
   12b6   bb                    CMP     E                       ; compare low
   12b7   c2 c2 12              JNZ     GT_BAD
   12ba   78                    MOV     A,B
   12bb   ba                    CMP     D                       ; compare high
   12bc   c2 c2 12              JNZ     GT_BAD
   12bf   3e 01                 MVI     A,01H
   12c1   c9                    RET
                        
   12c2   3e ff         GT_BAD: MVI     A,0FFH
   12c4   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEBLK -- write the 128 good bytes in XMBUF to the RAM disk at the current
                        ;   file position. Position = 0x2000 + BLKNO*1024 + RCNT_L*128. BLKNO is the
                        ;   first free data block found by NEXTBLOCK at upload start, so a second
                        ;   upload appends after existing files instead of overwriting block 2.
                        ; ============================================================================
   12c5                 WRITEBLK:
   12c5   2a 60 21              LHLD    RCNT_L
   12c8   54                    MOV     D,H
   12c9   5d                    MOV     E,L
   12ca   06 07                 MVI     B,07H
   12cc                 WBLK_SHL:
   12cc   7b                    MOV     A,E
   12cd   87                    ADD     A
   12ce   5f                    MOV     E,A
   12cf   7a                    MOV     A,D
   12d0   17                    RAL
   12d1   57                    MOV     D,A
   12d2   05                    DCR     B
   12d3   c2 cc 12              JNZ     WBLK_SHL        ; DE = RCNT_L*128
   12d6   d5                    PUSH    D               ; save RCNT_L*128
   12d7   3a 3c 15              LDA     BLKNO
   12da   6f                    MOV     L,A
   12db   26 00                 MVI     H,00H
   12dd   06 0a                 MVI     B,10            ; *1024 (2^10) -> HL = BLKNO*1024
   12df   29            WBLK_B: DAD     H
   12e0   05                    DCR     B
   12e1   c2 df 12              JNZ     WBLK_B
   12e4   11 00 20              LXI     D,2000H         ; data-area base (blocks are at 0x2000 + N*1024)
   12e7   19                    DAD     D               ; HL = 0x2000 + BLKNO*1024
   12e8   d1                    POP     D               ; DE = RCNT_L*128
   12e9   19                    DAD     D               ; HL += RCNT_L*128
   12ea   cd 78 10              CALL    RDSETA
   12ed   21 00 20              LXI     H,XMBUF
   12f0   0e 80                 MVI     C,128
   12f2   7e            WBLK:   MOV     A,M
   12f3   d3 20                 OUT     RDDATA
   12f5   23                    INX     H
   12f6   0d                    DCR     C
   12f7   c2 f2 12              JNZ     WBLK
   12fa   2a 60 21              LHLD    RCNT_L
   12fd   23                    INX     H
   12fe   22 60 21              SHLD    RCNT_L
   1301   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEFCB -- write the FCB directory entry/entries for the received file.
                        ;   BLKNO (first free data block) and FSLOT (first free dir slot) were chosen
                        ;   by NEXTBLK/FINDFREE at the START of the upload. Single extent (<=16K) ->
                        ;   one slot; >16K -> two slots (extents 0 and 1). All data blocks run
                        ;   contiguously from BLKNO, so a second upload never overwrites the first.
                        ; ============================================================================
   1302                 WRITEFCB:
   1302   cd 59 14              CALL    BUILD_FCB               ; builds FCB (and FCB2 copy) with name/ext
   1305   2a 60 21              LHLD    RCNT_L
   1308   7c                    MOV     A,H
   1309   b7                    ORA     A
   130a   c2 49 13              JNZ     WFC_TWO
   130d   7d                    MOV     A,L
   130e   fe 81                 CPI     129
   1310   d2 49 13              JNC     WFC_TWO
                                ; ---- single extent (<=16K) ----
   1313   3e 01                 MVI     A,01H
   1315   32 3a 15              STA     FNEED                   ; need 1 consecutive slot
   1318   cd 7f 10              CALL    FINDFREE                ; A = free slot (carry set = dir full)
   131b   da d6 11              JC      UP_NOSPC
   131e   32 38 15              STA     FSLOT
   1321   21 8b 17              LXI     H,MSGT_SLOT             ; DEBUG: trace the picked slot
   1324   cd 44 10              CALL    PRTDBG                  ; value in A = FSLOT
   1327   3a 0f 21              LDA     FCB+15
   132a   21 91 17              LXI     H,MSGT_RC               ; DEBUG: trace RC
   132d   cd 44 10              CALL    PRTDBG
   1330   3e 00                 MVI     A,00H
   1332   32 0c 21              STA     FCB+12                  ; EX=0
   1335   32 0d 21              STA     FCB+13                  ; S1=0
   1338   32 0e 21              STA     FCB+14                  ; S2=0
   133b   2a 60 21              LHLD    RCNT_L
   133e   7d                    MOV     A,L
   133f   32 0f 21              STA     FCB+15                  ; RC = records
   1342   cd d1 13              CALL    SETALLO                 ; fill FCB+16..31 (blocks from BLKNO)
   1345   cd af 13              CALL    WDIRFCB
   1348   c9                    RET
                        
   1349                 WFC_TWO:
   1349   3e 02                 MVI     A,02H
   134b   32 3a 15              STA     FNEED                   ; need 2 consecutive slots
   134e   cd 7f 10              CALL    FINDFREE                ; A = free slot run start
   1351   da d6 11              JC      UP_NOSPC
   1354   32 38 15              STA     FSLOT
   1357   3e 00                 MVI     A,00H
   1359   32 0c 21              STA     FCB+12
   135c   32 0d 21              STA     FCB+13
   135f   32 0e 21              STA     FCB+14
   1362   3e 80                 MVI     A,128
   1364   32 0f 21              STA     FCB+15
   1367   cd d1 13              CALL    SETALLO
   136a   2a 60 21              LHLD    RCNT_L
   136d   7d                    MOV     A,L
   136e   d6 80                 SUI     128
   1370   6f                    MOV     L,A
   1371   7c                    MOV     A,H
   1372   de 00                 SBI     00H
   1374   67                    MOV     H,A
   1375   7d                    MOV     A,L
   1376   32 2f 21              STA     FCB2+15                 ; RC extent 1
   1379   3e 01                 MVI     A,01H
   137b   32 2c 21              STA     FCB2+12                 ; EX=1
   137e   3e 00                 MVI     A,00H
   1380   32 2d 21              STA     FCB2+13                 ; S1=0
   1383   32 2e 21              STA     FCB2+14                 ; S2=0
   1386   cd ec 13              CALL    SETALLO2
   1389   cd af 13              CALL    WDIRFCB                 ; extent 0 at slot FSLOT
                                ; extent 1 at slot FSLOT+1
   138c   3a 38 15              LDA     FSLOT
   138f   3c                    INR     A
   1390   6f                    MOV     L,A
   1391   26 00                 MVI     H,00H
   1393   16 05                 MVI     D,05H
   1395   29            WFC2S:  DAD     H
   1396   15                    DCR     D
   1397   c2 95 13              JNZ     WFC2S                   ; HL = (FSLOT+1)*32
   139a   11 00 20              LXI     D,DIRBASE
   139d   19                    DAD     D
   139e   cd 78 10              CALL    RDSETA
   13a1   21 20 21              LXI     H,FCB2
   13a4   0e 20                 MVI     C,32
   13a6   7e            WFC2B:  MOV     A,M
   13a7   d3 20                 OUT     RDDATA
   13a9   23                    INX     H
   13aa   0d                    DCR     C
   13ab   c2 a6 13              JNZ     WFC2B
   13ae   c9                    RET
                        
   13af                 WDIRFCB:
   13af   3a 38 15              LDA     FSLOT
   13b2   6f                    MOV     L,A
   13b3   26 00                 MVI     H,00H
   13b5   16 05                 MVI     D,05H
   13b7   29            WDFS:   DAD     H
   13b8   15                    DCR     D
   13b9   c2 b7 13              JNZ     WDFS                    ; HL = FSLOT*32
   13bc   11 00 20              LXI     D,DIRBASE
   13bf   19                    DAD     D
   13c0   cd 78 10              CALL    RDSETA
   13c3   21 00 21              LXI     H,FCB
   13c6   0e 20                 MVI     C,32
   13c8   7e            WDF:    MOV     A,M
   13c9   d3 20                 OUT     RDDATA
   13cb   23                    INX     H
   13cc   0d                    DCR     C
   13cd   c2 c8 13              JNZ     WDF
   13d0   c9                    RET
                        
   13d1                 SETALLO:
   13d1   3a 0f 21              LDA     FCB+15
   13d4   b7                    ORA     A
   13d5   c8                    RZ                              ; RC=0 -> no blocks to allocate
   13d6   c6 07                 ADI     07H
   13d8   0f                    RRC
   13d9   0f                    RRC
   13da   0f                    RRC
   13db   e6 1f                 ANI     1FH
   13dd   47                    MOV     B,A
   13de   21 10 21              LXI     H,FCB+16
   13e1   3a 3c 15              LDA     BLKNO                   ; first free data block
   13e4   77            SA1:    MOV     M,A
   13e5   23                    INX     H
   13e6   3c                    INR     A
   13e7   05                    DCR     B
   13e8   c2 e4 13              JNZ     SA1
   13eb   c9                    RET
                        
   13ec                 SETALLO2:
   13ec   3a 2f 21              LDA     FCB2+15
   13ef   b7                    ORA     A
   13f0   c8                    RZ                              ; RC=0 -> no blocks to allocate
   13f1   c6 07                 ADI     07H
   13f3   0f                    RRC
   13f4   0f                    RRC
   13f5   0f                    RRC
   13f6   e6 1f                 ANI     1FH
   13f8   47                    MOV     B,A
   13f9   21 30 21              LXI     H,FCB2+16
   13fc   3a 3c 15              LDA     BLKNO
   13ff   c6 16                 ADI     16H                     ; extent 1 starts at BLKNO + 16
   1401   77            SA21:   MOV     M,A
   1402   23                    INX     H
   1403   3c                    INR     A
   1404   05                    DCR     B
   1405   c2 01 14              JNZ     SA21
   1408   c9                    RET
                        
                        ; ============================================================================
                        ; READNAME -- read "name.ext" (max 9 chars) from console into FNAME, echoing.
                        ; ============================================================================
   1409                 READNAME:
   1409   21 80 21              LXI     H,FNAME
   140c   06 0c                 MVI     B,12
   140e   cd 0f 10      RN1:    CALL    RXCHAR
   1411   fe 0d                 CPI     0DH
   1413   ca 52 14              JZ      RN_DONE
   1416   fe 08                 CPI     08H                     ; ^H backspace
   1418   ca 38 14              JZ      RN_BS
   141b   fe 7f                 CPI     7FH                     ; DEL backspace
   141d   ca 38 14              JZ      RN_BS
                                ; coerce lowercase a-z to A-Z so the name always matches CP/M's
                                ; uppercase convention (else files with lowercase names are stored but
                                ; DIR/save lookups that uppercase won't find them)
   1420   fe 61                 CPI     'a'
   1422   da 2c 14              JC      RN_STORE
   1425   fe 7b                 CPI     'z'+1
   1427   d2 2c 14              JNC     RN_STORE
   142a   d6 20                 SUI     20H                     ; 'a'->'A'
   142c                 RN_STORE:
   142c   77                    MOV     M,A
   142d   cd 03 10              CALL    TXCHAR                  ; ECHO the (upper-cased) char
   1430   23                    INX     H
   1431   05                    DCR     B
   1432   c2 0e 14              JNZ     RN1
   1435   c3 52 14              JMP     RN_DONE
   1438                 RN_BS:  ; backspace: erase from the screen and back the buffer up (if possible)
   1438   3e 08                 MVI     A,08H
   143a   cd 03 10              CALL    TXCHAR
   143d   3e 20                 MVI     A,20H
   143f   cd 03 10              CALL    TXCHAR
   1442   3e 08                 MVI     A,08H
   1444   cd 03 10              CALL    TXCHAR
   1447   78                    MOV     A,B
   1448   fe 09                 CPI     9
   144a   ca 0e 14              JZ      RN1                     ; buffer full, at start -> nothing to back up
   144d   2b                    DCX     H
   144e   04                    INR     B
   144f   c3 0e 14              JMP     RN1
   1452   3e 00         RN_DONE: MVI     A,00H
   1454   77                    MOV     M,A                     ; NUL terminate
   1455   cd 39 10              CALL    CRLF
   1458   c9                    RET
                        
                        ; ============================================================================
                        ; BUILD_FCB -- parse FNAME into the 32-byte FCB (and copy into FCB2).
                        ; ============================================================================
   1459                 BUILD_FCB:
   1459   21 00 21              LXI     H,FCB
   145c   06 40                 MVI     B,64                    ; zero both FCBs (2 x 32)
   145e   3e 00         BF_Z:   MVI     A,00H
   1460   77                    MOV     M,A
   1461   23                    INX     H
   1462   05                    DCR     B
   1463   c2 5e 14              JNZ     BF_Z
   1466   11 80 21              LXI     D,FNAME
   1469   21 01 21              LXI     H,FCB+1
   146c   06 08                 MVI     B,8
   146e   1a            BF_N:   LDAX    D
   146f   fe 00                 CPI     00H
   1471   ca 8a 14              JZ      BF_NPAD
   1474   fe 2e                 CPI     '.'
   1476   ca 8a 14              JZ      BF_GOTEXT
   1479   77                    MOV     M,A
   147a   23                    INX     H
   147b   13                    INX     D
   147c   05                    DCR     B
   147d   c2 6e 14              JNZ     BF_N
   1480   1a                    LDAX    D
   1481   fe 2e                 CPI     '.'
   1483   c2 b9 14              JNZ     BF_EXT0
   1486   13                    INX     D
   1487   c3 93 14              JMP     BF_EXT
   148a                 BF_GOTEXT:
   148a   3e 20         BF_NPAD: MVI     A,' '
   148c   77                    MOV     M,A
   148d   23                    INX     H
   148e   05                    DCR     B
   148f   c2 8a 14              JNZ     BF_NPAD
   1492   13                    INX     D                       ; skip '.'
   1493   21 09 21      BF_EXT: LXI     H,FCB+9
   1496   06 03                 MVI     B,3
   1498   1a            BF_E:   LDAX    D
   1499   fe 00                 CPI     00H
   149b   ca b1 14              JZ      BF_EXT_PAD
   149e   fe 2e                 CPI     '.'
   14a0   ca ad 14              JZ      BF_EXT_SKIP
   14a3   77                    MOV     M,A
   14a4   23                    INX     H
   14a5   13                    INX     D
   14a6   05                    DCR     B
   14a7   c2 98 14              JNZ     BF_E
   14aa   c3 b9 14              JMP     BF_EXT0
   14ad                 BF_EXT_SKIP:
   14ad   13                    INX     D
   14ae   c3 98 14              JMP     BF_E
   14b1                 BF_EXT_PAD:
   14b1   3e 20                 MVI     A,' '
   14b3   77                    MOV     M,A
   14b4   23                    INX     H
   14b5   05                    DCR     B
   14b6   c2 b1 14              JNZ     BF_EXT_PAD
   14b9                 BF_EXT0:
   14b9   21 00 21              LXI     H,FCB
   14bc   36 00                 MVI     M,00H                   ; dir entry byte0 = USER number (0), not drive
   14be   21 00 21              LXI     H,FCB
   14c1   11 20 21              LXI     D,FCB2
   14c4   06 20                 MVI     B,32
   14c6   7e            BF_C:   MOV     A,M
   14c7   12                    STAX    D
   14c8   23                    INX     H
   14c9   13                    INX     D
   14ca   05                    DCR     B
   14cb   c2 c6 14              JNZ     BF_C
   14ce   c9                    RET
                        
                        ; ============================================================================
                        ; DO_BOOTCPM -- receive the CP/M system image (CCP+BDOS+CBIOS, the combined
                        ;   brevia2_cpm binary) via XMODEM into MACHINE RAM at 0xE400, then cold-boot
                        ;   CP/M by jumping to the CBIOS cold-boot entry (0xFA00). The CBIOS persists
                        ;   CCP/BDOS to the RAM-disk system tracks and enters the CCP, so we reuse the
                        ;   proven boot path instead of duplicating it.
                        ;   Transfers into bank A via XMBUF, then copies each block to machine RAM.
                        ; ============================================================================
   14cf                 DO_BOOTCPM:
   14cf   21 16 17              LXI     H,MSGBCPM
   14d2   cd 58 10              CALL    PRTSTR
   14d5   21 00 e4              LXI     H,0E400H                ; load CCP at 0xE400 (image is contiguous)
   14d8   22 36 15              SHLD    BCPADDR
   14db   21 9e 16              LXI     H,MSGRECV
   14de   cd 58 10              CALL    PRTSTR
   14e1   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   14e3   cd 03 10              CALL    TXCHAR
   14e6   cd 01 12      BCPLOOP: CALL    GETBLK                  ; A=TO,01 good,FF bad,00 EOT,02 CAN
   14e9   fe fe                 CPI     XM_TO
   14eb   ca 1d 15              JZ      BCP_NAK                 ; timeout -> resend NAK
   14ee   fe 02                 CPI     02H
   14f0   ca 1d 15              JZ      BCP_NAK                 ; CAN
   14f3   fe 00                 CPI     00H
   14f5   ca 25 15              JZ      BCP_EOT
   14f8   fe ff                 CPI     0FFH
   14fa   ca 1d 15              JZ      BCP_NAK                 ; bad block -> NAK
                                ; good block -> copy XMBUF to machine RAM at BCPADDR, advance by 128
   14fd   2a 36 15              LHLD    BCPADDR
   1500   11 00 20              LXI     D,XMBUF
   1503   0e 80                 MVI     C,128
   1505   1a            BCPC:   LDAX    D
   1506   77                    MOV     M,A
   1507   13                    INX     D
   1508   23                    INX     H
   1509   0d                    DCR     C
   150a   c2 05 15              JNZ     BCPC
   150d   22 36 15              SHLD    BCPADDR                 ; advance for the next block
   1510   3e 06                 MVI     A,XM_ACK
   1512   cd 03 10              CALL    TXCHAR
   1515   3e 2e                 MVI     A,'.'
   1517   cd 03 10              CALL    TXCHAR
   151a   c3 e6 14              JMP     BCPLOOP
   151d   3e 15         BCP_NAK: MVI     A,XM_NAK
   151f   cd 03 10              CALL    TXCHAR
   1522   c3 e6 14              JMP     BCPLOOP
   1525   3e 06         BCP_EOT: MVI     A,XM_ACK
   1527   cd 03 10              CALL    TXCHAR
   152a   cd 39 10              CALL    CRLF
   152d   21 3e 17              LXI     H,MSGBCPMOK
   1530   cd 58 10              CALL    PRTSTR
   1533   c3 00 fa              JMP     0FA00H                  ; CBIOS cold boot -> enters CCP (A>)
                        
   1536                 BCPADDR: DS     2                        ; machine-RAM load address for the boot image
   1538                 FSLOT:   DS     1               ; directory slot index for the file being written
   1539                 TWOF:    DS     1               ; !=0 -> two-extent file (extents 0 AND 1 slots)
   153a                 FNEED:   DS     1               ; slots needed by FINDFREE (1 = single, 2 = two-extent)
   153b                 NBMAX:   DS     1               ; scratch: highest data block seen during NEXTBLK
   153c                 BLKNO:   DS     1               ; first free data block for the file being written
                        
                        ; ============================================================================
                        ; DO_DUMP -- dump 256 bytes from the RAM disk at a hex address, as hex (16/line).
                        ; ============================================================================
   153d                 DO_DUMP:
   153d   21 d1 16              LXI     H,MSGDUMP
   1540   cd 58 10              CALL    PRTSTR
   1543   cd 8a 15              CALL    READHEX                 ; HL = start address
   1546   cd 78 10              CALL    RDSETA
   1549   06 10                 MVI     B,16                    ; 16 lines
   154b   16 10         DUMP_L1: MVI     D,16                    ; 16 bytes per line
   154d   db 20         DUMP_B: IN      RDDATA
   154f   cd 62 10              CALL    PRTBYTE
   1552   3e 20                 MVI     A,' '
   1554   cd 03 10              CALL    TXCHAR
   1557   15                    DCR     D
   1558   c2 4d 15              JNZ     DUMP_B
   155b   cd 39 10              CALL    CRLF
   155e   05                    DCR     B
   155f   c2 4b 15              JNZ     DUMP_L1
   1562   c3 26 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_MDUMP -- dump 128 bytes of CPU (bank A) memory at a hex address.
                        ; Runs with the monitor banked out; reads bank A RAM directly. Useful for
                        ; inspecting CBIOS/BDOS variable state AFTER a CP/M session (reset -> G 1000).
                        ; ============================================================================
   1565                 DO_MDUMP:
   1565   21 ee 16              LXI     H,MSGMD
   1568   cd 58 10              CALL    PRTSTR
   156b   cd 8a 15              CALL    READHEX                 ; HL = start address
   156e   06 08                 MVI     B,8                     ; 8 lines
   1570   16 10         MD_L1:  MVI     D,16                    ; 16 bytes per line
   1572   7e            MD_B:   MOV     A,M
   1573   cd 62 10              CALL    PRTBYTE
   1576   3e 20                 MVI     A,' '
   1578   cd 03 10              CALL    TXCHAR
   157b   23                    INX     H
   157c   15                    DCR     D
   157d   c2 72 15              JNZ     MD_B
   1580   cd 39 10              CALL    CRLF
   1583   05                    DCR     B
   1584   c2 70 15              JNZ     MD_L1
   1587   c3 26 11              JMP     MENU
                        
                        ; ---------------------------------------------------------------------------
                        ; READHEX -- read up to 4 hex digits from the console into HL (echoed).
                        ; ---------------------------------------------------------------------------
   158a                 READHEX:
   158a   21 00 00              LXI     H,0000H
   158d   06 04                 MVI     B,4
   158f   cd 0f 10      RH1:    CALL    RXCHAR
   1592   fe 0d                 CPI     0DH
   1594   ca cb 15              JZ      RH_DONE                 ; Enter ends
                                ; determine hex digit value 0-15 in A
   1597   fe 30                 CPI     '0'
   1599   da cf 15              JC      RH_NEXT                 ; < '0' -> ignore
   159c   fe 3a                 CPI     '9'+1
   159e   da b2 15              JC      RH_DIG                  ; '0'-'9'
   15a1   e6 df                 ANI     0DFH                    ; uppercase
   15a3   fe 41                 CPI     'A'
   15a5   da cf 15              JC      RH_NEXT                 ; < 'A' -> ignore
   15a8   fe 47                 CPI     'F'+1
   15aa   d2 cf 15              JNC     RH_NEXT                 ; > 'F' -> ignore
   15ad   d6 37                 SUI     'A'-10                  ; 'A'-'F' -> 10-15
   15af   c3 b4 15              JMP     RH_ADD
   15b2   d6 30         RH_DIG: SUI     '0'                     ; '0'-'9' -> 0-9
   15b4   cd 03 10      RH_ADD: CALL    TXCHAR                  ; echo the digit
   15b7   4f                    MOV     C,A                     ; C = digit value
                                ; HL = (HL << 4) | C
   15b8   16 04                 MVI     D,04H
   15ba   7d            RH_SHL: MOV     A,L
   15bb   87                    ADD     A
   15bc   6f                    MOV     L,A
   15bd   7c                    MOV     A,H
   15be   17                    RAL
   15bf   67                    MOV     H,A
   15c0   15                    DCR     D
   15c1   c2 ba 15              JNZ     RH_SHL
   15c4   7d                    MOV     A,L
   15c5   b1                    ORA     C
   15c6   6f                    MOV     L,A
   15c7   05                    DCR     B
   15c8   c2 8f 15              JNZ     RH1
   15cb                 RH_DONE:
   15cb   cd 39 10              CALL    CRLF
   15ce   c9                    RET
   15cf   c3 8f 15      RH_NEXT: JMP     RH1
                        
                        ; ============================================================================
                        ; Messages
                        ; ============================================================================
   15d2   5a 38 30 20   MSGBANNER: DB 'Z80 Brevia2 RAM-disk utility',0DH,0AH,0
   15d6   42 72 65 76   
   15da   69 61 32 20   
   15de   52 41 4d 2d   
