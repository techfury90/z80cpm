                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xFA00 (BIOS base) so the image is loaded
                        ;   exactly at 0xFA00 by the GWMON-80 'L' command and entered with 'G FA00'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xE3FF  TPA
                        ;       0xE400-0xEBFF  CCP  (already loaded by the combined HEX)
                        ;       0xEC00-0xF9FF  BDOS (already loaded by the combined HEX)
                        ;       0xFA00-0xFFFF  THIS CBIOS
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 9600)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive A:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   fa00                         ORG     0FA00H
                        
                        ; ---- constants ------------------------------------------------------------
   fa00                 BIOS    EQU     0FA00H          ; BIOS base (jump table origin)
   e400                 CCP     EQU     0E400H          ; CCP origin
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xFA03.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   ec00                 BDOSL   EQU     0EC00H          ; BDOS origin
   ec06                 BDOSENT EQU     0EC06H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xFA00
                        ; ============================================================================
   fa00   c3 33 fa              JMP     BOOT            ; 0  BIOS+0   cold start
   fa03   c3 72 fa              JMP     WBOOT           ; 1  BIOS+3   warm start
   fa06   c3 b5 fa              JMP     CONST           ; 2  BIOS+6   console status
   fa09   c3 c1 fa              JMP     CONIN           ; 3  BIOS+9   console input
   fa0c   c3 cb fa              JMP     CONOUT          ; 4  BIOS+12  console output
   fa0f   c3 ef fa              JMP     LIST            ; 5  BIOS+15  list device output
   fa12   c3 f2 fa              JMP     PUNCH           ; 6  BIOS+18  punch device output
   fa15   c3 f5 fa              JMP     READER          ; 7  BIOS+21  reader device input
   fa18   c3 0d fb              JMP     HOME            ; 8  BIOS+24  home the disk
   fa1b   c3 fb fa              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   fa1e   c3 16 fb              JMP     SETTRK          ; 10 BIOS+30  set current track
   fa21   c3 1b fb              JMP     SETSEC          ; 11 BIOS+33  set current sector
   fa24   c3 20 fb              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   fa27   c3 56 fb              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   fa2a   c3 6e fb              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   fa2d   c3 29 fb              JMP     SECTRAN         ; 15 BIOS+45  sector translate (identity)
   fa30   c3 f8 fa              JMP     LISTST          ; 16 BIOS+48  list device status
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xFA00 via 'G FA00')
                        ; ============================================================================
   fa33                 BOOT:
   fa33   31 00 f0              LXI     SP,0F000H       ; establish a stack (transient, during boot)
   fa36   3e 01                 MVI     A,01H
   fa38   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   fa3a   cd 96 fa              CALL    SETVEC
                        ;
                        ; ---- write CCP and BDOS from machine RAM onto the RAM disk SYSTEM tracks ----
   fa3d   21 00 00              LXI     H,SYSCPP        ; disk byte 0 (system track 0)
   fa40   11 00 e4              LXI     D,CCP           ; source = CCP image
   fa43   01 00 08              LXI     B,2048          ; 2048 bytes
   fa46   cd 86 fb              CALL    RAMWR
   fa49   21 00 08              LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
   fa4c   11 00 ec              LXI     D,BDOSL         ; source = BDOS image
   fa4f   01 00 0e              LXI     B,3584          ; 3584 bytes
   fa52   cd 86 fb              CALL    RAMWR
                        ;
                        ; ---- format the user data area (tracks 2..15 = 56K) to 0xE5 (empty) ---------
   fa55   21 00 20              LXI     H,2000H         ; start of track 2 = disk byte 8192
   fa58   01 00 e0              LXI     B,0E000H        ; 57344 bytes = 14 tracks * 4K
   fa5b   3e e5                 MVI     A,0E5H          ; empty-directory marker
   fa5d   cd a2 fb              CALL    RAMFILL
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   fa60   21 b4 fb              LXI     H,BANNER
   fa63   cd e2 fa              CALL    PRTSTR
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   fa66   21 80 00              LXI     H,DMA0
   fa69   22 cd fb              SHLD    DMA
   fa6c   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   fa6f   c3 00 e4              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   fa72                 WBOOT:
   fa72   31 00 f0              LXI     SP,0F000H
                        ;
                        ; ---- reload CCP and BDOS from the RAM disk SYSTEM tracks --------------------
   fa75   21 00 00              LXI     H,SYSCPP
   fa78   11 00 e4              LXI     D,CCP
   fa7b   01 00 08              LXI     B,2048
   fa7e   cd 94 fb              CALL    RAMRD
   fa81   21 00 08              LXI     H,SYSBDS
   fa84   11 00 ec              LXI     D,BDOSL
   fa87   01 00 0e              LXI     B,3584
   fa8a   cd 94 fb              CALL    RAMRD
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   fa8d   cd 96 fa              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   fa90   01 00 00              LXI     B,0000H
   fa93   c3 00 e4              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xFA03), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xEC06)
                        ; ============================================================================
   fa96                 SETVEC:
   fa96   21 00 00              LXI     H,0000H
   fa99   36 c3                 MVI     M,0C3H          ; JP
   fa9b   23                    INX     H
   fa9c   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xFA03 (the WBOOT table entry)
   fa9e   23                    INX     H
   fa9f   36 fa                 MVI     M,HIGH(BIOS)
   faa1   21 03 00              LXI     H,0003H
   faa4   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   faa6   23                    INX     H
   faa7   36 00                 MVI     M,00H
   faa9   21 05 00              LXI     H,0005H
   faac   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   faae   23                    INX     H
   faaf   36 06                 MVI     M,LOW(BDOSENT)
   fab1   23                    INX     H
   fab2   36 ec                 MVI     M,HIGH(BDOSENT)
   fab4   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   fab5                 CONST:
   fab5   db 80                 IN      80H
   fab7   e6 02                 ANI     02H             ; rx_avail (bit1)
   fab9   3e 00                 MVI     A,00H           ; default: no char
   fabb   ca c0 fa              JZ      CONST2
   fabe   3e ff                 MVI     A,0FFH          ; char ready
   fac0                 CONST2:
   fac0   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   fac1                 CONIN:
   fac1   db 80                 IN      80H
   fac3   e6 02                 ANI     02H             ; rx_avail (bit1)
   fac5   ca c1 fa              JZ      CONIN           ; wait for a character
   fac8   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   faca   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   facb                 CONOUT:
   facb   db 80                 IN      80H
   facd   e6 01                 ANI     01H             ; tx_busy (bit0)
   facf   c2 cb fa              JNZ     CONOUT          ; wait until transmitter is idle
   fad2   79                    MOV     A,C
   fad3   d3 81                 OUT     81H
   fad5   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   fad6                 PUTC:
   fad6   f5                    PUSH    PSW
   fad7                 PUTC1:
   fad7   db 80                 IN      80H
   fad9   e6 01                 ANI     01H
   fadb   c2 d7 fa              JNZ     PUTC1
   fade   f1                    POP     PSW
   fadf   d3 81                 OUT     81H
   fae1   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   fae2                 PRTSTR:
   fae2   7e                    MOV     A,M
   fae3   b7                    ORA     A
   fae4   ca ee fa              JZ      PRTEND
   fae7   cd d6 fa              CALL    PUTC
   faea   23                    INX     H
   faeb   c3 e2 fa              JMP     PRTSTR
   faee                 PRTEND:
   faee   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   faef                 LIST:
   faef   c3 cb fa              JMP     CONOUT          ; char in C
   faf2                 PUNCH:
   faf2   c3 cb fa              JMP     CONOUT          ; char in C
   faf5                 READER:
   faf5   c3 c1 fa              JMP     CONIN           ; returns char in A
   faf8                 LISTST:
   faf8   3e ff                 MVI     A,0FFH          ; list device always "ready"
   fafa   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ; Only drive A (C=0) exists (the RAM disk); all other drives return an error.
   fafb                 SELDSK:
   fafb   79                    MOV     A,C
   fafc   32 ca fb              STA     SELBL           ; remember the selected drive number
   faff   b7                    ORA     A
   fb00   c2 07 fb              JNZ     SELERR          ; C != 0 -> not present
   fb03   21 d4 fb              LXI     H,DPH           ; drive A disk parameter header
   fb06   c9                    RET
   fb07                 SELERR:
   fb07   21 00 00              LXI     H,0000H         ; error return: HL=0
   fb0a   3e ff                 MVI     A,0FFH
   fb0c   c9                    RET
                        
                        ; HOME: move to track 0, sector 0.
   fb0d                 HOME:
   fb0d   3e 00                 MVI     A,00H
   fb0f   32 cb fb              STA     TRK
   fb12   32 cc fb              STA     SECN
   fb15   c9                    RET
                        
                        ; SETTRK: set the current track (register C).
   fb16                 SETTRK:
   fb16   79                    MOV     A,C
   fb17   32 cb fb              STA     TRK
   fb1a   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   fb1b                 SETSEC:
   fb1b   79                    MOV     A,C
   fb1c   32 cc fb              STA     SECN
   fb1f   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   fb20                 SETDMA:
   fb20   79                    MOV     A,C
   fb21   32 cd fb              STA     DMA
   fb24   78                    MOV     A,B
   fb25   32 ce fb              STA     DMA+1
   fb28   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   fb29                 SECTRAN:
   fb29   69                    MOV     L,C
   fb2a   60                    MOV     H,B
   fb2b   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   fb2c                 CALC:
   fb2c   3a cb fb              LDA     TRK
   fb2f   6f                    MOV     L,A
   fb30   26 00                 MVI     H,00H           ; HL = TRK
   fb32   29                    DAD     H               ; *2
   fb33   29                    DAD     H               ; *4
   fb34   29                    DAD     H               ; *8
   fb35   29                    DAD     H               ; *16
   fb36   29                    DAD     H               ; *32
   fb37   29                    DAD     H               ; *64
   fb38   29                    DAD     H               ; *128
   fb39   29                    DAD     H               ; *256
   fb3a   29                    DAD     H               ; *512
   fb3b   29                    DAD     H               ; *1024
   fb3c   29                    DAD     H               ; *2048
   fb3d   29                    DAD     H               ; *4096  -> HL = TRK*4096
   fb3e   44                    MOV     B,H
   fb3f   4d                    MOV     C,L             ; BC = TRK*4096
   fb40   3a cc fb              LDA     SECN
   fb43   6f                    MOV     L,A
   fb44   26 00                 MVI     H,00H           ; HL = SECN
   fb46   29                    DAD     H               ; *2
   fb47   29                    DAD     H               ; *4
   fb48   29                    DAD     H               ; *8
   fb49   29                    DAD     H               ; *16
   fb4a   29                    DAD     H               ; *32
   fb4b   29                    DAD     H               ; *64
   fb4c   29                    DAD     H               ; *128  -> HL = SECN*128
   fb4d   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   fb4e   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   fb4f                 RAMPTR:
   fb4f   7d                    MOV     A,L
   fb50   d3 21                 OUT     21H             ; address low byte
   fb52   7c                    MOV     A,H
   fb53   d3 22                 OUT     22H             ; address high byte
   fb55   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   fb56                 READ:
   fb56   cd 2c fb              CALL    CALC            ; HL = RAM-disk byte address
   fb59   cd 4f fb              CALL    RAMPTR          ; set the disk data-pointer
   fb5c   2a cd fb              LHLD    DMA
   fb5f   54                    MOV     D,H
   fb60   5d                    MOV     E,L             ; DE = DMA destination
   fb61   06 80                 MVI     B,128
   fb63                 READ1:
   fb63   db 20                 IN      20H             ; read a byte (data port auto-increments)
   fb65   12                    STAX    D
   fb66   13                    INX     D
   fb67   05                    DCR     B
   fb68   c2 63 fb              JNZ     READ1
   fb6b   3e 00                 MVI     A,00H           ; success
   fb6d   c9                    RET
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   fb6e                 WRITE:
   fb6e   cd 2c fb              CALL    CALC            ; HL = RAM-disk byte address
   fb71   cd 4f fb              CALL    RAMPTR
   fb74   2a cd fb              LHLD    DMA
   fb77   54                    MOV     D,H
   fb78   5d                    MOV     E,L             ; DE = DMA source
   fb79   06 80                 MVI     B,128
   fb7b                 WRITE1:
   fb7b   1a                    LDAX    D
   fb7c   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   fb7e   13                    INX     D
   fb7f   05                    DCR     B
   fb80   c2 7b fb              JNZ     WRITE1
   fb83   3e 00                 MVI     A,00H           ; success
   fb85   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   fb86                 RAMWR:
   fb86   cd 4f fb              CALL    RAMPTR
   fb89                 RAMWR1:
   fb89   1a                    LDAX    D
   fb8a   d3 20                 OUT     20H
   fb8c   13                    INX     D
   fb8d   0b                    DCX     B
   fb8e   78                    MOV     A,B
   fb8f   b1                    ORA     C
   fb90   c2 89 fb              JNZ     RAMWR1
   fb93   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   fb94                 RAMRD:
   fb94   cd 4f fb              CALL    RAMPTR
   fb97                 RAMRD1:
   fb97   db 20                 IN      20H
   fb99   12                    STAX    D
   fb9a   13                    INX     D
   fb9b   0b                    DCX     B
   fb9c   78                    MOV     A,B
   fb9d   b1                    ORA     C
   fb9e   c2 97 fb              JNZ     RAMRD1
   fba1   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   fba2                 RAMFILL:
   fba2   32 cf fb              STA     FILLV
   fba5   cd 4f fb              CALL    RAMPTR
   fba8                 RAMFILL1:
   fba8   3a cf fb              LDA     FILLV
   fbab   d3 20                 OUT     20H
   fbad   0b                    DCX     B
   fbae   78                    MOV     A,B
   fbaf   b1                    ORA     C
   fbb0   c2 a8 fb              JNZ     RAMFILL1
   fbb3   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   fbb4                 BANNER:
   fbb4   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH,0
   fbb8   20 32 2e 32   
   fbbc   20 6f 6e 20   
   fbc0   42 72 65 76   
   fbc4   69 61 32 0d   
   fbc8   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   fbca                 SELBL:  DS      1               ; last selected drive
   fbcb                 TRK:    DS      1               ; current (absolute) track
   fbcc                 SECN:   DS      1               ; current sector
   fbcd                 DMA:    DS      2               ; current DMA address
   fbcf                 FILLV:  DS      1               ; scratch for RAMFILL
   fbd0                         DS      4               ; (padding/alignment reserved)
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADER (DPH) for drive A
                        ;   Byte layout consumed by the BDOS:
                        ;     +0  XLT  (sector-translate vector address; 0 = none)
                        ;     +2  scratch, +4 scratch, +6 scratch
                        ;     +8  DIRBUF, +10 DPB, +12 CSV, +14 ALV
                        ; ============================================================================
   fbd4                 DPH:
   fbd4   00 00                 DW      0000H           ; XLT: no sector translation
   fbd6   00 00                 DW      0000H           ; scratch (cdrmax)
   fbd8   00 00                 DW      0000H           ; scratch (curtrk)
   fbda   00 00                 DW      0000H           ; scratch (currec)
   fbdc   fc fb                 DW      DIRBUF          ; directory buffer (128 bytes)
   fbde   e4 fb                 DW      DPB             ; disk parameter block
   fbe0   f3 fb                 DW      CSV             ; checksum vector
   fbe2   f4 fb                 DW      ALV             ; allocation vector
                        
                        ; ============================================================================
                        ;   DISK PARAMETER BLOCK (DPB)
                        ;   CP/M 2.2 geometry for the 64K RAM disk (drive A:):
                        ;     128-byte sectors, SPT=32, 14 user tracks + 2 system tracks = 16 tracks,
                        ;     1K allocation blocks (BSH=3/BLM=7), DSM=55 (56 blocks = 56K user data),
                        ;     DRM=63 (64 directory entries = 2 directory blocks), CKS=0 (fixed media),
                        ;     OFF=2 (reserve tracks 0-1 for the system).
                        ;   IMPORTANT: DSM is stored as a WORD (not a byte).  The BDOS copies this
                        ;   table byte-for-byte into its internal aligned structure, so DSM must be a
                        ;   word for the SECTPT/MAXALL/... fields to line up correctly.
                        ;   AL0/AL1 reserve the directory blocks.  With the MSB-first allocation-map
                        ;   convention the 2 directory blocks at the start of the data area are blocks
                        ;   0 and 1, so AL0=0xC0 / AL1=0x00.  (AL0=0x00/AL1=0xC0 would reserve blocks
                        ;   8-9 and leave the real directory at block 0 unprotected, breaking SAVE.)
                        ; ============================================================================
   fbe4                 DPB:
   fbe4   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   fbe6   03                    DB      03H             ; BSH  = 3    (block shift  -> 1K blocks)
   fbe7   07                    DB      07H             ; BLM  = 7    (block mask)
   fbe8   00                    DB      00H             ; EXM  = 0
   fbe9   37 00                 DW      55              ; DSM  = 55   (max block number = 56 blocks)
   fbeb   3f 00                 DW      63              ; DRM  = 63   (max directory entry = 64 entries)
   fbed   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   fbee   00                    DB      00H             ; AL1  = 0x00
   fbef   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   fbf1   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
                        
                        ; ============================================================================
                        ;   CBIOS BUFFERS / VECTORS
                        ; ============================================================================
   fbf3                 CSV:    DS      1               ; checksum vector (0 bytes needed since CKS=0)
   fbf4                 ALV:    DS      8               ; allocation vector (56 blocks / 8 = 7 -> pad 8)
   fbfc                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
   fc7c                         END
fbf4  ALV           fbb4  BANNER        ec06  BDOSENT       ec00  BDOSL     
fa00  BIOS          fa33  BOOT          fb2c  CALC          e400  CCP       
fac1  CONIN         facb  CONOUT        fab5  CONST         fac0  CONST2    
fbf3  CSV           fbfc  DIRBUF        fbcd  DMA           0080  DMA0      
fbe4  DPB           fbd4  DPH           fbcf  FILLV         fb0d  HOME      
faef  LIST          faf8  LISTST        faee  PRTEND        fae2  PRTSTR    
faf2  PUNCH         fad6  PUTC          fad7  PUTC1         fba2  RAMFILL   
fba8  RAMFILL1      fb4f  RAMPTR        fb94  RAMRD         fb97  RAMRD1    
fb86  RAMWR         fb89  RAMWR1        fb56  READ          fb63  READ1     
faf5  READER        fbcc  SECN          fb29  SECTRAN       fbca  SELBL     
