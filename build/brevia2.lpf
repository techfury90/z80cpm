# Brevia2 pin constraints for z80cpm_brevia2 (from the Lattice demo .lpf).
# CPU clock = clk_in (50 MHz) / 2 -> 25 MHz. Add a derived-clock FREQUENCY
# constraint on the divided clock via Diamond > Tools > Spreadsheet > Clocks.
LOCATE COMP "clk_in" SITE "21" ;
LOCATE COMP "rst_n" SITE "19" ;
LOCATE COMP "led[0]" SITE "46" ;
LOCATE COMP "led[1]" SITE "45" ;
LOCATE COMP "led[2]" SITE "44" ;
LOCATE COMP "led[3]" SITE "43" ;
LOCATE COMP "led[4]" SITE "40" ;
LOCATE COMP "led[5]" SITE "39" ;
LOCATE COMP "led[6]" SITE "38" ;
LOCATE COMP "led[7]" SITE "37" ;
LOCATE COMP "sw[0]" SITE "58" ;
LOCATE COMP "sw[1]" SITE "57" ;
LOCATE COMP "sw[2]" SITE "56" ;
LOCATE COMP "sw[3]" SITE "55" ;
LOCATE COMP "sw[4]" SITE "54" ;
LOCATE COMP "sw[5]" SITE "53" ;
LOCATE COMP "sw[6]" SITE "52" ;
LOCATE COMP "sw[7]" SITE "50" ;
LOCATE COMP "uart_rx" SITE "110" ;
LOCATE COMP "uart_tx" SITE "109" ;
LOCATE COMP "spi_csn" SITE "11" ;
LOCATE COMP "spi_miso" SITE "16" ;
LOCATE COMP "spi_mosi" SITE "15" ;
LOCATE COMP "spi_sclk" SITE "13" ;
LOCATE COMP "sram_addr[0]" SITE "119" ;
LOCATE COMP "sram_addr[1]" SITE "120" ;
LOCATE COMP "sram_addr[2]" SITE "121" ;
LOCATE COMP "sram_addr[3]" SITE "122" ;
LOCATE COMP "sram_addr[4]" SITE "123" ;
LOCATE COMP "sram_addr[5]" SITE "124" ;
LOCATE COMP "sram_addr[6]" SITE "125" ;
LOCATE COMP "sram_addr[7]" SITE "127" ;
LOCATE COMP "sram_addr[8]" SITE "129" ;
LOCATE COMP "sram_addr[9]" SITE "130" ;
LOCATE COMP "sram_addr[10]" SITE "131" ;
LOCATE COMP "sram_addr[11]" SITE "132" ;
LOCATE COMP "sram_addr[12]" SITE "133" ;
LOCATE COMP "sram_addr[13]" SITE "134" ;
LOCATE COMP "sram_addr[14]" SITE "137" ;
LOCATE COMP "sram_addr[15]" SITE "138" ;
LOCATE COMP "sram_addr[16]" SITE "141" ;
LOCATE COMP "sram_cen" SITE "142" ;
LOCATE COMP "sram_oen" SITE "143" ;
LOCATE COMP "sram_wen" SITE "144" ;
LOCATE COMP "sram_data[0]" SITE "1" ;
LOCATE COMP "sram_data[1]" SITE "2" ;
LOCATE COMP "sram_data[2]" SITE "5" ;
LOCATE COMP "sram_data[3]" SITE "6" ;
LOCATE COMP "sram_data[4]" SITE "7" ;
LOCATE COMP "sram_data[5]" SITE "8" ;
LOCATE COMP "sram_data[6]" SITE "9" ;
LOCATE COMP "sram_data[7]" SITE "10" ;
IOBUF ALLPORTS IO_TYPE=LVCMOS33 ;
IOBUF PORT "clk_in" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
FREQUENCY NET "clk_op" 25.000000 MHz ;
BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
BLOCK JTAGPATHS ;
FREQUENCY NET "clk_in_c" 50.000000 MHz ;
CLOCK_TO_OUT PORT "sram_addr*" 15.000000 ns CLKNET "clk_op" ;
INPUT_SETUP PORT "uart_rx" 20.000000 ns CLKNET "clk_op" ;
INPUT_SETUP PORT "sram_data*" 5.000000 ns CLKNET "clk_op" ;
CLOCK_TO_OUT PORT "sram_cen" 15.000000 ns CLKNET "clk_op" ;
CLOCK_TO_OUT PORT "sram_oen" 15.000000 ns CLKNET "clk_op" ;
CLOCK_TO_OUT PORT "sram_wen" 15.000000 ns CLKNET "clk_op" ;
CLOCK_TO_OUT PORT "sram_data*" 15.000000 ns CLKNET "clk_op" ;
CLOCK_TO_OUT PORT "uart_tx" 20.000000 ns CLKNET "clk_op" ;
