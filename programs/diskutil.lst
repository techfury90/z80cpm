                        ; ============================================================================
                        ; diskutil.s -- standalone RAM-disk maintenance utility for the Brevia2 Z80.
                        ;
                        ; Runs entirely OUTSIDE of CP/M. Loaded via GWMON-80 'L', run via 'G 1000'.
                        ; Uses the console UART (0x80 status / 0x81 data) for BOTH the menu and the
                        ; XMODEM file transfer, and the RAM-disk controller (0x20 DATA auto-inc,
                        ; 0x21 ADDR lo, 0x22 ADDR hi) for the CP/M disk layout in bank B.
                        ;
                        ; Commands:
                        ;   F  -- format drive A: (write 0xE5 to the 2K directory area)
                        ;   U  -- XMODEM upload (checksum mode): receive a file from the host PC and
                        ;         write it to the RAM disk as a CP/M file (multi-extent for >16K).
                        ;   D  -- XMODEM download: send a file from the RAM disk to the host PC.
                        ;   H  -- help
                        ;
                        ; XMODEM receive retries the initiating NAK with a ~1.5s timeout each cycle,
                        ; so the host (Tera Term / minicom) picks it up even if it starts the transfer
                        ; AFTER we began waiting. Supports checksum blocks (SOH) and CRC blocks (STX).
                        ;
                        ; Assembled with the Glitch Works a85 8085 cross-assembler (same as cbios.asm).
                        ; ============================================================================
                        
   1000                         ORG     1000H
                        
                        ; ---------------- Processor I/O ports ----------------
   0080                 USTAT   EQU     80H                     ; UART status (bit0 tx_busy, bit1 rx_avail)
   0081                 UDATA   EQU     81H                     ; UART data (read=RX char, write=TX char)
   0020                 RDDATA  EQU     20H                     ; RAM disk DATA (read/write, auto-increment)
   0021                 RDADRL  EQU     21H                     ; RAM disk ADDR low
   0022                 RDADRH  EQU     22H                     ; RAM disk ADDR high
                        
                        ; ---------------- CP/M drive A: disk layout (bank B) ----------------
   2000                 DIRBASE EQU     2000H                   ; directory area base (2K = 64 entries)
   2800                 DBLOCK0 EQU     2800H                   ; first USER data block (block 2) base
   0400                 BLKSZ   EQU     1024                    ; block size (1K)
   0080                 RECSZ   EQU     128                     ; CP/M record size
                        
                        ; ---------------- XMODEM control bytes ----------------
   0001                 XM_SOH  EQU     01H
   0002                 XM_STX  EQU     02H
   0004                 XM_EOT  EQU     04H
   0006                 XM_ACK  EQU     06H
   0015                 XM_NAK  EQU     15H
   0018                 XM_CAN  EQU     18H
   00fe                 XM_TO   EQU     0FEH                    ; internal: RX timeout marker
                        
                        ; ---------------- Workspace (bank A SRAM, well below the CCP at 0xE400) ----------------
   2000                 XMBUF   EQU     2000H                   ; 128-byte XMODEM block buffer
   2100                 FCB     EQU     2100H                   ; 32-byte FCB (extent 0) in RAM
   2120                 FCB2    EQU     2120H                   ; 32-byte FCB (extent 1) in RAM
   2160                 RCNT_L  EQU     2160H                   ; total records received (16-bit, L then H)
   2180                 FNAME   EQU     2180H                   ; 12-byte user filename buffer (8.3)
                        
                        ; ============================================================================
   1000   c3 6b 10              JMP     START
                        
                        ; ---------------- UART primitives ----------------
                        ; TXCHAR: output char in A; poll tx_busy(bit0) low.
   1003   f5            TXCHAR: PUSH    PSW
   1004   db 80         TXCH1:  IN      USTAT
   1006   e6 01                 ANI     01H
   1008   c2 04 10              JNZ     TXCH1
   100b   f1                    POP     PSW
   100c   d3 81                 OUT     UDATA
   100e   c9                    RET
                        
                        ; RXCHAR: block until a char, return it in A.
   100f   db 80         RXCHAR: IN      USTAT
   1011   e6 02                 ANI     02H
   1013   ca 0f 10              JZ      RXCHAR
   1016   db 81                 IN      UDATA
   1018   c9                    RET
                        
                        ; RXCHAR_T: receive a char with a ~1.5s timeout.
                        ;   Returns: carry CLEAR + A=char if a char arrived; carry SET if timeout.
   1019                 RXCHAR_T:
   1019   06 b0                 MVI     B,0B0H                  ; outer count
   101b   0e b0         RT_L2:  MVI     C,0B0H                  ; mid count
   101d   16 b0         RT_L1:  MVI     D,0B0H                  ; inner count
   101f   db 80         RT_L0:  IN      USTAT
   1021   e6 02                 ANI     02H
   1023   c2 34 10              JNZ     RT_HAVE
   1026   15                    DCR     D
   1027   c2 1f 10              JNZ     RT_L0
   102a   0d                    DCR     C
   102b   c2 1d 10              JNZ     RT_L1
   102e   05                    DCR     B
   102f   c2 1b 10              JNZ     RT_L2
   1032   37                    STC                             ; timeout
   1033   c9                    RET
   1034                 RT_HAVE:
   1034   db 81                 IN      UDATA                   ; char
   1036   37                    STC
   1037   3f                    CMC                             ; carry clear (char read)
   1038   c9                    RET
                        
                        ; CRLF: send CR + LF.
   1039   3e 0d         CRLF:   MVI     A,0DH
   103b   cd 03 10              CALL    TXCHAR
   103e   3e 0a                 MVI     A,0AH
   1040   cd 03 10              CALL    TXCHAR
   1043   c9                    RET
                        
                        ; PRTSTR: print NUL-terminated string at HL.
   1044   7e            PRTSTR: MOV     A,M
   1045   b7                    ORA     A
   1046   c8                    RZ
   1047   cd 03 10              CALL    TXCHAR
   104a   23                    INX     H
   104b   c3 44 10              JMP     PRTSTR
                        
                        ; PRTBYTE: print A as two hex digits.
   104e   f5            PRTBYTE: PUSH    PSW
   104f   e6 f0                 ANI     0F0H
   1051   0f                    RRC
   1052   0f                    RRC
   1053   0f                    RRC
   1054   0f                    RRC
   1055   cd 5b 10              CALL    PRTH1
   1058   f1                    POP     PSW
   1059   e6 0f                 ANI     0FH
   105b   c6 90         PRTH1:  ADI     90H
   105d   27                    DAA
   105e   ce 40                 ACI     40H                     ; add carry (ACI) so 0xA-0xF print A-F
   1060   27                    DAA
   1061   c3 03 10              JMP     TXCHAR
                        
                        ; ---------------- RAM-disk primitives (bank B) ----------------
   1064   7d            RDSETA: MOV     A,L
   1065   d3 21                 OUT     RDADRL
   1067   7c                    MOV     A,H
   1068   d3 22                 OUT     RDADRH
   106a   c9                    RET
                        
                        ; ============================================================================
                        ; START
                        ; ============================================================================
   106b   31 00 f0      START:  LXI     SP,0F000H               ; stack high in bank A (clear of code/buffers)
   106e   21 99 14              LXI     H,MSGBANNER
   1071   cd 44 10              CALL    PRTSTR
   1074   21 b8 14      MENU:   LXI     H,MSGMENU
   1077   cd 44 10              CALL    PRTSTR
   107a   cd 0f 10              CALL    RXCHAR                  ; wait for a command char
   107d   e6 df                 ANI     0DFH                    ; force uppercase (accept lowercase)
   107f   fe 46                 CPI     'F'
   1081   ca 9b 10              JZ      DO_FMT
   1084   fe 55                 CPI     'U'
   1086   ca c7 10              JZ      DO_UPLOAD
   1089   fe 44                 CPI     'D'
   108b   ca 94 13              JZ      DO_DOWNLOAD
   108e   fe 48                 CPI     'H'
   1090   ca be 10              JZ      DO_HELP
   1093   fe 42                 CPI     'B'
   1095   ca 29 14              JZ      DO_DUMP
   1098   c3 74 10              JMP     MENU
                        
                        ; ---------------- command: format ----------------
   109b   21 12 15      DO_FMT: LXI     H,MSGFMT
   109e   cd 44 10              CALL    PRTSTR
   10a1   21 00 20              LXI     H,DIRBASE
   10a4   cd 64 10              CALL    RDSETA
   10a7   01 00 08              LXI     B,2048                  ; 2K directory
   10aa   16 e5                 MVI     D,0E5H                  ; keep the fill value in D (A is clobbered below)
   10ac   7a            FMTW:   MOV     A,D
   10ad   d3 20                 OUT     RDDATA                  ; write 0xE5 (auto-increment)
   10af   0b                    DCX     B
   10b0   78                    MOV     A,B
   10b1   b1                    ORA     C
   10b2   c2 ac 10              JNZ     FMTW
   10b5   21 22 15              LXI     H,MSGFMTOK
   10b8   cd 44 10              CALL    PRTSTR
   10bb   c3 74 10              JMP     MENU
                        
   10be   21 db 14      DO_HELP: LXI     H,MSGHELP
   10c1   cd 44 10              CALL    PRTSTR
   10c4   c3 74 10              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_UPLOAD -- XMODEM (checksum/CRC) receive a file, write it as a CP/M file.
                        ; ============================================================================
   10c7                 DO_UPLOAD:
   10c7   21 2f 15              LXI     H,MSGPROMPT
   10ca   cd 44 10              CALL    PRTSTR
   10cd   cd da 12              CALL    READNAME                ; read "name.ext" into FNAME (echoed)
   10d0   21 00 00              LXI     H,0000H
   10d3   22 60 21              SHLD    RCNT_L                  ; init record counter
   10d6   21 48 15              LXI     H,MSGRECV
   10d9   cd 44 10              CALL    PRTSTR
   10dc   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   10de   cd 03 10              CALL    TXCHAR
                        
   10e1   cd 32 11      UPLOOP: CALL    GETBLK                  ; A=TO(timeout),01 good,FF bad,00 EOT,02 CAN
   10e4   fe fe                 CPI     XM_TO
   10e6   ca 08 11              JZ      UP_NAK                  ; timeout -> resend NAK, keep waiting
   10e9   fe 02                 CPI     02H
   10eb   ca 08 11              JZ      UP_NAK                  ; CAN
   10ee   fe 00                 CPI     00H
   10f0   ca 10 11              JZ      UP_EOT
   10f3   fe ff                 CPI     0FFH
   10f5   ca 08 11              JZ      UP_NAK                  ; bad block -> NAK
                                ; good block -> write it to the disk
   10f8   cd f6 11              CALL    WRITEBLK
   10fb   3e 06                 MVI     A,XM_ACK
   10fd   cd 03 10              CALL    TXCHAR
   1100   3e 2e                 MVI     A,'.'
   1102   cd 03 10              CALL    TXCHAR
   1105   c3 e1 10              JMP     UPLOOP
   1108   3e 15         UP_NAK: MVI     A,XM_NAK
   110a   cd 03 10              CALL    TXCHAR
   110d   c3 e1 10              JMP     UPLOOP
                        
   1110   3e 06         UP_EOT: MVI     A,XM_ACK
   1112   cd 03 10              CALL    TXCHAR
   1115   cd 39 10              CALL    CRLF
   1118   cd 23 12              CALL    WRITEFCB                ; write directory entries
   111b   21 60 15              LXI     H,MSGDONE
   111e   cd 44 10              CALL    PRTSTR
   1121   2a 60 21              LHLD    RCNT_L
   1124   7c                    MOV     A,H
   1125   cd 4e 10              CALL    PRTBYTE
   1128   7d                    MOV     A,L
   1129   cd 4e 10              CALL    PRTBYTE
   112c   cd 39 10              CALL    CRLF
   112f   c3 74 10              JMP     MENU
                        
                        ; ============================================================================
                        ; GETBLK -- receive one XMODEM block into XMBUF.
                        ; Returns A: XM_TO(timeout), 00=EOT, 01=good, FF=bad, 02=CAN.
                        ; (First byte uses the timed read so we can retry the NAK on timeout; the rest
                        ;  of the block uses blocking reads because the host sends them back-to-back.)
                        ; ============================================================================
   1132   cd 19 10      GETBLK: CALL    RXCHAR_T
   1135   da 4f 11              JC      GT_TIMEOUT              ; carry set = timeout
   1138   fe 04                 CPI     XM_EOT
   113a   ca 52 11              JZ      GT_EOT
   113d   fe 18                 CPI     XM_CAN
   113f   ca 54 11              JZ      GT_CAN
   1142   fe 01                 CPI     XM_SOH
   1144   ca 57 11              JZ      GT_SOH
   1147   fe 02                 CPI     XM_STX
   1149   ca 80 11              JZ      GT_STX
   114c   c3 32 11              JMP     GETBLK                  ; stray byte (e.g. 'rx name'), ignore
                        
   114f                 GT_TIMEOUT:
   114f   3e fe                 MVI     A,XM_TO
   1151   c9                    RET
   1152   af            GT_EOT: XRA     A
   1153   c9                    RET
   1154   3e 02         GT_CAN: MVI     A,02H
   1156   c9                    RET
                        
                        ; ---- SOH: checksum block (blkno, ~blkno, 128 data, 1-byte checksum) ----
   1157   cd 0f 10      GT_SOH: CALL    RXCHAR
   115a   47                    MOV     B,A                     ; blkno
   115b   cd 0f 10              CALL    RXCHAR
   115e   a8                    XRA     B                       ; ~blkno ^ blkno
   115f   fe ff                 CPI     0FFH
   1161   c2 f3 11              JNZ     GT_BAD
   1164   21 00 20              LXI     H,XMBUF
   1167   1e 00                 MVI     E,00H
   1169   0e 80                 MVI     C,128
   116b   cd 0f 10      GT_LP:  CALL    RXCHAR
   116e   77                    MOV     M,A
   116f   83                    ADD     E
   1170   5f                    MOV     E,A
   1171   23                    INX     H
   1172   0d                    DCR     C
   1173   c2 6b 11              JNZ     GT_LP
   1176   cd 0f 10              CALL    RXCHAR                  ; checksum byte
   1179   bb                    CMP     E
   117a   c2 f3 11              JNZ     GT_BAD
   117d   3e 01                 MVI     A,01H
   117f   c9                    RET
                        
                        ; ---- STX: CRC block (blkno, ~blkno, 128 data, 2-byte CRC-16) ----
   1180   cd 0f 10      GT_STX: CALL    RXCHAR
   1183   47                    MOV     B,A                     ; blkno
   1184   cd 0f 10              CALL    RXCHAR
   1187   a8                    XRA     B
   1188   fe ff                 CPI     0FFH
   118a   c2 f3 11              JNZ     GT_BAD
   118d   21 00 20              LXI     H,XMBUF
   1190   0e 80                 MVI     C,128
   1192   cd 0f 10      GT_LP2: CALL    RXCHAR
   1195   77                    MOV     M,A
   1196   23                    INX     H
   1197   0d                    DCR     C
   1198   c2 92 11              JNZ     GT_LP2
                                ; compute CRC-16 XMODEM over XMBUF -> D: E (D high, E low)
   119b   21 00 20              LXI     H,XMBUF
   119e   11 00 00              LXI     D,0000H                 ; crc = 0
   11a1   0e 80                 MVI     C,128
   11a3   7e            GT_CRC: MOV     A,M
   11a4   47                    MOV     B,A
   11a5   7a                    MOV     A,D
   11a6   a8                    XRA     B                       ; crc_hi ^= byte
   11a7   57                    MOV     D,A
   11a8   06 08                 MVI     B,08H
   11aa   7a            GTCB:   MOV     A,D
   11ab   e6 80                 ANI     80H                     ; crc & 0x8000 ?
   11ad   ca cb 11              JZ      GTCS
   11b0   a7                    ANA     A                       ; clear carry
   11b1   7b                    MOV     A,E
   11b2   17                    RAL                             ; E = E<<1 (carry = old E bit7)
   11b3   5f                    MOV     E,A
   11b4   7a                    MOV     A,D
   11b5   17                    RAL                             ; D = D<<1 | old E bit7
   11b6   57                    MOV     D,A
   11b7   7a                    MOV     A,D
   11b8   ee 10                 XRI     10H                     ; crc ^= 0x1021 (hi)
   11ba   57                    MOV     D,A
   11bb   7b                    MOV     A,E
   11bc   ee 21                 XRI     21H                     ; crc ^= 0x1021 (lo)
   11be   5f                    MOV     E,A
   11bf   05                    DCR     B
   11c0   c2 aa 11              JNZ     GTCB
   11c3   23                    INX     H
   11c4   0d                    DCR     C
   11c5   c2 a3 11              JNZ     GT_CRC
   11c8   c3 db 11              JMP     GT_CHK
   11cb   a7            GTCS:   ANA     A                       ; clear carry
   11cc   7b                    MOV     A,E
   11cd   17                    RAL
   11ce   5f                    MOV     E,A
   11cf   7a                    MOV     A,D
   11d0   17                    RAL
   11d1   57                    MOV     D,A
   11d2   05                    DCR     B
   11d3   c2 aa 11              JNZ     GTCB
   11d6   23                    INX     H
   11d7   0d                    DCR     C
   11d8   c2 a3 11              JNZ     GT_CRC
   11db                 GT_CHK:
   11db   23                    INX     H
   11dc   0d                    DCR     C
   11dd   c2 a3 11              JNZ     GT_CRC
                                ; read 2 CRC bytes (high, low), compare
   11e0   cd 0f 10              CALL    RXCHAR
   11e3   47                    MOV     B,A                     ; received crc hi
   11e4   cd 0f 10              CALL    RXCHAR
   11e7   bb                    CMP     E                       ; compare low
   11e8   c2 f3 11              JNZ     GT_BAD
   11eb   78                    MOV     A,B
   11ec   ba                    CMP     D                       ; compare high
   11ed   c2 f3 11              JNZ     GT_BAD
   11f0   3e 01                 MVI     A,01H
   11f2   c9                    RET
                        
   11f3   3e ff         GT_BAD: MVI     A,0FFH
   11f5   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEBLK -- write the 128 good bytes in XMBUF to the RAM disk at the current
                        ;   file position. Position = DBLOCK0 + RCNT_L*128. (Blocks contiguous; block #
                        ;   = RCNT/8 + 2.)
                        ; ============================================================================
   11f6                 WRITEBLK:
   11f6   2a 60 21              LHLD    RCNT_L
   11f9   54                    MOV     D,H
   11fa   5d                    MOV     E,L
   11fb   06 07                 MVI     B,07H
   11fd                 WBLK_SHL:
   11fd   7b                    MOV     A,E
   11fe   87                    ADD     A
   11ff   5f                    MOV     E,A
   1200   7a                    MOV     A,D
   1201   17                    RAL
   1202   57                    MOV     D,A
   1203   05                    DCR     B
   1204   c2 fd 11              JNZ     WBLK_SHL
   1207   21 00 28              LXI     H,DBLOCK0
   120a   19                    DAD     D
   120b   cd 64 10              CALL    RDSETA
   120e   21 00 20              LXI     H,XMBUF
   1211   0e 80                 MVI     C,128
   1213   7e            WBLK:   MOV     A,M
   1214   d3 20                 OUT     RDDATA
   1216   23                    INX     H
   1217   0d                    DCR     C
   1218   c2 13 12              JNZ     WBLK
   121b   2a 60 21              LHLD    RCNT_L
   121e   23                    INX     H
   121f   22 60 21              SHLD    RCNT_L
   1222   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEFCB -- write the FCB directory entry/entries for the received file.
                        ;   Single extent (<=16K) -> one slot; >16K -> two slots (extents 0 and 1).
                        ; ============================================================================
   1223                 WRITEFCB:
   1223   cd 1e 13              CALL    BUILD_FCB               ; builds FCB (and FCB2 copy) with name/ext
   1226   2a 60 21              LHLD    RCNT_L
   1229   7c                    MOV     A,H
   122a   b7                    ORA     A
   122b   c2 4d 12              JNZ     WFC_TWO
   122e   7d                    MOV     A,L
   122f   fe 81                 CPI     129
   1231   d2 4d 12              JNC     WFC_TWO
                                ; ---- single extent (<=16K) ----
   1234   3e 00                 MVI     A,00H
   1236   32 0c 21              STA     FCB+12                  ; EX=0
   1239   32 0d 21              STA     FCB+13                  ; S1=0
   123c   32 0e 21              STA     FCB+14                  ; S2=0
   123f   2a 60 21              LHLD    RCNT_L
   1242   7d                    MOV     A,L
   1243   32 0f 21              STA     FCB+15                  ; RC = records
   1246   cd aa 12              CALL    SETALLO                 ; fill FCB+16..31 (blocks from 2)
   1249   cd 96 12              CALL    WDIRFCB
   124c   c9                    RET
                        
   124d                 WFC_TWO:
   124d   3e 00                 MVI     A,00H
   124f   32 0c 21              STA     FCB+12
   1252   32 0d 21              STA     FCB+13
   1255   32 0e 21              STA     FCB+14
   1258   3e 80                 MVI     A,128
   125a   32 0f 21              STA     FCB+15
   125d   cd aa 12              CALL    SETALLO
   1260   2a 60 21              LHLD    RCNT_L
   1263   7d                    MOV     A,L
   1264   d6 80                 SUI     128
   1266   6f                    MOV     L,A
   1267   7c                    MOV     A,H
   1268   de 00                 SBI     00H
   126a   67                    MOV     H,A
   126b   7d                    MOV     A,L
   126c   32 2f 21              STA     FCB2+15                 ; RC extent 1
   126f   3e 01                 MVI     A,01H
   1271   32 2c 21              STA     FCB2+12                 ; EX=1
   1274   3e 00                 MVI     A,00H
   1276   32 2d 21              STA     FCB2+13                 ; S1=0
   1279   32 2e 21              STA     FCB2+14                 ; S2=0
   127c   cd c2 12              CALL    SETALLO2
   127f   cd 96 12              CALL    WDIRFCB
   1282   21 20 20              LXI     H,DIRBASE+32
   1285   cd 64 10              CALL    RDSETA
   1288   21 20 21              LXI     H,FCB2
   128b   0e 20                 MVI     C,32
   128d   7e            WFC2B:  MOV     A,M
   128e   d3 20                 OUT     RDDATA
   1290   23                    INX     H
   1291   0d                    DCR     C
   1292   c2 8d 12              JNZ     WFC2B
   1295   c9                    RET
                        
   1296   21 00 20      WDIRFCB: LXI     H,DIRBASE
   1299   cd 64 10              CALL    RDSETA
   129c   21 00 21              LXI     H,FCB
   129f   0e 20                 MVI     C,32
   12a1   7e            WDF:    MOV     A,M
   12a2   d3 20                 OUT     RDDATA
   12a4   23                    INX     H
   12a5   0d                    DCR     C
   12a6   c2 a1 12              JNZ     WDF
   12a9   c9                    RET
                        
   12aa                 SETALLO:
   12aa   3a 0f 21              LDA     FCB+15
   12ad   c6 07                 ADI     07H
   12af   0f                    RRC
   12b0   0f                    RRC
   12b1   0f                    RRC
   12b2   e6 1f                 ANI     1FH
   12b4   47                    MOV     B,A
   12b5   21 10 21              LXI     H,FCB+16
   12b8   3e 02                 MVI     A,02H
   12ba   77            SA1:    MOV     M,A
   12bb   23                    INX     H
   12bc   3c                    INR     A
   12bd   05                    DCR     B
   12be   c2 ba 12              JNZ     SA1
   12c1   c9                    RET
                        
   12c2                 SETALLO2:
   12c2   3a 2f 21              LDA     FCB2+15
   12c5   c6 07                 ADI     07H
   12c7   0f                    RRC
   12c8   0f                    RRC
   12c9   0f                    RRC
   12ca   e6 1f                 ANI     1FH
   12cc   47                    MOV     B,A
   12cd   21 30 21              LXI     H,FCB2+16
   12d0   3e 18                 MVI     A,18H
   12d2   77            SA21:   MOV     M,A
   12d3   23                    INX     H
   12d4   3c                    INR     A
   12d5   05                    DCR     B
   12d6   c2 d2 12              JNZ     SA21
   12d9   c9                    RET
                        
                        ; ============================================================================
                        ; READNAME -- read "name.ext" (max 9 chars) from console into FNAME, echoing.
                        ; ============================================================================
   12da                 READNAME:
   12da   21 80 21              LXI     H,FNAME
   12dd   06 0c                 MVI     B,12
   12df   cd 0f 10      RN1:    CALL    RXCHAR
   12e2   fe 0d                 CPI     0DH
   12e4   ca 17 13              JZ      RN_DONE
   12e7   fe 08                 CPI     08H                     ; ^H backspace
   12e9   ca fd 12              JZ      RN_BS
   12ec   fe 7f                 CPI     7FH                     ; DEL backspace
   12ee   ca fd 12              JZ      RN_BS
   12f1   77                    MOV     M,A
   12f2   cd 03 10              CALL    TXCHAR                  ; ECHO the char
   12f5   23                    INX     H
   12f6   05                    DCR     B
   12f7   c2 df 12              JNZ     RN1
   12fa   c3 17 13              JMP     RN_DONE
   12fd                 RN_BS:  ; backspace: erase from the screen and back the buffer up (if possible)
   12fd   3e 08                 MVI     A,08H
   12ff   cd 03 10              CALL    TXCHAR
   1302   3e 20                 MVI     A,20H
   1304   cd 03 10              CALL    TXCHAR
   1307   3e 08                 MVI     A,08H
   1309   cd 03 10              CALL    TXCHAR
   130c   78                    MOV     A,B
   130d   fe 09                 CPI     9
   130f   ca df 12              JZ      RN1                     ; buffer full, at start -> nothing to back up
   1312   2b                    DCX     H
   1313   04                    INR     B
   1314   c3 df 12              JMP     RN1
   1317   3e 00         RN_DONE: MVI     A,00H
   1319   77                    MOV     M,A                     ; NUL terminate
   131a   cd 39 10              CALL    CRLF
   131d   c9                    RET
                        
                        ; ============================================================================
                        ; BUILD_FCB -- parse FNAME into the 32-byte FCB (and copy into FCB2).
                        ; ============================================================================
   131e                 BUILD_FCB:
   131e   21 00 21              LXI     H,FCB
   1321   06 40                 MVI     B,64                    ; zero both FCBs (2 x 32)
   1323   3e 00         BF_Z:   MVI     A,00H
   1325   77                    MOV     M,A
   1326   23                    INX     H
   1327   05                    DCR     B
   1328   c2 23 13              JNZ     BF_Z
   132b   11 80 21              LXI     D,FNAME
   132e   21 01 21              LXI     H,FCB+1
   1331   06 08                 MVI     B,8
   1333   1a            BF_N:   LDAX    D
   1334   fe 00                 CPI     00H
   1336   ca 4f 13              JZ      BF_NPAD
   1339   fe 2e                 CPI     '.'
   133b   ca 4f 13              JZ      BF_GOTEXT
   133e   77                    MOV     M,A
   133f   23                    INX     H
   1340   13                    INX     D
   1341   05                    DCR     B
   1342   c2 33 13              JNZ     BF_N
   1345   1a                    LDAX    D
   1346   fe 2e                 CPI     '.'
   1348   c2 7e 13              JNZ     BF_EXT0
   134b   13                    INX     D
   134c   c3 58 13              JMP     BF_EXT
   134f                 BF_GOTEXT:
   134f   3e 20         BF_NPAD: MVI     A,' '
   1351   77                    MOV     M,A
   1352   23                    INX     H
   1353   05                    DCR     B
   1354   c2 4f 13              JNZ     BF_NPAD
   1357   13                    INX     D                       ; skip '.'
   1358   21 09 21      BF_EXT: LXI     H,FCB+9
   135b   06 03                 MVI     B,3
   135d   1a            BF_E:   LDAX    D
   135e   fe 00                 CPI     00H
   1360   ca 76 13              JZ      BF_EXT_PAD
   1363   fe 2e                 CPI     '.'
   1365   ca 72 13              JZ      BF_EXT_SKIP
   1368   77                    MOV     M,A
   1369   23                    INX     H
   136a   13                    INX     D
   136b   05                    DCR     B
   136c   c2 5d 13              JNZ     BF_E
   136f   c3 7e 13              JMP     BF_EXT0
   1372                 BF_EXT_SKIP:
   1372   13                    INX     D
   1373   c3 5d 13              JMP     BF_E
   1376                 BF_EXT_PAD:
   1376   3e 20                 MVI     A,' '
   1378   77                    MOV     M,A
   1379   23                    INX     H
   137a   05                    DCR     B
   137b   c2 76 13              JNZ     BF_EXT_PAD
   137e                 BF_EXT0:
   137e   21 00 21              LXI     H,FCB
   1381   36 01                 MVI     M,01H                   ; drive 1 = A: (dir entry byte0)
   1383   21 00 21              LXI     H,FCB
   1386   11 20 21              LXI     D,FCB2
   1389   06 20                 MVI     B,32
   138b   7e            BF_C:   MOV     A,M
   138c   12                    STAX    D
   138d   23                    INX     H
   138e   13                    INX     D
   138f   05                    DCR     B
   1390   c2 8b 13              JNZ     BF_C
   1393   c9                    RET
                        
                        ; ============================================================================
                        ; DO_DOWNLOAD -- XMODEM send dir-slot-0 file's extent 0 to the host (checksum).
                        ; ============================================================================
   1394                 DO_DOWNLOAD:
   1394   21 98 15              LXI     H,MSGDL
   1397   cd 44 10              CALL    PRTSTR
   139a   21 0f 20              LXI     H,DIRBASE+15
   139d   cd 64 10              CALL    RDSETA
   13a0   db 20                 IN      RDDATA                  ; A = RC (extent 0)
   13a2   32 25 14              STA     SEND_RC
   13a5   cd 0f 10              CALL    RXCHAR                  ; wait for NAK/'C' from host
   13a8   cd ae 13              CALL    XM_SENDFILE
   13ab   c3 74 10              JMP     MENU
                        
   13ae                 XM_SENDFILE:
   13ae   3a 25 14              LDA     SEND_RC
   13b1   47                    MOV     B,A                     ; B = records to send
   13b2   3e 01                 MVI     A,01H
   13b4   32 26 14              STA     XS_BLK
   13b7   21 00 28              LXI     H,DBLOCK0
   13ba   22 27 14              SHLD    XS_ADDR
   13bd   78            XS_LOOP: MOV     A,B
   13be   b7                    ORA     A
   13bf   ca 07 14              JZ      XS_DONE
   13c2   3e 01                 MVI     A,XM_SOH
   13c4   cd 03 10              CALL    TXCHAR
   13c7   3a 26 14              LDA     XS_BLK
   13ca   cd 03 10              CALL    TXCHAR
   13cd   4f                    MOV     C,A
   13ce   2f                    CMA
   13cf   cd 03 10              CALL    TXCHAR
   13d2   2a 27 14              LHLD    XS_ADDR
   13d5   cd 64 10              CALL    RDSETA
   13d8   1e 00                 MVI     E,00H
   13da   0e 80                 MVI     C,128
   13dc   db 20         XS_DATA: IN      RDDATA
   13de   83                    ADD     E
   13df   5f                    MOV     E,A
   13e0   0d                    DCR     C
   13e1   c2 dc 13              JNZ     XS_DATA
   13e4   7b                    MOV     A,E
   13e5   cd 03 10              CALL    TXCHAR                  ; checksum
   13e8   2a 27 14              LHLD    XS_ADDR
   13eb   11 28 01              LXI     D,0128H
   13ee   19                    DAD     D
   13ef   22 27 14              SHLD    XS_ADDR
   13f2   cd 0f 10              CALL    RXCHAR
   13f5   fe 06                 CPI     XM_ACK
   13f7   c2 bd 13              JNZ     XS_LOOP                 ; NAK/unknown -> resend
   13fa   3a 26 14              LDA     XS_BLK
   13fd   3c                    INR     A
   13fe   32 26 14              STA     XS_BLK
   1401   78                    MOV     A,B
   1402   3d                    DCR     A
   1403   47                    MOV     B,A
   1404   c2 bd 13              JNZ     XS_LOOP
   1407                 XS_DONE:
   1407   3e 04                 MVI     A,XM_EOT
   1409   cd 03 10              CALL    TXCHAR
   140c   cd 0f 10              CALL    RXCHAR
   140f   fe 06                 CPI     XM_ACK
   1411   ca 1c 14              JZ      XS_END
   1414   3e 04                 MVI     A,XM_EOT
   1416   cd 03 10              CALL    TXCHAR
   1419   cd 0f 10              CALL    RXCHAR
   141c   21 ae 15      XS_END: LXI     H,MSGDLDONE
   141f   cd 44 10              CALL    PRTSTR
   1422   c3 74 10              JMP     MENU
                        
   1425                 SEND_RC: DS     1
   1426                 XS_BLK:  DS     1
   1427                 XS_ADDR: DS     2
                        
                        ; ============================================================================
                        ; DO_DUMP -- dump 256 bytes from the RAM disk at a hex address, as hex (16/line).
                        ; ============================================================================
   1429                 DO_DUMP:
   1429   21 7b 15              LXI     H,MSGDUMP
   142c   cd 44 10              CALL    PRTSTR
   142f   cd 51 14              CALL    READHEX                 ; HL = start address
   1432   cd 64 10              CALL    RDSETA
   1435   06 10                 MVI     B,16                    ; 16 lines
   1437   16 10         DUMP_L1: MVI     D,16                    ; 16 bytes per line
   1439   db 20         DUMP_B: IN      RDDATA
   143b   cd 4e 10              CALL    PRTBYTE
   143e   3e 20                 MVI     A,' '
   1440   cd 03 10              CALL    TXCHAR
   1443   15                    DCR     D
   1444   c2 39 14              JNZ     DUMP_B
   1447   cd 39 10              CALL    CRLF
   144a   05                    DCR     B
   144b   c2 37 14              JNZ     DUMP_L1
   144e   c3 74 10              JMP     MENU
                        
                        ; ---------------------------------------------------------------------------
                        ; READHEX -- read up to 4 hex digits from the console into HL (echoed).
                        ; ---------------------------------------------------------------------------
   1451                 READHEX:
   1451   21 00 00              LXI     H,0000H
   1454   06 04                 MVI     B,4
   1456   cd 0f 10      RH1:    CALL    RXCHAR
   1459   fe 0d                 CPI     0DH
   145b   ca 92 14              JZ      RH_DONE                 ; Enter ends
                                ; determine hex digit value 0-15 in A
   145e   fe 30                 CPI     '0'
   1460   da 96 14              JC      RH_NEXT                 ; < '0' -> ignore
   1463   fe 3a                 CPI     '9'+1
   1465   da 79 14              JC      RH_DIG                  ; '0'-'9'
   1468   e6 df                 ANI     0DFH                    ; uppercase
   146a   fe 41                 CPI     'A'
   146c   da 96 14              JC      RH_NEXT                 ; < 'A' -> ignore
   146f   fe 47                 CPI     'F'+1
   1471   d2 96 14              JNC     RH_NEXT                 ; > 'F' -> ignore
   1474   d6 37                 SUI     'A'-10                  ; 'A'-'F' -> 10-15
   1476   c3 7b 14              JMP     RH_ADD
   1479   d6 30         RH_DIG: SUI     '0'                     ; '0'-'9' -> 0-9
   147b   cd 03 10      RH_ADD: CALL    TXCHAR                  ; echo the digit
   147e   4f                    MOV     C,A                     ; C = digit value
                                ; HL = (HL << 4) | C
   147f   16 04                 MVI     D,04H
   1481   7d            RH_SHL: MOV     A,L
   1482   87                    ADD     A
   1483   6f                    MOV     L,A
   1484   7c                    MOV     A,H
   1485   17                    RAL
   1486   67                    MOV     H,A
   1487   15                    DCR     D
   1488   c2 81 14              JNZ     RH_SHL
   148b   7d                    MOV     A,L
   148c   b1                    ORA     C
   148d   6f                    MOV     L,A
   148e   05                    DCR     B
   148f   c2 56 14              JNZ     RH1
   1492                 RH_DONE:
   1492   cd 39 10              CALL    CRLF
   1495   c9                    RET
   1496   c3 56 14      RH_NEXT: JMP     RH1
                        
