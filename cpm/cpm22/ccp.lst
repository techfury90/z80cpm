   61/D000 :                            ;	* at ccp+8 is executed automatically (normally a null  *
   62/D000 :                            ;	* command with comlen = 00).  An initializing program  *
   63/D000 :                            ;	* can be automatically loaded by storing the command   *
   64/D000 :                            ;	* at ccp+8, with the command length at ccp+7.  In this *
   65/D000 :                            ;	* case, the ccp executes the command before prompting  *
   66/D000 :                            ;	* the console for input.  Note that the command is exe-*
   67/D000 :                            ;	* cuted on both warm and cold starts.  When the command*
   68/D000 :                            ;	* line is initialized, a jump to "jmp ccpclear" dis-   *
   69/D000 :                            ;	* ables the automatic command execution.               *
   70/D000 :                            ;	********************************************************
   71/D000 :                            
   72/D000 : C3 5C D3                   	jmp	ccpstart	;start ccp with possible initial command
   73/D003 : C3 58 D3                   	jmp	ccpclear	;clear the command buffer
   74/D006 : 7F                         maxlen:	db	127	;max buffer length
   75/D007 : 00                         comlen:	db	0	;command length (filled in by dos)
   76/D008 :                            ;	(command executed initially if comlen non zero)
   77/D008 :                            combuf:
