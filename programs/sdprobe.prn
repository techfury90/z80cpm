                        ; SDPROBE.COM -- Brevia2 SD-card probe (SPI mode), bare-metal driver demo.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port wired to pins 31/32/35/36:
                        ;   IN  0x53 = SD SPI data        (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl   bit0 = CS# (0 = select, 1 = release)
                        ;                           bit1 = slow clock (1 = ~390 kHz for card init)
                        ;   IN  0x55 = SD SPI status bit0 = transfer-busy
                        ;
                        ; The on-board flash SPI pins are not broken out, so the SD breakout has its
                        ; OWN SPI port (implemented as a second instance of the generic byte engine in
                        ; rtl/z80cpm_brevia2.v).
                        ;
                        ; What it does:
                        ;   1. Full SPI-mode init handshake (power-up clocks, CMD0, CMD8, CMD55/ACMD41,
                        ;      CMD58, CMD16) -- proves the card initializes on real silicon.
                        ;   2. Reads the CID (CMD9) and prints manufacturer ID, product name, serial.
                        ;   3. Reads block 0 (CMD17) and reports whether an MBR (55AA) is present,
                        ;      printing the first partition entry (type / LBA / size) -- the first
                        ;      step toward partitioning support.
                        ;
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 06 04              LXI     H,BANNER
   0103   cd 97 03              CALL    PSTR
                        
                                ; ---------------- 1. init the card ----------------
   0106   cd 59 02              CALL    SDINIT          ; A = 0 if init OK (CMD0 idle + ACMD41 ready), 0FFh if not
   0109   b7                    ORA     A
   010a   ca 72 01              JZ      INI_OK
                                ; ---- failure: report detailed diagnostics ----
   010d   21 3f 04              LXI     H,MSG_NOCARD
   0110   cd 97 03              CALL    PSTR
   0113   cd a5 03              CALL    CRLF
                                ; raw CMD0 response bytes
   0116   21 57 04              LXI     H,MSG_CMD0R
   0119   cd 97 03              CALL    PSTR
   011c   21 8d 05              LXI     H,RBUF
   011f   06 08                 MVI     B,8
   0121                 SD_DIAG:
   0121   7e                    MOV     A,M
   0122   e5                    PUSH    H
   0123   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   0124   cd b0 03              CALL    PRHEX2
   0127   1e 20                 MVI     E,' '
   0129   cd 9f 03              CALL    CPUTC
   012c   c1                    POP     B
   012d   e1                    POP     H
   012e   23                    INX     H
   012f   05                    DCR     B
   0130   c2 21 01              JNZ     SD_DIAG
   0133   cd a5 03              CALL    CRLF
                                ; interpreted R1
   0136   21 69 04              LXI     H,MSG_R1
   0139   cd 97 03              CALL    PSTR
   013c   3a 8c 05              LDA     CMDR1
   013f   cd b0 03              CALL    PRHEX2
   0142   cd a5 03              CALL    CRLF
   0145   3a 8c 05              LDA     CMDR1
   0148   fe ff                 CPI     0FFH            ; no response at all?
   014a   c2 56 01              JNZ     SD_DIAG2
   014d   21 6d 04              LXI     H,MSG_NORESP
   0150   cd 97 03              CALL    PSTR
   0153   cd a5 03              CALL    CRLF
   0156                 SD_DIAG2:
                                ; ACMD41 poll count + result
   0156   21 ac 04              LXI     H,MSG_ACMD
   0159   cd 97 03              CALL    PSTR
   015c   3a 95 05              LDA     ACMDIT
   015f   cd b0 03              CALL    PRHEX2          ; poll count (hex)
   0162   21 bc 04              LXI     H,MSG_ACMDR
   0165   cd 97 03              CALL    PSTR
   0168   3a 96 05              LDA     ACMDR1
   016b   cd b0 03              CALL    PRHEX2
   016e   cd a5 03              CALL    CRLF
   0171   c9                    RET
   0172                 INI_OK:
   0172   21 2d 04              LXI     H,MSG_INI
   0175   cd 97 03              CALL    PSTR
   0178   3a 8c 05              LDA     CMDR1           ; show the CMD0 R1 (01h = idle) for hardware diagnostics
   017b   cd b0 03              CALL    PRHEX2
   017e   cd a5 03              CALL    CRLF
                        
                                ; ---- detect card type (CMD58 -> OCR CCS bit30) ----
   0181   cd 36 03              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0184   b7                    ORA     A
   0185   ca 91 01              JZ      IS_SC
   0188   21 c5 04              LXI     H,MSG_SDHC
   018b   cd 97 03              CALL    PSTR
   018e   c3 97 01              JMP     AFTER_TYPE
   0191                 IS_SC:
   0191   21 ea 04              LXI     H,MSG_SDSC
   0194   cd 97 03              CALL    PSTR
   0197                 AFTER_TYPE:
   0197   cd a5 03              CALL    CRLF
                        
                                ; ---------------- 2. read CID ----------------
   019a   cd 49 03              CALL    SD_CID          ; A = 1 ok / 0 err
   019d   b7                    ORA     A
   019e   ca ad 01              JZ      CID_OK
   01a1   21 1e 05              LXI     H,MSG_CIDERR
   01a4   cd 97 03              CALL    PSTR
   01a7   cd a5 03              CALL    CRLF
   01aa   c3 f4 01              JMP     AFTER_CID
   01ad                 CID_OK:
   01ad   21 09 05              LXI     H,MSG_CID
   01b0   cd 97 03              CALL    PSTR
                                ; manufacturer ID (CID[0])
   01b3   3a 97 05              LDA     CIDBUF
   01b6   cd b0 03              CALL    PRHEX2
   01b9   1e 20                 MVI     E,' '
   01bb   cd 9f 03              CALL    CPUTC
                                ; product name (CID[3..7], 5 ASCII bytes)
   01be   21 9a 05              LXI     H,CIDBUF+3
   01c1   06 05                 MVI     B,5
   01c3                 CID_NM:
   01c3   5e                    MOV     E,M
   01c4   e5                    PUSH    H
   01c5   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   01c6   cd 9f 03              CALL    CPUTC
   01c9   c1                    POP     B
   01ca   e1                    POP     H
   01cb   23                    INX     H
   01cc   05                    DCR     B
   01cd   c2 c3 01              JNZ     CID_NM
   01d0   cd a5 03              CALL    CRLF
                                ; serial number (CID[9..12])
   01d3   21 14 05              LXI     H,MSG_SN
   01d6   cd 97 03              CALL    PSTR
   01d9   3a a0 05              LDA     CIDBUF+9
   01dc   cd b0 03              CALL    PRHEX2
   01df   3a a1 05              LDA     CIDBUF+10
   01e2   cd b0 03              CALL    PRHEX2
   01e5   3a a2 05              LDA     CIDBUF+11
   01e8   cd b0 03              CALL    PRHEX2
   01eb   3a a3 05              LDA     CIDBUF+12
   01ee   cd b0 03              CALL    PRHEX2
   01f1   cd a5 03              CALL    CRLF
   01f4                 AFTER_CID:
                        
                                ; ---------------- 3. read block 0 + MBR check ----------------
   01f4   cd 70 03              CALL    SD_BLK0         ; A = 1 ok / 0 err
   01f7   b7                    ORA     A
   01f8   ca 07 02              JZ      BLK_OK
   01fb   21 30 05              LXI     H,MSG_BLKERR
   01fe   cd 97 03              CALL    PSTR
   0201   cd a5 03              CALL    CRLF
   0204   c3 4f 02              JMP     AFTER_BLK
   0207                 BLK_OK:
                                ; check MBR signature 55AA at DBUF+510
   0207   21 a5 07              LXI     H,DBUF+510
   020a   7e                    MOV     A,M
   020b   fe 55                 CPI     55H
   020d   c2 46 02              JNZ     NO_MBR
   0210   23                    INX     H
   0211   7e                    MOV     A,M
   0212   fe aa                 CPI     0AAH
   0214   c2 46 02              JNZ     NO_MBR
                                ; MBR present -> print partition 1 info
   0217   21 46 05              LXI     H,MSG_MBR
   021a   cd 97 03              CALL    PSTR
                                ; type byte at DBUF+446+4
   021d   21 69 07              LXI     H,DBUF+446+4
   0220   7e                    MOV     A,M
   0221   cd b0 03              CALL    PRHEX2
   0224   1e 20                 MVI     E,' '
   0226   cd 9f 03              CALL    CPUTC
                                ; LBA start (bytes +8..+11, little-endian); size (+12..+15)
   0229   21 6d 07              LXI     H,DBUF+446+8
   022c   06 08                 MVI     B,8             ; 4 LBA bytes + 4 size bytes
   022e                 MBR_LP:
   022e   7e                    MOV     A,M
   022f   e5                    PUSH    H
   0230   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   0231   cd b0 03              CALL    PRHEX2
   0234   1e 20                 MVI     E,' '
   0236   cd 9f 03              CALL    CPUTC
   0239   c1                    POP     B
   023a   e1                    POP     H
   023b   23                    INX     H
   023c   05                    DCR     B
   023d   c2 2e 02              JNZ     MBR_LP
   0240   cd a5 03              CALL    CRLF
   0243   c3 4f 02              JMP     AFTER_BLK
   0246                 NO_MBR:
   0246   21 72 05              LXI     H,MSG_NOMBR
   0249   cd 97 03              CALL    PSTR
   024c   cd a5 03              CALL    CRLF
   024f                 AFTER_BLK:
                        
   024f   21 84 05              LXI     H,MSG_DONE
   0252   cd 97 03              CALL    PSTR
   0255   cd a5 03              CALL    CRLF
   0258   c9                    RET
                        
                        ; ================= SD card driver subroutines =================
                        
                        ; SDINIT: full SPI-mode initialization.
                        ;   Success: A = 0  (CMDR1 = 01h idle, card ready).
                        ;   Failure: A = 0FFh, with diagnostics: CMDR1 = CMD0 R1 (or 0FFh if no
                        ;            response), RBUF = raw CMD0 response bytes, ACMDIT = ACMD41 poll
                        ;            count, ACMDR1 = final ACMD41 result.
   0259                 SDINIT:
   0259   af                    XRA     A
   025a   32 95 05              STA     ACMDIT          ; defaults so the no-card diagnostic shows 00/00
   025d   32 96 05              STA     ACMDR1
   0260   3e 03                 MVI     A,03H           ; bit0=1 (CS high), bit1=1 (slow)
   0262   d3 54                 OUT     SDCTL
   0264   06 0a                 MVI     B,10            ; 10 byte-writes = 80 power-up clocks (CS# high)
   0266                 SDI_CK:
   0266   3e ff                 MVI     A,0FFH
   0268   d3 53                 OUT     SDDAT
   026a   05                    DCR     B
   026b   c2 66 02              JNZ     SDI_CK
   026e   3e 02                 MVI     A,02H           ; select card (CS low), stay on slow clock
   0270   d3 54                 OUT     SDCTL
                                ; --- send CMD0, then capture the raw response bytes ---
   0272   21 d6 03              LXI     H,CMD0
   0275   06 06                 MVI     B,6
   0277                 SDI_TX:
   0277   7e                    MOV     A,M
   0278   d3 53                 OUT     SDDAT
   027a   23                    INX     H
   027b   05                    DCR     B
   027c   c2 77 02              JNZ     SDI_TX
   027f   21 8d 05              LXI     H,RBUF
   0282   06 08                 MVI     B,8
   0284                 SDI_RX:
   0284   db 53                 IN      SDDAT
   0286   77                    MOV     M,A
   0287   23                    INX     H
   0288   05                    DCR     B
   0289   c2 84 02              JNZ     SDI_RX
                                ; find the first byte that is not 0FFh = R1
   028c   21 8d 05              LXI     H,RBUF
   028f   06 08                 MVI     B,8
   0291                 SDI_FR1:
   0291   7e                    MOV     A,M
   0292   fe ff                 CPI     0FFH
   0294   c2 a1 02              JNZ     SDI_HAVE
   0297   23                    INX     H
   0298   05                    DCR     B
   0299   c2 91 02              JNZ     SDI_FR1
   029c   3e ff                 MVI     A,0FFH          ; no valid response at all
   029e   c3 a2 02              JMP     SDI_ST1
   02a1                 SDI_HAVE:
   02a1   7e                    MOV     A,M
   02a2                 SDI_ST1:
   02a2   32 8c 05              STA     CMDR1
   02a5   fe 01                 CPI     01H             ; must be in idle state to continue
   02a7   c2 e0 02              JNZ     SDI_FAIL
                                ; --- CMD8 (SEND_IF_COND): REQUIRED before ACMD41 on SDHC/SDXC cards.
                                ;     R1 = 01h (SD v2, and the AA check pattern echoes) or 05h
                                ;     (illegal command = old SDSC v1, which is fine).  Consume the
                                ;     4-byte R7 payload so the card is ready for the ACMD41 sequence.
   02aa   21 dc 03              LXI     H,CMD8
   02ad   cd e6 02              CALL    SD_SEND6        ; A = R1 (01h or 05h)
   02b0   db 53                 IN      SDDAT           ; R7 payload (4 bytes), consume
   02b2   db 53                 IN      SDDAT
   02b4   db 53                 IN      SDDAT
   02b6   db 53                 IN      SDDAT
                                ; --- poll CMD55+ACMD41 until the card leaves idle.  Card init is
                                ;     time-based, so we wait a real delay between attempts (CS# stays
                                ;     selected on the slow clock; the data-read routines switch to the
                                ;     fast clock once the card is ready). ---
   02b8   16 c8                 MVI     D,200           ; up to 200 attempts
   02ba   af                    XRA     A
   02bb   32 95 05              STA     ACMDIT
   02be                 SDI_RDY:
   02be   21 e2 03              LXI     H,CMD55
   02c1   cd e6 02              CALL    SD_SEND6
   02c4   21 e8 03              LXI     H,ACMD41
   02c7   cd e6 02              CALL    SD_SEND6        ; A = R1
   02ca   32 96 05              STA     ACMDR1
   02cd   fe 00                 CPI     00H
   02cf   ca e3 02              JZ      SDI_OK
   02d2   3a 95 05              LDA     ACMDIT
   02d5   3c                    INR     A
   02d6   32 95 05              STA     ACMDIT
   02d9   cd fe 02              CALL    DELAYMS         ; ~3ms pause before the next attempt
   02dc   15                    DCR     D
   02dd   c2 be 02              JNZ     SDI_RDY
   02e0                 SDI_FAIL:
   02e0   3e ff                 MVI     A,0FFH
   02e2   c9                    RET
   02e3                 SDI_OK:
   02e3   3e 00                 MVI     A,00H
   02e5   c9                    RET
                        
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Assumes the card is already selected (CS low).  Returns A = R1 (0FFh = no
                        ;   valid response after 16 bytes of clocking).
   02e6                 SD_SEND6:
   02e6   06 06                 MVI     B,6
   02e8                 SD6_TX:
   02e8   7e                    MOV     A,M
   02e9   d3 53                 OUT     SDDAT
   02eb   23                    INX     H
   02ec   05                    DCR     B
   02ed   c2 e8 02              JNZ     SD6_TX
   02f0   06 10                 MVI     B,16            ; clock up to 16 bytes looking for the response
   02f2                 SD6_RX:
   02f2   db 53                 IN      SDDAT           ; clocks out FFh, returns the MISO byte
   02f4   fe ff                 CPI     0FFH
   02f6   c2 fd 02              JNZ     SD6_DONE
   02f9   05                    DCR     B
   02fa   c2 f2 02              JNZ     SD6_RX
   02fd                 SD6_DONE:
   02fd   c9                    RET
                        
                        ; DELAYMS - approximate ~3ms busy-wait (uses HL only; used between SD init
                        ;   polls because SD card initialization is time-based, not clock-based).
   02fe                 DELAYMS:
   02fe   21 d0 07              LXI     H,2000
   0301                 DLMS:
   0301   2b                    DCX     H
   0302   7c                    MOV     A,H
   0303   b5                    ORA     L
   0304   c2 01 03              JNZ     DLMS
   0307   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success; CY=1 if 255 bytes pass with no token.
   0308                 SD_WAITTKN:
   0308   06 ff                 MVI     B,0FFH
   030a                 SD_WT:
   030a   db 53                 IN      SDDAT
   030c   fe fe                 CPI     0FEH
   030e   ca 17 03              JZ      SD_WT_OK
   0311   05                    DCR     B
   0312   c2 0a 03              JNZ     SD_WT
   0315   37                    STC
   0316   c9                    RET
   0317                 SD_WT_OK:
   0317   b7                    ORA     A               ; clear CY
   0318   c9                    RET
                        
                        ; SD_READBLK: read a 512-byte data block into the buffer at (HL) after a
                        ;   command has returned R1=0 and the 0FEh token; discard 2 CRC bytes.
                        ;   Returns A = 1 ok / 0 err (CY used internally).
   0319                 SD_READBLK:
   0319   cd 08 03              CALL    SD_WAITTKN
   031c   da 33 03              JC      SDRB_FAIL
   031f   01 00 02              LXI     B,512
   0322                 SDRB_LP:
   0322   db 53                 IN      SDDAT
   0324   77                    MOV     M,A
   0325   23                    INX     H
   0326   0b                    DCX     B
   0327   78                    MOV     A,B
   0328   b1                    ORA     C
   0329   c2 22 03              JNZ     SDRB_LP
   032c   db 53                 IN      SDDAT           ; discard 2 CRC bytes
   032e   db 53                 IN      SDDAT
   0330   3e 01                 MVI     A,1
   0332   c9                    RET
   0333                 SDRB_FAIL:
   0333   3e 00                 MVI     A,0
   0335   c9                    RET
                        
                        ; SDCCS: read the OCR (CMD58) and return the Card Capacity Status bit.
                        ;   Returns A = 40h (SDHC/SDXC, block addressing) or 00h (SDSC, byte addressing).
                        ;   Assumes card selected (CS low).
   0336                 SDCCS:
   0336   21 ee 03              LXI     H,CMD58
   0339   cd e6 02              CALL    SD_SEND6        ; A = R1
   033c   db 53                 IN      SDDAT           ; OCR byte0 (bits31..24); CCS=bit30 => bit6
   033e   e6 40                 ANI     40H
   0340   4f                    MOV     C,A
   0341   db 53                 IN      SDDAT           ; consume OCR bytes 1..3
   0343   db 53                 IN      SDDAT
   0345   db 53                 IN      SDDAT
   0347   79                    MOV     A,C
   0348   c9                    RET
                        
                        ; SD_CID: read the 16-byte CID (CMD9) into CIDBUF.
                        ;   Returns A = 1 ok / 0 err.  Manages CS low -> read -> release high.
   0349                 SD_CID:
   0349   3e 00                 MVI     A,00H
   034b   d3 54                 OUT     SDCTL           ; select, fast
   034d   21 fa 03              LXI     H,CMD9
   0350   cd e6 02              CALL    SD_SEND6        ; A = R1
   0353   fe 00                 CPI     00H
   0355   c2 69 03              JNZ     SDCID_TE
   0358   21 97 05              LXI     H,CIDBUF
   035b   cd 19 03              CALL    SD_READBLK      ; A = 1 ok / 0 err
   035e   b7                    ORA     A
   035f   ca 69 03              JZ      SDCID_TE        ; read failed
   0362   3e 01                 MVI     A,01H
   0364   d3 54                 OUT     SDCTL           ; release CS
   0366   3e 00                 MVI     A,00H           ; success (matches SDINIT: 0 = ok)
   0368   c9                    RET
   0369                 SDCID_TE:
   0369   3e 01                 MVI     A,01H
   036b   d3 54                 OUT     SDCTL           ; release CS
   036d   3e ff                 MVI     A,0FFH          ; error
   036f   c9                    RET
                        
                        ; SD_BLK0: read block 0 (CMD17) into DBUF.
                        ;   Returns A = 1 ok / 0 err.
   0370                 SD_BLK0:
   0370   3e 00                 MVI     A,00H
   0372   d3 54                 OUT     SDCTL           ; select, fast
   0374   21 00 04              LXI     H,CMD17
   0377   cd e6 02              CALL    SD_SEND6        ; A = R1
   037a   fe 00                 CPI     00H
   037c   c2 90 03              JNZ     SDBLK_TE
   037f   21 a7 05              LXI     H,DBUF
   0382   cd 19 03              CALL    SD_READBLK      ; A = 1 ok / 0 err
   0385   b7                    ORA     A
   0386   ca 90 03              JZ      SDBLK_TE
   0389   3e 01                 MVI     A,01H
   038b   d3 54                 OUT     SDCTL           ; release CS
   038d   3e 00                 MVI     A,00H           ; success
   038f   c9                    RET
   0390                 SDBLK_TE:
   0390   3e 01                 MVI     A,01H
   0392   d3 54                 OUT     SDCTL           ; release CS
   0394   3e ff                 MVI     A,0FFH          ; error
   0396   c9                    RET
                        
                        ; ---------------- console / numeric helpers (as in SWLED) ----------------
   0397                 PSTR:
   0397   54                    MOV     D,H
   0398   5d                    MOV     E,L
   0399   0e 09                 MVI     C,9
   039b   cd 05 00              CALL    5
   039e   c9                    RET
                        
   039f                 CPUTC:
   039f   0e 02                 MVI     C,2
   03a1   cd 05 00              CALL    5
   03a4   c9                    RET
                        
   03a5                 CRLF:
   03a5   1e 0d                 MVI     E,13
   03a7   cd 9f 03              CALL    CPUTC
   03aa   1e 0a                 MVI     E,10
   03ac   cd 9f 03              CALL    CPUTC
   03af   c9                    RET
                        
                        ; PRHEX2 -- print the byte in A as two uppercase hex digits.
   03b0                 PRHEX2:
   03b0   32 8b 05              STA     HEXV
   03b3   3a 8b 05              LDA     HEXV
   03b6   0f                    RRC
   03b7   0f                    RRC
   03b8   0f                    RRC
   03b9   0f                    RRC
   03ba   e6 0f                 ANI     0FH
   03bc   cd c8 03              CALL    PRNIB
   03bf   3a 8b 05              LDA     HEXV
   03c2   e6 0f                 ANI     0FH
   03c4   cd c8 03              CALL    PRNIB
   03c7   c9                    RET
                        
   03c8                 PRNIB:
   03c8   fe 0a                 CPI     0AH
   03ca   da cf 03              JC      PRNIB_NUM
   03cd   c6 07                 ADI     07H
   03cf                 PRNIB_NUM:
   03cf   c6 30                 ADI     '0'
   03d1   5f                    MOV     E,A
   03d2   cd 9f 03              CALL    CPUTC
   03d5   c9                    RET
                        
                        ; ---------------- data ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   03d6   40 00 00 00   CMD0:   DB      40H,00H,00H,00H,00H,95H
   03da   00 95         
   03dc   48 00 00 01   CMD8:   DB      48H,00H,00H,01H,0AAH,87H
   03e0   aa 87         
   03e2   77 00 00 00   CMD55:  DB      77H,00H,00H,00H,00H,65H
   03e6   00 65         
   03e8   69 40 00 00   ACMD41: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   03ec   00 77         
   03ee   7a 00 00 00   CMD58:  DB      7AH,00H,00H,00H,00H,0FDH
   03f2   00 fd         
   03f4   50 00 00 02   CMD16:  DB      50H,00H,00H,02H,00H,0FFH  ; set block length = 512
   03f8   00 ff         
   03fa   49 00 00 00   CMD9:   DB      49H,00H,00H,00H,00H,0FFH  ; read CID
   03fe   00 ff         
   0400   51 00 00 00   CMD17:  DB      51H,00H,00H,00H,00H,0FFH  ; read single block (block 0)
   0404   00 ff         
                        
   0406   53 44 50 52   BANNER: DB      'SDPROBE v0.1 - Brevia2 SD card probe',13,10,'$'
   040a   4f 42 45 20   
   040e   76 30 2e 31   
   0412   20 2d 20 42   
   0416   72 65 76 69   
   041a   61 32 20 53   
   041e   44 20 63 61   
   0422   72 64 20 70   
   0426   72 6f 62 65   
   042a   0d 0a 24      
   042d   49 4e 49 54   MSG_INI: DB      'INIT: CMD0 ok R1=','$'
   0431   3a 20 43 4d   
   0435   44 30 20 6f   
