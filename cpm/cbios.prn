                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xFA00 (BIOS base) so the image is loaded
                        ;   exactly at 0xFA00 by the GWMON-80 'L' command and entered with 'G FA00'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xE3FF  TPA
                        ;       0xE400-0xEBFF  CCP  (already loaded by the combined HEX)
                        ;       0xEC00-0xF9FF  BDOS (already loaded by the combined HEX)
                        ;       0xFA00-0xFFFF  THIS CBIOS
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 9600)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive A:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   fa00                         ORG     0FA00H
                        
                        ; ---- constants ------------------------------------------------------------
   fa00                 BIOS    EQU     0FA00H          ; BIOS base (jump table origin)
   e400                 CCP     EQU     0E400H          ; CCP origin
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xFA03.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   ec00                 BDOSL   EQU     0EC00H          ; BDOS origin
   ec06                 BDOSENT EQU     0EC06H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xFA00
                        ; ============================================================================
   fa00   c3 33 fa              JMP     BOOT            ; 0  BIOS+0   cold start
   fa03   c3 67 fa              JMP     WBOOT           ; 1  BIOS+3   warm start
   fa06   c3 aa fa              JMP     CONST           ; 2  BIOS+6   console status
   fa09   c3 b6 fa              JMP     CONIN           ; 3  BIOS+9   console input
   fa0c   c3 c0 fa              JMP     CONOUT          ; 4  BIOS+12  console output
   fa0f   c3 e4 fa              JMP     LIST            ; 5  BIOS+15  list device output
   fa12   c3 e7 fa              JMP     PUNCH           ; 6  BIOS+18  punch device output
   fa15   c3 ea fa              JMP     READER          ; 7  BIOS+21  reader device input
   fa18   c3 02 fb              JMP     HOME            ; 8  BIOS+24  home the disk
   fa1b   c3 f0 fa              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   fa1e   c3 0b fb              JMP     SETTRK          ; 10 BIOS+30  set current track
   fa21   c3 10 fb              JMP     SETSEC          ; 11 BIOS+33  set current sector
   fa24   c3 15 fb              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   fa27   c3 4b fb              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   fa2a   c3 63 fb              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   fa2d   c3 ed fa              JMP     LISTST          ; 15 BIOS+45  list device status
   fa30   c3 1e fb              JMP     SECTRAN         ; 16 BIOS+48  sector translate (identity)
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xFA00 via 'G FA00')
                        ; ============================================================================
   fa33                 BOOT:
   fa33   31 00 dc              LXI     SP,0DC00H       ; establish a stack in the TPA (below CCP@E400);
                                                        ; 0xF000 would sit INSIDE the BDOS (EC00-F9FF) and
                                                        ;  the boot's stack use would clobber the BDOS code.
   fa36   3e 01                 MVI     A,01H
   fa38   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   fa3a   cd 8b fa              CALL    SETVEC
                        ;
                        ; ---- write CCP and BDOS from machine RAM onto the RAM disk SYSTEM tracks ----
   fa3d   21 00 00              LXI     H,SYSCPP        ; disk byte 0 (system track 0)
   fa40   11 00 e4              LXI     D,CCP           ; source = CCP image
   fa43   01 00 08              LXI     B,2048          ; 2048 bytes
   fa46   cd 7b fb              CALL    RAMWR
   fa49   21 00 08              LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
   fa4c   11 00 ec              LXI     D,BDOSL         ; source = BDOS image
   fa4f   01 00 0e              LXI     B,3584          ; 3584 bytes
   fa52   cd 7b fb              CALL    RAMWR
                        ;
                        ; ---- the user DATA area is NOT formatted here --------------------------------
                        ; The diskutil formats the disk explicitly. The cold boot leaves the directory
                        ; untouched so files written to the RAM disk PERSIST across CP/M cold boots
                        ; (until power-off clears the volatile SRAM). Confirmed the directory lives at
                        ; 0x2000: a boot-format'd disk yields a clean NO FILE from DIR.
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   fa55   21 a9 fb              LXI     H,BANNER
   fa58   cd d7 fa              CALL    PRTSTR
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   fa5b   21 80 00              LXI     H,DMA0
   fa5e   22 c2 fb              SHLD    DMA
   fa61   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   fa64   c3 00 e4              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   fa67                 WBOOT:
   fa67   31 00 dc              LXI     SP,0DC00H
                        ;
                        ; ---- reload CCP and BDOS from the RAM disk SYSTEM tracks --------------------
   fa6a   21 00 00              LXI     H,SYSCPP
   fa6d   11 00 e4              LXI     D,CCP
   fa70   01 00 08              LXI     B,2048
   fa73   cd 89 fb              CALL    RAMRD
   fa76   21 00 08              LXI     H,SYSBDS
   fa79   11 00 ec              LXI     D,BDOSL
   fa7c   01 00 0e              LXI     B,3584
   fa7f   cd 89 fb              CALL    RAMRD
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   fa82   cd 8b fa              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   fa85   01 00 00              LXI     B,0000H
   fa88   c3 00 e4              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xFA03), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xEC06)
                        ; ============================================================================
   fa8b                 SETVEC:
   fa8b   21 00 00              LXI     H,0000H
   fa8e   36 c3                 MVI     M,0C3H          ; JP
   fa90   23                    INX     H
   fa91   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xFA03 (the WBOOT table entry)
   fa93   23                    INX     H
   fa94   36 fa                 MVI     M,HIGH(BIOS)
   fa96   21 03 00              LXI     H,0003H
   fa99   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   fa9b   23                    INX     H
   fa9c   36 00                 MVI     M,00H
   fa9e   21 05 00              LXI     H,0005H
   faa1   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   faa3   23                    INX     H
   faa4   36 06                 MVI     M,LOW(BDOSENT)
   faa6   23                    INX     H
   faa7   36 ec                 MVI     M,HIGH(BDOSENT)
   faa9   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   faaa                 CONST:
   faaa   db 80                 IN      80H
   faac   e6 02                 ANI     02H             ; rx_avail (bit1)
   faae   3e 00                 MVI     A,00H           ; default: no char
   fab0   ca b5 fa              JZ      CONST2
   fab3   3e ff                 MVI     A,0FFH          ; char ready
   fab5                 CONST2:
   fab5   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   fab6                 CONIN:
   fab6   db 80                 IN      80H
   fab8   e6 02                 ANI     02H             ; rx_avail (bit1)
   faba   ca b6 fa              JZ      CONIN           ; wait for a character
   fabd   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   fabf   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   fac0                 CONOUT:
   fac0   db 80                 IN      80H
   fac2   e6 01                 ANI     01H             ; tx_busy (bit0)
   fac4   c2 c0 fa              JNZ     CONOUT          ; wait until transmitter is idle
   fac7   79                    MOV     A,C
   fac8   d3 81                 OUT     81H
   faca   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   facb                 PUTC:
   facb   f5                    PUSH    PSW
   facc                 PUTC1:
   facc   db 80                 IN      80H
   face   e6 01                 ANI     01H
   fad0   c2 cc fa              JNZ     PUTC1
   fad3   f1                    POP     PSW
   fad4   d3 81                 OUT     81H
   fad6   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   fad7                 PRTSTR:
   fad7   7e                    MOV     A,M
   fad8   b7                    ORA     A
   fad9   ca e3 fa              JZ      PRTEND
   fadc   cd cb fa              CALL    PUTC
   fadf   23                    INX     H
   fae0   c3 d7 fa              JMP     PRTSTR
   fae3                 PRTEND:
   fae3   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   fae4                 LIST:
   fae4   c3 c0 fa              JMP     CONOUT          ; char in C
   fae7                 PUNCH:
   fae7   c3 c0 fa              JMP     CONOUT          ; char in C
   faea                 READER:
   faea   c3 b6 fa              JMP     CONIN           ; returns char in A
   faed                 LISTST:
   faed   3e ff                 MVI     A,0FFH          ; list device always "ready"
   faef   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ; Only drive A (C=0) exists (the RAM disk); all other drives return an error.
   faf0                 SELDSK:
   faf0   79                    MOV     A,C
   faf1   32 bf fb              STA     SELBL           ; remember the selected drive number
   faf4   b7                    ORA     A
   faf5   c2 fc fa              JNZ     SELERR          ; C != 0 -> not present
   faf8   21 c9 fb              LXI     H,DPH           ; drive A disk parameter header
   fafb   c9                    RET
   fafc                 SELERR:
   fafc   21 00 00              LXI     H,0000H         ; error return: HL=0
   faff   3e ff                 MVI     A,0FFH
   fb01   c9                    RET
                        
                        ; HOME: move to track 0, sector 0.
   fb02                 HOME:
   fb02   3e 00                 MVI     A,00H
   fb04   32 c0 fb              STA     TRK
   fb07   32 c1 fb              STA     SECN
   fb0a   c9                    RET
                        
                        ; SETTRK: set the current track (register C).
   fb0b                 SETTRK:
   fb0b   79                    MOV     A,C
   fb0c   32 c0 fb              STA     TRK
   fb0f   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   fb10                 SETSEC:
   fb10   79                    MOV     A,C
   fb11   32 c1 fb              STA     SECN
   fb14   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   fb15                 SETDMA:
   fb15   79                    MOV     A,C
   fb16   32 c2 fb              STA     DMA
   fb19   78                    MOV     A,B
   fb1a   32 c3 fb              STA     DMA+1
   fb1d   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   fb1e                 SECTRAN:
   fb1e   69                    MOV     L,C
   fb1f   60                    MOV     H,B
   fb20   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   fb21                 CALC:
   fb21   3a c0 fb              LDA     TRK
   fb24   6f                    MOV     L,A
   fb25   26 00                 MVI     H,00H           ; HL = TRK
   fb27   29                    DAD     H               ; *2
   fb28   29                    DAD     H               ; *4
   fb29   29                    DAD     H               ; *8
   fb2a   29                    DAD     H               ; *16
   fb2b   29                    DAD     H               ; *32
   fb2c   29                    DAD     H               ; *64
   fb2d   29                    DAD     H               ; *128
   fb2e   29                    DAD     H               ; *256
   fb2f   29                    DAD     H               ; *512
   fb30   29                    DAD     H               ; *1024
   fb31   29                    DAD     H               ; *2048
   fb32   29                    DAD     H               ; *4096  -> HL = TRK*4096
   fb33   44                    MOV     B,H
   fb34   4d                    MOV     C,L             ; BC = TRK*4096
   fb35   3a c1 fb              LDA     SECN
   fb38   6f                    MOV     L,A
   fb39   26 00                 MVI     H,00H           ; HL = SECN
   fb3b   29                    DAD     H               ; *2
   fb3c   29                    DAD     H               ; *4
   fb3d   29                    DAD     H               ; *8
   fb3e   29                    DAD     H               ; *16
   fb3f   29                    DAD     H               ; *32
   fb40   29                    DAD     H               ; *64
   fb41   29                    DAD     H               ; *128  -> HL = SECN*128
   fb42   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   fb43   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   fb44                 RAMPTR:
   fb44   7d                    MOV     A,L
   fb45   d3 21                 OUT     21H             ; address low byte
   fb47   7c                    MOV     A,H
   fb48   d3 22                 OUT     22H             ; address high byte
   fb4a   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   fb4b                 READ:
   fb4b   cd 21 fb              CALL    CALC            ; HL = RAM-disk byte address
   fb4e   cd 44 fb              CALL    RAMPTR          ; set the disk data-pointer
   fb51   2a c2 fb              LHLD    DMA
   fb54   54                    MOV     D,H
   fb55   5d                    MOV     E,L             ; DE = DMA destination
   fb56   06 80                 MVI     B,128
   fb58                 READ1:
   fb58   db 20                 IN      20H             ; read a byte (data port auto-increments)
   fb5a   12                    STAX    D
   fb5b   13                    INX     D
   fb5c   05                    DCR     B
   fb5d   c2 58 fb              JNZ     READ1
   fb60   3e 00                 MVI     A,00H           ; success
   fb62   c9                    RET
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   fb63                 WRITE:
   fb63   cd 21 fb              CALL    CALC            ; HL = RAM-disk byte address
   fb66   cd 44 fb              CALL    RAMPTR
   fb69   2a c2 fb              LHLD    DMA
   fb6c   54                    MOV     D,H
   fb6d   5d                    MOV     E,L             ; DE = DMA source
   fb6e   06 80                 MVI     B,128
   fb70                 WRITE1:
   fb70   1a                    LDAX    D
   fb71   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   fb73   13                    INX     D
   fb74   05                    DCR     B
   fb75   c2 70 fb              JNZ     WRITE1
   fb78   3e 00                 MVI     A,00H           ; success
   fb7a   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   fb7b                 RAMWR:
   fb7b   cd 44 fb              CALL    RAMPTR
   fb7e                 RAMWR1:
   fb7e   1a                    LDAX    D
   fb7f   d3 20                 OUT     20H
   fb81   13                    INX     D
   fb82   0b                    DCX     B
   fb83   78                    MOV     A,B
   fb84   b1                    ORA     C
   fb85   c2 7e fb              JNZ     RAMWR1
   fb88   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   fb89                 RAMRD:
   fb89   cd 44 fb              CALL    RAMPTR
   fb8c                 RAMRD1:
   fb8c   db 20                 IN      20H
   fb8e   12                    STAX    D
   fb8f   13                    INX     D
   fb90   0b                    DCX     B
   fb91   78                    MOV     A,B
   fb92   b1                    ORA     C
   fb93   c2 8c fb              JNZ     RAMRD1
   fb96   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   fb97                 RAMFILL:
   fb97   32 c4 fb              STA     FILLV
   fb9a   cd 44 fb              CALL    RAMPTR
   fb9d                 RAMFILL1:
   fb9d   3a c4 fb              LDA     FILLV
   fba0   d3 20                 OUT     20H
   fba2   0b                    DCX     B
   fba3   78                    MOV     A,B
   fba4   b1                    ORA     C
   fba5   c2 9d fb              JNZ     RAMFILL1
   fba8   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   fba9                 BANNER:
   fba9   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH,0
   fbad   20 32 2e 32   
   fbb1   20 6f 6e 20   
   fbb5   42 72 65 76   
   fbb9   69 61 32 0d   
   fbbd   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   fbbf                 SELBL:  DS      1               ; last selected drive
   fbc0                 TRK:    DS      1               ; current (absolute) track
   fbc1                 SECN:   DS      1               ; current sector
   fbc2                 DMA:    DS      2               ; current DMA address
   fbc4                 FILLV:  DS      1               ; scratch for RAMFILL
   fbc5                         DS      4               ; (padding/alignment reserved)
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADER (DPH) for drive A
                        ;   Byte layout consumed by the BDOS:
                        ;     +0  XLT  (sector-translate vector address; 0 = none)
                        ;     +2  scratch, +4 scratch, +6 scratch
                        ;     +8  DIRBUF, +10 DPB, +12 CSV, +14 ALV
                        ; ============================================================================
   fbc9                 DPH:
   fbc9   00 00                 DW      0000H           ; XLT: no sector translation
   fbcb   00 00                 DW      0000H           ; scratch (cdrmax)
   fbcd   00 00                 DW      0000H           ; scratch (curtrk)
   fbcf   00 00                 DW      0000H           ; scratch (currec)
   fbd1   f1 fb                 DW      DIRBUF          ; directory buffer (128 bytes)
   fbd3   d9 fb                 DW      DPB             ; disk parameter block
   fbd5   e8 fb                 DW      CSV             ; checksum vector
   fbd7   e9 fb                 DW      ALV             ; allocation vector
                        
                        ; ============================================================================
                        ;   DISK PARAMETER BLOCK (DPB)
                        ;   CP/M 2.2 geometry for the 64K RAM disk (drive A:):
                        ;     128-byte sectors, SPT=32, 14 user tracks + 2 system tracks = 16 tracks,
                        ;     1K allocation blocks (BSH=3/BLM=7), DSM=55 (56 blocks = 56K user data),
                        ;     DRM=63 (64 directory entries = 2 directory blocks), CKS=0 (fixed media),
                        ;     OFF=2 (reserve tracks 0-1 for the system).
                        ;   IMPORTANT: DSM is stored as a WORD (not a byte).  The BDOS copies this
                        ;   table byte-for-byte into its internal aligned structure, so DSM must be a
                        ;   word for the SECTPT/MAXALL/... fields to line up correctly.
                        ;   AL0/AL1 reserve the directory blocks.  With the MSB-first allocation-map
                        ;   convention the 2 directory blocks at the start of the data area are blocks
                        ;   0 and 1, so AL0=0xC0 / AL1=0x00.  (AL0=0x00/AL1=0xC0 would reserve blocks
                        ;   8-9 and leave the real directory at block 0 unprotected, breaking SAVE.)
                        ; ============================================================================
   fbd9                 DPB:
   fbd9   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   fbdb   03                    DB      03H             ; BSH  = 3    (block shift  -> 1K blocks)
   fbdc   07                    DB      07H             ; BLM  = 7    (block mask)
   fbdd   00                    DB      00H             ; EXM  = 0
   fbde   37 00                 DW      55              ; DSM  = 55   (max block number = 56 blocks)
   fbe0   3f 00                 DW      63              ; DRM  = 63   (max directory entry = 64 entries)
   fbe2   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   fbe3   00                    DB      00H             ; AL1  = 0x00
   fbe4   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   fbe6   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
                        
                        ; ============================================================================
                        ;   CBIOS BUFFERS / VECTORS
                        ; ============================================================================
   fbe8                 CSV:    DS      1               ; checksum vector (0 bytes needed since CKS=0)
   fbe9                 ALV:    DS      8               ; allocation vector (56 blocks / 8 = 7 -> pad 8)
   fbf1                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
   fc71                         END
fbe9  ALV           fba9  BANNER        ec06  BDOSENT       ec00  BDOSL     
fa00  BIOS          fa33  BOOT          fb21  CALC          e400  CCP       
fab6  CONIN         fac0  CONOUT        faaa  CONST         fab5  CONST2    
fbe8  CSV           fbf1  DIRBUF        fbc2  DMA           0080  DMA0      
fbd9  DPB           fbc9  DPH           fbc4  FILLV         fb02  HOME      
fae4  LIST          faed  LISTST        fae3  PRTEND        fad7  PRTSTR    
fae7  PUNCH         facb  PUTC          facc  PUTC1         fb97  RAMFILL   
fb9d  RAMFILL1      fb44  RAMPTR        fb89  RAMRD         fb8c  RAMRD1    
fb7b  RAMWR         fb7e  RAMWR1        fb4b  READ          fb58  READ1     
