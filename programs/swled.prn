                        ; SWLED.COM -- Brevia2 switches / LEDs / fabric clock demo for CP/M 2.2
                        ; 8080 assembly, Glitch Works a85. Loads at 0x0100 (CP/M transient).
                        ; Talks to the SoC hardware directly:
                        ;   IN  0x40 -> 8-position DIP switches
                        ;   OUT 0x40 -> 8 LEDs (active-low on the board)
                        ;   OUT 0x41 -> latch the 32-bit uptime clock; IN 0x42..0x45 -> clock bytes
                        ;               (0x42=ms[7:0] .. 0x45=ms[31:24], LSB first)
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
                        ;
                        ; Commands:  S = show switches (and mirror them to the LEDs)
                        ;            L = LED walking pattern (any key to stop)
                        ;            T = show fabric uptime clock (HH style "secs.mmm s")
                        ;            ? = help ; Q = quit
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 20 03              LXI     H,BANNER
   0103   cd 04 02              CALL    PSTR
                        
   0106                 MAINLOOP:
   0106   1e 3e                 MVI     E,'>'
   0108   cd 0c 02              CALL    CPUTC
   010b   cd 12 02              CALL    CIN
                                ; A = command char (echoed by func 1)
                                ; fold lower-case a-z to upper so input is case-insensitive
   010e   fe 61                 CPI     'a'
   0110   da 1a 01              JC      MAIN3
   0113   fe 7b                 CPI     7BH             ; 'z'+1
   0115   d2 1a 01              JNC     MAIN3
   0118   d6 20                 SUI     20H             ; 'a'-'A' -> uppercase
   011a                 MAIN3:
   011a   fe 53                 CPI     'S'
   011c   ca 49 01              JZ      CMD_S
   011f   fe 4c                 CPI     'L'
   0121   ca 78 01              JZ      CMD_L
   0124   fe 54                 CPI     'T'
   0126   ca 9f 01              JZ      CMD_T
   0129   fe 3f                 CPI     '?'
   012b   ca 3d 01              JZ      CMD_HELP
   012e   fe 51                 CPI     'Q'
   0130   ca 3c 01              JZ      CMD_QUIT
                                ; unknown
   0133   21 a7 03              LXI     H,MSG_UNK
   0136   cd 04 02              CALL    PSTR
   0139   c3 06 01              JMP     MAINLOOP
                        
   013c                 CMD_QUIT:
   013c   c9                    RET
                        
   013d                 CMD_HELP:
   013d   21 20 03              LXI     H,BANNER
   0140   cd 04 02              CALL    PSTR
   0143   cd 18 02              CALL    CRLF
   0146   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- S: show switches + mirror to LEDs ----------------
   0149                 CMD_S:
   0149   db 40                 IN      LEDSW           ; read switches (active-low: 1=open, 0=pressed)
   014b   32 b0 03              STA     SWVAL           ; stash in memory -- BDOS func9 clobbers B, keep it out of a reg
   014e   d3 40                 OUT     LEDSW           ; mirror switch bank to the LED bank
   0150   21 73 03              LXI     H,MSG_SW
   0153   cd 04 02              CALL    PSTR
   0156   3a b0 03              LDA     SWVAL           ; reload the TRUE switch value
   0159   47                    MOV     B,A
   015a   16 08                 MVI     D,8             ; print 8 bits, MSB first
   015c                 SBL:
   015c   17                    RAL
   015d   da 65 01              JC      SB1
   0160   1e 30                 MVI     E,'0'
   0162   c3 67 01              JMP     SB2
   0165                 SB1:
   0165   1e 31                 MVI     E,'1'
   0167                 SB2:
   0167   d5                    PUSH    D
   0168   f5                    PUSH    PSW             ; preserve A (rotating bit pattern) across the BDOS call
   0169   cd 0c 02              CALL    CPUTC           ; CPUTC clobbers A (func 2 returns 0)
   016c   f1                    POP     PSW
   016d   d1                    POP     D
   016e   15                    DCR     D
   016f   c2 5c 01              JNZ     SBL
   0172   cd 18 02              CALL    CRLF
   0175   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- L: LED walking pattern ----------------
   0178                 CMD_L:
   0178   21 7d 03              LXI     H,MSG_LED
   017b   cd 04 02              CALL    PSTR
   017e   06 01                 MVI     B,01H           ; start pattern
   0180                 LPL:
   0180   78                    MOV     A,B
   0181   d3 40                 OUT     LEDSW           ; drive LEDs
   0183   cd 23 02              CALL    DELAY           ; ~200ms, polling for a key
   0186   b7                    ORA     A
   0187   c2 95 01              JNZ     LPQUIT          ; key pressed -> stop
   018a   78                    MOV     A,B
   018b   87                    ADD     A
   018c   47                    MOV     B,A
   018d   c2 80 01              JNZ     LPL
   0190   06 01                 MVI     B,01H           ; wrapped past 0x80 -> restart
   0192   c3 80 01              JMP     LPL
   0195                 LPQUIT:
   0195   3e 00                 MVI     A,00H
   0197   d3 40                 OUT     LEDSW           ; LEDs are active-HIGH to the Z80: 00H = all off (0FFH would light them all)
   0199   cd 18 02              CALL    CRLF
   019c   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- T: fabric uptime clock ----------------
   019f                 CMD_T:
   019f   d3 41                 OUT     CLKL            ; latch the counter
   01a1   db 42                 IN      CLK0
   01a3   6f                    MOV     L,A
   01a4   db 43                 IN      CLK1
   01a6   67                    MOV     H,A
   01a7   db 44                 IN      CLK2
   01a9   5f                    MOV     E,A
   01aa   db 45                 IN      CLK3
   01ac   57                    MOV     D,A             ; DE:HL = ms (32-bit)
   01ad   01 e8 03              LXI     B,1000
   01b0   cd 3a 02              CALL    DIV32           ; DE:HL = secs, RMDR = msec remainder
                                ; save msec remainder
   01b3   3a ab 03              LDA     RMDR
   01b6   32 b1 03              STA     MSW
   01b9   3a ac 03              LDA     RMDR+1
   01bc   32 b2 03              STA     MSW+1
                                ; save secs (DE:HL) into SECW (32-bit)
   01bf   7d                    MOV     A,L
   01c0   32 b3 03              STA     SECW
   01c3   7c                    MOV     A,H
   01c4   32 b4 03              STA     SECW+1
   01c7   7b                    MOV     A,E
   01c8   32 b5 03              STA     SECW+2
   01cb   7a                    MOV     A,D
   01cc   32 b6 03              STA     SECW+3
   01cf   21 9a 03              LXI     H,MSG_UPT
   01d2   cd 04 02              CALL    PSTR
                                ; reload secs into DE:HL and print as decimal
   01d5   3a b3 03              LDA     SECW
   01d8   6f                    MOV     L,A
   01d9   3a b4 03              LDA     SECW+1
   01dc   67                    MOV     H,A
   01dd   3a b5 03              LDA     SECW+2
   01e0   5f                    MOV     E,A
   01e1   3a b6 03              LDA     SECW+3
   01e4   57                    MOV     D,A
   01e5   cd a6 02              CALL    PRDEC32
   01e8   1e 2e                 MVI     E,'.'
   01ea   cd 0c 02              CALL    CPUTC
                                ; print msec remainder, 3 zero-padded digits
   01ed   3a b1 03              LDA     MSW
   01f0   6f                    MOV     L,A
   01f1   3a b2 03              LDA     MSW+1
   01f4   67                    MOV     H,A
   01f5   cd ec 02              CALL    PR3
   01f8   21 a4 03              LXI     H,MSG_S
   01fb   cd 04 02              CALL    PSTR
   01fe   cd 18 02              CALL    CRLF
   0201   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- low-level routines ----------------
   0204                 PSTR:
   0204   54                    MOV     D,H
   0205   5d                    MOV     E,L
   0206   0e 09                 MVI     C,9
   0208   cd 05 00              CALL    5
   020b   c9                    RET
                        
   020c                 CPUTC:
   020c   0e 02                 MVI     C,2
   020e   cd 05 00              CALL    5
   0211   c9                    RET
                        
   0212                 CIN:
   0212   0e 01                 MVI     C,1
   0214   cd 05 00              CALL    5
   0217   c9                    RET
                        
   0218                 CRLF:
   0218   1e 0d                 MVI     E,13
   021a   cd 0c 02              CALL    CPUTC
   021d   1e 0a                 MVI     E,10
   021f   cd 0c 02              CALL    CPUTC
   0222   c9                    RET
                        
                        ; DELAY -- burn ~200ms while polling the console for a key.
                        ;  Returns A=0 if no key (timeout), A=key if one arrived.
   0223                 DELAY:
   0223   21 b8 0b              LXI     H,3000          ; outer loop count
   0226                 DL1:
   0226   0e 06                 MVI     C,6
   0228   1e ff                 MVI     E,0FFH          ; func6 input mode (E=0FFh = dirinp). E=0FEh is STATUS and
                                                        ; always returns 0 on this BDOS build, so the poll would hang.
   022a   cd 05 00              CALL    5               ; returns the char in A, or 0 if none ready (non-blocking)
   022d   b7                    ORA     A
   022e   c2 39 02              JNZ     DLYKEY
   0231   2b                    DCX     H
   0232   7c                    MOV     A,H
   0233   b5                    ORA     L
   0234   c2 26 02              JNZ     DL1
   0237   3e 00                 MVI     A,0
   0239                 DLYKEY:
   0239   c9                    RET
                        
                        ; DIV32 -- unsigned 32/16 restore division.
                        ;   in : DE:HL = 32-bit dividend ; BC = 16-bit divisor
                        ;   out: DE:HL = 32-bit quotient ; RMDR = 16-bit remainder
                        ;   Uses memory RMDR/MSBF/CNT.
   023a                 DIV32:
   023a   af                    XRA     A
   023b   32 ab 03              STA     RMDR
   023e   32 ac 03              STA     RMDR+1
   0241   32 ad 03              STA     MSBF
   0244   3e 20                 MVI     A,32
   0246   32 ae 03              STA     CNT
   0249                 D32L:
                                ; shift DE:HL left 1; MSB -> CY
   0249   7d                    MOV     A,L
   024a   87                    ADD     A
   024b   6f                    MOV     L,A
   024c   7c                    MOV     A,H
   024d   17                    RAL
   024e   67                    MOV     H,A
   024f   7b                    MOV     A,E
   0250   17                    RAL
   0251   5f                    MOV     E,A
   0252   7a                    MOV     A,D
   0253   17                    RAL
   0254   57                    MOV     D,A
   0255   3e 00                 MVI     A,0
   0257   17                    RAL                     ; A = captured MSB (0 or 1)
   0258   32 ad 03              STA     MSBF
                                ; RMDR = (RMDR << 1) | MSBF
   025b   3a ab 03              LDA     RMDR
   025e   87                    ADD     A
   025f   32 ab 03              STA     RMDR
   0262   3a ac 03              LDA     RMDR+1
   0265   17                    RAL
   0266   32 ac 03              STA     RMDR+1
   0269   3a ad 03              LDA     MSBF
   026c   b7                    ORA     A
   026d   ca 78 02              JZ      D32NOMS
   0270   3a ab 03              LDA     RMDR
   0273   f6 01                 ORI     1
   0275   32 ab 03              STA     RMDR
   0278                 D32NOMS:
                                ; if RMDR >= (BC) then RMDR -= BC, set quotient bit0
   0278   3a ac 03              LDA     RMDR+1
   027b   b8                    CMP     B
   027c   da 9b 02              JC      D32SKIP
   027f   c2 89 02              JNZ     D32SUB
   0282   3a ab 03              LDA     RMDR
   0285   b9                    CMP     C
   0286   da 9b 02              JC      D32SKIP
   0289                 D32SUB:
   0289   3a ab 03              LDA     RMDR
   028c   91                    SUB     C
   028d   32 ab 03              STA     RMDR
   0290   3a ac 03              LDA     RMDR+1
   0293   98                    SBB     B
   0294   32 ac 03              STA     RMDR+1
   0297   7d                    MOV     A,L
   0298   f6 01                 ORI     1
   029a   6f                    MOV     L,A
   029b                 D32SKIP:
   029b   3a ae 03              LDA     CNT
   029e   3d                    DCR     A
   029f   32 ae 03              STA     CNT
   02a2   c2 49 02              JNZ     D32L
   02a5   c9                    RET
                        
                        ; PRDEC32 -- print the 32-bit value in DE:HL as unsigned decimal (no padding).
   02a6                 PRDEC32:
   02a6   7a                    MOV     A,D
   02a7   b3                    ORA     E
   02a8   b4                    ORA     H
   02a9   b5                    ORA     L
   02aa   c2 b3 02              JNZ     PRDECL
   02ad   1e 30                 MVI     E,'0'
   02af   cd 0c 02              CALL    CPUTC
   02b2   c9                    RET
   02b3                 PRDECL:
   02b3   3e 00                 MVI     A,0
   02b5   32 af 03              STA     DIGCNT
   02b8                 PRDEC_GO:
   02b8   7a                    MOV     A,D
   02b9   b3                    ORA     E
   02ba   b4                    ORA     H
   02bb   b5                    ORA     L
   02bc   ca d5 02              JZ      PRDEC_PRT
                                ; divide DE:HL by 10
   02bf   01 0a 00              LXI     B,10
   02c2   cd 3a 02              CALL    DIV32
   02c5   3a ab 03              LDA     RMDR
   02c8   c6 30                 ADI     '0'
   02ca   f5                    PUSH    PSW
   02cb   3a af 03              LDA     DIGCNT
   02ce   3c                    INR     A
   02cf   32 af 03              STA     DIGCNT
   02d2   c3 b8 02              JMP     PRDEC_GO
   02d5                 PRDEC_PRT:
   02d5   3a af 03              LDA     DIGCNT
   02d8   b7                    ORA     A
   02d9   ca eb 02              JZ      PRDEC_DONE
   02dc   f1                    POP     PSW
   02dd   5f                    MOV     E,A
   02de   cd 0c 02              CALL    CPUTC
   02e1   3a af 03              LDA     DIGCNT
   02e4   3d                    DCR     A
   02e5   32 af 03              STA     DIGCNT
   02e8   c3 d5 02              JMP     PRDEC_PRT
   02eb                 PRDEC_DONE:
   02eb   c9                    RET
                        
                        ; PR3 -- print the 16-bit value in HL (0..999) as exactly 3 zero-padded digits.
   02ec                 PR3:
   02ec   3e 03                 MVI     A,3
   02ee   32 af 03              STA     DIGCNT
   02f1                 PR3_DIV:
   02f1   16 00                 MVI     D,0
   02f3   1e 00                 MVI     E,0
   02f5   01 0a 00              LXI     B,10
   02f8   cd 3a 02              CALL    DIV32
   02fb   3a ab 03              LDA     RMDR
   02fe   c6 30                 ADI     '0'
   0300   f5                    PUSH    PSW
   0301   3a af 03              LDA     DIGCNT
   0304   3d                    DCR     A
   0305   32 af 03              STA     DIGCNT
   0308   c2 f1 02              JNZ     PR3_DIV
   030b   3e 03                 MVI     A,3
   030d   32 af 03              STA     DIGCNT
   0310                 PR3_PRT:
   0310   f1                    POP     PSW
   0311   5f                    MOV     E,A
   0312   cd 0c 02              CALL    CPUTC
   0315   3a af 03              LDA     DIGCNT
   0318   3d                    DCR     A
   0319   32 af 03              STA     DIGCNT
   031c   c2 10 03              JNZ     PR3_PRT
   031f   c9                    RET
                        
                        ; ---------------- data ----------------
   0040                 LEDSW   EQU     40H
   0041                 CLKL    EQU     41H
   0042                 CLK0    EQU     42H
   0043                 CLK1    EQU     43H
   0044                 CLK2    EQU     44H
   0045                 CLK3    EQU     45H
                        
   0320                 BANNER:
   0320   53 57 4c 45           DB      'SWLED v1.0 - Brevia2 switches/LEDs/clock',13,10,'S=switches L=led T=clock ?=help Q=quit',13,10,'$'
   0324   44 20 76 31   
   0328   2e 30 20 2d   
   032c   20 42 72 65   
   0330   76 69 61 32   
   0334   20 73 77 69   
   0338   74 63 68 65   
   033c   73 2f 4c 45   
   0340   44 73 2f 63   
   0344   6c 6f 63 6b   
   0348   0d 0a 53 3d   
   034c   73 77 69 74   
   0350   63 68 65 73   
   0354   20 4c 3d 6c   
   0358   65 64 20 54   
   035c   3d 63 6c 6f   
   0360   63 6b 20 3f   
   0364   3d 68 65 6c   
   0368   70 20 51 3d   
   036c   71 75 69 74   
   0370   0d 0a 24      
   0373   53 57 49 54   MSG_SW: DB      'SWITCHES=','$'
   0377   43 48 45 53   
   037b   3d 24         
   037d   4c 45 44 20   MSG_LED: DB     'LED test - any key to stop',13,10,'$'
   0381   74 65 73 74   
   0385   20 2d 20 61   
   0389   6e 79 20 6b   
   038d   65 79 20 74   
   0391   6f 20 73 74   
   0395   6f 70 0d 0a   
   0399   24            
   039a   0d 0a 55 50   MSG_UPT: DB     13,10,'UPTIME ','$'
   039e   54 49 4d 45   
   03a2   20 24         
   03a4   20 73 24      MSG_S:  DB      ' s','$'
   03a7   0d 0a 3f 24   MSG_UNK: DB     13,10,'?','$'
                        
   03ab                 RMDR:   DS      2
   03ad                 MSBF:   DS      1
   03ae                 CNT:    DS      1
   03af                 DIGCNT: DS      1
   03b0                 SWVAL:  DS      1
   03b1                 MSW:    DS      2
   03b3                 SECW:   DS      4
   03b7                         END
0320  BANNER        0212  CIN           0042  CLK0          0043  CLK1      
0044  CLK2          0045  CLK3          0041  CLKL          013d  CMD_HELP  
0178  CMD_L         013c  CMD_QUIT      0149  CMD_S         019f  CMD_T     
03ae  CNT           020c  CPUTC         0218  CRLF          0249  D32L      
0278  D32NOMS       029b  D32SKIP       0289  D32SUB        0223  DELAY     
03af  DIGCNT        023a  DIV32         0226  DL1           0239  DLYKEY    
0040  LEDSW         0180  LPL           0195  LPQUIT        011a  MAIN3     
0106  MAINLOOP      03ad  MSBF          037d  MSG_LED       03a4  MSG_S     
0373  MSG_SW        03a7  MSG_UNK       039a  MSG_UPT       03b1  MSW       
02ec  PR3           02f1  PR3_DIV       0310  PR3_PRT       02a6  PRDEC32   
02b3  PRDECL        02eb  PRDEC_DONE    02b8  PRDEC_GO      02d5  PRDEC_PRT 
0204  PSTR          03ab  RMDR          0165  SB1           0167  SB2       
015c  SBL           03b3  SECW          0100  START         03b0  SWVAL     
