                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xFA00 (BIOS base) so the image is loaded
                        ;   exactly at 0xFA00 by the GWMON-80 'L' command and entered with 'G FA00'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xE3FF  TPA
                        ;       0xE400-0xEBFF  CCP  (already loaded by the combined HEX)
                        ;       0xEC00-0xF9FF  BDOS (already loaded by the combined HEX)
                        ;       0xFA00-0xFFFF  THIS CBIOS
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 115200)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;       SPI flash (ISSI IS25LD040, 512 KB -> CP/M drive B:):
                        ;                             0x50 = DATA (read clocks a byte in / write clocks
                        ;                                     a byte out, MSB first)
                        ;                             0x51 = CTL (bit0 = CS#: 0=select low, 1=release)
                        ;                             0x52 = STATUS (bit0 = transfer busy; poll OPTIONAL
                        ;                                     because the RTL byte engine stretches the
                        ;                                     CPU wait on every 0x50 access)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive A:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   fa00                         ORG     0FA00H
                        
                        ; ---- constants ------------------------------------------------------------
   fa00                 BIOS    EQU     0FA00H          ; BIOS base (jump table origin)
   e400                 CCP     EQU     0E400H          ; CCP origin
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xFA03.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   ec00                 BDOSL   EQU     0EC00H          ; BDOS origin
   ec06                 BDOSENT EQU     0EC06H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
                        ;
                        ; ---- ISSI IS25LD040 SPI flash ports (drive B:) — same map as diskutil ---- 
   0050                 SPI_DATA EQU    50H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0051                 SPI_CTL  EQU    51H             ; write bit0 = CS# (0=select low, 1=release high)
   0052                 SPI_STAT EQU    52H             ; read bit0 = transfer busy (poll OPTIONAL)
                        ;
                        ; ---- drive B: flash geometry (must match the DPB AND diskutil's formatter) ----
   d000                 RMWBUF  EQU     0D000H          ; 4KB read-modify-write buffer in the TPA (drive B: write).
                                                        ;  Safe: touched only while a transient is suspended inside the
                                                        ;  BDOS, and the transient/BDOS stack is high (~0xEBxx in the CCP or
                                                        ;  at the TPA top), well above 0xDFFF.  A transient > ~50KB would
                                                        ;  load over it.
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xFA00
                        ; ============================================================================
   fa00   c3 33 fa              JMP     BOOT            ; 0  BIOS+0   cold start
   fa03   c3 67 fa              JMP     WBOOT           ; 1  BIOS+3   warm start
   fa06   c3 ae fa              JMP     CONST           ; 2  BIOS+6   console status
   fa09   c3 ba fa              JMP     CONIN           ; 3  BIOS+9   console input
   fa0c   c3 c4 fa              JMP     CONOUT          ; 4  BIOS+12  console output
   fa0f   c3 e8 fa              JMP     LIST            ; 5  BIOS+15  list device output
   fa12   c3 eb fa              JMP     PUNCH           ; 6  BIOS+18  punch device output
   fa15   c3 ee fa              JMP     READER          ; 7  BIOS+21  reader device input
   fa18   c3 0f fb              JMP     HOME            ; 8  BIOS+24  home the disk
   fa1b   c3 f4 fa              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   fa1e   c3 18 fb              JMP     SETTRK          ; 10 BIOS+30  set current track
   fa21   c3 1d fb              JMP     SETSEC          ; 11 BIOS+33  set current sector
   fa24   c3 22 fb              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   fa27   c3 58 fb              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   fa2a   c3 77 fb              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   fa2d   c3 f1 fa              JMP     LISTST          ; 15 BIOS+45  list device status
   fa30   c3 2b fb              JMP     SECTRAN         ; 16 BIOS+48  sector translate (identity)
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xFA00 via 'G FA00')
                        ; ============================================================================
   fa33                 BOOT:
   fa33   31 00 dc              LXI     SP,0DC00H       ; establish a stack in the TPA (below CCP@E400);
                                                        ; 0xF000 would sit INSIDE the BDOS (EC00-F9FF) and
                                                        ;  the boot's stack use would clobber the BDOS code.
   fa36   3e 01                 MVI     A,01H
   fa38   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   fa3a   cd 8f fa              CALL    SETVEC
                        ;
                        ; ---- write CCP and BDOS from machine RAM onto the RAM disk SYSTEM tracks ----
   fa3d   21 00 00              LXI     H,SYSCPP        ; disk byte 0 (system track 0)
   fa40   11 00 e4              LXI     D,CCP           ; source = CCP image
   fa43   01 00 08              LXI     B,2048          ; 2048 bytes
   fa46   cd 96 fb              CALL    RAMWR
   fa49   21 00 08              LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
   fa4c   11 00 ec              LXI     D,BDOSL         ; source = BDOS image
   fa4f   01 00 0e              LXI     B,3584          ; 3584 bytes
   fa52   cd 96 fb              CALL    RAMWR
                        ;
                        ; ---- the user DATA area is NOT formatted here --------------------------------
                        ; The diskutil formats the disk explicitly. The cold boot leaves the directory
                        ; untouched so files written to the RAM disk PERSIST across CP/M cold boots
                        ; (until power-off clears the volatile SRAM). Confirmed the directory lives at
                        ; 0x2000: a boot-format'd disk yields a clean NO FILE from DIR.
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   fa55   21 f7 fc              LXI     H,BANNER
   fa58   cd db fa              CALL    PRTSTR
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   fa5b   21 80 00              LXI     H,DMA0
   fa5e   22 2b fd              SHLD    DMA
   fa61   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   fa64   c3 00 e4              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   fa67                 WBOOT:
   fa67   31 00 dc              LXI     SP,0DC00H
   fa6a   3e 01                 MVI     A,01H
   fa6c   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM (same as cold boot:
                                                        ;  'G FA03' from the monitor after a reset must swap
                                                        ;  the ROM out too, else page-zero/CCP reads hit ROM)
                        ;
                        ; ---- reload CCP and BDOS from the RAM disk SYSTEM tracks --------------------
   fa6e   21 00 00              LXI     H,SYSCPP
   fa71   11 00 e4              LXI     D,CCP
   fa74   01 00 08              LXI     B,2048
   fa77   cd a4 fb              CALL    RAMRD
   fa7a   21 00 08              LXI     H,SYSBDS
   fa7d   11 00 ec              LXI     D,BDOSL
   fa80   01 00 0e              LXI     B,3584
   fa83   cd a4 fb              CALL    RAMRD
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   fa86   cd 8f fa              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   fa89   01 00 00              LXI     B,0000H
   fa8c   c3 00 e4              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xFA03), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xEC06)
                        ; ============================================================================
   fa8f                 SETVEC:
   fa8f   21 00 00              LXI     H,0000H
   fa92   36 c3                 MVI     M,0C3H          ; JP
   fa94   23                    INX     H
   fa95   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xFA03 (the WBOOT table entry)
   fa97   23                    INX     H
   fa98   36 fa                 MVI     M,HIGH(BIOS)
   fa9a   21 03 00              LXI     H,0003H
   fa9d   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   fa9f   23                    INX     H
   faa0   36 00                 MVI     M,00H
   faa2   21 05 00              LXI     H,0005H
   faa5   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   faa7   23                    INX     H
   faa8   36 06                 MVI     M,LOW(BDOSENT)
   faaa   23                    INX     H
   faab   36 ec                 MVI     M,HIGH(BDOSENT)
   faad   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   faae                 CONST:
   faae   db 80                 IN      80H
   fab0   e6 02                 ANI     02H             ; rx_avail (bit1)
   fab2   3e 00                 MVI     A,00H           ; default: no char
   fab4   ca b9 fa              JZ      CONST2
   fab7   3e ff                 MVI     A,0FFH          ; char ready
   fab9                 CONST2:
   fab9   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   faba                 CONIN:
   faba   db 80                 IN      80H
   fabc   e6 02                 ANI     02H             ; rx_avail (bit1)
   fabe   ca ba fa              JZ      CONIN           ; wait for a character
   fac1   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   fac3   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   fac4                 CONOUT:
   fac4   db 80                 IN      80H
   fac6   e6 01                 ANI     01H             ; tx_busy (bit0)
   fac8   c2 c4 fa              JNZ     CONOUT          ; wait until transmitter is idle
   facb   79                    MOV     A,C
   facc   d3 81                 OUT     81H
   face   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   facf                 PUTC:
   facf   f5                    PUSH    PSW
   fad0                 PUTC1:
   fad0   db 80                 IN      80H
   fad2   e6 01                 ANI     01H
   fad4   c2 d0 fa              JNZ     PUTC1
   fad7   f1                    POP     PSW
   fad8   d3 81                 OUT     81H
   fada   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   fadb                 PRTSTR:
   fadb   7e                    MOV     A,M
   fadc   b7                    ORA     A
   fadd   ca e7 fa              JZ      PRTEND
   fae0   cd cf fa              CALL    PUTC
   fae3   23                    INX     H
   fae4   c3 db fa              JMP     PRTSTR
   fae7                 PRTEND:
   fae7   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   fae8                 LIST:
   fae8   c3 c4 fa              JMP     CONOUT          ; char in C
   faeb                 PUNCH:
   faeb   c3 c4 fa              JMP     CONOUT          ; char in C
   faee                 READER:
   faee   c3 ba fa              JMP     CONIN           ; returns char in A
   faf1                 LISTST:
   faf1   3e ff                 MVI     A,0FFH          ; list device always "ready"
   faf3   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ;   C=0 -> drive A (the RAM disk), C=1 -> drive B (the SPI flash).  C>1 -> error.
   faf4                 SELDSK:
   faf4   79                    MOV     A,C
   faf5   32 28 fd              STA     SELBL           ; remember the selected drive number
   faf8   b7                    ORA     A
   faf9   ca 07 fb              JZ      SELD0           ; C=0 -> drive A
   fafc   fe 01                 CPI     01H
   fafe   ca 0b fb              JZ      SELD1           ; C=1 -> drive B (SPI flash)
   fb01                 SELERR:
   fb01   21 00 00              LXI     H,0000H         ; error return: HL=0
   fb04   3e ff                 MVI     A,0FFH
   fb06   c9                    RET
   fb07                 SELD0:
   fb07   21 32 fd              LXI     H,DPH           ; drive A disk parameter header (RAM disk)
   fb0a   c9                    RET
   fb0b                 SELD1:
   fb0b   21 da fd              LXI     H,DPHB          ; drive B disk parameter header (SPI flash)
   fb0e   c9                    RET
                        
                        ; HOME: move to track 0, sector 0.
   fb0f                 HOME:
   fb0f   3e 00                 MVI     A,00H
   fb11   32 29 fd              STA     TRK
   fb14   32 2a fd              STA     SECN
   fb17   c9                    RET
                        
                        ; SETTRK: set the current track (register C).
   fb18                 SETTRK:
   fb18   79                    MOV     A,C
   fb19   32 29 fd              STA     TRK
   fb1c   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   fb1d                 SETSEC:
   fb1d   79                    MOV     A,C
   fb1e   32 2a fd              STA     SECN
   fb21   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   fb22                 SETDMA:
   fb22   79                    MOV     A,C
   fb23   32 2b fd              STA     DMA
   fb26   78                    MOV     A,B
   fb27   32 2c fd              STA     DMA+1
   fb2a   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   fb2b                 SECTRAN:
   fb2b   69                    MOV     L,C
   fb2c   60                    MOV     H,B
   fb2d   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   fb2e                 CALC:
   fb2e   3a 29 fd              LDA     TRK
   fb31   6f                    MOV     L,A
   fb32   26 00                 MVI     H,00H           ; HL = TRK
   fb34   29                    DAD     H               ; *2
   fb35   29                    DAD     H               ; *4
   fb36   29                    DAD     H               ; *8
   fb37   29                    DAD     H               ; *16
   fb38   29                    DAD     H               ; *32
   fb39   29                    DAD     H               ; *64
   fb3a   29                    DAD     H               ; *128
   fb3b   29                    DAD     H               ; *256
   fb3c   29                    DAD     H               ; *512
   fb3d   29                    DAD     H               ; *1024
   fb3e   29                    DAD     H               ; *2048
   fb3f   29                    DAD     H               ; *4096  -> HL = TRK*4096
   fb40   44                    MOV     B,H
   fb41   4d                    MOV     C,L             ; BC = TRK*4096
   fb42   3a 2a fd              LDA     SECN
   fb45   6f                    MOV     L,A
   fb46   26 00                 MVI     H,00H           ; HL = SECN
   fb48   29                    DAD     H               ; *2
   fb49   29                    DAD     H               ; *4
   fb4a   29                    DAD     H               ; *8
   fb4b   29                    DAD     H               ; *16
   fb4c   29                    DAD     H               ; *32
   fb4d   29                    DAD     H               ; *64
   fb4e   29                    DAD     H               ; *128  -> HL = SECN*128
   fb4f   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   fb50   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   fb51                 RAMPTR:
   fb51   7d                    MOV     A,L
   fb52   d3 21                 OUT     21H             ; address low byte
   fb54   7c                    MOV     A,H
   fb55   d3 22                 OUT     22H             ; address high byte
   fb57   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   fb58                 READ:
   fb58   3a 28 fd              LDA     SELBL
   fb5b   b7                    ORA     A
   fb5c   c2 8a fc              JNZ     READB           ; selected drive != 0 -> drive B (SPI flash)
                                ; ---- drive A: RAM disk path ----
   fb5f   cd 2e fb              CALL    CALC            ; HL = RAM-disk byte address
   fb62   cd 51 fb              CALL    RAMPTR          ; set the disk data-pointer
   fb65   2a 2b fd              LHLD    DMA
   fb68   54                    MOV     D,H
   fb69   5d                    MOV     E,L             ; DE = DMA destination
   fb6a   06 80                 MVI     B,128
   fb6c                 READ1:
   fb6c   db 20                 IN      20H             ; read a byte (data port auto-increments)
   fb6e   12                    STAX    D
   fb6f   13                    INX     D
   fb70   05                    DCR     B
   fb71   c2 6c fb              JNZ     READ1
   fb74   3e 00                 MVI     A,00H           ; success
   fb76   c9                    RET
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   fb77                 WRITE:
   fb77   3a 28 fd              LDA     SELBL
   fb7a   b7                    ORA     A
   fb7b   c2 9b fc              JNZ     WRITEB          ; selected drive != 0 -> drive B (SPI flash)
                                ; ---- drive A: RAM disk path ----
   fb7e   cd 2e fb              CALL    CALC            ; HL = RAM-disk byte address
   fb81   cd 51 fb              CALL    RAMPTR
   fb84   2a 2b fd              LHLD    DMA
   fb87   54                    MOV     D,H
   fb88   5d                    MOV     E,L             ; DE = DMA source
   fb89   06 80                 MVI     B,128
   fb8b                 WRITE1:
   fb8b   1a                    LDAX    D
   fb8c   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   fb8e   13                    INX     D
   fb8f   05                    DCR     B
   fb90   c2 8b fb              JNZ     WRITE1
   fb93   3e 00                 MVI     A,00H           ; success
   fb95   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   fb96                 RAMWR:
   fb96   cd 51 fb              CALL    RAMPTR
   fb99                 RAMWR1:
   fb99   1a                    LDAX    D
   fb9a   d3 20                 OUT     20H
   fb9c   13                    INX     D
   fb9d   0b                    DCX     B
   fb9e   78                    MOV     A,B
   fb9f   b1                    ORA     C
   fba0   c2 99 fb              JNZ     RAMWR1
   fba3   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   fba4                 RAMRD:
   fba4   cd 51 fb              CALL    RAMPTR
   fba7                 RAMRD1:
   fba7   db 20                 IN      20H
   fba9   12                    STAX    D
   fbaa   13                    INX     D
   fbab   0b                    DCX     B
   fbac   78                    MOV     A,B
   fbad   b1                    ORA     C
   fbae   c2 a7 fb              JNZ     RAMRD1
   fbb1   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   fbb2                 RAMFILL:
   fbb2   32 2d fd              STA     FILLV
   fbb5   cd 51 fb              CALL    RAMPTR
   fbb8                 RAMFILL1:
   fbb8   3a 2d fd              LDA     FILLV
   fbbb   d3 20                 OUT     20H
   fbbd   0b                    DCX     B
   fbbe   78                    MOV     A,B
   fbbf   b1                    ORA     C
   fbc0   c2 b8 fb              JNZ     RAMFILL1
   fbc3   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE B:  SPI FLASH  (ISSI IS25LD040 as CP/M drive B:)
                        ;
                        ;   Flash layout (MUST match diskutil's 'S' formatter and the drive B: DPB):
                        ;       0x00000-0x01FFF  (8KB, tracks 0-1)   reserved system (erased 0xFF)
                        ;       0x02000-0x7FFFF  (504KB, tracks 2-127) user data area = 126 blocks
                        ;           Block 0  (0x2000-0x2FFF) directory (reserved via AL0=0x80); the
                        ;                     first 2KB (0x2000-0x27FF) hold 64 x 32-byte entries
                        ;           Blocks 1..125 (0x3000-0x7FFFF) file data (125 blocks = 500KB)
                        ;
                        ;   Address formula (same as the drive A: CALC, but 24-bit -- the flash is
                        ;   512KB and exceeds 16 bits):  flash_addr = TRK*0x1000 + SECN*0x80
                        ;   (SPT=32, record=128).  The BDOS passes the absolute track (it already added
                        ;   the DPB offset), so OFF is NOT re-added here.
                        ;
                        ;   Erase-before-write is mandatory and the flash only erases at 4KB granularity
                        ;   (sector = 0x20 opcode), so one CP/M block maps to exactly one erase sector.
                        ;   A WRITE therefore does a 4KB read-modify-write: read the whole 4KB sector
                        ;   into RMWBUF, overlay the 128-byte record at its offset, erase the sector,
                        ;   then page-program it back (16 x 256B).  Correctness first; a dirty-sector
                        ;   cache is a later optimization.
                        ; ============================================================================
                        
                        ; ---- shared SPI driver (physical primitives + 24-bit ops) ----
                                INCL    "spi.inc"
                        ; ============================================================================
                        ; spi.inc -- shared 24-bit-capable SPI flash driver for the ISSI IS25LD040.
                        ; Included by BOTH diskutil (ORG 1000H) and cbios (ORG FA00H) so the physical
                        ; SPI protocol cannot drift between the two consumers.  Includes only
                        ; protocol-level primitives (selection, byte transfer, WIP wait, 24-bit
                        ; address send) and the bulk operations drive B: needs (page program, bulk
                        ; read, 4K sector erase).  Higher-level logic (CP/M read-modify-write, the
                        ; format routine) lives in each including program.
                        ;
                        ; Ports (must be defined by the including program BEFORE the INCL):
                        ;   SPI_DATA = 50H   read clocks 1 byte in / write clocks 1 byte out (MSB first)
                        ;   SPI_CTL  = 51H   write bit0 = CS# (0 = select low, 1 = release high)
                        ;   SPI_STAT = 52H   read bit0 = transfer busy (poll OPTIONAL -- the RTL byte
                        ;                               engine stretches the CPU wait on every 0x50
                        ;                               access, so back-to-back 0x50 completes in-cycle)
                        ;
                        ; Convention: the 24-bit flash address for an operation is held in the FBADDR
                        ; 3-byte block declared below.  Byte order is little-endian by FIELD:
                        ;   FBADDR+0 = A7-A0  (low byte)
                        ;   FBADDR+1 = A15-A8 (mid byte)
                        ;   FBADDR+2 = A23-A16(high byte)
                        ; SPI_ADDR transmits them MSB-first (A23-A16, A15-A8, A7-A0), which is the
                        ; order the IS25LD040 command set requires.
                        ;
                        ; Each routine documents which registers it clobbers.  A85 note: this file is
                        ; assembled inline at the INCL point, so FBADDR is allocated at that location
                        ; in each including program's address space (fine -- it is referenced purely
                        ; symbolically).  Do NOT add an ORG or END to this file; a85 splices it.
                        ; ============================================================================
                        
                        ; ---------------- CS# and byte transfer primitives ----------------
                        ; SPI_SEL: pull CS# low (select the flash).  Clobbers A.
   fbc4   3e 00         SPI_SEL: MVI     A,00H
   fbc6   d3 51                  OUT     SPI_CTL
   fbc8   c9                     RET
                        
                        ; SPI_REL: release CS# high (deselect the flash).  Clobbers A.
   fbc9   3e 01         SPI_REL: MVI     A,01H
   fbcb   d3 51                  OUT     SPI_CTL
   fbcd   c9                     RET
                        
                        ; SPI_XMIT: clock the byte in A out to the flash; the byte returned is
                        ; discarded.  A is unchanged (OUT does not modify A).  No other regs touched.
   fbce   d3 50         SPI_XMIT: OUT     SPI_DATA
   fbd0   c9                     RET
                        
                        ; SPI_WAIT: poll the RDSR (0x05) status until WIP (bit0) clears.  Re-selects
                        ; the flash and keeps CS# low across the status reads.  Clobbers A.
   fbd1   cd c4 fb      SPI_WAIT: CALL    SPI_SEL
   fbd4   3e 05                  MVI     A,05H
   fbd6   cd ce fb               CALL    SPI_XMIT                ; RDSR opcode
   fbd9   db 50         SPW:     IN      SPI_DATA                ; read status byte
   fbdb   e6 01                  ANI     01H                     ; WIP (bit0) still busy?
   fbdd   c2 d9 fb               JNZ     SPW                     ; loop until the flash is idle
   fbe0   cd c9 fb               CALL    SPI_REL
   fbe3   c9                     RET
                        
                        ; ---------------- 24-bit address send ----------------
                        ; SPI_ADDR: send the three FBADDR bytes as the command address (A23-A16,
                        ; A15-A8, A7-A0, MSB first).  Must be called with CS# already selected.
                        ; Clobbers A.
   fbe4   3a 57 fc      SPI_ADDR: LDA     FBADDR+2
   fbe7   cd ce fb               CALL    SPI_XMIT                ; A23-A16
   fbea   3a 56 fc               LDA     FBADDR+1
   fbed   cd ce fb               CALL    SPI_XMIT                ; A15-A8
   fbf0   3a 55 fc               LDA     FBADDR
   fbf3   cd ce fb               CALL    SPI_XMIT                ; A7-A0
   fbf6   c9                     RET
                        
                        ; ---------------- page program (0x02) ----------------
                        ; SPI_PAGE: program a full 256-byte page from (HL) at the page-aligned FBADDR.
                        ; FBADDR must be 256-byte aligned (the flash's page program wraps within a
                        ; page if it crosses the boundary).  Issues WREN (0x06, CS# toggled to latch it
                        ; -- REQUIRED before every program/erase on the IS25LD040), then the page-
                        ; program command and 256 data bytes in one CS#-low sequence.  Clobbers A, B,
                        ; HL (HL is advanced 256 bytes / left at HL+256).
   fbf7   cd c4 fb      SPI_PAGE: CALL    SPI_SEL
   fbfa   3e 06                  MVI     A,06H                   ; WREN (mandatory before every program)
   fbfc   cd ce fb               CALL    SPI_XMIT
   fbff   cd c9 fb               CALL    SPI_REL                 ; latch WREN (CS# must toggle)
   fc02   cd c4 fb               CALL    SPI_SEL
   fc05   3e 02                  MVI     A,02H                   ; Page Program opcode
   fc07   cd ce fb               CALL    SPI_XMIT
   fc0a   cd e4 fb               CALL    SPI_ADDR
   fc0d   06 00                  MVI     B,00H                   ; 256 bytes (0 wraps to 256 on DCR)
   fc0f   7e            SPG1:    MOV     A,M
   fc10   cd ce fb               CALL    SPI_XMIT
   fc13   23                     INX     H
   fc14   05                     DCR     B
   fc15   c2 0f fc               JNZ     SPG1
   fc18   cd c9 fb               CALL    SPI_REL
   fc1b   cd d1 fb               CALL    SPI_WAIT                ; wait for the program to settle
   fc1e   c9                     RET
                        
                        ; ---------------- bulk read (0x03) ----------------
                        ; SPI_READBUF: read BC bytes from FBADDR into (DE), keeping CS# low across the
                        ; whole burst (this is the same pattern the proven diskutil DO_READ uses for
                        ; 16 bytes, extended to an arbitrary count).  Clobbers A, B, C, D, E (BC runs
                        ; down to 0, DE advances past the last byte read).
   fc1f   cd c4 fb      SPI_READBUF: CALL    SPI_SEL
   fc22   3e 03                  MVI     A,03H                   ; Read opcode
   fc24   cd ce fb               CALL    SPI_XMIT
   fc27   cd e4 fb               CALL    SPI_ADDR
   fc2a   db 50         SRDB:    IN      SPI_DATA                ; next byte the flash clocks out
   fc2c   12                     STAX    D
   fc2d   13                     INX     D
   fc2e   0b                     DCX     B
   fc2f   78                     MOV     A,B
   fc30   b1                     ORA     C
   fc31   c2 2a fc               JNZ     SRDB
   fc34   cd c9 fb               CALL    SPI_REL
   fc37   c9                     RET
                        
                        ; ---------------- 4KB sector erase (0x20) ----------------
                        ; SPI_ERASE_SECT: erase the 4KB sector containing FBADDR.  FBADDR must be
                        ; pre-set to the sector base (the low 12 bits clear) so only that one sector
                        ; is erased.  Issues WREN, then the sector-erase command.  Clobbers A.
   fc38   cd c4 fb      SPI_ERASE_SECT: CALL    SPI_SEL
   fc3b   3e 06                  MVI     A,06H                   ; WREN (required before every program)
   fc3d   cd ce fb               CALL    SPI_XMIT
   fc40   cd c9 fb               CALL    SPI_REL                 ; latch WREN
   fc43   cd c4 fb               CALL    SPI_SEL
   fc46   3e 20                  MVI     A,20H                   ; Sector Erase (4KB) opcode
   fc48   cd ce fb               CALL    SPI_XMIT
   fc4b   cd e4 fb               CALL    SPI_ADDR
   fc4e   cd c9 fb               CALL    SPI_REL
   fc51   cd d1 fb               CALL    SPI_WAIT                ; wait for the erase to finish
   fc54   c9                     RET
                        
                        ; ---------------- FBADDR: the 24-bit address block ----------------
   fc55                 FBADDR:  DS      3                       ; A7-A0, A15-A8, A23-A16
                        
                        
                        ; FLADDR: compute FBADDR = TRK*0x1000 + SECN*0x80, the 24-bit flash byte address
                        ; of the selected record, split (validated against 0x7FF80 for TRK=127,SEC=31):
                        ;     byte2 (A23-A16) = TRK >> 4
                        ;     byte1 (A15-A8)  = ((TRK & 0x0F) << 4) | (SECN >> 1)
                        ;     byte0 (A7-A0)   = (SECN & 1) << 7
                        ; (SECN*0x80 < 0x1000 so it never carries into the TRK*0x1000 field.)  Clobbers
                        ; A, B, C, D.
   fc58                 FLADDR:
   fc58   3a 29 fd              LDA     TRK
   fc5b   47                    MOV     B,A             ; B = TRK
   fc5c   3a 2a fd              LDA     SECN
   fc5f   4f                    MOV     C,A             ; C = SECN
                                ; byte2 (A23-A16) = TRK >> 4
   fc60   78                    MOV     A,B
   fc61   e6 f0                 ANI     0F0H
   fc63   0f                    RRC
   fc64   0f                    RRC
   fc65   0f                    RRC
   fc66   0f                    RRC
   fc67   32 57 fc              STA     FBADDR+2
                                ; byte1 (A15-A8) = ((TRK & 0x0F) << 4) | (SECN >> 1)
   fc6a   78                    MOV     A,B
   fc6b   e6 0f                 ANI     0FH
   fc6d   07                    RLC
   fc6e   07                    RLC
   fc6f   07                    RLC
   fc70   07                    RLC
   fc71   57                    MOV     D,A
   fc72   79                    MOV     A,C
   fc73   0f                    RRC
   fc74   e6 7f                 ANI     7FH
   fc76   b2                    ORA     D
   fc77   32 56 fc              STA     FBADDR+1
                                ; byte0 (A7-A0) = (SECN & 1) << 7
   fc7a   79                    MOV     A,C
   fc7b   e6 01                 ANI     01H
   fc7d   ca 85 fc              JZ      FLAD0
   fc80   3e 80                 MVI     A,80H
   fc82   c3 86 fc              JMP     FLADR
   fc85   af            FLAD0:  XRA     A
   fc86   32 55 fc      FLADR:  STA     FBADDR
   fc89   c9                    RET
                        
                        ; READB: read one 128-byte sector from the SPI flash (drive B:) into the DMA
                        ; buffer.  Returns A=0.  (A flash read is error-free.)
   fc8a                 READB:
   fc8a   cd 58 fc              CALL    FLADDR          ; FBADDR = 24-bit record address
   fc8d   2a 2b fd              LHLD    DMA
   fc90   54                    MOV     D,H
   fc91   5d                    MOV     E,L             ; DE = DMA destination
   fc92   01 80 00              LXI     B,80H           ; 128 bytes
   fc95   cd 1f fc              CALL    SPI_READBUF
   fc98   3e 00                 MVI     A,00H           ; success
   fc9a   c9                    RET
                        
                        ; WRITEB: write one 128-byte sector to the SPI flash (drive B:) via a 4KB
                        ; read-modify-write.  Returns A=0.  Clobbers A,B,D,E,H,L.
   fc9b                 WRITEB:
   fc9b   cd 58 fc              CALL    FLADDR          ; FBADDR = 24-bit record address
                                ; ---- save the record's in-sector offset (FBADDR & 0xFFF) ----
   fc9e   3a 55 fc              LDA     FBADDR
   fca1   32 0a fe              STA     RECOFF          ; offset low byte
   fca4   3a 56 fc              LDA     FBADDR+1
   fca7   e6 0f                 ANI     0FH
   fca9   32 0b fe              STA     RECOFF+1        ; offset high nibble (0..0x0F)
                                ; ---- set FBADDR to the enclosing 4KB sector base (clear low 12 bits) ----
   fcac   3a 56 fc              LDA     FBADDR+1
   fcaf   e6 f0                 ANI     0F0H
   fcb1   32 56 fc              STA     FBADDR+1
   fcb4   af                    XRA     A
   fcb5   32 55 fc              STA     FBADDR          ; low byte of the sector base = 0
                                ; ---- read the whole 4KB sector into the RMW buffer ----
   fcb8   11 00 d0              LXI     D,RMWBUF
   fcbb   01 00 10              LXI     B,1000H         ; 4096 bytes
   fcbe   cd 1f fc              CALL    SPI_READBUF
                                ; ---- overlay the 128-byte DMA record at the in-sector offset ----
   fcc1   2a 2b fd              LHLD    DMA
   fcc4   11 00 d0              LXI     D,RMWBUF
   fcc7   3a 0a fe              LDA     RECOFF
   fcca   83                    ADD     E
   fccb   5f                    MOV     E,A
   fccc   3a 0b fe              LDA     RECOFF+1
   fccf   8a                    ADC     D
   fcd0   57                    MOV     D,A             ; DE = RMWBUF + offset
   fcd1   06 80                 MVI     B,128
   fcd3   7e            WRCPY:  MOV     A,M
   fcd4   12                    STAX    D
   fcd5   23                    INX     H
   fcd6   13                    INX     D
   fcd7   05                    DCR     B
   fcd8   c2 d3 fc              JNZ     WRCPY
                                ; ---- erase the 4KB sector (FBADDR = sector base) ----
   fcdb   cd 38 fc              CALL    SPI_ERASE_SECT
                                ; ---- program the whole 4KB sector back, 16 x 256B pages ----
   fcde   21 00 d0              LXI     H,RMWBUF
   fce1   06 10                 MVI     B,16            ; 16 pages
   fce3   c5            WRPG:   PUSH    B
   fce4   cd f7 fb              CALL    SPI_PAGE        ; programs 256 bytes from (HL), advances HL by 256
   fce7   3a 56 fc              LDA     FBADDR+1
   fcea   c6 01                 ADI     01H
   fcec   32 56 fc              STA     FBADDR+1        ; next page (low byte stays 00, high byte unchanged)
   fcef   c1                    POP     B
   fcf0   05                    DCR     B
   fcf1   c2 e3 fc              JNZ     WRPG
   fcf4   3e 00                 MVI     A,00H           ; success
   fcf6   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   fcf7                 BANNER:
   fcf7   0d 0a                 DB      0DH,0AH                          ; blank line before the banner
   fcf9   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH
   fcfd   20 32 2e 32   
   fd01   20 6f 6e 20   
   fd05   42 72 65 76   
   fd09   69 61 32 0d   
   fd0d   0a            
   fd0e   43 50 2f 4d           DB      'CP/M port by Whale-Chan',0DH,0AH,0
   fd12   20 70 6f 72   
   fd16   74 20 62 79   
   fd1a   20 57 68 61   
   fd1e   6c 65 2d 43   
   fd22   68 61 6e 0d   
   fd26   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   fd28                 SELBL:  DS      1               ; last selected drive
   fd29                 TRK:    DS      1               ; current (absolute) track
   fd2a                 SECN:   DS      1               ; current sector
   fd2b                 DMA:    DS      2               ; current DMA address
   fd2d                 FILLV:  DS      1               ; scratch for RAMFILL
   fd2e                         DS      4               ; (padding/alignment reserved)
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADER (DPH) for drive A
                        ;   Byte layout consumed by the BDOS:
                        ;     +0  XLT  (sector-translate vector address; 0 = none)
                        ;     +2  scratch, +4 scratch, +6 scratch
                        ;     +8  DIRBUF, +10 DPB, +12 CSV, +14 ALV
                        ; ============================================================================
   fd32                 DPH:
   fd32   00 00                 DW      0000H           ; XLT: no sector translation
   fd34   00 00                 DW      0000H           ; scratch (cdrmax)
   fd36   00 00                 DW      0000H           ; scratch (curtrk)
   fd38   00 00                 DW      0000H           ; scratch (currec)
   fd3a   5a fd                 DW      DIRBUF          ; directory buffer (128 bytes)
   fd3c   42 fd                 DW      DPB             ; disk parameter block
   fd3e   51 fd                 DW      CSV             ; checksum vector
   fd40   52 fd                 DW      ALV             ; allocation vector
                        
                        ; ============================================================================
                        ;   DISK PARAMETER BLOCK (DPB)
                        ;   CP/M 2.2 geometry for the 64K RAM disk (drive A:):
                        ;     128-byte sectors, SPT=32, 14 user tracks + 2 system tracks = 16 tracks,
                        ;     1K allocation blocks (BSH=3/BLM=7), DSM=55 (56 blocks = 56K user data),
                        ;     DRM=63 (64 directory entries = 2 directory blocks), CKS=0 (fixed media),
                        ;     OFF=2 (reserve tracks 0-1 for the system).
                        ;   IMPORTANT: DSM is stored as a WORD (not a byte).  The BDOS copies this
                        ;   table byte-for-byte into its internal aligned structure, so DSM must be a
                        ;   word for the SECTPT/MAXALL/... fields to line up correctly.
                        ;   AL0/AL1 reserve the directory blocks.  With the MSB-first allocation-map
                        ;   convention the 2 directory blocks at the start of the data area are blocks
                        ;   0 and 1, so AL0=0xC0 / AL1=0x00.  (AL0=0x00/AL1=0xC0 would reserve blocks
                        ;   8-9 and leave the real directory at block 0 unprotected, breaking SAVE.)
                        ; ============================================================================
   fd42                 DPB:
   fd42   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   fd44   03                    DB      03H             ; BSH  = 3    (block shift  -> 1K blocks)
   fd45   07                    DB      07H             ; BLM  = 7    (block mask)
   fd46   00                    DB      00H             ; EXM  = 0
   fd47   37 00                 DW      55              ; DSM  = 55   (max block number = 56 blocks)
   fd49   3f 00                 DW      63              ; DRM  = 63   (max directory entry = 64 entries)
   fd4b   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   fd4c   00                    DB      00H             ; AL1  = 0x00
   fd4d   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   fd4f   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
                        
                        ; ============================================================================
                        ;   CBIOS BUFFERS / VECTORS
                        ; ============================================================================
   fd51                 CSV:    DS      1               ; checksum vector (0 bytes needed since CKS=0)
   fd52                 ALV:    DS      8               ; allocation vector (56 blocks / 8 = 7 -> pad 8)
   fd5a                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
                        ; ============================================================================
                        ;   DRIVE B: (SPI flash) DISK PARAMETER HEADER / BLOCK / VECTORS
                        ;   Geometry: 128-byte sectors, SPT=32, 4KB allocation (BSH=5/BLM=31), OFF=2
                        ;   (tracks 0-1 reserved for the future boot), directory = block 0 reserved via
                        ;   AL0=0x80, DSM=125 (126 blocks), DRM=63 (64 entries), CKS=0 (fixed media).
                        ;   This MUST agree with diskutil's formatter (data at 0x2000).  The BDOS builds
                        ;   the allocation vector itself on first login, so ALVB just needs the space.
                        ; ============================================================================
   fdda                 DPHB:
   fdda   00 00                 DW      0000H           ; XLT: no sector translation
   fddc   00 00                 DW      0000H           ; scratch (cdrmax)
   fdde   00 00                 DW      0000H           ; scratch (curtrk)
   fde0   00 00                 DW      0000H           ; scratch (currec)
   fde2   5a fd                 DW      DIRBUF          ; shared directory buffer (128 bytes)
   fde4   ea fd                 DW      DPBB            ; disk parameter block
   fde6   f9 fd                 DW      CSVB            ; checksum vector
   fde8   fa fd                 DW      ALVB            ; allocation vector
   fdea                 DPBB:
   fdea   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   fdec   05                    DB      05H             ; BSH  = 5    (block shift -> 4KB blocks)
   fded   1f                    DB      1FH             ; BLM  = 31   (block mask)
   fdee   03                    DB      03H             ; EXM  = 3    (extent mask, BLS=4096 & DSM<256)
   fdef   7d 00                 DW      125             ; DSM  = 125  (max block number = 126 blocks)
   fdf1   3f 00                 DW      63              ; DRM  = 63   (max directory entry = 64 entries)
   fdf3   80                    DB      80H             ; AL0  = 0x80 (reserve directory block 0, MSB-first)
   fdf4   00                    DB      00H             ; AL1  = 0x00
   fdf5   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   fdf7   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   fdf9                 CSVB:   DS      1               ; checksum vector (0 bytes used since CKS=0)
   fdfa                 ALVB:   DS      16              ; allocation vector (DSM=125 -> (125/8)+1 = 16 bytes)
   fe0a                 RECOFF: DS      2               ; in-sector byte offset for the drive B: RMW
                        
   fe0c                         END
fd52  ALV           fdfa  ALVB          fcf7  BANNER        ec06  BDOSENT   
ec00  BDOSL         fa00  BIOS          fa33  BOOT          fb2e  CALC      
