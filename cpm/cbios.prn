                        ; ============================================================================
                        ;   CBIOS (Custom BIOS) for CP/M 2.2 on the LatticeXP2 Brevia2 (TV80 Z80 core)
                        ; ============================================================================
                        ;   Assembled with a85 (8080/8085 cross-assembler). 8080-only instructions are
                        ;   used throughout; ORG is fixed at 0xE600 (BIOS base) so the image is loaded
                        ;   exactly at 0xE600 by the GWMON-80 'L' command and entered with 'G E600'.
                        ;
                        ;   Memory map after the GWMON monitor ROM is banked out (OUT 0x30,1):
                        ;       0x0000-0x00FF  page zero   (0x0000 = JP WBOOT, 0x0005 = JP BDOS entry)
                        ;       0x0100-0xCFFF  TPA
                        ;       0xD000-0xD7FF  CCP  (already loaded by the combined HEX)
                        ;       0xD800-0xE5FF  BDOS (already loaded by the combined HEX)
                        ;       0xE600-0xEFFF  THIS CBIOS
                        ;       0xEF00-0xFEFF  drive A: 4KB RMW buffer (ABOVE the whole CP/M system, so
                        ;                     no transient program can ever load over it)
                        ;       0xFF00-0xFFFF  reserved for GWMON (its stack / banked-out area; CP/M
                        ;                     must stay strictly below 0xFF00 so the monitor cannot
                        ;                     clobber a running system image -- do not use this region).
                        ;
                        ;   Hardware driven by this CBIOS (Brevia2 custom I/O map):
                        ;       Serial console UART: 0x80 = status (bit0 tx_busy, bit1 rx_avail)
                        ;                             0x81 = TX data / RX data    (8N1 @ 115200)
                        ;       RAM disk (bank B of 128K SRAM, 64K bytes):
                        ;                             0x20 = DATA (IN=read / OUT=write, AUTO-INCREMENT)
                        ;                             0x21 = ADDR low byte (write)
                        ;                             0x22 = ADDR high byte (write)
                        ;   drive A:  the on-board ISSI IS25LD040 SPI flash (512 KB, persistent boot drive).
                        ;   drive B:  the 64K I/O-mapped RAM disk (volatile scratch).
                        ;                             0x50 = DATA (read clocks a byte in / write clocks
                        ;                                     a byte out, MSB first)
                        ;                             0x51 = CTL (bit0 = CS#: 0=select low, 1=release)
                        ;                             0x52 = STATUS (bit0 = transfer busy; poll OPTIONAL
                        ;                                     because the RTL byte engine stretches the
                        ;                                     CPU wait on every 0x50 access)
                        ;       ROM banking:          OUT 0x30 with bit0=1 banks out the GWMON ROM.
                        ;
                        ;   The 64K RAM disk is treated as a single CP/M disk (drive B:).  Its first
                        ;   two tracks (0 and 1) hold the SYSTEM tracks where this CBIOS writes the CCP
                        ;   and BDOS so that WBOOT (warm start) can reload them.  Tracks 2-15 are the
                        ;   user file area.  See the DPB below for the exact geometry.
                        ;
                        ;   NOTE on track/sector semantics: the DR CP/M 2.2 BDOS performs the block and
                        ;   sector translation itself and passes the *absolute* track (the BDOS already
                        ;   added the DPB "offset"/OFF) to SETTRK.  Therefore the CBIOS READ/WRITE below
                        ;   map an absolute (track, sector) to a RAM-disk byte address with:
                        ;           addr = (track * SPT + sector) * 128          ; SPT = 32, 128 = rec size
                        ;   The OFF tracks are NOT added again in READ/WRITE (they are already included
                        ;   in the track value passed by the BDOS).
                        ; ============================================================================
                        
   e600                         ORG     0E600H
                        
                        ; ---- constants ------------------------------------------------------------
   e600                 BIOS    EQU     0E600H          ; BIOS base (jump table origin)
   d000                 CCP     EQU     0D000H          ; CCP origin
                        ; (WBOOT is the label of the warm-boot routine, which lands at BIOS+3 = 0xE603.
                        ;  It is *not* declared with EQU here to avoid a duplicate-symbol error.)
   d800                 BDOSL   EQU     0D800H          ; BDOS origin
   d806                 BDOSENT EQU     0D806H          ; BDOS entry point (page-zero 0x0005 vector)
   0020                 SPT     EQU     32              ; sectors per track (from DPB)
   0000                 SYSCPP  EQU     0000H           ; RAM-disk byte offset of the stored CCP
   0800                 SYSBDS  EQU     0800H           ; RAM-disk byte offset of the stored BDOS
   0080                 DMA0    EQU     0080H           ; CP/M default DMA buffer
   0040                 LEDPORT EQU     40H             ; drive-activity LEDs (write bit = drive; MSB = drive A).
                                                        ;  Port 40h is shared read-only with the DIP switches.
                        ;
                        ; ---- ISSI IS25LD040 SPI flash ports (drive B:) — same map as diskutil ---- 
   0050                 SPI_DATA EQU    50H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0051                 SPI_CTL  EQU    51H             ; write bit0 = CS# (0=select low, 1=release high)
   0052                 SPI_STAT EQU    52H             ; read bit0 = transfer busy (poll OPTIONAL)
                        ;
                        ; ---- drive B: flash geometry (must match the DPB AND diskutil's formatter) ----
   ef00                 RMWBUF  EQU     0EF00H          ; 4KB read-modify-write buffer ABOVE the CP/M system
                                                        ;  (0xEF00-0xFEFF, just below GWMON's reserved 0xFF00).
                                                        ;  It is above the CCP/BDOS/CBIOS, so no transient program
                                                        ;  (bounded by the CCP at 0xD000) can ever load over it --
                                                        ;  this is the whole point of moving the system down.
                        ; ---- SD card (drive C:) dedicated SPI port, pins 31/32/35/36 ----
   0053                 SD_DATA EQU     53H             ; read clocks a byte in / write clocks a byte out (MSB first)
   0054                 SD_CTL  EQU     54H             ; write bit0 = CS# (0=select low, 1=release high);
                                                        ;        bit1 = slow clock (1 = ~390 kHz for card init)
   0055                 SD_STAT EQU     55H             ; read bit0 = transfer busy (poll OPTIONAL; the engine
                                                        ;        wait-stretches the CPU so no polling is needed)
   0001                 SDPLBA  EQU     1               ; SD partition LBA start (from the sdtool-created MBR, LBA=1).
                                                        ; Drive C: is a 2K-block single-DM CP/M drive (DPBC below);
                                                        ; the deblock buffer ALIASES the RMWBUF region (drive A flash
                                                        ; writes and drive C SD accesses NEVER happen at the same time
                                                        ; -- the BDOS drives one disk at a time).
                        
                        ;
                        ; ============================================================================
                        ;   BIOS JUMP TABLE (17 entries, each JP)  -- MUST be first, at 0xE600
                        ; ============================================================================
   e600   c3 33 e6              JMP     BOOT            ; 0  BIOS+0   cold start
   e603   c3 6a e6              JMP     WBOOT           ; 1  BIOS+3   warm start
   e606   c3 b1 e6              JMP     CONST           ; 2  BIOS+6   console status
   e609   c3 bd e6              JMP     CONIN           ; 3  BIOS+9   console input
   e60c   c3 c7 e6              JMP     CONOUT          ; 4  BIOS+12  console output
   e60f   c3 eb e6              JMP     LIST            ; 5  BIOS+15  list device output
   e612   c3 ee e6              JMP     PUNCH           ; 6  BIOS+18  punch device output
   e615   c3 f1 e6              JMP     READER          ; 7  BIOS+21  reader device input
   e618   c3 24 e7              JMP     HOME            ; 8  BIOS+24  home the disk
   e61b   c3 f7 e6              JMP     SELDSK          ; 9  BIOS+27  select disk drive
   e61e   c3 2f e7              JMP     SETTRK          ; 10 BIOS+30  set current track
   e621   c3 38 e7              JMP     SETSEC          ; 11 BIOS+33  set current sector
   e624   c3 3d e7              JMP     SETDMA          ; 12 BIOS+36  set DMA address
   e627   c3 90 e7              JMP     READ            ; 13 BIOS+39  read one 128-byte sector
   e62a   c3 ca e7              JMP     WRITE           ; 14 BIOS+42  write one 128-byte sector
   e62d   c3 f4 e6              JMP     LISTST          ; 15 BIOS+45  list device status
   e630   c3 46 e7              JMP     SECTRAN         ; 16 BIOS+48  sector translate (identity)
                        
                        ; ============================================================================
                        ;   COLD BOOT  (entry at 0xE600 via 'G E600')
                        ; ============================================================================
   e633                 BOOT:
   e633   31 00 ce              LXI     SP,0CE00H       ; establish a stack in the TPA (below CCP@D000);
                                                        ; it must sit BELOW the system (D000+) so the boot's
                                                        ;  stack use cannot clobber CCP/BDOS/CBIOS code.
   e636   3e 01                 MVI     A,01H
   e638   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM
                        ;
                        ; ---- set page-zero vectors ------------------------------------------------
   e63a   cd 92 e6              CALL    SETVEC
                        ;
                        ; ---- write CCP and BDOS from machine RAM onto the RAM disk SYSTEM tracks ----
   e63d   21 00 00              LXI     H,SYSCPP        ; disk byte 0 (system track 0)
   e640   11 00 d0              LXI     D,CCP           ; source = CCP image
   e643   01 00 08              LXI     B,2048          ; 2048 bytes
   e646   cd 96 ea              CALL    RAMWR
   e649   21 00 08              LXI     H,SYSBDS        ; disk byte 0x0800 (system track 0/1)
   e64c   11 00 d8              LXI     D,BDOSL         ; source = BDOS image
   e64f   01 00 0e              LXI     B,3584          ; 3584 bytes
   e652   cd 96 ea              CALL    RAMWR
                        ;
                        ; ---- the user DATA area is NOT formatted here --------------------------------
                        ; The diskutil formats the disk explicitly. The cold boot leaves the directory
                        ; untouched so files written to the RAM disk PERSIST across CP/M cold boots
                        ; (until power-off clears the volatile SRAM). Confirmed the directory lives at
                        ; 0x2000: a boot-format'd disk yields a clean NO FILE from DIR.
                        ;
                        ; ---- output the sign-on banner ---------------------------------------------
   e655   21 f7 eb              LXI     H,BANNER
   e658   cd de e6              CALL    PRTSTR
                        ;
                        ; ---- initialize the SD card (drive C:) so it is ready if logged in ----------
   e65b   cd 1f ea              CALL    SD_INIT
                        ;
                        ; ---- initialize the default DMA address and jump to the CCP -----------------
   e65e   21 80 00              LXI     H,DMA0
   e661   22 2c ec              SHLD    DMA
   e664   01 00 00              LXI     B,0000H         ; drive A (low nibble), user 0 (high nibble)
   e667   c3 00 d0              JMP     CCP             ; the CCP sets up its own stack and prints "A>"
                        
                        ; ============================================================================
                        ;   WARM BOOT  (0x0000 jumps here)
                        ; ============================================================================
   e66a                 WBOOT:
   e66a   31 00 ce              LXI     SP,0CE00H
   e66d   3e 01                 MVI     A,01H
   e66f   d3 30                 OUT     30H             ; bank OUT the GWMON monitor ROM (same as cold boot:
                                                        ;  'G E603' from the monitor after a reset must swap
                                                        ;  the ROM out too, else page-zero/CCP reads hit ROM)
                        ;
                        ; ---- reload CCP and BDOS from the RAM disk SYSTEM tracks --------------------
   e671   21 00 00              LXI     H,SYSCPP
   e674   11 00 d0              LXI     D,CCP
   e677   01 00 08              LXI     B,2048
   e67a   cd a4 ea              CALL    RAMRD
   e67d   21 00 08              LXI     H,SYSBDS
   e680   11 00 d8              LXI     D,BDOSL
   e683   01 00 0e              LXI     B,3584
   e686   cd a4 ea              CALL    RAMRD
                        ;
                        ; ---- restore page-zero vectors (a transient program may have clobbered them) -
   e689   cd 92 e6              CALL    SETVEC
                        ;
                        ; ---- re-enter the CCP -------------------------------------------------------
   e68c   01 00 00              LXI     B,0000H
   e68f   c3 00 d0              JMP     CCP
                        
                        ; ============================================================================
                        ;   PAGE-ZERO VECTOR SETUP
                        ;   0x0000 = JP WBOOT (0xE603), 0x0003 = IOBYTE, 0x0005 = JP BDOSENT (0xD806)
                        ; ============================================================================
   e692                 SETVEC:
   e692   21 00 00              LXI     H,0000H
   e695   36 c3                 MVI     M,0C3H          ; JP
   e697   23                    INX     H
   e698   36 03                 MVI     M,LOW(BIOS)+3   ; 0x0000 = JP 0xE603 (the WBOOT table entry)
   e69a   23                    INX     H
   e69b   36 e6                 MVI     M,HIGH(BIOS)
   e69d   21 03 00              LXI     H,0003H
   e6a0   36 00                 MVI     M,00H           ; IOBYTE = 0 (video console default)
   e6a2   23                    INX     H
   e6a3   36 00                 MVI     M,00H
   e6a5   21 05 00              LXI     H,0005H
   e6a8   36 c3                 MVI     M,0C3H          ; JP BDOS entry
   e6aa   23                    INX     H
   e6ab   36 06                 MVI     M,LOW(BDOSENT)
   e6ad   23                    INX     H
   e6ae   36 d8                 MVI     M,HIGH(BDOSENT)
   e6b0   c9                    RET
                        
                        ; ============================================================================
                        ;   CONSOLE ROUTINES (Brevia2 UART: 0x80 status, 0x81 data)
                        ; ============================================================================
                        ; CONST: return 0xFF if a character is ready, else 0x00.
   e6b1                 CONST:
   e6b1   db 80                 IN      80H
   e6b3   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6b5   3e 00                 MVI     A,00H           ; default: no char
   e6b7   ca bc e6              JZ      CONST2
   e6ba   3e ff                 MVI     A,0FFH          ; char ready
   e6bc                 CONST2:
   e6bc   c9                    RET
                        
                        ; CONIN: poll rx_avail, then read the character (returned in A).
   e6bd                 CONIN:
   e6bd   db 80                 IN      80H
   e6bf   e6 02                 ANI     02H             ; rx_avail (bit1)
   e6c1   ca bd e6              JZ      CONIN           ; wait for a character
   e6c4   db 81                 IN      81H             ; read it (8N1, no parity strip needed)
   e6c6   c9                    RET
                        
                        ; CONOUT: output the character held in register C (BDOS/DOS convention).
   e6c7                 CONOUT:
   e6c7   db 80                 IN      80H
   e6c9   e6 01                 ANI     01H             ; tx_busy (bit0)
   e6cb   c2 c7 e6              JNZ     CONOUT          ; wait until transmitter is idle
   e6ce   79                    MOV     A,C
   e6cf   d3 81                 OUT     81H
   e6d1   c9                    RET
                        
                        ; PUTC: internal helper - output the character held in A (used for the banner).
   e6d2                 PUTC:
   e6d2   f5                    PUSH    PSW
   e6d3                 PUTC1:
   e6d3   db 80                 IN      80H
   e6d5   e6 01                 ANI     01H
   e6d7   c2 d3 e6              JNZ     PUTC1
   e6da   f1                    POP     PSW
   e6db   d3 81                 OUT     81H
   e6dd   c9                    RET
                        
                        ; PRTSTR: print a NUL-terminated string pointed to by HL.
   e6de                 PRTSTR:
   e6de   7e                    MOV     A,M
   e6df   b7                    ORA     A
   e6e0   ca ea e6              JZ      PRTEND
   e6e3   cd d2 e6              CALL    PUTC
   e6e6   23                    INX     H
   e6e7   c3 de e6              JMP     PRTSTR
   e6ea                 PRTEND:
   e6ea   c9                    RET
                        
                        ; LIST / PUNCH / READER / LISTST: the serial console is the only device, so
                        ; the list/punch devices map to the console UART and the reader is the console.
   e6eb                 LIST:
   e6eb   c3 c7 e6              JMP     CONOUT          ; char in C
   e6ee                 PUNCH:
   e6ee   c3 c7 e6              JMP     CONOUT          ; char in C
   e6f1                 READER:
   e6f1   c3 bd e6              JMP     CONIN           ; returns char in A
   e6f4                 LISTST:
   e6f4   3e ff                 MVI     A,0FFH          ; list device always "ready"
   e6f6   c9                    RET
                        
                        ; ============================================================================
                        ;   DISK SELECT / TRACK / SECTOR / DMA  (these merely save parameters)
                        ; ============================================================================
                        ; SELDSK: select drive given by register C.  Return HL = DPH address for the
                        ; selected drive, or HL=0000 with A=0xFF if the drive is not present.
                        ;   C=0 -> drive A (the SPI flash boot drive), C=1 -> drive B (the RAM disk).
                        ;   C>1 -> error.
   e6f7                 SELDSK:
   e6f7   79                    MOV     A,C
   e6f8   32 28 ec              STA     SELBL           ; remember the selected drive number
   e6fb   b7                    ORA     A
   e6fc   ca 14 e7              JZ      SELD0           ; C=0 -> drive A
   e6ff   fe 01                 CPI     01H
   e701   ca 18 e7              JZ      SELD1           ; C=1 -> drive B (RAM disk)
   e704   fe 02                 CPI     02H
   e706   ca 1c e7              JZ      SELD2           ; C=2 -> drive C (SD card)
   e709   fe 03                 CPI     03H
   e70b   ca 20 e7              JZ      SELD3           ; C=3 -> drive D (future; reserved)
   e70e                 SELERR:
   e70e   21 00 00              LXI     H,0000H         ; error return: HL=0
   e711   3e ff                 MVI     A,0FFH
   e713   c9                    RET
   e714                 SELD0:
   e714   21 33 ec              LXI     H,DPH           ; drive A disk parameter header (SPI flash)
   e717   c9                    RET
   e718                 SELD1:
   e718   21 db ec              LXI     H,DPHB          ; drive B disk parameter header (RAM disk)
   e71b   c9                    RET
   e71c                 SELD2:
   e71c   21 1d ed              LXI     H,DPHC          ; drive C disk parameter header (SD card)
   e71f   c9                    RET
   e720                 SELD3:
   e720   21 2d ed              LXI     H,DPHD          ; drive D disk parameter header (SD partition 2, future)
   e723   c9                    RET
                        
                        ; HOME: move to track 0, sector 0.
   e724                 HOME:
   e724   af                    XRA     A
   e725   32 29 ec              STA     TRK             ; track low byte
   e728   32 2a ec              STA     TRK+1           ; track high byte -- MUST clear both, or a stale
                                                        ; high byte left by a prior drive-C access would
                                                        ; survive a HOME on a small drive A/B and corrupt
                                                        ; the track address
   e72b   32 2b ec              STA     SECN
   e72e   c9                    RET
                        
                        ; SETTRK: set the current track.  CP/M 2 passes the track as a WORD in BC (DRI
                        ;   manual Table 6-5: "Register BC contains the track number ... 0-65535 for
                        ;   nonstandard disk subsystems"; seasip: "a word under CP/M 2").  Store BOTH
                        ;   bytes -- the high byte is what lets us address >256 tracks (an 8 MB drive at
                        ;   SPT=32 needs tracks up to 2047).
   e72f                 SETTRK:
   e72f   79                    MOV     A,C
   e730   32 29 ec              STA     TRK             ; track low byte
   e733   78                    MOV     A,B
   e734   32 2a ec              STA     TRK+1           ; track high byte
   e737   c9                    RET
                        
                        ; SETSEC: set the current sector (register C).
   e738                 SETSEC:
   e738   79                    MOV     A,C
   e739   32 2b ec              STA     SECN
   e73c   c9                    RET
                        
                        ; SETDMA: set the DMA buffer address (registers B,C).
   e73d                 SETDMA:
   e73d   79                    MOV     A,C
   e73e   32 2c ec              STA     DMA
   e741   78                    MOV     A,B
   e742   32 2d ec              STA     DMA+1
   e745   c9                    RET
                        
                        ; SECTRAN: sector translate = identity.  The requested sector (BC) is returned
                        ; unchanged in HL.  (XLT in the DPH is 0, i.e. no translation table, so we do
                        ; a pure identity and never read from a table.)
   e746                 SECTRAN:
   e746   69                    MOV     L,C
   e747   60                    MOV     H,B
   e748   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK ADDRESS CALCULATION
                        ;   HL = (TRK*SPT + SECN)*128 = (TRK*32 + SECN)*128  =  TRK*4096 + SECN*128
                        ;   The BDOS passes the absolute track (offset already included), so OFF is not
                        ;   re-added here.
                        ; ============================================================================
   e749                 CALC:
   e749   3a 29 ec              LDA     TRK
   e74c   6f                    MOV     L,A
   e74d   26 00                 MVI     H,00H           ; HL = TRK
   e74f   29                    DAD     H               ; *2
   e750   29                    DAD     H               ; *4
   e751   29                    DAD     H               ; *8
   e752   29                    DAD     H               ; *16
   e753   29                    DAD     H               ; *32
   e754   29                    DAD     H               ; *64
   e755   29                    DAD     H               ; *128
   e756   29                    DAD     H               ; *256
   e757   29                    DAD     H               ; *512
   e758   29                    DAD     H               ; *1024
   e759   29                    DAD     H               ; *2048
   e75a   29                    DAD     H               ; *4096  -> HL = TRK*4096
   e75b   44                    MOV     B,H
   e75c   4d                    MOV     C,L             ; BC = TRK*4096
   e75d   3a 2b ec              LDA     SECN
   e760   6f                    MOV     L,A
   e761   26 00                 MVI     H,00H           ; HL = SECN
   e763   29                    DAD     H               ; *2
   e764   29                    DAD     H               ; *4
   e765   29                    DAD     H               ; *8
   e766   29                    DAD     H               ; *16
   e767   29                    DAD     H               ; *32
   e768   29                    DAD     H               ; *64
   e769   29                    DAD     H               ; *128  -> HL = SECN*128
   e76a   09                    DAD     B               ; HL = TRK*4096 + SECN*128
   e76b   c9                    RET
                        
                        ; ============================================================================
                        ;   RAM-DISK SET-POINTER:  write HL to ports 0x21/0x22
                        ; ============================================================================
   e76c                 RAMPTR:
   e76c   7d                    MOV     A,L
   e76d   d3 21                 OUT     21H             ; address low byte
   e76f   7c                    MOV     A,H
   e770   d3 22                 OUT     22H             ; address high byte
   e772   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE-ACTIVITY LEDS.  Port 40h carries the drive LEDs (write-only; the DIP
                        ;   switches share the port read-only).  On every disk READ/WRITE we light the
                        ;   LED for the selected drive, then write 00h to extinguish before returning.
                        ;   Bit assignment (user spec): MSB / pin37 / D8 = drive A, D7 = drive B,
                        ;   D6 = drive C, D5 = drive D  =>  bit = 7 - SELBL.
                        ; ============================================================================
   e773                 LIGHT:
   e773   3a 28 ec              LDA     SELBL           ; A = drive number (0..3)
   e776   4f                    MOV     C,A             ; C = shift count
   e777   06 80                 MVI     B,80H           ; B = MSB mask (drive A)
   e779                 LIGHT_LP:
   e779   79                    MOV     A,C
   e77a   b7                    ORA     A
   e77b   ca 85 e7              JZ      LIGHT_OUT
   e77e   78                    MOV     A,B
   e77f   0f                    RRC
   e780   47                    MOV     B,A
   e781   0d                    DCR     C
   e782   c3 79 e7              JMP     LIGHT_LP
   e785                 LIGHT_OUT:
   e785   78                    MOV     A,B
   e786   d3 40                 OUT     LEDPORT
   e788   c9                    RET
                        
                        ; LEDOFF: write 00h to the LED port (all drives off).  Preserves ALL registers,
                        ;   so the disk status in A survives unchanged to the BDOS caller.
   e789                 LEDOFF:
   e789   f5                    PUSH    PSW
   e78a   3e 00                 MVI     A,00H
   e78c   d3 40                 OUT     LEDPORT
   e78e   f1                    POP     PSW
   e78f   c9                    RET
                        
                        ; ============================================================================
                        ;   READ:  read one 128-byte CP/M sector from the RAM disk into the DMA buffer.
                        ;   Returns A=0 on success (RAM disk is error-free -> always 0).
                        ; ============================================================================
   e790                 READ:
   e790   cd 73 e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e793   3a 28 ec              LDA     SELBL
   e796   b7                    ORA     A
   e797   ca be e7              JZ      READ_A          ; drive A (SELBL==0) -> SPI flash (boot drive)
   e79a   fe 02                 CPI     02H
   e79c   ca c4 e7              JZ      READ_C          ; drive C (SELBL==2) -> SD card (with retry)
   e79f   fe 03                 CPI     03H
   e7a1   ca c4 e7              JZ      READ_C          ; drive D (SELBL==3) -> SD card (with retry)
                                ; ---- drive B: RAM disk path ----
   e7a4   cd 49 e7              CALL    CALC            ; HL = RAM-disk byte address
   e7a7   cd 6c e7              CALL    RAMPTR          ; set the disk data-pointer
   e7aa   2a 2c ec              LHLD    DMA
   e7ad   54                    MOV     D,H
   e7ae   5d                    MOV     E,L             ; DE = DMA destination
   e7af   06 80                 MVI     B,128
   e7b1                 READ1:
   e7b1   db 20                 IN      20H             ; read a byte (data port auto-increments)
   e7b3   12                    STAX    D
   e7b4   13                    INX     D
   e7b5   05                    DCR     B
   e7b6   c2 b1 e7              JNZ     READ1
   e7b9   3e 00                 MVI     A,00H           ; success
   e7bb   c3 89 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
                                                        ;  (LEDOFF preserves A, so the BDOS still sees 00H)
   e7be                 READ_A:
   e7be   cd 8a eb              CALL    READB           ; drive A flash read; RET here with A = status
   e7c1   c3 89 e7              JMP     LEDOFF
   e7c4                 READ_C:
   e7c4   cd 5e e8              CALL    READC           ; drive C/D SD read (retry); RET here with A = status
   e7c7   c3 89 e7              JMP     LEDOFF
                        
                        ; ============================================================================
                        ;   WRITE: write one 128-byte CP/M sector from the DMA buffer to the RAM disk.
                        ;   Returns A=0 on success.
                        ; ============================================================================
   e7ca                 WRITE:
   e7ca   cd 73 e7              CALL    LIGHT           ; light the LED for the selected drive (bit = 7-SELBL)
   e7cd   3a 28 ec              LDA     SELBL
   e7d0   b7                    ORA     A
   e7d1   ca f8 e7              JZ      WRITE_A         ; drive A (SELBL==0) -> SPI flash (boot drive)
   e7d4   fe 02                 CPI     02H
   e7d6   ca fe e7              JZ      WRITE_C         ; drive C (SELBL==2) -> SD card (with retry)
   e7d9   fe 03                 CPI     03H
   e7db   ca fe e7              JZ      WRITE_C         ; drive D (SELBL==3) -> SD card (with retry)
                                ; ---- drive B: RAM disk path ----
   e7de   cd 49 e7              CALL    CALC            ; HL = RAM-disk byte address
   e7e1   cd 6c e7              CALL    RAMPTR
   e7e4   2a 2c ec              LHLD    DMA
   e7e7   54                    MOV     D,H
   e7e8   5d                    MOV     E,L             ; DE = DMA source
   e7e9   06 80                 MVI     B,128
   e7eb                 WRITE1:
   e7eb   1a                    LDAX    D
   e7ec   d3 20                 OUT     20H             ; write a byte (data port auto-increments)
   e7ee   13                    INX     D
   e7ef   05                    DCR     B
   e7f0   c2 eb e7              JNZ     WRITE1
   e7f3   3e 00                 MVI     A,00H           ; success
   e7f5   c3 89 e7              JMP     LEDOFF          ; extinguish the activity LED, then return to the BDOS
   e7f8                 WRITE_A:
   e7f8   cd 9b eb              CALL    WRITEB          ; drive A flash write (4KB RMW); RET here with A = status
   e7fb   c3 89 e7              JMP     LEDOFF
   e7fe                 WRITE_C:
   e7fe   cd 72 e8              CALL    WRITEC          ; drive C/D SD write (retry); RET here with A = status
   e801   c3 89 e7              JMP     LEDOFF
                        
                        ; ============================================================================
                        ;   SD CARD (drive C:) DRIVER + DEBLOCKING
                        ;   The SD is a 2K-block single-DM CP/M drive (DPBC, same geometry family as the
                        ;   flash drive A but OFF=0 because it is a data partition).  The BDOS operates
                        ;   on 128-byte records; the SD only transfers 512-byte sectors, so the CBIOS
                        ;   deblocks: record r -> SD sector (SDPLBA + r/4) at byte offset (r%4)*128.
                        ;   The 512-byte sector buffer ALIASES the RMWBUF region (0xEF00): drive A flash
                        ;   writes and drive C SD accesses never occur at the same time (the BDOS drives
                        ;   one disk at a time), so the two can safely share that 4KB area.
                        ; ============================================================================
                        ; SDMAP: from TRK/SECN compute the SD block number (BLKN, 32-bit, MSB first) and
                        ;   the in-sector byte offset (SDOFF, 16-bit) for the current 128-byte record.
                        ;   record = TRK*SPT + SECN = TRK*32 + SECN.
   e804                 SDMAP:
   e804   2a 29 ec              LHLD    TRK             ; HL = full 16-bit TRK (CP/M 2 passes it as a word
                                                        ; in BC; an 8 MB drive at SPT=32 reaches track 2047)
   e807   29                    DAD     H               ; *2
   e808   29                    DAD     H               ; *4
   e809   29                    DAD     H               ; *8
   e80a   29                    DAD     H               ; *16
   e80b   29                    DAD     H               ; *32  -> HL = TRK*32
   e80c   3a 2b ec              LDA     SECN
   e80f   5f                    MOV     E,A
   e810   16 00                 MVI     D,00H
   e812   19                    DAD     D               ; HL = record
                                ; SDOFF_hi = (record & 3) >> 1   [0,0,1,1]
   e813   7d                    MOV     A,L
   e814   e6 03                 ANI     03H
   e816   47                    MOV     B,A
   e817   e6 02                 ANI     02H
   e819   ca 21 e8              JZ      SDMAP_H0
   e81c   3e 01                 MVI     A,01H
   e81e   c3 23 e8              JMP     SDMAP_H1
   e821                 SDMAP_H0:
   e821   3e 00                 MVI     A,00H
   e823                 SDMAP_H1:
   e823   32 5d ee              STA     SDOFF+1
                                ; SDOFF_lo = ((record & 3) << 7) & 0xFF   [*128]
                                ; NOTE: RAL (rotate through carry), NOT RLC.  RLC is CIRCULAR, so bit 7
                                ; wraps back into bit 0: (record&3)=2 gave 0x01 instead of 0x00 and
                                ; (record&3)=3 gave 0x81 instead of 0x80, i.e. records 2 and 3 of every
                                ; 512-byte sector were deblocked ONE BYTE HIGH.  CP/M still round-tripped
                                ; (READ used the same offset) but the on-card sector was shifted, so the
                                ; directory/data written to the SD was silently corrupt.
   e826   af                    XRA     A               ; clear CY (and A)
   e827   78                    MOV     A,B
   e828   17                    RAL                     ; *2
   e829   17                    RAL                     ; *4
   e82a   17                    RAL                     ; *8
   e82b   17                    RAL                     ; *16
   e82c   17                    RAL                     ; *32
   e82d   17                    RAL                     ; *64
   e82e   17                    RAL                     ; *128
   e82f   32 5c ee              STA     SDOFF
                                ; SSEC = record >> 2 (16-bit logical right shift)
   e832   af                    XRA     A               ; A=0, CY=0
   e833   7c                    MOV     A,H
   e834   1f                    RAR
   e835   67                    MOV     H,A
   e836   7d                    MOV     A,L
   e837   1f                    RAR
   e838   6f                    MOV     L,A
   e839   af                    XRA     A
   e83a   7c                    MOV     A,H
   e83b   1f                    RAR
   e83c   67                    MOV     H,A
   e83d   7d                    MOV     A,L
   e83e   1f                    RAR
   e83f   6f                    MOV     L,A             ; HL = record >> 2 = SSEC
                                ; ---- per-drive region offset (CP/M has no partitioning) ----
                                ; The BDOS does NOT reliably apply the DPB OFF here, so the region base is
                                ; added at the CBIOS deblock layer.  Drive D (SELBL==3) is region 1 =
                                ; +8 MB = +16384 SD sectors (0x4000); drive C (SELBL==2) is region 0 (+0).
                                ; This shifts the logical drive's record space into its own 8 MB region of
                                ; the 64 MB partition.  SDOFF is unaffected (the region is a multiple of 4
                                ; records, so record&3 is unchanged).
   e840   3a 28 ec              LDA     SELBL
   e843   fe 03                 CPI     03H
   e845   c2 4c e8              JNZ     SDMAP_REG0
   e848   11 00 40              LXI     D,4000H
   e84b   19                    DAD     D               ; SSEC += 0x4000 (into region 1)
   e84c                 SDMAP_REG0:
                                ; BLKN = SDPLBA + SSEC  (SDPLBA=1)
   e84c   23                    INX     H
   e84d   3e 00                 MVI     A,00H
   e84f   32 5e ee              STA     BLKN+0
   e852   32 5f ee              STA     BLKN+1
   e855   7c                    MOV     A,H
   e856   32 60 ee              STA     BLKN+2
   e859   7d                    MOV     A,L
   e85a   32 61 ee              STA     BLKN+3
   e85d   c9                    RET
                        
                        ; ---- drive C: retry wrappers -------------------------------------------------
                        ; An SD transaction can fail TRANSIENTLY: a command issued while the card is
                        ; still internally busy is silently dropped (the MISO read then looks like
                        ; R1=OK or 0FFh), a response can be lost, or the boot-time handshake can fail
                        ; and leave drive C dead for the whole session.  A CP/M BIOS must not turn
                        ; those into a hard "Bad Sector" on the first try: retry the WHOLE operation up
                        ; to SDTRIES times, re-initialising the card between attempts.
   0006                 SDTRIES EQU     06H          ; attempts; each retry also WAITS before re-init
   e85e                 READC:
   e85e   3e 06                 MVI     A,SDTRIES
   e860   32 68 ee              STA     SDTRY
   e863                 READC1:
   e863   cd a5 e8              CALL    READS
   e866   b7                    ORA     A
   e867   ca 86 e8              JZ      SDOP_OK
   e86a   cd 88 e8              CALL    SD_RECOVER
   e86d   b7                    ORA     A
   e86e   ca 63 e8              JZ      READC1
   e871   c9                    RET                     ; out of tries -> A = 0FFh (real failure)
   e872                 WRITEC:
   e872   3e 06                 MVI     A,SDTRIES
   e874   32 68 ee              STA     SDTRY
   e877                 WRITEC1:
   e877   cd d2 e8              CALL    WRITES
   e87a   b7                    ORA     A
   e87b   ca 86 e8              JZ      SDOP_OK
   e87e   cd 88 e8              CALL    SD_RECOVER
   e881   b7                    ORA     A
   e882   ca 77 e8              JZ      WRITEC1
   e885   c9                    RET
   e886                 SDOP_OK:
   e886   af                    XRA     A
   e887   c9                    RET
                        ; SD_RECOVER: another attempt allowed -> release CS, re-init the card, return
                        ;   A=0.  Out of tries -> release CS and return A=0FFh.  Clobbers A,BC,DE,HL.
   e888                 SD_RECOVER:
   e888   3a 68 ee              LDA     SDTRY
   e88b   3d                    DCR     A
   e88c   32 68 ee              STA     SDTRY
   e88f   ca 9e e8              JZ      SDRC_NO
   e892   3e 01                 MVI     A,01H
   e894   d3 54                 OUT     SD_CTL          ; release CS, give the card time to finish its
   e896   cd 74 ea              CALL    SD_RDLY         ; internal programming (~10 ms), then re-handshake
   e899   cd 1f ea              CALL    SD_INIT
   e89c   af                    XRA     A
   e89d   c9                    RET
   e89e                 SDRC_NO:
   e89e   3e 01                 MVI     A,01H           ; release CS and report the failure
   e8a0   d3 54                 OUT     SD_CTL
   e8a2   3e ff                 MVI     A,0FFH
   e8a4   c9                    RET
                        
                        ; READS: read one 128-byte CP/M record from the SD into the DMA buffer.
                        ;   Returns A=0 on success, 0FFh on error.
   e8a5                 READS:
   e8a5   cd 04 e8              CALL    SDMAP
   e8a8   21 00 ef              LXI     H,RMWBUF        ; deblock sector buffer (aliases the RMWBUF region)
   e8ab   cd 09 e9              CALL    SD_READBLK      ; read the 512-byte SD sector into RMWBUF
   e8ae   b7                    ORA     A
   e8af   c2 d1 e8              JNZ     READS_ERR
                                ; copy RMWBUF+SDOFF (128 bytes) to the DMA buffer
   e8b2   2a 2c ec              LHLD    DMA
   e8b5   54                    MOV     D,H
   e8b6   5d                    MOV     E,L             ; DE = DMA destination
   e8b7   21 00 ef              LXI     H,RMWBUF
   e8ba   3a 5c ee              LDA     SDOFF
   e8bd   85                    ADD     L
   e8be   6f                    MOV     L,A
   e8bf   3a 5d ee              LDA     SDOFF+1
   e8c2   8c                    ADC     H
   e8c3   67                    MOV     H,A             ; HL = RMWBUF + SDOFF
   e8c4   06 80                 MVI     B,128
   e8c6                 READS1:
   e8c6   7e                    MOV     A,M
   e8c7   12                    STAX    D
   e8c8   23                    INX     H
   e8c9   13                    INX     D
   e8ca   05                    DCR     B
   e8cb   c2 c6 e8              JNZ     READS1
   e8ce   3e 00                 MVI     A,00H           ; success
   e8d0   c9                    RET
   e8d1                 READS_ERR:
   e8d1   c9                    RET                     ; A = 0FFh (disk read error)
                        
                        ; WRITES: write one 128-byte CP/M record from the DMA buffer to the SD
                        ;   (read-modify-write of the containing 512-byte sector).
                        ;   Returns A=0 on success, 0FFh on error.
   e8d2                 WRITES:
   e8d2   cd 04 e8              CALL    SDMAP
   e8d5   21 00 ef              LXI     H,RMWBUF
   e8d8   cd 09 e9              CALL    SD_READBLK      ; read the sector first (RMW)
   e8db   b7                    ORA     A
   e8dc   c2 08 e9              JNZ     WRITES_ERR
                                ; overlay the 128-byte DMA record at RMWBUF+SDOFF
   e8df   2a 2c ec              LHLD    DMA
   e8e2   54                    MOV     D,H
   e8e3   5d                    MOV     E,L             ; DE = DMA source
   e8e4   21 00 ef              LXI     H,RMWBUF
   e8e7   3a 5c ee              LDA     SDOFF
   e8ea   85                    ADD     L
   e8eb   6f                    MOV     L,A
   e8ec   3a 5d ee              LDA     SDOFF+1
   e8ef   8c                    ADC     H
   e8f0   67                    MOV     H,A             ; HL = RMWBUF + SDOFF (in-buffer destination)
   e8f1   06 80                 MVI     B,128
   e8f3                 WRITES1:
   e8f3   1a                    LDAX    D
   e8f4   77                    MOV     M,A
   e8f5   23                    INX     H
   e8f6   13                    INX     D
   e8f7   05                    DCR     B
   e8f8   c2 f3 e8              JNZ     WRITES1
   e8fb   21 00 ef              LXI     H,RMWBUF
   e8fe   cd 61 e9              CALL    SD_WRITEBLK     ; write the modified 512-byte sector back
   e901   b7                    ORA     A
   e902   c2 08 e9              JNZ     WRITES_ERR
   e905   3e 00                 MVI     A,00H           ; success
   e907   c9                    RET
   e908                 WRITES_ERR:
   e908   c9                    RET                     ; A = 0FFh (disk write error)
                        
                        ; SD_READBLK: read the 512-byte SD block BLKN (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the destination buffer).
   e909                 SD_READBLK:
   e909   3e 00                 MVI     A,00H
   e90b   d3 54                 OUT     SD_CTL          ; select the SD card (CS low), fast
   e90d   3e 51                 MVI     A,51H           ; CMD17 (read single block)
   e90f   32 62 ee              STA     SDCMDB
   e912   3a 5e ee              LDA     BLKN+0
   e915   32 63 ee              STA     SDCMDB+1
   e918   3a 5f ee              LDA     BLKN+1
   e91b   32 64 ee              STA     SDCMDB+2
   e91e   3a 60 ee              LDA     BLKN+2
   e921   32 65 ee              STA     SDCMDB+3
   e924   3a 61 ee              LDA     BLKN+3
   e927   32 66 ee              STA     SDCMDB+4
   e92a   3e ff                 MVI     A,0FFH
   e92c   32 67 ee              STA     SDCMDB+5
   e92f   e5                    PUSH    H
   e930   21 62 ee              LXI     H,SDCMDB
   e933   cd f1 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e936   e1                    POP     H               ; restore the destination buffer
   e937   fe 00                 CPI     00H
   e939   c2 5a e9              JNZ     SDRB_ERR
   e93c   cd 0e ea              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   e93f   da 5a e9              JC      SDRB_ERR
   e942   01 00 02              LXI     B,512
   e945                 SDRB1:
   e945   db 53                 IN      SD_DATA
   e947   77                    MOV     M,A
   e948   23                    INX     H
   e949   0b                    DCX     B
   e94a   78                    MOV     A,B
   e94b   b1                    ORA     C
   e94c   c2 45 e9              JNZ     SDRB1
   e94f   db 53                 IN      SD_DATA         ; 2 CRC bytes
   e951   db 53                 IN      SD_DATA
   e953   3e 01                 MVI     A,01H
   e955   d3 54                 OUT     SD_CTL          ; release CS
   e957   3e 00                 MVI     A,00H
   e959   c9                    RET
   e95a                 SDRB_ERR:
   e95a   3e 01                 MVI     A,01H
   e95c   d3 54                 OUT     SD_CTL          ; release CS
   e95e   3e ff                 MVI     A,0FFH
   e960   c9                    RET
                        
                        ; SD_WRITEBLK: write the 512 bytes at (HL) to the SD block BLKN.
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the source buffer).
   e961                 SD_WRITEBLK:
   e961   3e 00                 MVI     A,00H
   e963   d3 54                 OUT     SD_CTL          ; select the SD card, fast
   e965   3e 58                 MVI     A,58H           ; CMD24 (write single block)
   e967   32 62 ee              STA     SDCMDB
   e96a   3a 5e ee              LDA     BLKN+0
   e96d   32 63 ee              STA     SDCMDB+1
   e970   3a 5f ee              LDA     BLKN+1
   e973   32 64 ee              STA     SDCMDB+2
   e976   3a 60 ee              LDA     BLKN+2
   e979   32 65 ee              STA     SDCMDB+3
   e97c   3a 61 ee              LDA     BLKN+3
   e97f   32 66 ee              STA     SDCMDB+4
   e982   3e ff                 MVI     A,0FFH
   e984   32 67 ee              STA     SDCMDB+5
   e987   e5                    PUSH    H
   e988   21 62 ee              LXI     H,SDCMDB
   e98b   cd f1 e9              CALL    SD_SEND6        ; A = R1 (should be 00)
   e98e   e1                    POP     H               ; restore the source buffer
   e98f   fe 00                 CPI     00H
   e991   c2 cd e9              JNZ     SDWB_ERR
   e994   3e fe                 MVI     A,0FEH          ; data start token
   e996   d3 53                 OUT     SD_DATA
   e998   01 00 02              LXI     B,512
   e99b                 SDWB1:
   e99b   7e                    MOV     A,M
   e99c   d3 53                 OUT     SD_DATA
   e99e   23                    INX     H
   e99f   0b                    DCX     B
   e9a0   78                    MOV     A,B
   e9a1   b1                    ORA     C
   e9a2   c2 9b e9              JNZ     SDWB1
   e9a5   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC disabled)
   e9a7   d3 53                 OUT     SD_DATA
   e9a9   d3 53                 OUT     SD_DATA
                                ; read the data-response token: the card clocks 0xFF for a few bytes
                                ; first, then 0bxxx00101 (0x05) = data accepted.
   e9ab   06 10                 MVI     B,16
   e9ad                 SDWB_RSP:
   e9ad   db 53                 IN      SD_DATA
   e9af   fe ff                 CPI     0FFH
   e9b1   c2 b8 e9              JNZ     SDWB_GOT
   e9b4   05                    DCR     B
   e9b5   c2 ad e9              JNZ     SDWB_RSP
   e9b8                 SDWB_GOT:
   e9b8   e6 1f                 ANI     1FH             ; response bits 0-4; 0x05 = accepted
   e9ba   fe 05                 CPI     05H
   e9bc   c2 cd e9              JNZ     SDWB_ERR        ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS so the
                                ; very next command is not issued into a busy card
   e9bf   cd d4 e9              CALL    SD_READY
   e9c2   b7                    ORA     A
   e9c3   c2 cd e9              JNZ     SDWB_ERR
   e9c6                 SDWB_DONE:
   e9c6   3e 01                 MVI     A,01H
   e9c8   d3 54                 OUT     SD_CTL          ; release CS
   e9ca   3e 00                 MVI     A,00H
   e9cc   c9                    RET
   e9cd                 SDWB_ERR:
   e9cd   3e 01                 MVI     A,01H
   e9cf   d3 54                 OUT     SD_CTL          ; release CS
   e9d1   3e ff                 MVI     A,0FFH
   e9d3   c9                    RET
                        
                        ; SD_READY: wait until the card is NOT busy (MISO high, reads 0xFF) before a
                        ;   command is issued.  A card that is still programming a block drives MISO
                        ;   LOW, so bytes read as 0x00 -- and SD_SEND6's R1 read would accept that 0x00
                        ;   as "R1 = OK" and drop the command on the floor, leaving the card's data
                        ;   stream desynced.  That is what turned every write after the first into
                        ;   "Bad Sector".  Timeout ~260k port reads (~0.4 s at 25 MHz), which covers the
                        ;   SD spec's 250 ms worst-case block-programming time.
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   e9d4                 SD_READY:
   e9d4   d5                    PUSH    D
   e9d5   16 04                 MVI     D,04H           ; 4 x 65536 port reads
   e9d7                 SDRDY0:
   e9d7   01 00 00              LXI     B,0000H
   e9da                 SDRDY1:
   e9da   db 53                 IN      SD_DATA         ; 0xFF = idle, 0x00 = still programming
   e9dc   fe ff                 CPI     0FFH
   e9de   ca ee e9              JZ      SDRDY_OK
   e9e1   0b                    DCX     B
   e9e2   78                    MOV     A,B
   e9e3   b1                    ORA     C
   e9e4   c2 da e9              JNZ     SDRDY1
   e9e7   15                    DCR     D
   e9e8   c2 d7 e9              JNZ     SDRDY0
   e9eb   d1                    POP     D
   e9ec   37                    STC
   e9ed   c9                    RET
   e9ee                 SDRDY_OK:
   e9ee   d1                    POP     D
   e9ef   af                    XRA     A               ; A=0, clear CY
   e9f0   c9                    RET
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Returns A = R1 (0FFh if no valid response after 16 bytes of clocking).
   e9f1                 SD_SEND6:
   e9f1   e5                    PUSH    H
   e9f2   cd d4 e9              CALL    SD_READY        ; never issue a command into a busy card
   e9f5   e1                    POP     H
   e9f6   06 06                 MVI     B,6
   e9f8                 SD6_TX:
   e9f8   7e                    MOV     A,M
   e9f9   d3 53                 OUT     SD_DATA
   e9fb   23                    INX     H
   e9fc   05                    DCR     B
   e9fd   c2 f8 e9              JNZ     SD6_TX
   ea00   06 10                 MVI     B,16
   ea02                 SD6_RX:
   ea02   db 53                 IN      SD_DATA
   ea04   fe ff                 CPI     0FFH
   ea06   c2 0d ea              JNZ     SD6_DONE
   ea09   05                    DCR     B
   ea0a   c2 02 ea              JNZ     SD6_RX
   ea0d                 SD6_DONE:
   ea0d   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success, CY=1 if 255 bytes pass with no token.
   ea0e                 SD_WAITTKN:
   ea0e   06 ff                 MVI     B,0FFH
   ea10                 SD_WT:
   ea10   db 53                 IN      SD_DATA
   ea12   fe fe                 CPI     0FEH
   ea14   ca 1d ea              JZ      SD_WT_OK
   ea17   05                    DCR     B
   ea18   c2 10 ea              JNZ     SD_WT
   ea1b   37                    STC
   ea1c   c9                    RET
   ea1d                 SD_WT_OK:
   ea1d   b7                    ORA     A               ; clear CY
   ea1e   c9                    RET
                        
                        ; SD_INIT: full SPI-mode initialization of the SD card.  Called from BOOT so a
                        ;   logged-in drive C is ready.  A = 0 on success (card entering SPI mode and
                        ;   initializing), 0FFh if no card / init failed (drive C reads will then error).
                        ;   This is the same handshake as sdprobe/sdtool (CMD0 -> CMD8 -> CMD55/ACMD41).
   ea1f                 SD_INIT:
   ea1f   3e 03                 MVI     A,03H           ; CS high + slow clock
   ea21   d3 54                 OUT     SD_CTL
   ea23   06 0a                 MVI     B,10            ; 10 x 0xFF = 80 power-up clocks
   ea25                 SDI_CK:
   ea25   3e ff                 MVI     A,0FFH
   ea27   d3 53                 OUT     SD_DATA
   ea29   05                    DCR     B
   ea2a   c2 25 ea              JNZ     SDI_CK
   ea2d   3e 02                 MVI     A,02H           ; select the card (CS low), slow clock
   ea2f   d3 54                 OUT     SD_CTL
                                ; CMD0 + read R1
   ea31   21 7e ea              LXI     H,SDCMD0
   ea34   cd f1 e9              CALL    SD_SEND6        ; A = R1 (01h = idle, or 0FFh if no response)
   ea37   fe 01                 CPI     01H
   ea39   c2 64 ea              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) - required before ACMD41 on SDHC/SDXC
   ea3c   21 84 ea              LXI     H,SDCMD8
   ea3f   cd f1 e9              CALL    SD_SEND6
   ea42   db 53                 IN      SD_DATA         ; consume the 4-byte R7 payload
   ea44   db 53                 IN      SD_DATA
   ea46   db 53                 IN      SD_DATA
   ea48   db 53                 IN      SD_DATA
                                ; CMD55 + ACMD41 poll until the card leaves idle
   ea4a   16 c8                 MVI     D,200
   ea4c                 SDI_RDY:
   ea4c   21 8a ea              LXI     H,SDCMD55
   ea4f   cd f1 e9              CALL    SD_SEND6
   ea52   21 90 ea              LXI     H,SDACMD
   ea55   cd f1 e9              CALL    SD_SEND6        ; A = R1
   ea58   fe 00                 CPI     00H
   ea5a   ca 67 ea              JZ      SDI_OK
   ea5d   cd 6a ea              CALL    SD_DELAY        ; ~3ms between attempts (card init is time-based)
   ea60   15                    DCR     D
   ea61   c2 4c ea              JNZ     SDI_RDY
   ea64                 SDI_FAIL:
   ea64   3e ff                 MVI     A,0FFH
   ea66   c9                    RET
   ea67                 SDI_OK:
   ea67   3e 00                 MVI     A,00H
   ea69   c9                    RET
                        
                        ; SD_DELAY: approximate ~3ms busy-wait (HL only; for SD init polling).
   ea6a                 SD_DELAY:
   ea6a   21 d0 07              LXI     H,2000
   ea6d                 SDDL:
   ea6d   2b                    DCX     H
   ea6e   7c                    MOV     A,H
   ea6f   b5                    ORA     L
   ea70   c2 6d ea              JNZ     SDDL
   ea73   c9                    RET
                        
                        ; SD_RDLY: ~10 ms recovery delay (65536 iterations).  Used BETWEEN drive-C retry
                        ;   attempts so a card that is still programming a block has time to finish --
                        ;   SD_DELAY (~1.6 ms) is far too short for that.
   ea74                 SD_RDLY:
   ea74   01 00 00              LXI     B,0000H
   ea77                 SRDL1:
   ea77   0b                    DCX     B
   ea78   78                    MOV     A,B
   ea79   b1                    ORA     C
   ea7a   c2 77 ea              JNZ     SRDL1
   ea7d   c9                    RET
                        
   ea7e   40 00 00 00   SDCMD0: DB      40H,00H,00H,00H,00H,95H
   ea82   00 95         
   ea84   48 00 00 01   SDCMD8: DB      48H,00H,00H,01H,0AAH,87H
   ea88   aa 87         
   ea8a   77 00 00 00   SDCMD55: DB     77H,00H,00H,00H,00H,65H
   ea8e   00 65         
   ea90   69 40 00 00   SDACMD: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   ea94   00 77         
                        
                        ; ============================================================================
                        ;   RAM-DISK BLOCK COPY / FILL HELPERS (used by BOOT/WBOOT)
                        ; ============================================================================
                        ; RAMWR: write BC bytes from (DE) to the RAM disk starting at disk byte addr HL.
   ea96                 RAMWR:
   ea96   cd 6c e7              CALL    RAMPTR
   ea99                 RAMWR1:
   ea99   1a                    LDAX    D
   ea9a   d3 20                 OUT     20H
   ea9c   13                    INX     D
   ea9d   0b                    DCX     B
   ea9e   78                    MOV     A,B
   ea9f   b1                    ORA     C
   eaa0   c2 99 ea              JNZ     RAMWR1
   eaa3   c9                    RET
                        
                        ; RAMRD: read BC bytes from the RAM disk at disk byte addr HL into (DE).
   eaa4                 RAMRD:
   eaa4   cd 6c e7              CALL    RAMPTR
   eaa7                 RAMRD1:
   eaa7   db 20                 IN      20H
   eaa9   12                    STAX    D
   eaaa   13                    INX     D
   eaab   0b                    DCX     B
   eaac   78                    MOV     A,B
   eaad   b1                    ORA     C
   eaae   c2 a7 ea              JNZ     RAMRD1
   eab1   c9                    RET
                        
                        ; RAMFILL: fill BC bytes on the RAM disk starting at disk byte addr HL with
                        ; the value in A.
   eab2                 RAMFILL:
   eab2   32 2e ec              STA     FILLV
   eab5   cd 6c e7              CALL    RAMPTR
   eab8                 RAMFILL1:
   eab8   3a 2e ec              LDA     FILLV
   eabb   d3 20                 OUT     20H
   eabd   0b                    DCX     B
   eabe   78                    MOV     A,B
   eabf   b1                    ORA     C
   eac0   c2 b8 ea              JNZ     RAMFILL1
   eac3   c9                    RET
                        
                        ; ============================================================================
                        ;   DRIVE A:  SPI FLASH  (ISSI IS25LD040 as CP/M drive A:)
                        ;
                        ;   Flash layout (MUST match diskutil's 'S' formatter and the drive A: DPB):
                        ;       0x00000-0x01FFF  (8KB, tracks 0-1)   reserved system (erased 0xFF)
                        ;       0x02000-0x7FFFF  (504KB, tracks 2-127) user data area = 252 blocks
                        ;           Block 0  (0x2000-0x27FF) + Block 1 (0x2800-0x2FFF) directory
                        ;                     (2KB each, reserved via AL0=0xC0) = 128 x 32-byte entries
                        ;           Blocks 2..251 (0x3000-0x7FFFF) file data (250 blocks = 500KB)
                        ;
                        ;   Address formula (same as the drive B: RAM-disk CALC, but 24-bit -- the flash is
                        ;   512KB and exceeds 16 bits):  flash_addr = TRK*0x1000 + SECN*0x80
                        ;   (SPT=32, record=128).  The BDOS passes the absolute track (it already added
                        ;   the DPB offset), so OFF is NOT re-added here.
                        ;
                        ;   Erase-before-write is mandatory and the flash only erases at 4KB granularity
                        ;   (sector = 0x20 opcode).  With 2KB CP/M blocks a CP/M block is HALF an erase
                        ;   sector, so two CP/M blocks share one physical 4KB sector.  Writes are still
                        ;   correct: a WRITE does a 4KB read-modify-write (read the whole 4KB sector
                        ;   into RMWBUF, overlay the 128-byte record at its offset, erase the sector,
                        ;   then page-program it back 16 x 256B), which reads back and thus PRESERVES
                        ;   the other CP/M block that shares the sector.  Correctness first; a
                        ;   dirty-sector cache is a later optimization.
                        ; ============================================================================
                        
                        ; ---- shared SPI driver (physical primitives + 24-bit ops) ----
                                INCL    "spi.inc"
                        ; ============================================================================
                        ; spi.inc -- shared 24-bit-capable SPI flash driver for the ISSI IS25LD040.
                        ; Included by BOTH diskutil (ORG 1000H) and cbios (ORG FA00H) so the physical
                        ; SPI protocol cannot drift between the two consumers.  Includes only
                        ; protocol-level primitives (selection, byte transfer, WIP wait, 24-bit
                        ; address send) and the bulk operations drive B: needs (page program, bulk
                        ; read, 4K sector erase).  Higher-level logic (CP/M read-modify-write, the
                        ; format routine) lives in each including program.
                        ;
                        ; Ports (must be defined by the including program BEFORE the INCL):
                        ;   SPI_DATA = 50H   read clocks 1 byte in / write clocks 1 byte out (MSB first)
                        ;   SPI_CTL  = 51H   write bit0 = CS# (0 = select low, 1 = release high)
                        ;   SPI_STAT = 52H   read bit0 = transfer busy (poll OPTIONAL -- the RTL byte
                        ;                               engine stretches the CPU wait on every 0x50
                        ;                               access, so back-to-back 0x50 completes in-cycle)
                        ;
                        ; Convention: the 24-bit flash address for an operation is held in the FBADDR
                        ; 3-byte block declared below.  Byte order is little-endian by FIELD:
                        ;   FBADDR+0 = A7-A0  (low byte)
                        ;   FBADDR+1 = A15-A8 (mid byte)
                        ;   FBADDR+2 = A23-A16(high byte)
                        ; SPI_ADDR transmits them MSB-first (A23-A16, A15-A8, A7-A0), which is the
                        ; order the IS25LD040 command set requires.
                        ;
                        ; Each routine documents which registers it clobbers.  A85 note: this file is
                        ; assembled inline at the INCL point, so FBADDR is allocated at that location
                        ; in each including program's address space (fine -- it is referenced purely
                        ; symbolically).  Do NOT add an ORG or END to this file; a85 splices it.
                        ; ============================================================================
                        
                        ; ---------------- CS# and byte transfer primitives ----------------
                        ; SPI_SEL: pull CS# low (select the flash).  Clobbers A.
   eac4   3e 00         SPI_SEL: MVI     A,00H
   eac6   d3 51                  OUT     SPI_CTL
   eac8   c9                     RET
                        
                        ; SPI_REL: release CS# high (deselect the flash).  Clobbers A.
   eac9   3e 01         SPI_REL: MVI     A,01H
   eacb   d3 51                  OUT     SPI_CTL
   eacd   c9                     RET
                        
                        ; SPI_XMIT: clock the byte in A out to the flash; the byte returned is
                        ; discarded.  A is unchanged (OUT does not modify A).  No other regs touched.
   eace   d3 50         SPI_XMIT: OUT     SPI_DATA
   ead0   c9                     RET
                        
                        ; SPI_WAIT: poll the RDSR (0x05) status until WIP (bit0) clears.  Re-selects
                        ; the flash and keeps CS# low across the status reads.  Clobbers A.
   ead1   cd c4 ea      SPI_WAIT: CALL    SPI_SEL
   ead4   3e 05                  MVI     A,05H
   ead6   cd ce ea               CALL    SPI_XMIT                ; RDSR opcode
   ead9   db 50         SPW:     IN      SPI_DATA                ; read status byte
   eadb   e6 01                  ANI     01H                     ; WIP (bit0) still busy?
   eadd   c2 d9 ea               JNZ     SPW                     ; loop until the flash is idle
   eae0   cd c9 ea               CALL    SPI_REL
   eae3   c9                     RET
                        
                        ; ---------------- 24-bit address send ----------------
                        ; SPI_ADDR: send the three FBADDR bytes as the command address (A23-A16,
                        ; A15-A8, A7-A0, MSB first).  Must be called with CS# already selected.
                        ; Clobbers A.
   eae4   3a 57 eb      SPI_ADDR: LDA     FBADDR+2
   eae7   cd ce ea               CALL    SPI_XMIT                ; A23-A16
   eaea   3a 56 eb               LDA     FBADDR+1
   eaed   cd ce ea               CALL    SPI_XMIT                ; A15-A8
   eaf0   3a 55 eb               LDA     FBADDR
   eaf3   cd ce ea               CALL    SPI_XMIT                ; A7-A0
   eaf6   c9                     RET
                        
                        ; ---------------- page program (0x02) ----------------
                        ; SPI_PAGE: program a full 256-byte page from (HL) at the page-aligned FBADDR.
                        ; FBADDR must be 256-byte aligned (the flash's page program wraps within a
                        ; page if it crosses the boundary).  Issues WREN (0x06, CS# toggled to latch it
                        ; -- REQUIRED before every program/erase on the IS25LD040), then the page-
                        ; program command and 256 data bytes in one CS#-low sequence.  Clobbers A, B,
                        ; HL (HL is advanced 256 bytes / left at HL+256).
   eaf7   cd c4 ea      SPI_PAGE: CALL    SPI_SEL
   eafa   3e 06                  MVI     A,06H                   ; WREN (mandatory before every program)
   eafc   cd ce ea               CALL    SPI_XMIT
   eaff   cd c9 ea               CALL    SPI_REL                 ; latch WREN (CS# must toggle)
   eb02   cd c4 ea               CALL    SPI_SEL
   eb05   3e 02                  MVI     A,02H                   ; Page Program opcode
   eb07   cd ce ea               CALL    SPI_XMIT
   eb0a   cd e4 ea               CALL    SPI_ADDR
   eb0d   06 00                  MVI     B,00H                   ; 256 bytes (0 wraps to 256 on DCR)
   eb0f   7e            SPG1:    MOV     A,M
   eb10   cd ce ea               CALL    SPI_XMIT
   eb13   23                     INX     H
   eb14   05                     DCR     B
   eb15   c2 0f eb               JNZ     SPG1
   eb18   cd c9 ea               CALL    SPI_REL
   eb1b   cd d1 ea               CALL    SPI_WAIT                ; wait for the program to settle
   eb1e   c9                     RET
                        
                        ; ---------------- bulk read (0x03) ----------------
                        ; SPI_READBUF: read BC bytes from FBADDR into (DE), keeping CS# low across the
                        ; whole burst (this is the same pattern the proven diskutil DO_READ uses for
                        ; 16 bytes, extended to an arbitrary count).  Clobbers A, B, C, D, E (BC runs
                        ; down to 0, DE advances past the last byte read).
   eb1f   cd c4 ea      SPI_READBUF: CALL    SPI_SEL
   eb22   3e 03                  MVI     A,03H                   ; Read opcode
   eb24   cd ce ea               CALL    SPI_XMIT
   eb27   cd e4 ea               CALL    SPI_ADDR
   eb2a   db 50         SRDB:    IN      SPI_DATA                ; next byte the flash clocks out
   eb2c   12                     STAX    D
   eb2d   13                     INX     D
   eb2e   0b                     DCX     B
   eb2f   78                     MOV     A,B
   eb30   b1                     ORA     C
   eb31   c2 2a eb               JNZ     SRDB
   eb34   cd c9 ea               CALL    SPI_REL
   eb37   c9                     RET
                        
                        ; ---------------- 4KB sector erase (0x20) ----------------
                        ; SPI_ERASE_SECT: erase the 4KB sector containing FBADDR.  FBADDR must be
                        ; pre-set to the sector base (the low 12 bits clear) so only that one sector
                        ; is erased.  Issues WREN, then the sector-erase command.  Clobbers A.
   eb38   cd c4 ea      SPI_ERASE_SECT: CALL    SPI_SEL
   eb3b   3e 06                  MVI     A,06H                   ; WREN (required before every program)
   eb3d   cd ce ea               CALL    SPI_XMIT
   eb40   cd c9 ea               CALL    SPI_REL                 ; latch WREN
   eb43   cd c4 ea               CALL    SPI_SEL
   eb46   3e 20                  MVI     A,20H                   ; Sector Erase (4KB) opcode
   eb48   cd ce ea               CALL    SPI_XMIT
   eb4b   cd e4 ea               CALL    SPI_ADDR
   eb4e   cd c9 ea               CALL    SPI_REL
   eb51   cd d1 ea               CALL    SPI_WAIT                ; wait for the erase to finish
   eb54   c9                     RET
                        
                        ; ---------------- FBADDR: the 24-bit address block ----------------
   eb55                 FBADDR:  DS      3                       ; A7-A0, A15-A8, A23-A16
                        
                        
                        ; FLADDR: compute FBADDR = TRK*0x1000 + SECN*0x80, the 24-bit flash byte address
                        ; of the selected record, split (validated against 0x7FF80 for TRK=127,SEC=31):
                        ;     byte2 (A23-A16) = TRK >> 4
                        ;     byte1 (A15-A8)  = ((TRK & 0x0F) << 4) | (SECN >> 1)
                        ;     byte0 (A7-A0)   = (SECN & 1) << 7
                        ; (SECN*0x80 < 0x1000 so it never carries into the TRK*0x1000 field.)  Clobbers
                        ; A, B, C, D.
   eb58                 FLADDR:
   eb58   3a 29 ec              LDA     TRK
   eb5b   47                    MOV     B,A             ; B = TRK
   eb5c   3a 2b ec              LDA     SECN
   eb5f   4f                    MOV     C,A             ; C = SECN
                                ; byte2 (A23-A16) = TRK >> 4
   eb60   78                    MOV     A,B
   eb61   e6 f0                 ANI     0F0H
   eb63   0f                    RRC
   eb64   0f                    RRC
   eb65   0f                    RRC
   eb66   0f                    RRC
   eb67   32 57 eb              STA     FBADDR+2
                                ; byte1 (A15-A8) = ((TRK & 0x0F) << 4) | (SECN >> 1)
   eb6a   78                    MOV     A,B
   eb6b   e6 0f                 ANI     0FH
   eb6d   07                    RLC
   eb6e   07                    RLC
   eb6f   07                    RLC
   eb70   07                    RLC
   eb71   57                    MOV     D,A
   eb72   79                    MOV     A,C
   eb73   0f                    RRC
   eb74   e6 7f                 ANI     7FH
   eb76   b2                    ORA     D
   eb77   32 56 eb              STA     FBADDR+1
                                ; byte0 (A7-A0) = (SECN & 1) << 7
   eb7a   79                    MOV     A,C
   eb7b   e6 01                 ANI     01H
   eb7d   ca 85 eb              JZ      FLAD0
   eb80   3e 80                 MVI     A,80H
   eb82   c3 86 eb              JMP     FLADR
   eb85   af            FLAD0:  XRA     A
   eb86   32 55 eb      FLADR:  STA     FBADDR
   eb89   c9                    RET
                        
                        ; READB: read one 128-byte sector from the SPI flash (drive A:) into the DMA
                        ; buffer.  Returns A=0.  (A flash read is error-free.)
   eb8a                 READB:
   eb8a   cd 58 eb              CALL    FLADDR          ; FBADDR = 24-bit record address
   eb8d   2a 2c ec              LHLD    DMA
   eb90   54                    MOV     D,H
   eb91   5d                    MOV     E,L             ; DE = DMA destination
   eb92   01 80 00              LXI     B,80H           ; 128 bytes
   eb95   cd 1f eb              CALL    SPI_READBUF
   eb98   3e 00                 MVI     A,00H           ; success
   eb9a   c9                    RET
                        
                        ; WRITEB: write one 128-byte sector to the SPI flash (drive A:) via a 4KB
                        ; read-modify-write.  Returns A=0.  Clobbers A,B,D,E,H,L.
   eb9b                 WRITEB:
   eb9b   cd 58 eb              CALL    FLADDR          ; FBADDR = 24-bit record address
                                ; ---- save the record's in-sector offset (FBADDR & 0xFFF) ----
   eb9e   3a 55 eb              LDA     FBADDR
   eba1   32 1b ed              STA     RECOFF          ; offset low byte
   eba4   3a 56 eb              LDA     FBADDR+1
   eba7   e6 0f                 ANI     0FH
   eba9   32 1c ed              STA     RECOFF+1        ; offset high nibble (0..0x0F)
                                ; ---- set FBADDR to the enclosing 4KB sector base (clear low 12 bits) ----
   ebac   3a 56 eb              LDA     FBADDR+1
   ebaf   e6 f0                 ANI     0F0H
   ebb1   32 56 eb              STA     FBADDR+1
   ebb4   af                    XRA     A
   ebb5   32 55 eb              STA     FBADDR          ; low byte of the sector base = 0
                                ; ---- read the whole 4KB sector into the RMW buffer ----
   ebb8   11 00 ef              LXI     D,RMWBUF
   ebbb   01 00 10              LXI     B,1000H         ; 4096 bytes
   ebbe   cd 1f eb              CALL    SPI_READBUF
                                ; ---- overlay the 128-byte DMA record at the in-sector offset ----
   ebc1   2a 2c ec              LHLD    DMA
   ebc4   11 00 ef              LXI     D,RMWBUF
   ebc7   3a 1b ed              LDA     RECOFF
   ebca   83                    ADD     E
   ebcb   5f                    MOV     E,A
   ebcc   3a 1c ed              LDA     RECOFF+1
   ebcf   8a                    ADC     D
   ebd0   57                    MOV     D,A             ; DE = RMWBUF + offset
   ebd1   06 80                 MVI     B,128
   ebd3   7e            WRCPY:  MOV     A,M
   ebd4   12                    STAX    D
   ebd5   23                    INX     H
   ebd6   13                    INX     D
   ebd7   05                    DCR     B
   ebd8   c2 d3 eb              JNZ     WRCPY
                                ; ---- erase the 4KB sector (FBADDR = sector base) ----
   ebdb   cd 38 eb              CALL    SPI_ERASE_SECT
                                ; ---- program the whole 4KB sector back, 16 x 256B pages ----
   ebde   21 00 ef              LXI     H,RMWBUF
   ebe1   06 10                 MVI     B,16            ; 16 pages
   ebe3   c5            WRPG:   PUSH    B
   ebe4   cd f7 ea              CALL    SPI_PAGE        ; programs 256 bytes from (HL), advances HL by 256
   ebe7   3a 56 eb              LDA     FBADDR+1
   ebea   c6 01                 ADI     01H
   ebec   32 56 eb              STA     FBADDR+1        ; next page (low byte stays 00, high byte unchanged)
   ebef   c1                    POP     B
   ebf0   05                    DCR     B
   ebf1   c2 e3 eb              JNZ     WRPG
   ebf4   3e 00                 MVI     A,00H           ; success
   ebf6   c9                    RET
                        
                        ; ============================================================================
                        ;   SIGN-ON BANNER
                        ; ============================================================================
   ebf7                 BANNER:
   ebf7   0d 0a                 DB      0DH,0AH                          ; blank line before the banner
   ebf9   43 50 2f 4d           DB      'CP/M 2.2 on Brevia2',0DH,0AH
   ebfd   20 32 2e 32   
   ec01   20 6f 6e 20   
   ec05   42 72 65 76   
   ec09   69 61 32 0d   
   ec0d   0a            
   ec0e   43 50 2f 4d           DB      'CP/M port by Whale-Chan',0DH,0AH,0
   ec12   20 70 6f 72   
   ec16   74 20 62 79   
   ec1a   20 57 68 61   
   ec1e   6c 65 2d 43   
   ec22   68 61 6e 0d   
   ec26   0a 00         
                        
                        ; ============================================================================
                        ;   CBIOS VARIABLES
                        ; ============================================================================
   ec28                 SELBL:  DS      1               ; last selected drive
   ec29                 TRK:    DS      2               ; current (absolute) track -- 16-bit!  CP/M 2 passes
                                                        ; the track as a WORD in BC (DRI manual Table 6-5),
                                                        ; and a DPB with >256 tracks (8 MB at SPT=32 needs
                                                        ; tracks up to 2047) REQUIRES the high byte.  TRK+0 =
                                                        ; low byte (from C), TRK+1 = high byte (from B).
   ec2b                 SECN:   DS      1               ; current sector
   ec2c                 DMA:    DS      2               ; current DMA address
   ec2e                 FILLV:  DS      1               ; scratch for RAMFILL
   ec2f                         DS      4               ; (padding/alignment reserved)
                        
                        ; ============================================================================
                        ;   DISK PARAMETER HEADER (DPH) for drive A (the SPI flash boot drive)
                        ;   Byte layout consumed by the BDOS:
                        ;     +0  XLT  (sector-translate vector address; 0 = none)
                        ;     +2  scratch, +4 scratch, +6 scratch
                        ;     +8  DIRBUF, +10 DPBB, +12 CSVB, +14 ALVB
                        ; ============================================================================
   ec33                 DPH:
   ec33   00 00                 DW      0000H           ; XLT: no sector translation
   ec35   00 00                 DW      0000H           ; scratch (cdrmax)
   ec37   00 00                 DW      0000H           ; scratch (curtrk)
   ec39   00 00                 DW      0000H           ; scratch (currec)
   ec3b   5b ec                 DW      DIRBUF          ; directory buffer (128 bytes)
   ec3d   eb ec                 DW      DPBB            ; disk parameter block (SPI flash 2K geometry)
   ec3f   fa ec                 DW      CSVB            ; checksum vector
   ec41   fb ec                 DW      ALVB            ; allocation vector
                        
                        ; ============================================================================
                        ;   DISK PARAMETER BLOCK (DPB)
                        ;   CP/M 2.2 geometry for the 64K RAM disk (drive B:, volatile scratch):
                        ;     128-byte sectors, SPT=32, 14 user tracks + 2 system tracks = 16 tracks,
                        ;     1K allocation blocks (BSH=3/BLM=7), DSM=55 (56 blocks = 56K user data),
                        ;     DRM=63 (64 directory entries = 2 directory blocks), CKS=0 (fixed media),
                        ;     OFF=2 (reserve tracks 0-1 for the system).
                        ;   IMPORTANT: DSM is stored as a WORD (not a byte).  The BDOS copies this
                        ;   table byte-for-byte into its internal aligned structure, so DSM must be a
                        ;   word for the SECTPT/MAXALL/... fields to line up correctly.
                        ;   AL0/AL1 reserve the directory blocks.  With the MSB-first allocation-map
                        ;   convention the 2 directory blocks at the start of the data area are blocks
                        ;   0 and 1, so AL0=0xC0 / AL1=0x00.  (AL0=0x00/AL1=0xC0 would reserve blocks
                        ;   8-9 and leave the real directory at block 0 unprotected, breaking SAVE.)
                        ; ============================================================================
   ec43                 DPB:
   ec43   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   ec45   03                    DB      03H             ; BSH  = 3    (block shift  -> 1K blocks)
   ec46   07                    DB      07H             ; BLM  = 7    (block mask)
   ec47   00                    DB      00H             ; EXM  = 0
   ec48   37 00                 DW      55              ; DSM  = 55   (max block number = 56 blocks)
   ec4a   3f 00                 DW      63              ; DRM  = 63   (max directory entry = 64 entries)
   ec4c   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1)
   ec4d   00                    DB      00H             ; AL1  = 0x00
   ec4e   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   ec50   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
                        
                        ; ============================================================================
                        ;   CBIOS BUFFERS / VECTORS
                        ; ============================================================================
   ec52                 CSV:    DS      1               ; checksum vector (0 bytes needed since CKS=0)
   ec53                 ALV:    DS      8               ; allocation vector (56 blocks / 8 = 7 -> pad 8)
   ec5b                 DIRBUF: DS      128             ; directory buffer (one 128-byte directory record)
                        
                        ; ============================================================================
                        ;   DRIVE A: (SPI flash) DISK PARAMETER HEADER / BLOCK / VECTORS
                        ;   Geometry: 128-byte sectors, SPT=32, 2KB allocation (BSH=4/BLM=15), OFF=2
                        ;   (tracks 0-1 reserved for the CP/M boot image), directory = blocks 0-1
                        ;   reserved via AL0=0xC0 (128 entries = 4K dir spanning both 2K blocks),
                        ;   DSM=251 (252 blocks), DRM=127 (128 entries), CKS=0 (fixed media).
                        ;   DSM=251 < 256 so the BDOS stays in SINGLE-DM (1-byte FCB map entries) --
                        ;   do NOT raise DSM past 255, which flips the BDOS into double-DM.
                        ;   This MUST agree with diskutil's formatter (data at 0x3000).  The BDOS builds
                        ;   the allocation vector itself on first login, so ALVB just needs the space.
                        ; ============================================================================
   ecdb                 DPHB:
   ecdb   00 00                 DW      0000H           ; XLT: no sector translation
   ecdd   00 00                 DW      0000H           ; scratch (cdrmax)
   ecdf   00 00                 DW      0000H           ; scratch (curtrk)
   ece1   00 00                 DW      0000H           ; scratch (currec)
   ece3   5b ec                 DW      DIRBUF          ; shared directory buffer (128 bytes)
   ece5   43 ec                 DW      DPB             ; disk parameter block (RAM disk 1K geometry)
   ece7   52 ec                 DW      CSV             ; checksum vector
   ece9   53 ec                 DW      ALV             ; allocation vector
   eceb                 DPBB:
   eceb   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   eced   04                    DB      04H             ; BSH  = 4    (block shift -> 2KB blocks)
   ecee   0f                    DB      0FH             ; BLM  = 15   (block mask)
   ecef   01                    DB      01H             ; EXM  = 1    (extent mask, BLS=2048 & DSM<256)
   ecf0   fb 00                 DW      251             ; DSM  = 251  (max block number = 252 blocks)
   ecf2   7f 00                 DW      127             ; DRM  = 127  (max directory entry = 128 entries)
   ecf4   c0                    DB      0C0H            ; AL0  = 0xC0 (reserve directory blocks 0-1, MSB-first)
   ecf5   00                    DB      00H             ; AL1  = 0x00
   ecf6   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   ecf8   02 00                 DW      02H             ; OFF  = 2    (reserve 2 system tracks)
   ecfa                 CSVB:   DS      1               ; checksum vector (0 bytes used since CKS=0)
   ecfb                 ALVB:   DS      32              ; allocation vector (DSM=251 -> (251/8)+1 = 32 bytes)
   ed1b                 RECOFF: DS      2               ; in-sector byte offset for the drive B: RMW
                        
                        ; ============================================================================
                        ;   DRIVE C / D: (SD card) DISK PARAMETER HEADER / BLOCK / VECTORS
                        ;   Geometry: 128-byte sectors, SPT=32, 4KB allocation blocks (BSH=5/BLM=31),
                        ;   DRM=255 (256 dir entries), AL0=0xC0 (reserve dir blocks 0-1 = 8KB),
                        ;   CKS=0, DSM=2047 (DOUBLE-DM -- 2048 blocks x 4KB = 8 MB = the CP/M 2.2
                        ;   16-bit record-counter ceiling), OFF=0 (data partition, no system tracks --
                        ;   the directory is at the partition start, where sdtool formats it).
                        ;   Drive C is 8 MB; drive D (DPHD) still maps here (a future SD partition 2).
                        ;   See cpm/SD-8MB-DRIVE.md.
   ed1d                 DPHC:
   ed1d   00 00                 DW      0000H           ; XLT: no sector translation
   ed1f   00 00                 DW      0000H           ; scratch (cdrmax)
   ed21   00 00                 DW      0000H           ; scratch (curtrk)
   ed23   00 00                 DW      0000H           ; scratch (currec)
   ed25   5b ec                 DW      DIRBUF          ; shared directory buffer (128 bytes)
   ed27   3d ed                 DW      DPBC            ; disk parameter block (SD 8K geometry, OFF=0)
   ed29   5b ed                 DW      CSVC            ; checksum vector (CKS=0 -> 0 bytes)
   ed2b   5c ed                 DW      ALVC            ; allocation vector (drive C)
   ed2d                 DPHD:
   ed2d   00 00                 DW      0000H           ; XLT: no sector translation
   ed2f   00 00                 DW      0000H           ; scratch (cdrmax)
   ed31   00 00                 DW      0000H           ; scratch (curtrk)
   ed33   00 00                 DW      0000H           ; scratch (currec)
   ed35   5b ec                 DW      DIRBUF          ; shared directory buffer (128 bytes)
   ed37   4c ed                 DW      DPBD            ; disk parameter block (SD 8K geometry, OFF=2048)
   ed39   5b ed                 DW      CSVC            ; checksum vector (CKS=0 -> 0 bytes)
   ed3b   dc ed                 DW      ALVD            ; allocation vector (drive D)
   ed3d                 DPBC:
   ed3d   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   ed3f   06                    DB      06H             ; BSH  = 6    (block shift  -> 8KB blocks)
   ed40   3f                    DB      3FH             ; BLM  = 63   (block mask)
   ed41   03                    DB      03H             ; EXM  = 3    (DSM>255 & BLS=8192 -> double-DM (16-bit
                                                        ;              block pointers): entry covers 8x8KB=64KB
                                                        ;              -> EXM = 64KB/16KB - 1 = 3)
   ed42   ff 03                 DW      1023            ; DSM  = 1023 (max block = 1024 blocks x 8KB = 8 MB --
                                                        ;              the CP/M 2.2 16-bit record-counter ceiling)
   ed44   ff 0f                 DW      4095            ; DRM  = 4095 (max directory entry = 4096 entries)
   ed46   ff                    DB      0FFH            ; AL0  = 0xFF (reserve directory blocks 0-7, MSB-first)
   ed47   ff                    DB      0FFH            ; AL1  = 0xFF (reserve directory blocks 8-15 = the max 16
                                                        ;              blocks; 16 x 8KB = 128KB = 4096 entries)
   ed48   00 00                 DW      00H             ; CKS  = 0    (fixed media -> no checksum)
   ed4a   00 00                 DW      00H             ; OFF  = 0    (drive C: partition region 0, no system tracks)
   ed4c                 DPBD:
   ed4c   20 00                 DW      SPT             ; SPT  = 32   (sectors per track)
   ed4e   06                    DB      06H             ; BSH  = 6    (block shift  -> 8KB blocks)
   ed4f   3f                    DB      3FH             ; BLM  = 63   (block mask)
   ed50   03                    DB      03H             ; EXM  = 3    (double-DM, 8KB blocks)
   ed51   ff 03                 DW      1023            ; DSM  = 1023 (1024 blocks x 8KB = 8 MB)
   ed53   ff 0f                 DW      4095            ; DRM  = 4095 (4096 entries)
   ed55   ff                    DB      0FFH            ; AL0  = 0xFF (reserve directory blocks 0-7)
   ed56   ff                    DB      0FFH            ; AL1  = 0xFF (reserve directory blocks 8-15)
   ed57   00 00                 DW      00H             ; CKS  = 0
   ed59   00 00                 DW      00H             ; OFF  = 0    (drive D: partition region 1.  CP/M has
                                                        ;              no partitioning, so the region offset is
                                                        ;              applied at the CBIOS deblock layer (SDMAP
                                                        ;              adds +0x4000 SD sectors for SELBL==3).
   ed5b                 CSVC:   DS      1               ; checksum vector (0 bytes used since CKS=0)
   ed5c                 ALVC:   DS      128             ; allocation vector (drive C: DSM=1023 -> (1023+1)/8 = 128 B)
   eddc                 ALVD:   DS      128             ; allocation vector (drive D: DSM=1023 -> 128 B)
                                                        ;   The BDOS builds these itself on drive login and keeps
                                                        ;   them while the drives are logged in -- they must NOT
                                                        ;   alias a clobbered buffer.  ALVC+ALVD = 256 total, the
                                                        ;   SAME footprint the old single-drive ALV used (it lived
                                                        ;   in the free RAM gap 0xED00-0xEF00, below RMWBUF).
   ee5c                 SDOFF:  DS      2               ; in-sector byte offset for the SD deblock
   ee5e                 BLKN:   DS      4               ; SD block number (32-bit, MSB first); SD block = SDPLBA + record/4
   ee62                 SDCMDB: DS      6               ; SD command buffer (opcode + 4-byte arg + CRC)
   ee68                 SDTRY:  DS      1               ; drive C: retry counter (READC/WRITEC)
                        
   ee69                         END
