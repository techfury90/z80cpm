                        ; SWLED.COM -- Brevia2 switches / LEDs / fabric clock demo for CP/M 2.2
                        ; 8080 assembly, Glitch Works a85. Loads at 0x0100 (CP/M transient).
                        ; Talks to the SoC hardware directly:
                        ;   IN  0x40 -> 8-position DIP switches
                        ;   OUT 0x40 -> 8 LEDs (active-low on the board)
                        ;   OUT 0x41 -> latch the 32-bit uptime clock; IN 0x42..0x45 -> clock bytes
                        ;               (0x42=ms[7:0] .. 0x45=ms[31:24], LSB first)
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
                        ;
                        ; Commands:  S = show switches (and mirror them to the LEDs)
                        ;            L = LED walking pattern (any key to stop)
                        ;            T = show fabric uptime clock (HH style "secs.mmm s")
                        ;            ? = help ; Q = quit
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 36 03              LXI     H,BANNER
   0103   cd 13 02              CALL    PSTR
                        
   0106                 MAINLOOP:
   0106   1e 3e                 MVI     E,'>'
   0108   cd 1b 02              CALL    CPUTC
   010b   cd 21 02              CALL    CIN
                                ; A = command char (echoed by func 1)
                                ; fold lower-case a-z to upper so input is case-insensitive
   010e   fe 61                 CPI     'a'
   0110   da 1a 01              JC      MAIN3
   0113   fe 7b                 CPI     7BH             ; 'z'+1
   0115   d2 1a 01              JNC     MAIN3
   0118   d6 20                 SUI     20H             ; 'a'-'A' -> uppercase
   011a                 MAIN3:
   011a   fe 53                 CPI     'S'
   011c   ca 49 01              JZ      CMD_S
   011f   fe 4c                 CPI     'L'
   0121   ca 78 01              JZ      CMD_L
   0124   fe 54                 CPI     'T'
   0126   ca ae 01              JZ      CMD_T
   0129   fe 3f                 CPI     '?'
   012b   ca 3d 01              JZ      CMD_HELP
   012e   fe 51                 CPI     'Q'
   0130   ca 3c 01              JZ      CMD_QUIT
                                ; unknown
   0133   21 bd 03              LXI     H,MSG_UNK
   0136   cd 13 02              CALL    PSTR
   0139   c3 06 01              JMP     MAINLOOP
                        
   013c                 CMD_QUIT:
   013c   c9                    RET
                        
   013d                 CMD_HELP:
   013d   21 36 03              LXI     H,BANNER
   0140   cd 13 02              CALL    PSTR
   0143   cd 27 02              CALL    CRLF
   0146   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- S: show switches + mirror to LEDs ----------------
   0149                 CMD_S:
   0149   db 40                 IN      LEDSW           ; read switches (active-low: 1=open, 0=pressed)
   014b   32 c6 03              STA     SWVAL           ; stash in memory -- BDOS func9 clobbers B, keep it out of a reg
   014e   d3 40                 OUT     LEDSW           ; mirror switch bank to the LED bank
   0150   21 89 03              LXI     H,MSG_SW
   0153   cd 13 02              CALL    PSTR
   0156   3a c6 03              LDA     SWVAL           ; reload the TRUE switch value
   0159   47                    MOV     B,A
   015a   16 08                 MVI     D,8             ; print 8 bits, MSB first
   015c                 SBL:
   015c   17                    RAL
   015d   da 65 01              JC      SB1
   0160   1e 30                 MVI     E,'0'
   0162   c3 67 01              JMP     SB2
   0165                 SB1:
   0165   1e 31                 MVI     E,'1'
   0167                 SB2:
   0167   d5                    PUSH    D
   0168   f5                    PUSH    PSW             ; preserve A (rotating bit pattern) across the BDOS call
   0169   cd 1b 02              CALL    CPUTC           ; CPUTC clobbers A (func 2 returns 0)
   016c   f1                    POP     PSW
   016d   d1                    POP     D
   016e   15                    DCR     D
   016f   c2 5c 01              JNZ     SBL
   0172   cd 27 02              CALL    CRLF
   0175   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- L: LED walking pattern ----------------
   0178                 CMD_L:
   0178   21 93 03              LXI     H,MSG_LED
   017b   cd 13 02              CALL    PSTR
   017e   3e 01                 MVI     A,01H
   0180   32 c7 03              STA     LEDPAT          ; walking pattern stashed in RAM (BDOS clobbers regs, not memory)
   0183                 LPL:
   0183   3a c7 03              LDA     LEDPAT
   0186   d3 40                 OUT     LEDSW           ; active-high: single bit = one LED
   0188   cd 32 02              CALL    DELAY           ; non-blocking func11 poll; returns A=1 if a key is pending
   018b   b7                    ORA     A
   018c   c2 a1 01              JNZ     LQKEY           ; key ready -> stop
   018f   3a c7 03              LDA     LEDPAT          ; advance the pattern (survives the BDOS call: it's in RAM)
   0192   87                    ADD     A
   0193   32 c7 03              STA     LEDPAT
   0196   c2 83 01              JNZ     LPL
   0199   3e 01                 MVI     A,01H
   019b   32 c7 03              STA     LEDPAT          ; wrapped past 0x80 -> restart at bit0
   019e   c3 83 01              JMP     LPL
   01a1                 LQKEY:
   01a1   cd 21 02              CALL    CIN             ; consume the stop key (func11 buffered it; func1 reads kbchar)
   01a4   3e 00                 MVI     A,00H
   01a6   d3 40                 OUT     LEDSW           ; LEDs off (active-high)
   01a8   cd 27 02              CALL    CRLF
   01ab   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- T: fabric uptime clock ----------------
   01ae                 CMD_T:
   01ae   d3 41                 OUT     CLKL            ; latch the counter
   01b0   db 42                 IN      CLK0
   01b2   6f                    MOV     L,A
   01b3   db 43                 IN      CLK1
   01b5   67                    MOV     H,A
   01b6   db 44                 IN      CLK2
   01b8   5f                    MOV     E,A
   01b9   db 45                 IN      CLK3
   01bb   57                    MOV     D,A             ; DE:HL = ms (32-bit)
   01bc   01 e8 03              LXI     B,1000
   01bf   cd 50 02              CALL    DIV32           ; DE:HL = secs, RMDR = msec remainder
                                ; save msec remainder
   01c2   3a c1 03              LDA     RMDR
   01c5   32 ca 03              STA     MSW
   01c8   3a c2 03              LDA     RMDR+1
   01cb   32 cb 03              STA     MSW+1
                                ; save secs (DE:HL) into SECW (32-bit)
   01ce   7d                    MOV     A,L
   01cf   32 cc 03              STA     SECW
   01d2   7c                    MOV     A,H
   01d3   32 cd 03              STA     SECW+1
   01d6   7b                    MOV     A,E
   01d7   32 ce 03              STA     SECW+2
   01da   7a                    MOV     A,D
   01db   32 cf 03              STA     SECW+3
   01de   21 b0 03              LXI     H,MSG_UPT
   01e1   cd 13 02              CALL    PSTR
                                ; reload secs into DE:HL and print as decimal
   01e4   3a cc 03              LDA     SECW
   01e7   6f                    MOV     L,A
   01e8   3a cd 03              LDA     SECW+1
   01eb   67                    MOV     H,A
   01ec   3a ce 03              LDA     SECW+2
   01ef   5f                    MOV     E,A
   01f0   3a cf 03              LDA     SECW+3
   01f3   57                    MOV     D,A
   01f4   cd bc 02              CALL    PRDEC32
   01f7   1e 2e                 MVI     E,'.'
   01f9   cd 1b 02              CALL    CPUTC
                                ; print msec remainder, 3 zero-padded digits
   01fc   3a ca 03              LDA     MSW
   01ff   6f                    MOV     L,A
   0200   3a cb 03              LDA     MSW+1
   0203   67                    MOV     H,A
   0204   cd 02 03              CALL    PR3
   0207   21 ba 03              LXI     H,MSG_S
   020a   cd 13 02              CALL    PSTR
   020d   cd 27 02              CALL    CRLF
   0210   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- low-level routines ----------------
   0213                 PSTR:
   0213   54                    MOV     D,H
   0214   5d                    MOV     E,L
   0215   0e 09                 MVI     C,9
   0217   cd 05 00              CALL    5
   021a   c9                    RET
                        
   021b                 CPUTC:
   021b   0e 02                 MVI     C,2
   021d   cd 05 00              CALL    5
   0220   c9                    RET
                        
   0221                 CIN:
   0221   0e 01                 MVI     C,1
   0223   cd 05 00              CALL    5
   0226   c9                    RET
                        
   0227                 CRLF:
   0227   1e 0d                 MVI     E,13
   0229   cd 1b 02              CALL    CPUTC
   022c   1e 0a                 MVI     E,10
   022e   cd 1b 02              CALL    CPUTC
   0231   c9                    RET
                        
                        ; DELAY -- burn ~200ms while polling the console for a key.
                        ;  Returns A=0 if no key (timeout), A=key if one arrived.
   0232                 DELAY:
   0232   21 b8 0b              LXI     H,3000
   0235   22 c8 03              SHLD    DELCNT          ; loop counter in RAM (func11 clobbers H/L on the CALL 5)
   0238                 DL1:
   0238   0e 0b                 MVI     C,11            ; func 11: console status -- non-blocking
   023a   cd 05 00              CALL    5
   023d   b7                    ORA     A
   023e   c2 4f 02              JNZ     DLYKEY          ; 1 = key pending -> report it
   0241   2a c8 03              LHLD    DELCNT          ; reload counter (survives the BDOS call: it's in RAM)
   0244   2b                    DCX     H
   0245   22 c8 03              SHLD    DELCNT
   0248   7c                    MOV     A,H
   0249   b5                    ORA     L
   024a   c2 38 02              JNZ     DL1
   024d   3e 00                 MVI     A,0
   024f                 DLYKEY:
   024f   c9                    RET
                        
                        ; DIV32 -- unsigned 32/16 restore division.
                        ;   in : DE:HL = 32-bit dividend ; BC = 16-bit divisor
                        ;   out: DE:HL = 32-bit quotient ; RMDR = 16-bit remainder
                        ;   Uses memory RMDR/MSBF/CNT.
   0250                 DIV32:
   0250   af                    XRA     A
   0251   32 c1 03              STA     RMDR
   0254   32 c2 03              STA     RMDR+1
   0257   32 c3 03              STA     MSBF
   025a   3e 20                 MVI     A,32
   025c   32 c4 03              STA     CNT
   025f                 D32L:
                                ; shift DE:HL left 1; MSB -> CY
   025f   7d                    MOV     A,L
   0260   87                    ADD     A
   0261   6f                    MOV     L,A
   0262   7c                    MOV     A,H
   0263   17                    RAL
   0264   67                    MOV     H,A
   0265   7b                    MOV     A,E
   0266   17                    RAL
   0267   5f                    MOV     E,A
   0268   7a                    MOV     A,D
   0269   17                    RAL
   026a   57                    MOV     D,A
   026b   3e 00                 MVI     A,0
   026d   17                    RAL                     ; A = captured MSB (0 or 1)
   026e   32 c3 03              STA     MSBF
                                ; RMDR = (RMDR << 1) | MSBF
   0271   3a c1 03              LDA     RMDR
   0274   87                    ADD     A
   0275   32 c1 03              STA     RMDR
   0278   3a c2 03              LDA     RMDR+1
   027b   17                    RAL
   027c   32 c2 03              STA     RMDR+1
   027f   3a c3 03              LDA     MSBF
   0282   b7                    ORA     A
   0283   ca 8e 02              JZ      D32NOMS
   0286   3a c1 03              LDA     RMDR
   0289   f6 01                 ORI     1
   028b   32 c1 03              STA     RMDR
   028e                 D32NOMS:
                                ; if RMDR >= (BC) then RMDR -= BC, set quotient bit0
   028e   3a c2 03              LDA     RMDR+1
   0291   b8                    CMP     B
   0292   da b1 02              JC      D32SKIP
   0295   c2 9f 02              JNZ     D32SUB
   0298   3a c1 03              LDA     RMDR
   029b   b9                    CMP     C
   029c   da b1 02              JC      D32SKIP
   029f                 D32SUB:
   029f   3a c1 03              LDA     RMDR
   02a2   91                    SUB     C
   02a3   32 c1 03              STA     RMDR
   02a6   3a c2 03              LDA     RMDR+1
   02a9   98                    SBB     B
   02aa   32 c2 03              STA     RMDR+1
   02ad   7d                    MOV     A,L
   02ae   f6 01                 ORI     1
   02b0   6f                    MOV     L,A
   02b1                 D32SKIP:
   02b1   3a c4 03              LDA     CNT
   02b4   3d                    DCR     A
   02b5   32 c4 03              STA     CNT
   02b8   c2 5f 02              JNZ     D32L
   02bb   c9                    RET
                        
                        ; PRDEC32 -- print the 32-bit value in DE:HL as unsigned decimal (no padding).
   02bc                 PRDEC32:
   02bc   7a                    MOV     A,D
   02bd   b3                    ORA     E
   02be   b4                    ORA     H
   02bf   b5                    ORA     L
   02c0   c2 c9 02              JNZ     PRDECL
   02c3   1e 30                 MVI     E,'0'
   02c5   cd 1b 02              CALL    CPUTC
   02c8   c9                    RET
   02c9                 PRDECL:
   02c9   3e 00                 MVI     A,0
   02cb   32 c5 03              STA     DIGCNT
   02ce                 PRDEC_GO:
   02ce   7a                    MOV     A,D
   02cf   b3                    ORA     E
   02d0   b4                    ORA     H
   02d1   b5                    ORA     L
   02d2   ca eb 02              JZ      PRDEC_PRT
                                ; divide DE:HL by 10
   02d5   01 0a 00              LXI     B,10
   02d8   cd 50 02              CALL    DIV32
   02db   3a c1 03              LDA     RMDR
   02de   c6 30                 ADI     '0'
   02e0   f5                    PUSH    PSW
   02e1   3a c5 03              LDA     DIGCNT
   02e4   3c                    INR     A
   02e5   32 c5 03              STA     DIGCNT
   02e8   c3 ce 02              JMP     PRDEC_GO
   02eb                 PRDEC_PRT:
   02eb   3a c5 03              LDA     DIGCNT
   02ee   b7                    ORA     A
   02ef   ca 01 03              JZ      PRDEC_DONE
   02f2   f1                    POP     PSW
   02f3   5f                    MOV     E,A
   02f4   cd 1b 02              CALL    CPUTC
   02f7   3a c5 03              LDA     DIGCNT
   02fa   3d                    DCR     A
   02fb   32 c5 03              STA     DIGCNT
   02fe   c3 eb 02              JMP     PRDEC_PRT
   0301                 PRDEC_DONE:
   0301   c9                    RET
                        
                        ; PR3 -- print the 16-bit value in HL (0..999) as exactly 3 zero-padded digits.
   0302                 PR3:
   0302   3e 03                 MVI     A,3
   0304   32 c5 03              STA     DIGCNT
   0307                 PR3_DIV:
   0307   16 00                 MVI     D,0
   0309   1e 00                 MVI     E,0
   030b   01 0a 00              LXI     B,10
   030e   cd 50 02              CALL    DIV32
   0311   3a c1 03              LDA     RMDR
   0314   c6 30                 ADI     '0'
   0316   f5                    PUSH    PSW
   0317   3a c5 03              LDA     DIGCNT
   031a   3d                    DCR     A
   031b   32 c5 03              STA     DIGCNT
   031e   c2 07 03              JNZ     PR3_DIV
   0321   3e 03                 MVI     A,3
   0323   32 c5 03              STA     DIGCNT
   0326                 PR3_PRT:
   0326   f1                    POP     PSW
   0327   5f                    MOV     E,A
   0328   cd 1b 02              CALL    CPUTC
   032b   3a c5 03              LDA     DIGCNT
   032e   3d                    DCR     A
   032f   32 c5 03              STA     DIGCNT
   0332   c2 26 03              JNZ     PR3_PRT
   0335   c9                    RET
                        
                        ; ---------------- data ----------------
   0040                 LEDSW   EQU     40H
   0041                 CLKL    EQU     41H
   0042                 CLK0    EQU     42H
   0043                 CLK1    EQU     43H
   0044                 CLK2    EQU     44H
   0045                 CLK3    EQU     45H
                        
   0336                 BANNER:
   0336   53 57 4c 45           DB      'SWLED v1.0 - Brevia2 switches/LEDs/clock',13,10,'S=switches L=led T=clock ?=help Q=quit',13,10,'$'
   033a   44 20 76 31   
   033e   2e 30 20 2d   
   0342   20 42 72 65   
   0346   76 69 61 32   
   034a   20 73 77 69   
   034e   74 63 68 65   
   0352   73 2f 4c 45   
   0356   44 73 2f 63   
   035a   6c 6f 63 6b   
   035e   0d 0a 53 3d   
   0362   73 77 69 74   
   0366   63 68 65 73   
   036a   20 4c 3d 6c   
   036e   65 64 20 54   
   0372   3d 63 6c 6f   
   0376   63 6b 20 3f   
   037a   3d 68 65 6c   
   037e   70 20 51 3d   
   0382   71 75 69 74   
   0386   0d 0a 24      
   0389   53 57 49 54   MSG_SW: DB      'SWITCHES=','$'
   038d   43 48 45 53   
   0391   3d 24         
   0393   4c 45 44 20   MSG_LED: DB     'LED test - any key to stop',13,10,'$'
   0397   74 65 73 74   
   039b   20 2d 20 61   
   039f   6e 79 20 6b   
   03a3   65 79 20 74   
   03a7   6f 20 73 74   
   03ab   6f 70 0d 0a   
   03af   24            
   03b0   0d 0a 55 50   MSG_UPT: DB     13,10,'UPTIME ','$'
   03b4   54 49 4d 45   
   03b8   20 24         
   03ba   20 73 24      MSG_S:  DB      ' s','$'
   03bd   0d 0a 3f 24   MSG_UNK: DB     13,10,'?','$'
                        
   03c1                 RMDR:   DS      2
   03c3                 MSBF:   DS      1
   03c4                 CNT:    DS      1
   03c5                 DIGCNT: DS      1
   03c6                 SWVAL:  DS      1
   03c7                 LEDPAT: DS      1
   03c8                 DELCNT: DS      2
   03ca                 MSW:    DS      2
   03cc                 SECW:   DS      4
   03d0                         END
0336  BANNER        0221  CIN           0042  CLK0          0043  CLK1      
0044  CLK2          0045  CLK3          0041  CLKL          013d  CMD_HELP  
0178  CMD_L         013c  CMD_QUIT      0149  CMD_S         01ae  CMD_T     
03c4  CNT           021b  CPUTC         0227  CRLF          025f  D32L      
028e  D32NOMS       02b1  D32SKIP       029f  D32SUB        0232  DELAY     
03c8  DELCNT        03c5  DIGCNT        0250  DIV32         0238  DL1       
024f  DLYKEY        03c7  LEDPAT        0040  LEDSW         0183  LPL       
01a1  LQKEY         011a  MAIN3         0106  MAINLOOP      03c3  MSBF      
0393  MSG_LED       03ba  MSG_S         0389  MSG_SW        03bd  MSG_UNK   
03b0  MSG_UPT       03ca  MSW           0302  PR3           0307  PR3_DIV   
0326  PR3_PRT       02bc  PRDEC32       02c9  PRDECL        0301  PRDEC_DONE
02ce  PRDEC_GO      02eb  PRDEC_PRT     0213  PSTR          03c1  RMDR      
0165  SB1           0167  SB2           015c  SBL           03cc  SECW      
0100  START         03c6  SWVAL         
