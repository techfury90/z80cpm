                        ; ============================================================================
                        ; diskutil.s -- standalone RAM-disk maintenance utility for the Brevia2 Z80.
                        ;
                        ; Runs entirely OUTSIDE of CP/M. Loaded via GWMON-80 'L', run via 'G 1000'.
                        ; Uses the console UART (0x80 status / 0x81 data) for BOTH the menu and the
                        ; XMODEM file transfer, and the RAM-disk controller (0x20 DATA auto-inc,
                        ; 0x21 ADDR lo, 0x22 ADDR hi) for the CP/M disk layout in bank B.
                        ;
                        ; Commands:
                        ;   F  -- format drive A: (write 0xE5 to the 2K directory area)
                        ;   U  -- XMODEM upload (checksum mode): receive a file from the host PC and
                        ;         write it to the RAM disk as a CP/M file (multi-extent for >16K).
                        ;   D  -- XMODEM download: send a file from the RAM disk to the host PC.
                        ;   H  -- help
                        ;
                        ; XMODEM receive retries the initiating NAK with a ~1.5s timeout each cycle,
                        ; so the host (Tera Term / minicom) picks it up even if it starts the transfer
                        ; AFTER we began waiting. Supports checksum blocks (SOH) and CRC blocks (STX).
                        ;
                        ; Assembled with the Glitch Works a85 8085 cross-assembler (same as cbios.asm).
                        ; ============================================================================
                        
   1000                         ORG     1000H
                        
                        ; ---------------- Processor I/O ports ----------------
   0080                 USTAT   EQU     80H                     ; UART status (bit0 tx_busy, bit1 rx_avail)
   0081                 UDATA   EQU     81H                     ; UART data (read=RX char, write=TX char)
   0020                 RDDATA  EQU     20H                     ; RAM disk DATA (read/write, auto-increment)
   0021                 RDADRL  EQU     21H                     ; RAM disk ADDR low
   0022                 RDADRH  EQU     22H                     ; RAM disk ADDR high
                        
                        ; ---------------- CP/M drive A: disk layout (bank B) ----------------
   2000                 DIRBASE EQU     2000H                   ; directory area base (2K = 64 entries)
   2800                 DBLOCK0 EQU     2800H                   ; first USER data block (block 2) base
   0400                 BLKSZ   EQU     1024                    ; block size (1K)
   0080                 RECSZ   EQU     128                     ; CP/M record size
                        
                        ; ---------------- XMODEM control bytes ----------------
   0001                 XM_SOH  EQU     01H
   0002                 XM_STX  EQU     02H
   0004                 XM_EOT  EQU     04H
   0006                 XM_ACK  EQU     06H
   0015                 XM_NAK  EQU     15H
   0018                 XM_CAN  EQU     18H
   00fe                 XM_TO   EQU     0FEH                    ; internal: RX timeout marker
                        
                        ; ---------------- Workspace (bank A SRAM, well below the CCP at 0xE400) ----------------
   2000                 XMBUF   EQU     2000H                   ; 128-byte XMODEM block buffer
   2100                 FCB     EQU     2100H                   ; 32-byte FCB (extent 0) in RAM
   2120                 FCB2    EQU     2120H                   ; 32-byte FCB (extent 1) in RAM
   2160                 RCNT_L  EQU     2160H                   ; total records received (16-bit, L then H)
   2180                 FNAME   EQU     2180H                   ; 12-byte user filename buffer (8.3)
                        
                        ; ============================================================================
   1000   c3 07 11              JMP     START
                        
                        ; ---------------- UART primitives ----------------
                        ; TXCHAR: output char in A; poll tx_busy(bit0) low.
   1003   f5            TXCHAR: PUSH    PSW
   1004   db 80         TXCH1:  IN      USTAT
   1006   e6 01                 ANI     01H
   1008   c2 04 10              JNZ     TXCH1
   100b   f1                    POP     PSW
   100c   d3 81                 OUT     UDATA
   100e   c9                    RET
                        
                        ; RXCHAR: block until a char, return it in A.
   100f   db 80         RXCHAR: IN      USTAT
   1011   e6 02                 ANI     02H
   1013   ca 0f 10              JZ      RXCHAR
   1016   db 81                 IN      UDATA
   1018   c9                    RET
                        
                        ; RXCHAR_T: receive a char with a ~1.5s timeout.
                        ;   Returns: carry CLEAR + A=char if a char arrived; carry SET if timeout.
   1019                 RXCHAR_T:
   1019   06 b0                 MVI     B,0B0H                  ; outer count
   101b   0e b0         RT_L2:  MVI     C,0B0H                  ; mid count
   101d   16 b0         RT_L1:  MVI     D,0B0H                  ; inner count
   101f   db 80         RT_L0:  IN      USTAT
   1021   e6 02                 ANI     02H
   1023   c2 34 10              JNZ     RT_HAVE
   1026   15                    DCR     D
   1027   c2 1f 10              JNZ     RT_L0
   102a   0d                    DCR     C
   102b   c2 1d 10              JNZ     RT_L1
   102e   05                    DCR     B
   102f   c2 1b 10              JNZ     RT_L2
   1032   37                    STC                             ; timeout
   1033   c9                    RET
   1034                 RT_HAVE:
   1034   db 81                 IN      UDATA                   ; char
   1036   37                    STC
   1037   3f                    CMC                             ; carry clear (char read)
   1038   c9                    RET
                        
                        ; CRLF: send CR + LF.
   1039   3e 0d         CRLF:   MVI     A,0DH
   103b   cd 03 10              CALL    TXCHAR
   103e   3e 0a                 MVI     A,0AH
   1040   cd 03 10              CALL    TXCHAR
   1043   c9                    RET
                        
                        ; PRTSTR: print NUL-terminated string at HL.
   1044   7e            PRTSTR: MOV     A,M
   1045   b7                    ORA     A
   1046   c8                    RZ
   1047   cd 03 10              CALL    TXCHAR
   104a   23                    INX     H
   104b   c3 44 10              JMP     PRTSTR
                        
                        ; PRTBYTE: print A as two hex digits.
   104e   f5            PRTBYTE: PUSH    PSW
   104f   e6 f0                 ANI     0F0H
   1051   0f                    RRC
   1052   0f                    RRC
   1053   0f                    RRC
   1054   0f                    RRC
   1055   cd 5b 10              CALL    PRTH1
   1058   f1                    POP     PSW
   1059   e6 0f                 ANI     0FH
   105b   c6 90         PRTH1:  ADI     90H
   105d   27                    DAA
   105e   ce 40                 ACI     40H                     ; add carry (ACI) so 0xA-0xF print A-F
   1060   27                    DAA
   1061   c3 03 10              JMP     TXCHAR
                        
                        ; ---------------- RAM-disk primitives (bank B) ----------------
   1064   7d            RDSETA: MOV     A,L
   1065   d3 21                 OUT     RDADRL
   1067   7c                    MOV     A,H
   1068   d3 22                 OUT     RDADRH
   106a   c9                    RET
                        
                        ; ============================================================================
                        ; FINDFREE -- scan the directory (64 slots) for a run of `FNEED` consecutive
                        ;   EMPTY (0xE5) slots. Set FNEED=1 for a single-extent file, FNEED=2 for a
                        ;   two-extent file (extents 0 and 1 occupy two ADJACENT slots).
                        ;   Returns: A = slot index of the run start, carry CLEAR if found; carry SET
                        ;            if the directory has no such run (full).
                        ; ============================================================================
   106b                 FINDFREE:
   106b   06 40                 MVI     B,64            ; slots to examine
   106d   0e 00                 MVI     C,00H           ; candidate run-start index
   106f                 FF_LOOP:
   106f   3a 2f 15              LDA     FNEED
   1072   57                    MOV     D,A             ; D = number of consecutive empties still needed
   1073   59                    MOV     E,C             ; E = running slot index
                                ; remaining slots must be >= FNEED
   1074   78                    MOV     A,B
   1075   ba                    CMP     D
   1076   da 9f 10              JC      FF_FULL         ; not enough slots left for a full run
   1079                 FF_RUN:
                                ; check slot E is empty
   1079   7b                    MOV     A,E
   107a   6f                    MOV     L,A
   107b   26 00                 MVI     H,00H
   107d   3e 05                 MVI     A,05H
   107f   29            FF_SHL: DAD     H
   1080   3d                    DCR     A
   1081   c2 7f 10              JNZ     FF_SHL          ; HL = E*32
   1084   11 00 20              LXI     D,DIRBASE
   1087   19                    DAD     D               ; HL = DIRBASE + E*32
   1088   cd 64 10              CALL    RDSETA
   108b   db 20                 IN      RDDATA          ; byte 0 (0xE5 = empty)
   108d   fe e5                 CPI     0E5H
   108f   c2 9a 10              JNZ     FF_ADV          ; slot E occupied -> try next run start
   1092   1c                    INR     E
   1093   15                    DCR     D
   1094   c2 79 10              JNZ     FF_RUN          ; continue the run
                                ; found a run of FNEED consecutive empties starting at C
   1097   79                    MOV     A,C
   1098   b7                    ORA     A               ; clear carry
   1099   c9                    RET
   109a                 FF_ADV:
   109a   0c                    INR     C               ; advance run start
   109b   05                    DCR     B
   109c   c2 6f 10              JNZ     FF_LOOP
   109f                 FF_FULL:
   109f   37                    STC
   10a0   c9                    RET
                        
                        ; ============================================================================
                        ; NEXTBLK -- find the first FREE data block for a new file, scanning every
                        ;   non-empty directory entry's allocation map for the highest block in use.
                        ;   Returns: A = next free block number, carry CLEAR if one exists;
                        ;            carry SET if the data area is full.
                        ;   Data blocks run from 2 (block N at 0x2000 + N*1024); DSM=55 (blocks 2-55).
                        ; ============================================================================
   10a1                 NEXTBLK:
   10a1   3e 01                 MVI     A,01H           ; start "highest used" just below block 2
   10a3   32 30 15              STA     NBMAX
   10a6   21 00 20              LXI     H,DIRBASE       ; scan base
   10a9   06 40                 MVI     B,64            ; 64 slots
   10ab   0e 00                 MVI     C,00H           ; slot index
   10ad                 NB_LOOP:
   10ad   79                    MOV     A,C
   10ae   6f                    MOV     L,A
   10af   26 00                 MVI     H,00H
   10b1   16 05                 MVI     D,05H
   10b3   29            NB_SHL: DAD     H
   10b4   15                    DCR     D
   10b5   c2 b3 10              JNZ     NB_SHL          ; HL = slot*32
   10b8   11 00 20              LXI     D,DIRBASE
   10bb   19                    DAD     D
   10bc   cd 64 10              CALL    RDSETA
   10bf   db 20                 IN      RDDATA          ; byte 0 = user number
   10c1   fe e5                 CPI     0E5H
   10c3   ca f4 10              JZ      NB_NEXT         ; empty slot -> no blocks to scan
                                ; non-empty: read its 16 allocation bytes and track the max block
   10c6   21 00 20              LXI     H,DIRBASE
   10c9   19                    DAD     D               ; HL = DIRBASE (already have D=DIRBASE from DAD)
   10ca   79                    MOV     A,C
   10cb   6f                    MOV     L,A
   10cc   26 00                 MVI     H,00H
   10ce   16 05                 MVI     D,05H
   10d0   29            NB_SHL2: DAD     H
   10d1   15                    DCR     D
   10d2   c2 d0 10              JNZ     NB_SHL2
   10d5   11 10 20              LXI     D,DIRBASE+16    ; +16 -> start of allocation map
   10d8   19                    DAD     D
   10d9   cd 64 10              CALL    RDSETA
   10dc   16 10                 MVI     D,16            ; read 16 allocation bytes
   10de   db 20         NB_MAP: IN      RDDATA
   10e0   b7                    ORA     A
   10e1   ca f0 10              JZ      NB_MAPC         ; block 0 = unallocated (means no block) -> skip
   10e4   5f                    MOV     E,A             ; E = this block number
   10e5   3a 30 15              LDA     NBMAX
   10e8   bb                    CMP     E
   10e9   d2 f0 10              JNC     NB_MAPC         ; NBMAX >= this -> no change
   10ec   7b                    MOV     A,E
   10ed   32 30 15              STA     NBMAX           ; NBMAX = this block
   10f0   15            NB_MAPC: DCR     D
   10f1   c2 de 10              JNZ     NB_MAP
   10f4                 NB_NEXT:
   10f4   0c                    INR     C
   10f5   05                    DCR     B
   10f6   c2 ad 10              JNZ     NB_LOOP
                                ; next free block = NBMAX + 1
   10f9   3a 30 15              LDA     NBMAX
   10fc   c6 01                 ADI     01H
   10fe   fe 38                 CPI     56              ; block 56 would be past DSM=55
   1100   d2 05 11              JNC     NB_FULL
   1103   b7                    ORA     A               ; clear carry (block number in A, < 56)
   1104   c9                    RET
   1105                 NB_FULL:
   1105   37                    STC
   1106   c9                    RET
                        
                        ; ============================================================================
                        ; START
                        ; ============================================================================
   1107   31 00 e0      START:  LXI     SP,0E000H               ; stack in the TPA, BELOW the BDOS/CCP (0xE400+)
                                                                ; 0xF000 sat INSIDE the BDOS (0xEC00-0xFFFF), so
                                                                ;  diskutil's CALL/PUSH frames clobbered CP/M's
                                                                ;  in-RAM image; cold boot then ran the corrupted
                                                                ;  code. The CBIOS itself uses 0xDC00 for the same
                                                                ;  reason. TPA is 0x0100-0xE3FF; 0xE000 grows down
                                                                ;  into free space clear of code/buffers (0x1000+).
   110a   21 c7 15              LXI     H,MSGBANNER
   110d   cd 44 10              CALL    PRTSTR
   1110   21 e6 15      MENU:   LXI     H,MSGMENU
   1113   cd 44 10              CALL    PRTSTR
   1116   cd 0f 10              CALL    RXCHAR                  ; wait for a command char
   1119   e6 df                 ANI     0DFH                    ; force uppercase (accept lowercase)
   111b   fe 46                 CPI     'F'
   111d   ca 3c 11              JZ      DO_FMT
   1120   fe 55                 CPI     'U'
   1122   ca 68 11              JZ      DO_UPLOAD
   1125   fe 44                 CPI     'D'
   1127   ca 98 14              JZ      DO_DOWNLOAD
   112a   fe 48                 CPI     'H'
   112c   ca 5f 11              JZ      DO_HELP
   112f   fe 42                 CPI     'B'
   1131   ca 32 15              JZ      DO_DUMP
   1134   fe 4d                 CPI     'M'
   1136   ca 5a 15              JZ      DO_MDUMP
   1139   c3 10 11              JMP     MENU
                        
                        ; ---------------- command: format ----------------
   113c   21 40 16      DO_FMT: LXI     H,MSGFMT
   113f   cd 44 10              CALL    PRTSTR
   1142   21 00 00              LXI     H,0000H                 ; start at byte 0 of the RAM disk
   1145   cd 64 10              CALL    RDSETA
   1148   01 00 00              LXI     B,65536                 ; erase the ENTIRE 64K bank-B RAM disk
   114b   16 e5                 MVI     D,0E5H                  ; keep the fill value in D (A is clobbered below)
   114d   7a            FMTW:   MOV     A,D
   114e   d3 20                 OUT     RDDATA                  ; write 0xE5 (auto-increment)
   1150   0b                    DCX     B
   1151   78                    MOV     A,B
   1152   b1                    ORA     C
   1153   c2 4d 11              JNZ     FMTW
   1156   21 50 16              LXI     H,MSGFMTOK
   1159   cd 44 10              CALL    PRTSTR
   115c   c3 10 11              JMP     MENU
                        
   115f   21 09 16      DO_HELP: LXI     H,MSGHELP
   1162   cd 44 10              CALL    PRTSTR
   1165   c3 10 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_UPLOAD -- XMODEM (checksum/CRC) receive a file, write it as a CP/M file.
                        ; ============================================================================
   1168                 DO_UPLOAD:
   1168   21 5d 16              LXI     H,MSGPROMPT
   116b   cd 44 10              CALL    PRTSTR
   116e   cd de 13              CALL    READNAME                ; read "name.ext" into FNAME (echoed)
                                ; ---- allocate the first free data block NOW so WRITEBLK (during the
                                ;      receive, before the FCB is written) appends after existing
                                ;      files instead of overwriting block 2. The directory slot is
                                ;      allocated later in WRITEFCB, after the extent count is known.
   1171   cd a1 10              CALL    NEXTBLK                 ; A = first free data block (carry set = full)
   1174   da ba 11              JC      UP_NOSPC
   1177   32 31 15              STA     BLKNO
   117a   21 00 00              LXI     H,0000H
   117d   22 60 21              SHLD    RCNT_L                  ; init record counter
   1180   21 76 16              LXI     H,MSGRECV
   1183   cd 44 10              CALL    PRTSTR
   1186   3e 15                 MVI     A,XM_NAK                ; kick off with a checksum NAK
   1188   cd 03 10              CALL    TXCHAR
                        
   118b   cd e5 11      UPLOOP: CALL    GETBLK                  ; A=TO(timeout),01 good,FF bad,00 EOT,02 CAN
   118e   fe fe                 CPI     XM_TO
   1190   ca b2 11              JZ      UP_NAK                  ; timeout -> resend NAK, keep waiting
   1193   fe 02                 CPI     02H
   1195   ca b2 11              JZ      UP_NAK                  ; CAN
   1198   fe 00                 CPI     00H
   119a   ca c3 11              JZ      UP_EOT
   119d   fe ff                 CPI     0FFH
   119f   ca b2 11              JZ      UP_NAK                  ; bad block -> NAK
                                ; good block -> write it to the disk
   11a2   cd a9 12              CALL    WRITEBLK
   11a5   3e 06                 MVI     A,XM_ACK
   11a7   cd 03 10              CALL    TXCHAR
   11aa   3e 2e                 MVI     A,'.'
   11ac   cd 03 10              CALL    TXCHAR
   11af   c3 8b 11              JMP     UPLOOP
   11b2   3e 15         UP_NAK: MVI     A,XM_NAK
   11b4   cd 03 10              CALL    TXCHAR
   11b7   c3 8b 11              JMP     UPLOOP
                        ; disk full (no free data block or no free directory slot) -> report and bail
   11ba                 UP_NOSPC:
   11ba   21 15 17              LXI     H,MSGNOSPC
   11bd   cd 44 10              CALL    PRTSTR
   11c0   c3 10 11              JMP     MENU
                        
   11c3   3e 06         UP_EOT: MVI     A,XM_ACK
   11c5   cd 03 10              CALL    TXCHAR
   11c8   cd 39 10              CALL    CRLF
   11cb   cd e6 12              CALL    WRITEFCB                ; write directory entries
   11ce   21 8e 16              LXI     H,MSGDONE
   11d1   cd 44 10              CALL    PRTSTR
   11d4   2a 60 21              LHLD    RCNT_L
   11d7   7c                    MOV     A,H
   11d8   cd 4e 10              CALL    PRTBYTE
   11db   7d                    MOV     A,L
   11dc   cd 4e 10              CALL    PRTBYTE
   11df   cd 39 10              CALL    CRLF
   11e2   c3 10 11              JMP     MENU
                        
                        ; ============================================================================
                        ; GETBLK -- receive one XMODEM block into XMBUF.
                        ; Returns A: XM_TO(timeout), 00=EOT, 01=good, FF=bad, 02=CAN.
                        ; (First byte uses the timed read so we can retry the NAK on timeout; the rest
                        ;  of the block uses blocking reads because the host sends them back-to-back.)
                        ; ============================================================================
   11e5   cd 19 10      GETBLK: CALL    RXCHAR_T
   11e8   da 02 12              JC      GT_TIMEOUT              ; carry set = timeout
   11eb   fe 04                 CPI     XM_EOT
   11ed   ca 05 12              JZ      GT_EOT
   11f0   fe 18                 CPI     XM_CAN
   11f2   ca 07 12              JZ      GT_CAN
   11f5   fe 01                 CPI     XM_SOH
   11f7   ca 0a 12              JZ      GT_SOH
   11fa   fe 02                 CPI     XM_STX
   11fc   ca 33 12              JZ      GT_STX
   11ff   c3 e5 11              JMP     GETBLK                  ; stray byte (e.g. 'rx name'), ignore
                        
   1202                 GT_TIMEOUT:
   1202   3e fe                 MVI     A,XM_TO
   1204   c9                    RET
   1205   af            GT_EOT: XRA     A
   1206   c9                    RET
   1207   3e 02         GT_CAN: MVI     A,02H
   1209   c9                    RET
                        
                        ; ---- SOH: checksum block (blkno, ~blkno, 128 data, 1-byte checksum) ----
   120a   cd 0f 10      GT_SOH: CALL    RXCHAR
   120d   47                    MOV     B,A                     ; blkno
   120e   cd 0f 10              CALL    RXCHAR
   1211   a8                    XRA     B                       ; ~blkno ^ blkno
   1212   fe ff                 CPI     0FFH
   1214   c2 a6 12              JNZ     GT_BAD
   1217   21 00 20              LXI     H,XMBUF
   121a   1e 00                 MVI     E,00H
   121c   0e 80                 MVI     C,128
   121e   cd 0f 10      GT_LP:  CALL    RXCHAR
   1221   77                    MOV     M,A
   1222   83                    ADD     E
   1223   5f                    MOV     E,A
   1224   23                    INX     H
   1225   0d                    DCR     C
   1226   c2 1e 12              JNZ     GT_LP
   1229   cd 0f 10              CALL    RXCHAR                  ; checksum byte
   122c   bb                    CMP     E
   122d   c2 a6 12              JNZ     GT_BAD
   1230   3e 01                 MVI     A,01H
   1232   c9                    RET
                        
                        ; ---- STX: CRC block (blkno, ~blkno, 128 data, 2-byte CRC-16) ----
   1233   cd 0f 10      GT_STX: CALL    RXCHAR
   1236   47                    MOV     B,A                     ; blkno
   1237   cd 0f 10              CALL    RXCHAR
   123a   a8                    XRA     B
   123b   fe ff                 CPI     0FFH
   123d   c2 a6 12              JNZ     GT_BAD
   1240   21 00 20              LXI     H,XMBUF
   1243   0e 80                 MVI     C,128
   1245   cd 0f 10      GT_LP2: CALL    RXCHAR
   1248   77                    MOV     M,A
   1249   23                    INX     H
   124a   0d                    DCR     C
   124b   c2 45 12              JNZ     GT_LP2
                                ; compute CRC-16 XMODEM over XMBUF -> D: E (D high, E low)
   124e   21 00 20              LXI     H,XMBUF
   1251   11 00 00              LXI     D,0000H                 ; crc = 0
   1254   0e 80                 MVI     C,128
   1256   7e            GT_CRC: MOV     A,M
   1257   47                    MOV     B,A
   1258   7a                    MOV     A,D
   1259   a8                    XRA     B                       ; crc_hi ^= byte
   125a   57                    MOV     D,A
   125b   06 08                 MVI     B,08H
   125d   7a            GTCB:   MOV     A,D
   125e   e6 80                 ANI     80H                     ; crc & 0x8000 ?
   1260   ca 7e 12              JZ      GTCS
   1263   a7                    ANA     A                       ; clear carry
   1264   7b                    MOV     A,E
   1265   17                    RAL                             ; E = E<<1 (carry = old E bit7)
   1266   5f                    MOV     E,A
   1267   7a                    MOV     A,D
   1268   17                    RAL                             ; D = D<<1 | old E bit7
   1269   57                    MOV     D,A
   126a   7a                    MOV     A,D
   126b   ee 10                 XRI     10H                     ; crc ^= 0x1021 (hi)
   126d   57                    MOV     D,A
   126e   7b                    MOV     A,E
   126f   ee 21                 XRI     21H                     ; crc ^= 0x1021 (lo)
   1271   5f                    MOV     E,A
   1272   05                    DCR     B
   1273   c2 5d 12              JNZ     GTCB
   1276   23                    INX     H
   1277   0d                    DCR     C
   1278   c2 56 12              JNZ     GT_CRC
   127b   c3 8e 12              JMP     GT_CHK
   127e   a7            GTCS:   ANA     A                       ; clear carry
   127f   7b                    MOV     A,E
   1280   17                    RAL
   1281   5f                    MOV     E,A
   1282   7a                    MOV     A,D
   1283   17                    RAL
   1284   57                    MOV     D,A
   1285   05                    DCR     B
   1286   c2 5d 12              JNZ     GTCB
   1289   23                    INX     H
   128a   0d                    DCR     C
   128b   c2 56 12              JNZ     GT_CRC
   128e                 GT_CHK:
   128e   23                    INX     H
   128f   0d                    DCR     C
   1290   c2 56 12              JNZ     GT_CRC
                                ; read 2 CRC bytes (high, low), compare
   1293   cd 0f 10              CALL    RXCHAR
   1296   47                    MOV     B,A                     ; received crc hi
   1297   cd 0f 10              CALL    RXCHAR
   129a   bb                    CMP     E                       ; compare low
   129b   c2 a6 12              JNZ     GT_BAD
   129e   78                    MOV     A,B
   129f   ba                    CMP     D                       ; compare high
   12a0   c2 a6 12              JNZ     GT_BAD
   12a3   3e 01                 MVI     A,01H
   12a5   c9                    RET
                        
   12a6   3e ff         GT_BAD: MVI     A,0FFH
   12a8   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEBLK -- write the 128 good bytes in XMBUF to the RAM disk at the current
                        ;   file position. Position = 0x2000 + BLKNO*1024 + RCNT_L*128. BLKNO is the
                        ;   first free data block found by NEXTBLOCK at upload start, so a second
                        ;   upload appends after existing files instead of overwriting block 2.
                        ; ============================================================================
   12a9                 WRITEBLK:
   12a9   2a 60 21              LHLD    RCNT_L
   12ac   54                    MOV     D,H
   12ad   5d                    MOV     E,L
   12ae   06 07                 MVI     B,07H
   12b0                 WBLK_SHL:
   12b0   7b                    MOV     A,E
   12b1   87                    ADD     A
   12b2   5f                    MOV     E,A
   12b3   7a                    MOV     A,D
   12b4   17                    RAL
   12b5   57                    MOV     D,A
   12b6   05                    DCR     B
   12b7   c2 b0 12              JNZ     WBLK_SHL        ; DE = RCNT_L*128
   12ba   d5                    PUSH    D               ; save RCNT_L*128
   12bb   3a 31 15              LDA     BLKNO
   12be   6f                    MOV     L,A
   12bf   26 00                 MVI     H,00H
   12c1   06 0a                 MVI     B,10            ; *1024 (2^10) -> HL = BLKNO*1024
   12c3   29            WBLK_B: DAD     H
   12c4   05                    DCR     B
   12c5   c2 c3 12              JNZ     WBLK_B
   12c8   11 00 20              LXI     D,2000H         ; data-area base (blocks are at 0x2000 + N*1024)
   12cb   19                    DAD     D               ; HL = 0x2000 + BLKNO*1024
   12cc   d1                    POP     D               ; DE = RCNT_L*128
   12cd   19                    DAD     D               ; HL += RCNT_L*128
   12ce   cd 64 10              CALL    RDSETA
   12d1   21 00 20              LXI     H,XMBUF
   12d4   0e 80                 MVI     C,128
   12d6   7e            WBLK:   MOV     A,M
   12d7   d3 20                 OUT     RDDATA
   12d9   23                    INX     H
   12da   0d                    DCR     C
   12db   c2 d6 12              JNZ     WBLK
   12de   2a 60 21              LHLD    RCNT_L
   12e1   23                    INX     H
   12e2   22 60 21              SHLD    RCNT_L
   12e5   c9                    RET
                        
                        ; ============================================================================
                        ; WRITEFCB -- write the FCB directory entry/entries for the received file.
                        ;   BLKNO (first free data block) and FSLOT (first free dir slot) were chosen
                        ;   by NEXTBLK/FINDFREE at the START of the upload. Single extent (<=16K) ->
                        ;   one slot; >16K -> two slots (extents 0 and 1). All data blocks run
                        ;   contiguously from BLKNO, so a second upload never overwrites the first.
                        ; ============================================================================
   12e6                 WRITEFCB:
   12e6   cd 22 14              CALL    BUILD_FCB               ; builds FCB (and FCB2 copy) with name/ext
   12e9   2a 60 21              LHLD    RCNT_L
   12ec   7c                    MOV     A,H
   12ed   b7                    ORA     A
   12ee   c2 1e 13              JNZ     WFC_TWO
   12f1   7d                    MOV     A,L
   12f2   fe 81                 CPI     129
   12f4   d2 1e 13              JNC     WFC_TWO
                                ; ---- single extent (<=16K) ----
   12f7   3e 01                 MVI     A,01H
   12f9   32 2f 15              STA     FNEED                   ; need 1 consecutive slot
   12fc   cd 6b 10              CALL    FINDFREE                ; A = free slot (carry set = dir full)
   12ff   da ba 11              JC      UP_NOSPC
   1302   32 2d 15              STA     FSLOT
   1305   3e 00                 MVI     A,00H
   1307   32 0c 21              STA     FCB+12                  ; EX=0
   130a   32 0d 21              STA     FCB+13                  ; S1=0
   130d   32 0e 21              STA     FCB+14                  ; S2=0
   1310   2a 60 21              LHLD    RCNT_L
   1313   7d                    MOV     A,L
   1314   32 0f 21              STA     FCB+15                  ; RC = records
   1317   cd a6 13              CALL    SETALLO                 ; fill FCB+16..31 (blocks from BLKNO)
   131a   cd 84 13              CALL    WDIRFCB
   131d   c9                    RET
                        
   131e                 WFC_TWO:
   131e   3e 02                 MVI     A,02H
   1320   32 2f 15              STA     FNEED                   ; need 2 consecutive slots
   1323   cd 6b 10              CALL    FINDFREE                ; A = free slot run start
   1326   da ba 11              JC      UP_NOSPC
   1329   32 2d 15              STA     FSLOT
   132c   3e 00                 MVI     A,00H
   132e   32 0c 21              STA     FCB+12
   1331   32 0d 21              STA     FCB+13
   1334   32 0e 21              STA     FCB+14
   1337   3e 80                 MVI     A,128
   1339   32 0f 21              STA     FCB+15
   133c   cd a6 13              CALL    SETALLO
   133f   2a 60 21              LHLD    RCNT_L
   1342   7d                    MOV     A,L
   1343   d6 80                 SUI     128
   1345   6f                    MOV     L,A
   1346   7c                    MOV     A,H
   1347   de 00                 SBI     00H
   1349   67                    MOV     H,A
   134a   7d                    MOV     A,L
   134b   32 2f 21              STA     FCB2+15                 ; RC extent 1
   134e   3e 01                 MVI     A,01H
   1350   32 2c 21              STA     FCB2+12                 ; EX=1
   1353   3e 00                 MVI     A,00H
   1355   32 2d 21              STA     FCB2+13                 ; S1=0
   1358   32 2e 21              STA     FCB2+14                 ; S2=0
   135b   cd c1 13              CALL    SETALLO2
   135e   cd 84 13              CALL    WDIRFCB                 ; extent 0 at slot FSLOT
                                ; extent 1 at slot FSLOT+1
   1361   3a 2d 15              LDA     FSLOT
   1364   3c                    INR     A
   1365   6f                    MOV     L,A
   1366   26 00                 MVI     H,00H
   1368   16 05                 MVI     D,05H
   136a   29            WFC2S:  DAD     H
   136b   15                    DCR     D
   136c   c2 6a 13              JNZ     WFC2S                   ; HL = (FSLOT+1)*32
   136f   11 00 20              LXI     D,DIRBASE
   1372   19                    DAD     D
   1373   cd 64 10              CALL    RDSETA
   1376   21 20 21              LXI     H,FCB2
   1379   0e 20                 MVI     C,32
   137b   7e            WFC2B:  MOV     A,M
   137c   d3 20                 OUT     RDDATA
   137e   23                    INX     H
   137f   0d                    DCR     C
   1380   c2 7b 13              JNZ     WFC2B
   1383   c9                    RET
                        
   1384                 WDIRFCB:
   1384   3a 2d 15              LDA     FSLOT
   1387   6f                    MOV     L,A
   1388   26 00                 MVI     H,00H
   138a   16 05                 MVI     D,05H
   138c   29            WDFS:   DAD     H
   138d   15                    DCR     D
   138e   c2 8c 13              JNZ     WDFS                    ; HL = FSLOT*32
   1391   11 00 20              LXI     D,DIRBASE
   1394   19                    DAD     D
   1395   cd 64 10              CALL    RDSETA
   1398   21 00 21              LXI     H,FCB
   139b   0e 20                 MVI     C,32
   139d   7e            WDF:    MOV     A,M
   139e   d3 20                 OUT     RDDATA
   13a0   23                    INX     H
   13a1   0d                    DCR     C
   13a2   c2 9d 13              JNZ     WDF
   13a5   c9                    RET
                        
   13a6                 SETALLO:
   13a6   3a 0f 21              LDA     FCB+15
   13a9   b7                    ORA     A
   13aa   c8                    RZ                              ; RC=0 -> no blocks to allocate
   13ab   c6 07                 ADI     07H
   13ad   0f                    RRC
   13ae   0f                    RRC
   13af   0f                    RRC
   13b0   e6 1f                 ANI     1FH
   13b2   47                    MOV     B,A
   13b3   21 10 21              LXI     H,FCB+16
   13b6   3a 31 15              LDA     BLKNO                   ; first free data block
   13b9   77            SA1:    MOV     M,A
   13ba   23                    INX     H
   13bb   3c                    INR     A
   13bc   05                    DCR     B
   13bd   c2 b9 13              JNZ     SA1
   13c0   c9                    RET
                        
   13c1                 SETALLO2:
   13c1   3a 2f 21              LDA     FCB2+15
   13c4   b7                    ORA     A
   13c5   c8                    RZ                              ; RC=0 -> no blocks to allocate
   13c6   c6 07                 ADI     07H
   13c8   0f                    RRC
   13c9   0f                    RRC
   13ca   0f                    RRC
   13cb   e6 1f                 ANI     1FH
   13cd   47                    MOV     B,A
   13ce   21 30 21              LXI     H,FCB2+16
   13d1   3a 31 15              LDA     BLKNO
   13d4   c6 16                 ADI     16H                     ; extent 1 starts at BLKNO + 16
   13d6   77            SA21:   MOV     M,A
   13d7   23                    INX     H
   13d8   3c                    INR     A
   13d9   05                    DCR     B
   13da   c2 d6 13              JNZ     SA21
   13dd   c9                    RET
                        
                        ; ============================================================================
                        ; READNAME -- read "name.ext" (max 9 chars) from console into FNAME, echoing.
                        ; ============================================================================
   13de                 READNAME:
   13de   21 80 21              LXI     H,FNAME
   13e1   06 0c                 MVI     B,12
   13e3   cd 0f 10      RN1:    CALL    RXCHAR
   13e6   fe 0d                 CPI     0DH
   13e8   ca 1b 14              JZ      RN_DONE
   13eb   fe 08                 CPI     08H                     ; ^H backspace
   13ed   ca 01 14              JZ      RN_BS
   13f0   fe 7f                 CPI     7FH                     ; DEL backspace
   13f2   ca 01 14              JZ      RN_BS
   13f5   77                    MOV     M,A
   13f6   cd 03 10              CALL    TXCHAR                  ; ECHO the char
   13f9   23                    INX     H
   13fa   05                    DCR     B
   13fb   c2 e3 13              JNZ     RN1
   13fe   c3 1b 14              JMP     RN_DONE
   1401                 RN_BS:  ; backspace: erase from the screen and back the buffer up (if possible)
   1401   3e 08                 MVI     A,08H
   1403   cd 03 10              CALL    TXCHAR
   1406   3e 20                 MVI     A,20H
   1408   cd 03 10              CALL    TXCHAR
   140b   3e 08                 MVI     A,08H
   140d   cd 03 10              CALL    TXCHAR
   1410   78                    MOV     A,B
   1411   fe 09                 CPI     9
   1413   ca e3 13              JZ      RN1                     ; buffer full, at start -> nothing to back up
   1416   2b                    DCX     H
   1417   04                    INR     B
   1418   c3 e3 13              JMP     RN1
   141b   3e 00         RN_DONE: MVI     A,00H
   141d   77                    MOV     M,A                     ; NUL terminate
   141e   cd 39 10              CALL    CRLF
   1421   c9                    RET
                        
                        ; ============================================================================
                        ; BUILD_FCB -- parse FNAME into the 32-byte FCB (and copy into FCB2).
                        ; ============================================================================
   1422                 BUILD_FCB:
   1422   21 00 21              LXI     H,FCB
   1425   06 40                 MVI     B,64                    ; zero both FCBs (2 x 32)
   1427   3e 00         BF_Z:   MVI     A,00H
   1429   77                    MOV     M,A
   142a   23                    INX     H
   142b   05                    DCR     B
   142c   c2 27 14              JNZ     BF_Z
   142f   11 80 21              LXI     D,FNAME
   1432   21 01 21              LXI     H,FCB+1
   1435   06 08                 MVI     B,8
   1437   1a            BF_N:   LDAX    D
   1438   fe 00                 CPI     00H
   143a   ca 53 14              JZ      BF_NPAD
   143d   fe 2e                 CPI     '.'
   143f   ca 53 14              JZ      BF_GOTEXT
   1442   77                    MOV     M,A
   1443   23                    INX     H
   1444   13                    INX     D
   1445   05                    DCR     B
   1446   c2 37 14              JNZ     BF_N
   1449   1a                    LDAX    D
   144a   fe 2e                 CPI     '.'
   144c   c2 82 14              JNZ     BF_EXT0
   144f   13                    INX     D
   1450   c3 5c 14              JMP     BF_EXT
   1453                 BF_GOTEXT:
   1453   3e 20         BF_NPAD: MVI     A,' '
   1455   77                    MOV     M,A
   1456   23                    INX     H
   1457   05                    DCR     B
   1458   c2 53 14              JNZ     BF_NPAD
   145b   13                    INX     D                       ; skip '.'
   145c   21 09 21      BF_EXT: LXI     H,FCB+9
   145f   06 03                 MVI     B,3
   1461   1a            BF_E:   LDAX    D
   1462   fe 00                 CPI     00H
   1464   ca 7a 14              JZ      BF_EXT_PAD
   1467   fe 2e                 CPI     '.'
   1469   ca 76 14              JZ      BF_EXT_SKIP
   146c   77                    MOV     M,A
   146d   23                    INX     H
   146e   13                    INX     D
   146f   05                    DCR     B
   1470   c2 61 14              JNZ     BF_E
   1473   c3 82 14              JMP     BF_EXT0
   1476                 BF_EXT_SKIP:
   1476   13                    INX     D
   1477   c3 61 14              JMP     BF_E
   147a                 BF_EXT_PAD:
   147a   3e 20                 MVI     A,' '
   147c   77                    MOV     M,A
   147d   23                    INX     H
   147e   05                    DCR     B
   147f   c2 7a 14              JNZ     BF_EXT_PAD
   1482                 BF_EXT0:
   1482   21 00 21              LXI     H,FCB
   1485   36 00                 MVI     M,00H                   ; dir entry byte0 = USER number (0), not drive
   1487   21 00 21              LXI     H,FCB
   148a   11 20 21              LXI     D,FCB2
   148d   06 20                 MVI     B,32
   148f   7e            BF_C:   MOV     A,M
   1490   12                    STAX    D
   1491   23                    INX     H
   1492   13                    INX     D
   1493   05                    DCR     B
   1494   c2 8f 14              JNZ     BF_C
   1497   c9                    RET
                        
                        ; ============================================================================
                        ; DO_DOWNLOAD -- XMODEM send dir-slot-0 file's extent 0 to the host (checksum).
                        ; ============================================================================
   1498                 DO_DOWNLOAD:
   1498   21 ee 16              LXI     H,MSGDL
   149b   cd 44 10              CALL    PRTSTR
   149e   21 0f 20              LXI     H,DIRBASE+15
   14a1   cd 64 10              CALL    RDSETA
   14a4   db 20                 IN      RDDATA                  ; A = RC (extent 0)
   14a6   32 29 15              STA     SEND_RC
   14a9   cd 0f 10              CALL    RXCHAR                  ; wait for NAK/'C' from host
   14ac   cd b2 14              CALL    XM_SENDFILE
   14af   c3 10 11              JMP     MENU
                        
   14b2                 XM_SENDFILE:
   14b2   3a 29 15              LDA     SEND_RC
   14b5   47                    MOV     B,A                     ; B = records to send
   14b6   3e 01                 MVI     A,01H
   14b8   32 2a 15              STA     XS_BLK
   14bb   21 00 28              LXI     H,DBLOCK0
   14be   22 2b 15              SHLD    XS_ADDR
   14c1   78            XS_LOOP: MOV     A,B
   14c2   b7                    ORA     A
   14c3   ca 0b 15              JZ      XS_DONE
   14c6   3e 01                 MVI     A,XM_SOH
   14c8   cd 03 10              CALL    TXCHAR
   14cb   3a 2a 15              LDA     XS_BLK
   14ce   cd 03 10              CALL    TXCHAR
   14d1   4f                    MOV     C,A
   14d2   2f                    CMA
   14d3   cd 03 10              CALL    TXCHAR
   14d6   2a 2b 15              LHLD    XS_ADDR
   14d9   cd 64 10              CALL    RDSETA
   14dc   1e 00                 MVI     E,00H
   14de   0e 80                 MVI     C,128
   14e0   db 20         XS_DATA: IN      RDDATA
   14e2   83                    ADD     E
   14e3   5f                    MOV     E,A
   14e4   0d                    DCR     C
   14e5   c2 e0 14              JNZ     XS_DATA
   14e8   7b                    MOV     A,E
   14e9   cd 03 10              CALL    TXCHAR                  ; checksum
   14ec   2a 2b 15              LHLD    XS_ADDR
   14ef   11 28 01              LXI     D,0128H
   14f2   19                    DAD     D
   14f3   22 2b 15              SHLD    XS_ADDR
   14f6   cd 0f 10              CALL    RXCHAR
   14f9   fe 06                 CPI     XM_ACK
   14fb   c2 c1 14              JNZ     XS_LOOP                 ; NAK/unknown -> resend
   14fe   3a 2a 15              LDA     XS_BLK
   1501   3c                    INR     A
   1502   32 2a 15              STA     XS_BLK
   1505   78                    MOV     A,B
   1506   3d                    DCR     A
   1507   47                    MOV     B,A
   1508   c2 c1 14              JNZ     XS_LOOP
   150b                 XS_DONE:
   150b   3e 04                 MVI     A,XM_EOT
   150d   cd 03 10              CALL    TXCHAR
   1510   cd 0f 10              CALL    RXCHAR
   1513   fe 06                 CPI     XM_ACK
   1515   ca 20 15              JZ      XS_END
   1518   3e 04                 MVI     A,XM_EOT
   151a   cd 03 10              CALL    TXCHAR
   151d   cd 0f 10              CALL    RXCHAR
   1520   21 04 17      XS_END: LXI     H,MSGDLDONE
   1523   cd 44 10              CALL    PRTSTR
   1526   c3 10 11              JMP     MENU
                        
   1529                 SEND_RC: DS     1
   152a                 XS_BLK:  DS     1
   152b                 XS_ADDR: DS     2
   152d                 FSLOT:   DS     1               ; directory slot index for the file being written
   152e                 TWOF:    DS     1               ; !=0 -> two-extent file (extents 0 AND 1 slots)
   152f                 FNEED:   DS     1               ; slots needed by FINDFREE (1 = single, 2 = two-extent)
   1530                 NBMAX:   DS     1               ; scratch: highest data block seen during NEXTBLK
   1531                 BLKNO:   DS     1               ; first free data block for the file being written
                        
                        ; ============================================================================
                        ; DO_DUMP -- dump 256 bytes from the RAM disk at a hex address, as hex (16/line).
                        ; ============================================================================
   1532                 DO_DUMP:
   1532   21 a9 16              LXI     H,MSGDUMP
   1535   cd 44 10              CALL    PRTSTR
   1538   cd 7f 15              CALL    READHEX                 ; HL = start address
   153b   cd 64 10              CALL    RDSETA
   153e   06 10                 MVI     B,16                    ; 16 lines
   1540   16 10         DUMP_L1: MVI     D,16                    ; 16 bytes per line
   1542   db 20         DUMP_B: IN      RDDATA
   1544   cd 4e 10              CALL    PRTBYTE
   1547   3e 20                 MVI     A,' '
   1549   cd 03 10              CALL    TXCHAR
   154c   15                    DCR     D
   154d   c2 42 15              JNZ     DUMP_B
   1550   cd 39 10              CALL    CRLF
   1553   05                    DCR     B
   1554   c2 40 15              JNZ     DUMP_L1
   1557   c3 10 11              JMP     MENU
                        
                        ; ============================================================================
                        ; DO_MDUMP -- dump 128 bytes of CPU (bank A) memory at a hex address.
                        ; Runs with the monitor banked out; reads bank A RAM directly. Useful for
                        ; inspecting CBIOS/BDOS variable state AFTER a CP/M session (reset -> G 1000).
                        ; ============================================================================
   155a                 DO_MDUMP:
   155a   21 c6 16              LXI     H,MSGMD
   155d   cd 44 10              CALL    PRTSTR
   1560   cd 7f 15              CALL    READHEX                 ; HL = start address
   1563   06 08                 MVI     B,8                     ; 8 lines
   1565   16 10         MD_L1:  MVI     D,16                    ; 16 bytes per line
   1567   7e            MD_B:   MOV     A,M
   1568   cd 4e 10              CALL    PRTBYTE
   156b   3e 20                 MVI     A,' '
   156d   cd 03 10              CALL    TXCHAR
   1570   23                    INX     H
   1571   15                    DCR     D
   1572   c2 67 15              JNZ     MD_B
   1575   cd 39 10              CALL    CRLF
   1578   05                    DCR     B
   1579   c2 65 15              JNZ     MD_L1
   157c   c3 10 11              JMP     MENU
                        
                        ; ---------------------------------------------------------------------------
                        ; READHEX -- read up to 4 hex digits from the console into HL (echoed).
                        ; ---------------------------------------------------------------------------
   157f                 READHEX:
   157f   21 00 00              LXI     H,0000H
   1582   06 04                 MVI     B,4
   1584   cd 0f 10      RH1:    CALL    RXCHAR
   1587   fe 0d                 CPI     0DH
   1589   ca c0 15              JZ      RH_DONE                 ; Enter ends
                                ; determine hex digit value 0-15 in A
   158c   fe 30                 CPI     '0'
   158e   da c4 15              JC      RH_NEXT                 ; < '0' -> ignore
   1591   fe 3a                 CPI     '9'+1
   1593   da a7 15              JC      RH_DIG                  ; '0'-'9'
   1596   e6 df                 ANI     0DFH                    ; uppercase
   1598   fe 41                 CPI     'A'
   159a   da c4 15              JC      RH_NEXT                 ; < 'A' -> ignore
   159d   fe 47                 CPI     'F'+1
   159f   d2 c4 15              JNC     RH_NEXT                 ; > 'F' -> ignore
   15a2   d6 37                 SUI     'A'-10                  ; 'A'-'F' -> 10-15
   15a4   c3 a9 15              JMP     RH_ADD
   15a7   d6 30         RH_DIG: SUI     '0'                     ; '0'-'9' -> 0-9
   15a9   cd 03 10      RH_ADD: CALL    TXCHAR                  ; echo the digit
   15ac   4f                    MOV     C,A                     ; C = digit value
                                ; HL = (HL << 4) | C
   15ad   16 04                 MVI     D,04H
   15af   7d            RH_SHL: MOV     A,L
   15b0   87                    ADD     A
   15b1   6f                    MOV     L,A
   15b2   7c                    MOV     A,H
   15b3   17                    RAL
   15b4   67                    MOV     H,A
   15b5   15                    DCR     D
   15b6   c2 af 15              JNZ     RH_SHL
   15b9   7d                    MOV     A,L
   15ba   b1                    ORA     C
   15bb   6f                    MOV     L,A
   15bc   05                    DCR     B
   15bd   c2 84 15              JNZ     RH1
   15c0                 RH_DONE:
   15c0   cd 39 10              CALL    CRLF
   15c3   c9                    RET
   15c4   c3 84 15      RH_NEXT: JMP     RH1
                        
