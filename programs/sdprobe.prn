                        ; SDPROBE.COM -- Brevia2 SD-card probe (SPI mode), bare-metal driver demo.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port wired to pins 31/32/35/36:
                        ;   IN  0x53 = SD SPI data        (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl   bit0 = CS# (0 = select, 1 = release)
                        ;                           bit1 = slow clock (1 = ~390 kHz for card init)
                        ;   IN  0x55 = SD SPI status bit0 = transfer-busy
                        ;
                        ; The on-board flash SPI pins are not broken out, so the SD breakout has its
                        ; OWN SPI port (implemented as a second instance of the generic byte engine in
                        ; rtl/z80cpm_brevia2.v).
                        ;
                        ; What it does:
                        ;   1. Full SPI-mode init handshake (power-up clocks, CMD0, CMD8, CMD55/ACMD41,
                        ;      CMD58, CMD16) -- proves the card initializes on real silicon.
                        ;   2. Reads the CID (CMD9) and prints manufacturer ID, product name, serial.
                        ;   3. Reads block 0 (CMD17) and reports whether an MBR (55AA) is present,
                        ;      printing the first partition entry (type / LBA / size) -- the first
                        ;      step toward partitioning support.
                        ;
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 e5 03              LXI     H,BANNER
   0103   cd 76 03              CALL    PSTR
                        
                                ; ---------------- 1. init the card ----------------
   0106   cd 4d 02              CALL    SDINIT          ; A = 0 if init OK (CMD0 idle + ACMD41 ready), 0FFh if not
   0109   b7                    ORA     A
   010a   ca 6e 01              JZ      INI_OK
                                ; ---- failure: report detailed diagnostics ----
   010d   21 1e 04              LXI     H,MSG_NOCARD
   0110   cd 76 03              CALL    PSTR
   0113   cd 84 03              CALL    CRLF
                                ; raw CMD0 response bytes
   0116   21 36 04              LXI     H,MSG_CMD0R
   0119   cd 76 03              CALL    PSTR
   011c   21 6c 05              LXI     H,RBUF
   011f   06 08                 MVI     B,8
   0121                 SD_DIAG:
   0121   7e                    MOV     A,M
   0122   cd 8f 03              CALL    PRHEX2
   0125   1e 20                 MVI     E,' '
   0127   cd 7e 03              CALL    CPUTC
   012a   23                    INX     H
   012b   05                    DCR     B
   012c   c2 21 01              JNZ     SD_DIAG
   012f   cd 84 03              CALL    CRLF
                                ; interpreted R1
   0132   21 48 04              LXI     H,MSG_R1
   0135   cd 76 03              CALL    PSTR
   0138   3a 6b 05              LDA     CMDR1
   013b   cd 8f 03              CALL    PRHEX2
   013e   cd 84 03              CALL    CRLF
   0141   3a 6b 05              LDA     CMDR1
   0144   fe ff                 CPI     0FFH            ; no response at all?
   0146   c2 52 01              JNZ     SD_DIAG2
   0149   21 4c 04              LXI     H,MSG_NORESP
   014c   cd 76 03              CALL    PSTR
   014f   cd 84 03              CALL    CRLF
   0152                 SD_DIAG2:
                                ; ACMD41 poll count + result
   0152   21 8b 04              LXI     H,MSG_ACMD
   0155   cd 76 03              CALL    PSTR
   0158   3a 74 05              LDA     ACMDIT
   015b   cd 8f 03              CALL    PRHEX2          ; poll count (hex)
   015e   21 9b 04              LXI     H,MSG_ACMDR
   0161   cd 76 03              CALL    PSTR
   0164   3a 75 05              LDA     ACMDR1
   0167   cd 8f 03              CALL    PRHEX2
   016a   cd 84 03              CALL    CRLF
   016d   c9                    RET
   016e                 INI_OK:
   016e   21 0c 04              LXI     H,MSG_INI
   0171   cd 76 03              CALL    PSTR
   0174   3a 6b 05              LDA     CMDR1           ; show the CMD0 R1 (01h = idle) for hardware diagnostics
   0177   cd 8f 03              CALL    PRHEX2
   017a   cd 84 03              CALL    CRLF
                        
                                ; ---- detect card type (CMD58 -> OCR CCS bit30) ----
   017d   cd 15 03              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0180   b7                    ORA     A
   0181   ca 8d 01              JZ      IS_SC
   0184   21 a4 04              LXI     H,MSG_SDHC
   0187   cd 76 03              CALL    PSTR
   018a   c3 93 01              JMP     AFTER_TYPE
   018d                 IS_SC:
   018d   21 c9 04              LXI     H,MSG_SDSC
   0190   cd 76 03              CALL    PSTR
   0193                 AFTER_TYPE:
   0193   cd 84 03              CALL    CRLF
                        
                                ; ---------------- 2. read CID ----------------
   0196   cd 28 03              CALL    SD_CID          ; A = 1 ok / 0 err
   0199   b7                    ORA     A
   019a   ca a9 01              JZ      CID_OK
   019d   21 fd 04              LXI     H,MSG_CIDERR
   01a0   cd 76 03              CALL    PSTR
   01a3   cd 84 03              CALL    CRLF
   01a6   c3 ec 01              JMP     AFTER_CID
   01a9                 CID_OK:
   01a9   21 e8 04              LXI     H,MSG_CID
   01ac   cd 76 03              CALL    PSTR
                                ; manufacturer ID (CID[0])
   01af   3a 76 05              LDA     CIDBUF
   01b2   cd 8f 03              CALL    PRHEX2
   01b5   1e 20                 MVI     E,' '
   01b7   cd 7e 03              CALL    CPUTC
                                ; product name (CID[3..7], 5 ASCII bytes)
   01ba   21 79 05              LXI     H,CIDBUF+3
   01bd   06 05                 MVI     B,5
   01bf                 CID_NM:
   01bf   5e                    MOV     E,M
   01c0   cd 7e 03              CALL    CPUTC
   01c3   23                    INX     H
   01c4   05                    DCR     B
   01c5   c2 bf 01              JNZ     CID_NM
   01c8   cd 84 03              CALL    CRLF
                                ; serial number (CID[9..12])
   01cb   21 f3 04              LXI     H,MSG_SN
   01ce   cd 76 03              CALL    PSTR
   01d1   3a 7f 05              LDA     CIDBUF+9
   01d4   cd 8f 03              CALL    PRHEX2
   01d7   3a 80 05              LDA     CIDBUF+10
   01da   cd 8f 03              CALL    PRHEX2
   01dd   3a 81 05              LDA     CIDBUF+11
   01e0   cd 8f 03              CALL    PRHEX2
   01e3   3a 82 05              LDA     CIDBUF+12
   01e6   cd 8f 03              CALL    PRHEX2
   01e9   cd 84 03              CALL    CRLF
   01ec                 AFTER_CID:
                        
                                ; ---------------- 3. read block 0 + MBR check ----------------
   01ec   cd 4f 03              CALL    SD_BLK0         ; A = 1 ok / 0 err
   01ef   b7                    ORA     A
   01f0   ca ff 01              JZ      BLK_OK
   01f3   21 0f 05              LXI     H,MSG_BLKERR
   01f6   cd 76 03              CALL    PSTR
   01f9   cd 84 03              CALL    CRLF
   01fc   c3 43 02              JMP     AFTER_BLK
   01ff                 BLK_OK:
                                ; check MBR signature 55AA at DBUF+510
   01ff   21 84 07              LXI     H,DBUF+510
   0202   7e                    MOV     A,M
   0203   fe 55                 CPI     55H
   0205   c2 3a 02              JNZ     NO_MBR
   0208   23                    INX     H
   0209   7e                    MOV     A,M
   020a   fe aa                 CPI     0AAH
   020c   c2 3a 02              JNZ     NO_MBR
                                ; MBR present -> print partition 1 info
   020f   21 25 05              LXI     H,MSG_MBR
   0212   cd 76 03              CALL    PSTR
                                ; type byte at DBUF+446+4
   0215   21 48 07              LXI     H,DBUF+446+4
   0218   7e                    MOV     A,M
   0219   cd 8f 03              CALL    PRHEX2
   021c   1e 20                 MVI     E,' '
   021e   cd 7e 03              CALL    CPUTC
                                ; LBA start (bytes +8..+11, little-endian); size (+12..+15)
   0221   21 4c 07              LXI     H,DBUF+446+8
   0224   06 08                 MVI     B,8             ; 4 LBA bytes + 4 size bytes
   0226                 MBR_LP:
   0226   7e                    MOV     A,M
   0227   cd 8f 03              CALL    PRHEX2
   022a   1e 20                 MVI     E,' '
   022c   cd 7e 03              CALL    CPUTC
   022f   23                    INX     H
   0230   05                    DCR     B
   0231   c2 26 02              JNZ     MBR_LP
   0234   cd 84 03              CALL    CRLF
   0237   c3 43 02              JMP     AFTER_BLK
   023a                 NO_MBR:
   023a   21 51 05              LXI     H,MSG_NOMBR
   023d   cd 76 03              CALL    PSTR
   0240   cd 84 03              CALL    CRLF
   0243                 AFTER_BLK:
                        
   0243   21 63 05              LXI     H,MSG_DONE
   0246   cd 76 03              CALL    PSTR
   0249   cd 84 03              CALL    CRLF
   024c   c9                    RET
                        
                        ; ================= SD card driver subroutines =================
                        
                        ; SDINIT: full SPI-mode initialization.
                        ;   Success: A = 0  (CMDR1 = 01h idle, card ready).
                        ;   Failure: A = 0FFh, with diagnostics: CMDR1 = CMD0 R1 (or 0FFh if no
                        ;            response), RBUF = raw CMD0 response bytes, ACMDIT = ACMD41 poll
                        ;            count, ACMDR1 = final ACMD41 result.
   024d                 SDINIT:
   024d   3e 03                 MVI     A,03H           ; bit0=1 (CS high), bit1=1 (slow)
   024f   d3 54                 OUT     SDCTL
   0251   06 0a                 MVI     B,10            ; 10 byte-writes = 80 power-up clocks (CS# high)
   0253                 SDI_CK:
   0253   3e ff                 MVI     A,0FFH
   0255   d3 53                 OUT     SDDAT
   0257   05                    DCR     B
   0258   c2 53 02              JNZ     SDI_CK
   025b   3e 02                 MVI     A,02H           ; select card (CS low), stay on slow clock
   025d   d3 54                 OUT     SDCTL
                                ; --- send CMD0, then capture the raw response bytes ---
   025f   21 b5 03              LXI     H,CMD0
   0262   06 06                 MVI     B,6
   0264                 SDI_TX:
   0264   7e                    MOV     A,M
   0265   d3 53                 OUT     SDDAT
   0267   23                    INX     H
   0268   05                    DCR     B
   0269   c2 64 02              JNZ     SDI_TX
   026c   21 6c 05              LXI     H,RBUF
   026f   06 08                 MVI     B,8
   0271                 SDI_RX:
   0271   db 53                 IN      SDDAT
   0273   77                    MOV     M,A
   0274   23                    INX     H
   0275   05                    DCR     B
   0276   c2 71 02              JNZ     SDI_RX
                                ; find the first byte that is not 0FFh = R1
   0279   21 6c 05              LXI     H,RBUF
   027c   06 08                 MVI     B,8
   027e                 SDI_FR1:
   027e   7e                    MOV     A,M
   027f   fe ff                 CPI     0FFH
   0281   c2 8e 02              JNZ     SDI_HAVE
   0284   23                    INX     H
   0285   05                    DCR     B
   0286   c2 7e 02              JNZ     SDI_FR1
   0289   3e ff                 MVI     A,0FFH          ; no valid response at all
   028b   c3 8f 02              JMP     SDI_ST1
   028e                 SDI_HAVE:
   028e   7e                    MOV     A,M
   028f                 SDI_ST1:
   028f   32 6b 05              STA     CMDR1
   0292   fe 01                 CPI     01H             ; must be in idle state to continue
   0294   c2 bf 02              JNZ     SDI_FAIL
                                ; --- poll CMD55+ACMD41 until the card leaves idle.  Card init is
                                ;     time-based, so we wait a real delay between attempts (CS# stays
                                ;     selected on the slow clock; the data-read routines switch to the
                                ;     fast clock once the card is ready). ---
   0297   16 c8                 MVI     D,200           ; up to 200 attempts
   0299   af                    XRA     A
   029a   32 74 05              STA     ACMDIT
   029d                 SDI_RDY:
   029d   21 c1 03              LXI     H,CMD55
   02a0   cd c5 02              CALL    SD_SEND6
   02a3   21 c7 03              LXI     H,ACMD41
   02a6   cd c5 02              CALL    SD_SEND6        ; A = R1
   02a9   32 75 05              STA     ACMDR1
   02ac   fe 00                 CPI     00H
   02ae   ca c2 02              JZ      SDI_OK
   02b1   3a 74 05              LDA     ACMDIT
   02b4   3c                    INR     A
   02b5   32 74 05              STA     ACMDIT
   02b8   cd dd 02              CALL    DELAYMS         ; ~3ms pause before the next attempt
   02bb   15                    DCR     D
   02bc   c2 9d 02              JNZ     SDI_RDY
   02bf                 SDI_FAIL:
   02bf   3e ff                 MVI     A,0FFH
   02c1   c9                    RET
   02c2                 SDI_OK:
   02c2   3e 00                 MVI     A,00H
   02c4   c9                    RET
                        
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Assumes the card is already selected (CS low).  Returns A = R1 (0FFh = no
                        ;   valid response after 16 bytes of clocking).
   02c5                 SD_SEND6:
   02c5   06 06                 MVI     B,6
   02c7                 SD6_TX:
   02c7   7e                    MOV     A,M
   02c8   d3 53                 OUT     SDDAT
   02ca   23                    INX     H
   02cb   05                    DCR     B
   02cc   c2 c7 02              JNZ     SD6_TX
   02cf   06 10                 MVI     B,16            ; clock up to 16 bytes looking for the response
   02d1                 SD6_RX:
   02d1   db 53                 IN      SDDAT           ; clocks out FFh, returns the MISO byte
   02d3   fe ff                 CPI     0FFH
   02d5   c2 dc 02              JNZ     SD6_DONE
   02d8   05                    DCR     B
   02d9   c2 d1 02              JNZ     SD6_RX
   02dc                 SD6_DONE:
   02dc   c9                    RET
                        
                        ; DELAYMS - approximate ~3ms busy-wait (uses HL only; used between SD init
                        ;   polls because SD card initialization is time-based, not clock-based).
   02dd                 DELAYMS:
   02dd   21 d0 07              LXI     H,2000
   02e0                 DLMS:
   02e0   2b                    DCX     H
   02e1   7c                    MOV     A,H
   02e2   b5                    ORA     L
   02e3   c2 e0 02              JNZ     DLMS
   02e6   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success; CY=1 if 255 bytes pass with no token.
   02e7                 SD_WAITTKN:
   02e7   06 ff                 MVI     B,0FFH
   02e9                 SD_WT:
   02e9   db 53                 IN      SDDAT
   02eb   fe fe                 CPI     0FEH
   02ed   ca f6 02              JZ      SD_WT_OK
   02f0   05                    DCR     B
   02f1   c2 e9 02              JNZ     SD_WT
   02f4   37                    STC
   02f5   c9                    RET
   02f6                 SD_WT_OK:
   02f6   b7                    ORA     A               ; clear CY
   02f7   c9                    RET
                        
                        ; SD_READBLK: read a 512-byte data block into the buffer at (HL) after a
                        ;   command has returned R1=0 and the 0FEh token; discard 2 CRC bytes.
                        ;   Returns A = 1 ok / 0 err (CY used internally).
   02f8                 SD_READBLK:
   02f8   cd e7 02              CALL    SD_WAITTKN
   02fb   da 12 03              JC      SDRB_FAIL
   02fe   01 00 02              LXI     B,512
   0301                 SDRB_LP:
   0301   db 53                 IN      SDDAT
   0303   77                    MOV     M,A
   0304   23                    INX     H
   0305   0b                    DCX     B
   0306   78                    MOV     A,B
   0307   b1                    ORA     C
   0308   c2 01 03              JNZ     SDRB_LP
   030b   db 53                 IN      SDDAT           ; discard 2 CRC bytes
   030d   db 53                 IN      SDDAT
   030f   3e 01                 MVI     A,1
   0311   c9                    RET
   0312                 SDRB_FAIL:
   0312   3e 00                 MVI     A,0
   0314   c9                    RET
                        
                        ; SDCCS: read the OCR (CMD58) and return the Card Capacity Status bit.
                        ;   Returns A = 40h (SDHC/SDXC, block addressing) or 00h (SDSC, byte addressing).
                        ;   Assumes card selected (CS low).
   0315                 SDCCS:
   0315   21 cd 03              LXI     H,CMD58
   0318   cd c5 02              CALL    SD_SEND6        ; A = R1
   031b   db 53                 IN      SDDAT           ; OCR byte0 (bits31..24); CCS=bit30 => bit6
   031d   e6 40                 ANI     40H
   031f   4f                    MOV     C,A
   0320   db 53                 IN      SDDAT           ; consume OCR bytes 1..3
   0322   db 53                 IN      SDDAT
   0324   db 53                 IN      SDDAT
   0326   79                    MOV     A,C
   0327   c9                    RET
                        
                        ; SD_CID: read the 16-byte CID (CMD9) into CIDBUF.
                        ;   Returns A = 1 ok / 0 err.  Manages CS low -> read -> release high.
   0328                 SD_CID:
   0328   3e 00                 MVI     A,00H
   032a   d3 54                 OUT     SDCTL           ; select, fast
   032c   21 d9 03              LXI     H,CMD9
   032f   cd c5 02              CALL    SD_SEND6        ; A = R1
   0332   fe 00                 CPI     00H
   0334   c2 48 03              JNZ     SDCID_TE
   0337   21 76 05              LXI     H,CIDBUF
   033a   cd f8 02              CALL    SD_READBLK      ; A = 1 ok / 0 err
   033d   b7                    ORA     A
   033e   ca 48 03              JZ      SDCID_TE        ; read failed
   0341   3e 01                 MVI     A,01H
   0343   d3 54                 OUT     SDCTL           ; release CS
   0345   3e 00                 MVI     A,00H           ; success (matches SDINIT: 0 = ok)
   0347   c9                    RET
   0348                 SDCID_TE:
   0348   3e 01                 MVI     A,01H
   034a   d3 54                 OUT     SDCTL           ; release CS
   034c   3e ff                 MVI     A,0FFH          ; error
   034e   c9                    RET
                        
                        ; SD_BLK0: read block 0 (CMD17) into DBUF.
                        ;   Returns A = 1 ok / 0 err.
   034f                 SD_BLK0:
   034f   3e 00                 MVI     A,00H
   0351   d3 54                 OUT     SDCTL           ; select, fast
   0353   21 df 03              LXI     H,CMD17
   0356   cd c5 02              CALL    SD_SEND6        ; A = R1
   0359   fe 00                 CPI     00H
   035b   c2 6f 03              JNZ     SDBLK_TE
   035e   21 86 05              LXI     H,DBUF
   0361   cd f8 02              CALL    SD_READBLK      ; A = 1 ok / 0 err
   0364   b7                    ORA     A
   0365   ca 6f 03              JZ      SDBLK_TE
   0368   3e 01                 MVI     A,01H
   036a   d3 54                 OUT     SDCTL           ; release CS
   036c   3e 00                 MVI     A,00H           ; success
   036e   c9                    RET
   036f                 SDBLK_TE:
   036f   3e 01                 MVI     A,01H
   0371   d3 54                 OUT     SDCTL           ; release CS
   0373   3e ff                 MVI     A,0FFH          ; error
   0375   c9                    RET
                        
                        ; ---------------- console / numeric helpers (as in SWLED) ----------------
   0376                 PSTR:
   0376   54                    MOV     D,H
   0377   5d                    MOV     E,L
   0378   0e 09                 MVI     C,9
   037a   cd 05 00              CALL    5
   037d   c9                    RET
                        
   037e                 CPUTC:
   037e   0e 02                 MVI     C,2
   0380   cd 05 00              CALL    5
   0383   c9                    RET
                        
   0384                 CRLF:
   0384   1e 0d                 MVI     E,13
   0386   cd 7e 03              CALL    CPUTC
   0389   1e 0a                 MVI     E,10
   038b   cd 7e 03              CALL    CPUTC
   038e   c9                    RET
                        
                        ; PRHEX2 -- print the byte in A as two uppercase hex digits.
   038f                 PRHEX2:
   038f   32 6a 05              STA     HEXV
   0392   3a 6a 05              LDA     HEXV
   0395   0f                    RRC
   0396   0f                    RRC
   0397   0f                    RRC
   0398   0f                    RRC
   0399   e6 0f                 ANI     0FH
   039b   cd a7 03              CALL    PRNIB
   039e   3a 6a 05              LDA     HEXV
   03a1   e6 0f                 ANI     0FH
   03a3   cd a7 03              CALL    PRNIB
   03a6   c9                    RET
                        
   03a7                 PRNIB:
   03a7   fe 0a                 CPI     0AH
   03a9   da ae 03              JC      PRNIB_NUM
   03ac   c6 07                 ADI     07H
   03ae                 PRNIB_NUM:
   03ae   c6 30                 ADI     '0'
   03b0   5f                    MOV     E,A
   03b1   cd 7e 03              CALL    CPUTC
   03b4   c9                    RET
                        
                        ; ---------------- data ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   03b5   40 00 00 00   CMD0:   DB      40H,00H,00H,00H,00H,95H
   03b9   00 95         
   03bb   48 00 00 01   CMD8:   DB      48H,00H,00H,01H,0AAH,87H
   03bf   aa 87         
   03c1   77 00 00 00   CMD55:  DB      77H,00H,00H,00H,00H,65H
   03c5   00 65         
   03c7   69 40 00 00   ACMD41: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   03cb   00 77         
   03cd   7a 00 00 00   CMD58:  DB      7AH,00H,00H,00H,00H,0FDH
   03d1   00 fd         
   03d3   50 00 00 02   CMD16:  DB      50H,00H,00H,02H,00H,0FFH  ; set block length = 512
   03d7   00 ff         
   03d9   49 00 00 00   CMD9:   DB      49H,00H,00H,00H,00H,0FFH  ; read CID
   03dd   00 ff         
   03df   51 00 00 00   CMD17:  DB      51H,00H,00H,00H,00H,0FFH  ; read single block (block 0)
   03e3   00 ff         
                        
   03e5   53 44 50 52   BANNER: DB      'SDPROBE v0.1 - Brevia2 SD card probe',13,10,'$'
   03e9   4f 42 45 20   
   03ed   76 30 2e 31   
   03f1   20 2d 20 42   
   03f5   72 65 76 69   
   03f9   61 32 20 53   
   03fd   44 20 63 61   
   0401   72 64 20 70   
   0405   72 6f 62 65   
   0409   0d 0a 24      
   040c   49 4e 49 54   MSG_INI: DB      'INIT: CMD0 ok R1=','$'
   0410   3a 20 43 4d   
   0414   44 30 20 6f   
   0418   6b 20 52 31   
   041c   3d 24         
   041e   0d 0a 4e 4f   MSG_NOCARD: DB  13,10,'NO CARD / init failed','$'
   0422   20 43 41 52   
   0426   44 20 2f 20   
   042a   69 6e 69 74   
   042e   20 66 61 69   
   0432   6c 65 64 24   
   0436   0d 0a 43 4d   MSG_CMD0R: DB  13,10,'CMD0 raw resp: ','$'
   043a   44 30 20 72   
   043e   61 77 20 72   
   0442   65 73 70 3a   
   0446   20 24         
   0448   52 31 3d 24   MSG_R1:  DB  'R1=','$'
   044c   20 28 6e 6f   MSG_NORESP: DB ' (no response - check wiring/power, or the module may be dead)','$'
   0450   20 72 65 73   
   0454   70 6f 6e 73   
   0458   65 20 2d 20   
   045c   63 68 65 63   
   0460   6b 20 77 69   
   0464   72 69 6e 67   
   0468   2f 70 6f 77   
   046c   65 72 2c 20   
   0470   6f 72 20 74   
   0474   68 65 20 6d   
   0478   6f 64 75 6c   
   047c   65 20 6d 61   
   0480   79 20 62 65   
   0484   20 64 65 61   
   0488   64 29 24      
   048b   0d 0a 41 43   MSG_ACMD: DB  13,10,'ACMD41 polls=','$'
   048f   4d 44 34 31   
