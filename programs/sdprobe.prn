                        ; SDPROBE.COM -- Brevia2 SD-card probe (SPI mode), bare-metal driver demo.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port wired to pins 31/32/35/36:
                        ;   IN  0x53 = SD SPI data        (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl   bit0 = CS# (0 = select, 1 = release)
                        ;                           bit1 = slow clock (1 = ~390 kHz for card init)
                        ;   IN  0x55 = SD SPI status bit0 = transfer-busy
                        ;
                        ; The on-board flash SPI pins are not broken out, so the SD breakout has its
                        ; OWN SPI port (implemented as a second instance of the generic byte engine in
                        ; rtl/z80cpm_brevia2.v).
                        ;
                        ; What it does:
                        ;   1. Full SPI-mode init handshake (power-up clocks, CMD0, CMD8, CMD55/ACMD41,
                        ;      CMD58, CMD16) -- proves the card initializes on real silicon.
                        ;   2. Reads the CID (CMD9) and prints manufacturer ID, product name, serial.
                        ;   3. Reads block 0 (CMD17) and reports whether an MBR (55AA) is present,
                        ;      printing the first partition entry (type / LBA / size) -- the first
                        ;      step toward partitioning support.
                        ;
                        ; Console I/O via the normal BDOS (func 1/2/6/9).
   0100                         ORG     0100H
                        
   0100                 START:
   0100   21 f1 03              LXI     H,BANNER
   0103   cd 82 03              CALL    PSTR
                        
                                ; ---------------- 1. init the card ----------------
   0106   cd 59 02              CALL    SDINIT          ; A = 0 if init OK (CMD0 idle + ACMD41 ready), 0FFh if not
   0109   b7                    ORA     A
   010a   ca 72 01              JZ      INI_OK
                                ; ---- failure: report detailed diagnostics ----
   010d   21 2a 04              LXI     H,MSG_NOCARD
   0110   cd 82 03              CALL    PSTR
   0113   cd 90 03              CALL    CRLF
                                ; raw CMD0 response bytes
   0116   21 42 04              LXI     H,MSG_CMD0R
   0119   cd 82 03              CALL    PSTR
   011c   21 78 05              LXI     H,RBUF
   011f   06 08                 MVI     B,8
   0121                 SD_DIAG:
   0121   7e                    MOV     A,M
   0122   e5                    PUSH    H
   0123   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   0124   cd 9b 03              CALL    PRHEX2
   0127   1e 20                 MVI     E,' '
   0129   cd 8a 03              CALL    CPUTC
   012c   c1                    POP     B
   012d   e1                    POP     H
   012e   23                    INX     H
   012f   05                    DCR     B
   0130   c2 21 01              JNZ     SD_DIAG
   0133   cd 90 03              CALL    CRLF
                                ; interpreted R1
   0136   21 54 04              LXI     H,MSG_R1
   0139   cd 82 03              CALL    PSTR
   013c   3a 77 05              LDA     CMDR1
   013f   cd 9b 03              CALL    PRHEX2
   0142   cd 90 03              CALL    CRLF
   0145   3a 77 05              LDA     CMDR1
   0148   fe ff                 CPI     0FFH            ; no response at all?
   014a   c2 56 01              JNZ     SD_DIAG2
   014d   21 58 04              LXI     H,MSG_NORESP
   0150   cd 82 03              CALL    PSTR
   0153   cd 90 03              CALL    CRLF
   0156                 SD_DIAG2:
                                ; ACMD41 poll count + result
   0156   21 97 04              LXI     H,MSG_ACMD
   0159   cd 82 03              CALL    PSTR
   015c   3a 80 05              LDA     ACMDIT
   015f   cd 9b 03              CALL    PRHEX2          ; poll count (hex)
   0162   21 a7 04              LXI     H,MSG_ACMDR
   0165   cd 82 03              CALL    PSTR
   0168   3a 81 05              LDA     ACMDR1
   016b   cd 9b 03              CALL    PRHEX2
   016e   cd 90 03              CALL    CRLF
   0171   c9                    RET
   0172                 INI_OK:
   0172   21 18 04              LXI     H,MSG_INI
   0175   cd 82 03              CALL    PSTR
   0178   3a 77 05              LDA     CMDR1           ; show the CMD0 R1 (01h = idle) for hardware diagnostics
   017b   cd 9b 03              CALL    PRHEX2
   017e   cd 90 03              CALL    CRLF
                        
                                ; ---- detect card type (CMD58 -> OCR CCS bit30) ----
   0181   cd 21 03              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0184   b7                    ORA     A
   0185   ca 91 01              JZ      IS_SC
   0188   21 b0 04              LXI     H,MSG_SDHC
   018b   cd 82 03              CALL    PSTR
   018e   c3 97 01              JMP     AFTER_TYPE
   0191                 IS_SC:
   0191   21 d5 04              LXI     H,MSG_SDSC
   0194   cd 82 03              CALL    PSTR
   0197                 AFTER_TYPE:
   0197   cd 90 03              CALL    CRLF
                        
                                ; ---------------- 2. read CID ----------------
   019a   cd 34 03              CALL    SD_CID          ; A = 1 ok / 0 err
   019d   b7                    ORA     A
   019e   ca ad 01              JZ      CID_OK
   01a1   21 09 05              LXI     H,MSG_CIDERR
   01a4   cd 82 03              CALL    PSTR
   01a7   cd 90 03              CALL    CRLF
   01aa   c3 f4 01              JMP     AFTER_CID
   01ad                 CID_OK:
   01ad   21 f4 04              LXI     H,MSG_CID
   01b0   cd 82 03              CALL    PSTR
                                ; manufacturer ID (CID[0])
   01b3   3a 82 05              LDA     CIDBUF
   01b6   cd 9b 03              CALL    PRHEX2
   01b9   1e 20                 MVI     E,' '
   01bb   cd 8a 03              CALL    CPUTC
                                ; product name (CID[3..7], 5 ASCII bytes)
   01be   21 85 05              LXI     H,CIDBUF+3
   01c1   06 05                 MVI     B,5
   01c3                 CID_NM:
   01c3   5e                    MOV     E,M
   01c4   e5                    PUSH    H
   01c5   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   01c6   cd 8a 03              CALL    CPUTC
   01c9   c1                    POP     B
   01ca   e1                    POP     H
   01cb   23                    INX     H
   01cc   05                    DCR     B
   01cd   c2 c3 01              JNZ     CID_NM
   01d0   cd 90 03              CALL    CRLF
                                ; serial number (CID[9..12])
   01d3   21 ff 04              LXI     H,MSG_SN
   01d6   cd 82 03              CALL    PSTR
   01d9   3a 8b 05              LDA     CIDBUF+9
   01dc   cd 9b 03              CALL    PRHEX2
   01df   3a 8c 05              LDA     CIDBUF+10
   01e2   cd 9b 03              CALL    PRHEX2
   01e5   3a 8d 05              LDA     CIDBUF+11
   01e8   cd 9b 03              CALL    PRHEX2
   01eb   3a 8e 05              LDA     CIDBUF+12
   01ee   cd 9b 03              CALL    PRHEX2
   01f1   cd 90 03              CALL    CRLF
   01f4                 AFTER_CID:
                        
                                ; ---------------- 3. read block 0 + MBR check ----------------
   01f4   cd 5b 03              CALL    SD_BLK0         ; A = 1 ok / 0 err
   01f7   b7                    ORA     A
   01f8   ca 07 02              JZ      BLK_OK
   01fb   21 1b 05              LXI     H,MSG_BLKERR
   01fe   cd 82 03              CALL    PSTR
   0201   cd 90 03              CALL    CRLF
   0204   c3 4f 02              JMP     AFTER_BLK
   0207                 BLK_OK:
                                ; check MBR signature 55AA at DBUF+510
   0207   21 90 07              LXI     H,DBUF+510
   020a   7e                    MOV     A,M
   020b   fe 55                 CPI     55H
   020d   c2 46 02              JNZ     NO_MBR
   0210   23                    INX     H
   0211   7e                    MOV     A,M
   0212   fe aa                 CPI     0AAH
   0214   c2 46 02              JNZ     NO_MBR
                                ; MBR present -> print partition 1 info
   0217   21 31 05              LXI     H,MSG_MBR
   021a   cd 82 03              CALL    PSTR
                                ; type byte at DBUF+446+4
   021d   21 54 07              LXI     H,DBUF+446+4
   0220   7e                    MOV     A,M
   0221   cd 9b 03              CALL    PRHEX2
   0224   1e 20                 MVI     E,' '
   0226   cd 8a 03              CALL    CPUTC
                                ; LBA start (bytes +8..+11, little-endian); size (+12..+15)
   0229   21 58 07              LXI     H,DBUF+446+8
   022c   06 08                 MVI     B,8             ; 4 LBA bytes + 4 size bytes
   022e                 MBR_LP:
   022e   7e                    MOV     A,M
   022f   e5                    PUSH    H
   0230   c5                    PUSH    B               ; BDOS func2 clobbers B/HL -- save loop state
   0231   cd 9b 03              CALL    PRHEX2
   0234   1e 20                 MVI     E,' '
   0236   cd 8a 03              CALL    CPUTC
   0239   c1                    POP     B
   023a   e1                    POP     H
   023b   23                    INX     H
   023c   05                    DCR     B
   023d   c2 2e 02              JNZ     MBR_LP
   0240   cd 90 03              CALL    CRLF
   0243   c3 4f 02              JMP     AFTER_BLK
   0246                 NO_MBR:
   0246   21 5d 05              LXI     H,MSG_NOMBR
   0249   cd 82 03              CALL    PSTR
   024c   cd 90 03              CALL    CRLF
   024f                 AFTER_BLK:
                        
   024f   21 6f 05              LXI     H,MSG_DONE
   0252   cd 82 03              CALL    PSTR
   0255   cd 90 03              CALL    CRLF
   0258   c9                    RET
                        
                        ; ================= SD card driver subroutines =================
                        
                        ; SDINIT: full SPI-mode initialization.
                        ;   Success: A = 0  (CMDR1 = 01h idle, card ready).
                        ;   Failure: A = 0FFh, with diagnostics: CMDR1 = CMD0 R1 (or 0FFh if no
                        ;            response), RBUF = raw CMD0 response bytes, ACMDIT = ACMD41 poll
                        ;            count, ACMDR1 = final ACMD41 result.
   0259                 SDINIT:
   0259   3e 03                 MVI     A,03H           ; bit0=1 (CS high), bit1=1 (slow)
   025b   d3 54                 OUT     SDCTL
   025d   06 0a                 MVI     B,10            ; 10 byte-writes = 80 power-up clocks (CS# high)
   025f                 SDI_CK:
   025f   3e ff                 MVI     A,0FFH
   0261   d3 53                 OUT     SDDAT
   0263   05                    DCR     B
   0264   c2 5f 02              JNZ     SDI_CK
   0267   3e 02                 MVI     A,02H           ; select card (CS low), stay on slow clock
   0269   d3 54                 OUT     SDCTL
                                ; --- send CMD0, then capture the raw response bytes ---
   026b   21 c1 03              LXI     H,CMD0
   026e   06 06                 MVI     B,6
   0270                 SDI_TX:
   0270   7e                    MOV     A,M
   0271   d3 53                 OUT     SDDAT
   0273   23                    INX     H
   0274   05                    DCR     B
   0275   c2 70 02              JNZ     SDI_TX
   0278   21 78 05              LXI     H,RBUF
   027b   06 08                 MVI     B,8
   027d                 SDI_RX:
   027d   db 53                 IN      SDDAT
   027f   77                    MOV     M,A
   0280   23                    INX     H
   0281   05                    DCR     B
   0282   c2 7d 02              JNZ     SDI_RX
                                ; find the first byte that is not 0FFh = R1
   0285   21 78 05              LXI     H,RBUF
   0288   06 08                 MVI     B,8
   028a                 SDI_FR1:
   028a   7e                    MOV     A,M
   028b   fe ff                 CPI     0FFH
   028d   c2 9a 02              JNZ     SDI_HAVE
   0290   23                    INX     H
   0291   05                    DCR     B
   0292   c2 8a 02              JNZ     SDI_FR1
   0295   3e ff                 MVI     A,0FFH          ; no valid response at all
   0297   c3 9b 02              JMP     SDI_ST1
   029a                 SDI_HAVE:
   029a   7e                    MOV     A,M
   029b                 SDI_ST1:
   029b   32 77 05              STA     CMDR1
   029e   fe 01                 CPI     01H             ; must be in idle state to continue
   02a0   c2 cb 02              JNZ     SDI_FAIL
                                ; --- poll CMD55+ACMD41 until the card leaves idle.  Card init is
                                ;     time-based, so we wait a real delay between attempts (CS# stays
                                ;     selected on the slow clock; the data-read routines switch to the
                                ;     fast clock once the card is ready). ---
   02a3   16 c8                 MVI     D,200           ; up to 200 attempts
   02a5   af                    XRA     A
   02a6   32 80 05              STA     ACMDIT
   02a9                 SDI_RDY:
   02a9   21 cd 03              LXI     H,CMD55
   02ac   cd d1 02              CALL    SD_SEND6
   02af   21 d3 03              LXI     H,ACMD41
   02b2   cd d1 02              CALL    SD_SEND6        ; A = R1
   02b5   32 81 05              STA     ACMDR1
   02b8   fe 00                 CPI     00H
   02ba   ca ce 02              JZ      SDI_OK
   02bd   3a 80 05              LDA     ACMDIT
   02c0   3c                    INR     A
   02c1   32 80 05              STA     ACMDIT
   02c4   cd e9 02              CALL    DELAYMS         ; ~3ms pause before the next attempt
   02c7   15                    DCR     D
   02c8   c2 a9 02              JNZ     SDI_RDY
   02cb                 SDI_FAIL:
   02cb   3e ff                 MVI     A,0FFH
   02cd   c9                    RET
   02ce                 SDI_OK:
   02ce   3e 00                 MVI     A,00H
   02d0   c9                    RET
                        
                        
                        ; SD_SEND6: transmit the 6-byte command at (HL), then read the R1 status byte.
                        ;   Assumes the card is already selected (CS low).  Returns A = R1 (0FFh = no
                        ;   valid response after 16 bytes of clocking).
   02d1                 SD_SEND6:
   02d1   06 06                 MVI     B,6
   02d3                 SD6_TX:
   02d3   7e                    MOV     A,M
   02d4   d3 53                 OUT     SDDAT
   02d6   23                    INX     H
   02d7   05                    DCR     B
   02d8   c2 d3 02              JNZ     SD6_TX
   02db   06 10                 MVI     B,16            ; clock up to 16 bytes looking for the response
   02dd                 SD6_RX:
   02dd   db 53                 IN      SDDAT           ; clocks out FFh, returns the MISO byte
   02df   fe ff                 CPI     0FFH
   02e1   c2 e8 02              JNZ     SD6_DONE
   02e4   05                    DCR     B
   02e5   c2 dd 02              JNZ     SD6_RX
   02e8                 SD6_DONE:
   02e8   c9                    RET
                        
                        ; DELAYMS - approximate ~3ms busy-wait (uses HL only; used between SD init
                        ;   polls because SD card initialization is time-based, not clock-based).
   02e9                 DELAYMS:
   02e9   21 d0 07              LXI     H,2000
   02ec                 DLMS:
   02ec   2b                    DCX     H
   02ed   7c                    MOV     A,H
   02ee   b5                    ORA     L
   02ef   c2 ec 02              JNZ     DLMS
   02f2   c9                    RET
                        
                        ; SD_WAITTKN: clock until the card sends the 0FEh data-start token.
                        ;   Returns CY=0 + A=0FEh on success; CY=1 if 255 bytes pass with no token.
   02f3                 SD_WAITTKN:
   02f3   06 ff                 MVI     B,0FFH
   02f5                 SD_WT:
   02f5   db 53                 IN      SDDAT
   02f7   fe fe                 CPI     0FEH
   02f9   ca 02 03              JZ      SD_WT_OK
   02fc   05                    DCR     B
   02fd   c2 f5 02              JNZ     SD_WT
   0300   37                    STC
   0301   c9                    RET
   0302                 SD_WT_OK:
   0302   b7                    ORA     A               ; clear CY
   0303   c9                    RET
                        
                        ; SD_READBLK: read a 512-byte data block into the buffer at (HL) after a
                        ;   command has returned R1=0 and the 0FEh token; discard 2 CRC bytes.
                        ;   Returns A = 1 ok / 0 err (CY used internally).
   0304                 SD_READBLK:
   0304   cd f3 02              CALL    SD_WAITTKN
   0307   da 1e 03              JC      SDRB_FAIL
   030a   01 00 02              LXI     B,512
   030d                 SDRB_LP:
   030d   db 53                 IN      SDDAT
   030f   77                    MOV     M,A
   0310   23                    INX     H
   0311   0b                    DCX     B
   0312   78                    MOV     A,B
   0313   b1                    ORA     C
   0314   c2 0d 03              JNZ     SDRB_LP
   0317   db 53                 IN      SDDAT           ; discard 2 CRC bytes
   0319   db 53                 IN      SDDAT
   031b   3e 01                 MVI     A,1
   031d   c9                    RET
   031e                 SDRB_FAIL:
   031e   3e 00                 MVI     A,0
   0320   c9                    RET
                        
                        ; SDCCS: read the OCR (CMD58) and return the Card Capacity Status bit.
                        ;   Returns A = 40h (SDHC/SDXC, block addressing) or 00h (SDSC, byte addressing).
                        ;   Assumes card selected (CS low).
   0321                 SDCCS:
   0321   21 d9 03              LXI     H,CMD58
   0324   cd d1 02              CALL    SD_SEND6        ; A = R1
   0327   db 53                 IN      SDDAT           ; OCR byte0 (bits31..24); CCS=bit30 => bit6
   0329   e6 40                 ANI     40H
   032b   4f                    MOV     C,A
   032c   db 53                 IN      SDDAT           ; consume OCR bytes 1..3
   032e   db 53                 IN      SDDAT
   0330   db 53                 IN      SDDAT
   0332   79                    MOV     A,C
   0333   c9                    RET
                        
                        ; SD_CID: read the 16-byte CID (CMD9) into CIDBUF.
                        ;   Returns A = 1 ok / 0 err.  Manages CS low -> read -> release high.
   0334                 SD_CID:
   0334   3e 00                 MVI     A,00H
   0336   d3 54                 OUT     SDCTL           ; select, fast
   0338   21 e5 03              LXI     H,CMD9
   033b   cd d1 02              CALL    SD_SEND6        ; A = R1
   033e   fe 00                 CPI     00H
   0340   c2 54 03              JNZ     SDCID_TE
   0343   21 82 05              LXI     H,CIDBUF
   0346   cd 04 03              CALL    SD_READBLK      ; A = 1 ok / 0 err
   0349   b7                    ORA     A
   034a   ca 54 03              JZ      SDCID_TE        ; read failed
   034d   3e 01                 MVI     A,01H
   034f   d3 54                 OUT     SDCTL           ; release CS
   0351   3e 00                 MVI     A,00H           ; success (matches SDINIT: 0 = ok)
   0353   c9                    RET
   0354                 SDCID_TE:
   0354   3e 01                 MVI     A,01H
   0356   d3 54                 OUT     SDCTL           ; release CS
   0358   3e ff                 MVI     A,0FFH          ; error
   035a   c9                    RET
                        
                        ; SD_BLK0: read block 0 (CMD17) into DBUF.
                        ;   Returns A = 1 ok / 0 err.
   035b                 SD_BLK0:
   035b   3e 00                 MVI     A,00H
   035d   d3 54                 OUT     SDCTL           ; select, fast
   035f   21 eb 03              LXI     H,CMD17
   0362   cd d1 02              CALL    SD_SEND6        ; A = R1
   0365   fe 00                 CPI     00H
   0367   c2 7b 03              JNZ     SDBLK_TE
   036a   21 92 05              LXI     H,DBUF
   036d   cd 04 03              CALL    SD_READBLK      ; A = 1 ok / 0 err
   0370   b7                    ORA     A
   0371   ca 7b 03              JZ      SDBLK_TE
   0374   3e 01                 MVI     A,01H
   0376   d3 54                 OUT     SDCTL           ; release CS
   0378   3e 00                 MVI     A,00H           ; success
   037a   c9                    RET
   037b                 SDBLK_TE:
   037b   3e 01                 MVI     A,01H
   037d   d3 54                 OUT     SDCTL           ; release CS
   037f   3e ff                 MVI     A,0FFH          ; error
   0381   c9                    RET
                        
                        ; ---------------- console / numeric helpers (as in SWLED) ----------------
   0382                 PSTR:
   0382   54                    MOV     D,H
   0383   5d                    MOV     E,L
   0384   0e 09                 MVI     C,9
   0386   cd 05 00              CALL    5
   0389   c9                    RET
                        
   038a                 CPUTC:
   038a   0e 02                 MVI     C,2
   038c   cd 05 00              CALL    5
   038f   c9                    RET
                        
   0390                 CRLF:
   0390   1e 0d                 MVI     E,13
   0392   cd 8a 03              CALL    CPUTC
   0395   1e 0a                 MVI     E,10
   0397   cd 8a 03              CALL    CPUTC
   039a   c9                    RET
                        
                        ; PRHEX2 -- print the byte in A as two uppercase hex digits.
   039b                 PRHEX2:
   039b   32 76 05              STA     HEXV
   039e   3a 76 05              LDA     HEXV
   03a1   0f                    RRC
   03a2   0f                    RRC
   03a3   0f                    RRC
   03a4   0f                    RRC
   03a5   e6 0f                 ANI     0FH
   03a7   cd b3 03              CALL    PRNIB
   03aa   3a 76 05              LDA     HEXV
   03ad   e6 0f                 ANI     0FH
   03af   cd b3 03              CALL    PRNIB
   03b2   c9                    RET
                        
   03b3                 PRNIB:
   03b3   fe 0a                 CPI     0AH
   03b5   da ba 03              JC      PRNIB_NUM
   03b8   c6 07                 ADI     07H
   03ba                 PRNIB_NUM:
   03ba   c6 30                 ADI     '0'
   03bc   5f                    MOV     E,A
   03bd   cd 8a 03              CALL    CPUTC
   03c0   c9                    RET
                        
                        ; ---------------- data ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   03c1   40 00 00 00   CMD0:   DB      40H,00H,00H,00H,00H,95H
   03c5   00 95         
   03c7   48 00 00 01   CMD8:   DB      48H,00H,00H,01H,0AAH,87H
   03cb   aa 87         
   03cd   77 00 00 00   CMD55:  DB      77H,00H,00H,00H,00H,65H
   03d1   00 65         
   03d3   69 40 00 00   ACMD41: DB      69H,40H,00H,00H,00H,77H   ; HCS bit -> SDHC/SDXC
   03d7   00 77         
   03d9   7a 00 00 00   CMD58:  DB      7AH,00H,00H,00H,00H,0FDH
   03dd   00 fd         
   03df   50 00 00 02   CMD16:  DB      50H,00H,00H,02H,00H,0FFH  ; set block length = 512
   03e3   00 ff         
   03e5   49 00 00 00   CMD9:   DB      49H,00H,00H,00H,00H,0FFH  ; read CID
   03e9   00 ff         
   03eb   51 00 00 00   CMD17:  DB      51H,00H,00H,00H,00H,0FFH  ; read single block (block 0)
   03ef   00 ff         
                        
   03f1   53 44 50 52   BANNER: DB      'SDPROBE v0.1 - Brevia2 SD card probe',13,10,'$'
   03f5   4f 42 45 20   
   03f9   76 30 2e 31   
   03fd   20 2d 20 42   
   0401   72 65 76 69   
   0405   61 32 20 53   
   0409   44 20 63 61   
   040d   72 64 20 70   
   0411   72 6f 62 65   
   0415   0d 0a 24      
   0418   49 4e 49 54   MSG_INI: DB      'INIT: CMD0 ok R1=','$'
   041c   3a 20 43 4d   
   0420   44 30 20 6f   
   0424   6b 20 52 31   
   0428   3d 24         
   042a   0d 0a 4e 4f   MSG_NOCARD: DB  13,10,'NO CARD / init failed','$'
   042e   20 43 41 52   
   0432   44 20 2f 20   
   0436   69 6e 69 74   
   043a   20 66 61 69   
   043e   6c 65 64 24   
   0442   0d 0a 43 4d   MSG_CMD0R: DB  13,10,'CMD0 raw resp: ','$'
   0446   44 30 20 72   
   044a   61 77 20 72   
   044e   65 73 70 3a   
   0452   20 24         
   0454   52 31 3d 24   MSG_R1:  DB  'R1=','$'
   0458   20 28 6e 6f   MSG_NORESP: DB ' (no response - check wiring/power, or the module may be dead)','$'
   045c   20 72 65 73   
   0460   70 6f 6e 73   
   0464   65 20 2d 20   
   0468   63 68 65 63   
