                        ; SDTOOL.COM -- Brevia2 SD card partition / format / test tool for CP/M 2.2.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port (pins 31/32/35/36):
                        ;   IN  0x53 = SD SPI data (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl  bit0 = CS# (0 select, 1 release); bit1 = slow clock
                        ;   IN  0x55 = SD SPI status bit0 = busy
                        ;
                        ; Commands:
                        ;   I -- init + info: card type, CID (manufacturer/product/serial), test read.
                        ;   P -- read the MBR (block 0) and print the partition table.
                        ;   C -- create an MBR with one CP/M partition (type 0x53) and write block 0.
                        ;   F -- format the CP/M partition: write the directory area to 0xE5.
                        ;   Q -- quit.
                        ;
                        ; The SD CP/M partition geometry (MUST match the CBIOS DPB):
                        ;   128-byte records, SPT=32, 8KB allocation blocks (BSH=6/BLM=63),
                        ;   DSM=1023 (DOUBLE-DM, 1024 blocks x 8KB = 8 MB per drive = CP/M 2.2 ceiling),
                        ;   DRM=4095 (4096 directory entries = 128KB = 16 blocks, reserved via
                        ;   AL0=0xFF/AL1=0xFF), EXM=3, CKS=0, OFF=0 (the region/system offsets are added
                        ;   at the CBIOS deblock layer).  TWO 8 MB logical drives are formatted: each
                        ;   volume reserves a SD_SYS-sector system area at its region start (to hold a
                        ;   bootable CP/M image) and the directory/data begin PAST it -- region 0 (drive
                        ;   A) at partition LBA + SD_SYS, region 1 (drive B) at +8 MB + SD_SYS.  Each
                        ;   directory = 128KB = 256 x 512B SD sectors written as 0xE5; the reserved
                        ;   system area is left blank (0xFF) for the boot image (the CBIOS BOOT
                        ;   self-provisions it).  Partition 1 starts at LBA 1, size 0x00020000 sectors
                        ;   (64 MB -- drives A:/B: currently use the first 16 MB of it).
                        ;
                        ; NOTE on BDOS register clobbering: every console-call loop preserves B/HL
                        ; across CPUTC/func-2 with PUSH/POP (func 2 destroys B and HL on this CBIOS).
   0100                         ORG     0100H
                        
                        ; ---------------- constants ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   0020                 SPT     EQU     32              ; sectors (128B) per track  [geometry]
   0006                 BSH     EQU     6               ; 8KB allocation blocks
   003f                 BLM     EQU     63
   0003                 EXM     EQU     3               ; BLS=8192 & DSM>255 -> double-DM (16-bit block ptrs)
   03ff                 DSM     EQU     1023            ; 8 MB (1024 blocks x 8KB = CP/M 2.2 ceiling)
   0fff                 DRM     EQU     4095            ; 4096 directory entries
   00ff                 AL0V    EQU     0FFH            ; reserve directory blocks 0-7 (MSB-first)
   00ff                 AL1V    EQU     0FFH            ; reserve directory blocks 8-15 (16 blocks = 128KB dir)
                        
                        ; ---- reserved SD system area (must match cbios.asm SDSYS_OFF) ----------------
                        ; Each SD volume reserves SD_SYS 512-byte sectors at its region start to hold a
                        ; bootable CP/M image.  The directory/data area begins PAST this offset, so the
                        ; formatter must skip the reserved system area.  In the SD-primary build SD_SYS=
                        ; 16 (SDSYS_OFF); in the legacy SPI-primary build the SD drives are pure data and
                        ; SD_SYS=0 (set it to 0 before formatting for an SPI-primary card).
   0010                 SD_SYS  EQU     16
                        
   0053                 PMTYPE  EQU     53H             ; CP/M partition type (no standard MBR type exists)
   0001                 PARTLBA0 EQU    01H             ; partition 1 LBA start = 1 (LE byte 0)
   0000                 PARTSEC0 EQU    00H             ; partition size = 0x00020000 (LE: 00 00 02 00)
   0000                 PARTSEC1 EQU    00H
   0002                 PARTSEC2 EQU    02H
   0000                 PARTSEC3 EQU    00H
                        
   0100                 START:
   0100   21 d7 06              LXI     H,BANNER
   0103   cd 57 06              CALL    PSTR
                        
   0106                 MAINLOOP:
   0106   1e 3e                 MVI     E,'>'
   0108   cd 5f 06              CALL    CPUTC
   010b   cd 65 06              CALL    CIN             ; A = command char (echoed by func1)
                                ; fold lower-case a-z -> upper
   010e   fe 61                 CPI     'a'
   0110   da 1a 01              JC      ML1
   0113   fe 7b                 CPI     7BH
   0115   d2 1a 01              JNC     ML1
   0118   d6 20                 SUI     20H
   011a                 ML1:
   011a   fe 49                 CPI     'I'
   011c   c2 25 01              JNZ     ML_P
   011f   cd 55 01              CALL    CMD_INFO
   0122   c3 06 01              JMP     MAINLOOP
   0125                 ML_P:
   0125   fe 50                 CPI     'P'
   0127   c2 30 01              JNZ     ML_C
   012a   cd 01 02              CALL    CMD_PART
   012d   c3 06 01              JMP     MAINLOOP
   0130                 ML_C:
   0130   fe 43                 CPI     'C'
   0132   c2 3b 01              JNZ     ML_F
   0135   cd 9e 02              CALL    CMD_CREATE
   0138   c3 06 01              JMP     MAINLOOP
   013b                 ML_F:
   013b   fe 46                 CPI     'F'
   013d   c2 46 01              JNZ     ML_Q
   0140   cd 16 03              CALL    CMD_FORMAT
   0143   c3 06 01              JMP     MAINLOOP
   0146                 ML_Q:
   0146   fe 51                 CPI     'Q'
   0148   c2 4c 01              JNZ     ML_UNK
   014b   c9                    RET                     ; quit to CP/M (returns to the CCP)
   014c                 ML_UNK:
   014c   21 30 07              LXI     H,MSG_UNK
   014f   cd 57 06              CALL    PSTR
   0152   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- I: init + info ----------------
   0155                 CMD_INFO:
   0155   cd 13 04              CALL    SDINIT
   0158   b7                    ORA     A
   0159   ca 66 01              JZ      CI_OK
   015c   21 34 07              LXI     H,MSG_NOINIT
   015f   cd 57 06              CALL    PSTR
   0162   cd 6b 06              CALL    CRLF
   0165   c9                    RET
   0166                 CI_OK:
   0166   21 4c 07              LXI     H,MSG_INITOK
   0169   cd 57 06              CALL    PSTR
   016c   cd 6b 06              CALL    CRLF
                                ; card type
   016f   cd c0 05              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0172   b7                    ORA     A
   0173   ca 7f 01              JZ      CI_SC
   0176   21 54 07              LXI     H,MSG_SDHC
   0179   cd 57 06              CALL    PSTR
   017c   c3 85 01              JMP     CI_AFTTYPE
   017f                 CI_SC:
   017f   21 79 07              LXI     H,MSG_SDSC
   0182   cd 57 06              CALL    PSTR
   0185                 CI_AFTTYPE:
   0185   cd 6b 06              CALL    CRLF
                                ; CID
   0188   cd d3 05              CALL    SD_CID
   018b   b7                    ORA     A
   018c   ca 99 01              JZ      CI_CIDOK
   018f   21 ad 07              LXI     H,MSG_CIDERR
   0192   cd 57 06              CALL    PSTR
   0195   cd 6b 06              CALL    CRLF
   0198   c9                    RET
   0199                 CI_CIDOK:
   0199   21 98 07              LXI     H,MSG_CID
   019c   cd 57 06              CALL    PSTR
   019f   3a 8d 08              LDA     CIDBUF
   01a2   cd 76 06              CALL    PRHEX2
   01a5   1e 20                 MVI     E,' '
   01a7   cd 5f 06              CALL    CPUTC
   01aa   21 90 08              LXI     H,CIDBUF+3
   01ad   06 05                 MVI     B,5
   01af                 CI_NM:
   01af   5e                    MOV     E,M
   01b0   e5                    PUSH    H
   01b1   c5                    PUSH    B
   01b2   cd 5f 06              CALL    CPUTC
   01b5   c1                    POP     B
   01b6   e1                    POP     H
   01b7   23                    INX     H
   01b8   05                    DCR     B
   01b9   c2 af 01              JNZ     CI_NM
   01bc   cd 6b 06              CALL    CRLF
   01bf   21 a3 07              LXI     H,MSG_SN
   01c2   cd 57 06              CALL    PSTR
   01c5   3a 96 08              LDA     CIDBUF+9
   01c8   cd 76 06              CALL    PRHEX2
   01cb   3a 97 08              LDA     CIDBUF+10
   01ce   cd 76 06              CALL    PRHEX2
   01d1   3a 98 08              LDA     CIDBUF+11
   01d4   cd 76 06              CALL    PRHEX2
   01d7   3a 99 08              LDA     CIDBUF+12
   01da   cd 76 06              CALL    PRHEX2
   01dd   cd 6b 06              CALL    CRLF
                                ; test read block 0
   01e0   cd e7 04              CALL    SD_SETBLK0
   01e3   21 9d 08              LXI     H,BLKBUF
   01e6   cd f5 04              CALL    SD_READBLKN
   01e9   b7                    ORA     A
   01ea   c2 f7 01              JNZ     CI_BLKERR
   01ed   21 bf 07              LXI     H,MSG_RDOK
   01f0   cd 57 06              CALL    PSTR
   01f3   cd 6b 06              CALL    CRLF
   01f6   c9                    RET
   01f7                 CI_BLKERR:
   01f7   21 d1 07              LXI     H,MSG_RDERR
   01fa   cd 57 06              CALL    PSTR
   01fd   cd 6b 06              CALL    CRLF
   0200   c9                    RET
                        
                        ; ---------------- P: show MBR partitions ----------------
   0201                 CMD_PART:
   0201   cd 13 04              CALL    SDINIT
   0204   b7                    ORA     A
   0205   ca 12 02              JZ      CP_OK
   0208   21 34 07              LXI     H,MSG_NOINIT
   020b   cd 57 06              CALL    PSTR
   020e   cd 6b 06              CALL    CRLF
   0211   c9                    RET
   0212                 CP_OK:
   0212   cd e7 04              CALL    SD_SETBLK0
   0215   21 9d 08              LXI     H,BLKBUF
   0218   cd f5 04              CALL    SD_READBLKN
   021b   b7                    ORA     A
   021c   ca 29 02              JZ      CP_MBROK
   021f   21 d1 07              LXI     H,MSG_RDERR
   0222   cd 57 06              CALL    PSTR
   0225   cd 6b 06              CALL    CRLF
   0228   c9                    RET
   0229                 CP_MBROK:
                                ; check 55AA
   0229   21 9b 0a              LXI     H,BLKBUF+510
   022c   7e                    MOV     A,M
   022d   fe 55                 CPI     55H
   022f   c2 94 02              JNZ     CP_NOMBR
   0232   23                    INX     H
   0233   7e                    MOV     A,M
   0234   fe aa                 CPI     0AAH
   0236   c2 94 02              JNZ     CP_NOMBR
   0239   21 e5 07              LXI     H,MSG_MBR
   023c   cd 57 06              CALL    PSTR
   023f   cd 6b 06              CALL    CRLF
                                ; print 4 partitions
   0242   21 5b 0a              LXI     H,BLKBUF+446
   0245   22 72 08              SHLD    ENTPTR
   0248   16 04                 MVI     D,4
   024a                 CP_LP:
                                ; status (+0)
   024a   2a 72 08              LHLD    ENTPTR
   024d   7e                    MOV     A,M
   024e   cd 76 06              CALL    PRHEX2
   0251   1e 20                 MVI     E,' '
   0253   cd 5f 06              CALL    CPUTC
                                ; type (+4)
   0256   2a 72 08              LHLD    ENTPTR
   0259   3e 04                 MVI     A,4
   025b   cd ac 06              CALL    ADDH
   025e   7e                    MOV     A,M
   025f   cd 76 06              CALL    PRHEX2
   0262   1e 20                 MVI     E,' '
   0264   cd 5f 06              CALL    CPUTC
                                ; LBA (+8, 4 bytes LE)
   0267   2a 72 08              LHLD    ENTPTR
   026a   3e 08                 MVI     A,8
   026c   cd ac 06              CALL    ADDH
   026f   cd 9c 06              CALL    PRHEX32
   0272   1e 20                 MVI     E,' '
   0274   cd 5f 06              CALL    CPUTC
                                ; size (+12, 4 bytes LE)
   0277   2a 72 08              LHLD    ENTPTR
   027a   3e 0c                 MVI     A,12
   027c   cd ac 06              CALL    ADDH
   027f   cd 9c 06              CALL    PRHEX32
   0282   cd 6b 06              CALL    CRLF
                                ; next entry
   0285   2a 72 08              LHLD    ENTPTR
   0288   01 10 00              LXI     B,16
   028b   09                    DAD     B
   028c   22 72 08              SHLD    ENTPTR
   028f   15                    DCR     D
   0290   c2 4a 02              JNZ     CP_LP
   0293   c9                    RET
   0294                 CP_NOMBR:
   0294   21 09 08              LXI     H,MSG_NOMBR
   0297   cd 57 06              CALL    PSTR
   029a   cd 6b 06              CALL    CRLF
   029d   c9                    RET
                        
                        ; ---------------- C: create an MBR with one CP/M partition ----------------
   029e                 CMD_CREATE:
   029e   cd 13 04              CALL    SDINIT
   02a1   b7                    ORA     A
   02a2   ca af 02              JZ      CC_OK
   02a5   21 34 07              LXI     H,MSG_NOINIT
   02a8   cd 57 06              CALL    PSTR
   02ab   cd 6b 06              CALL    CRLF
   02ae   c9                    RET
   02af                 CC_OK:
                                ; zero BLKBUF
   02af   21 9d 08              LXI     H,BLKBUF
   02b2   06 00                 MVI     B,0
   02b4                 CC_Z:
   02b4   36 00                 MVI     M,0
   02b6   23                    INX     H
   02b7   05                    DCR     B
   02b8   c2 b4 02              JNZ     CC_Z
                                ; partition 1 entry at BLKBUF+446
   02bb   21 5b 0a              LXI     H,BLKBUF+446
   02be   36 80                 MVI     M,80H           ; bootable status
   02c0   23                    INX     H
   02c1   36 01                 MVI     M,01H           ; CHS start head
   02c3   23                    INX     H
   02c4   36 01                 MVI     M,01H           ; sector
   02c6   23                    INX     H
   02c7   36 00                 MVI     M,00H           ; cyl
   02c9   23                    INX     H
   02ca   36 53                 MVI     M,PMTYPE        ; type 0x53 (CP/M)
   02cc   23                    INX     H
   02cd   36 ff                 MVI     M,0FFH          ; CHS end head
   02cf   23                    INX     H
   02d0   36 fe                 MVI     M,0FEH          ; sector
   02d2   23                    INX     H
   02d3   36 ff                 MVI     M,0FFH          ; cyl
   02d5   23                    INX     H
   02d6   36 01                 MVI     M,PARTLBA0      ; LBA start LE byte0 = 1
   02d8   23                    INX     H
   02d9   36 00                 MVI     M,00H
   02db   23                    INX     H
   02dc   36 00                 MVI     M,00H
   02de   23                    INX     H
   02df   36 00                 MVI     M,00H
   02e1   23                    INX     H
   02e2   36 00                 MVI     M,PARTSEC0      ; size LE
   02e4   23                    INX     H
   02e5   36 00                 MVI     M,PARTSEC1
   02e7   23                    INX     H
   02e8   36 02                 MVI     M,PARTSEC2
   02ea   23                    INX     H
   02eb   36 00                 MVI     M,PARTSEC3
                                ; signature 55AA
   02ed   21 9b 0a              LXI     H,BLKBUF+510
   02f0   36 55                 MVI     M,55H
   02f2   23                    INX     H
   02f3   36 aa                 MVI     M,0AAH
                                ; write block 0
   02f5   cd e7 04              CALL    SD_SETBLK0
   02f8   21 9d 08              LXI     H,BLKBUF
   02fb   cd 4d 05              CALL    SD_WRITEBLKN
   02fe   b7                    ORA     A
   02ff   ca 0c 03              JZ      CC_WOK
   0302   21 1b 08              LXI     H,MSG_WERR
   0305   cd 57 06              CALL    PSTR
   0308   cd 6b 06              CALL    CRLF
   030b   c9                    RET
   030c                 CC_WOK:
   030c   21 2a 08              LXI     H,MSG_WROTE
   030f   cd 57 06              CALL    PSTR
   0312   cd 6b 06              CALL    CRLF
   0315   c9                    RET
                        
                        ; ---------------- F: format the CP/M partition ----------------
   0316                 CMD_FORMAT:
   0316   cd 13 04              CALL    SDINIT
   0319   b7                    ORA     A
   031a   ca 27 03              JZ      CF_OK
   031d   21 34 07              LXI     H,MSG_NOINIT
   0320   cd 57 06              CALL    PSTR
   0323   cd 6b 06              CALL    CRLF
   0326   c9                    RET
   0327                 CF_OK:
                                ; read MBR to find partition 1 start
   0327   cd e7 04              CALL    SD_SETBLK0
   032a   21 9d 08              LXI     H,BLKBUF
   032d   cd f5 04              CALL    SD_READBLKN
   0330   b7                    ORA     A
   0331   ca 3e 03              JZ      CF_MBROK
   0334   21 d1 07              LXI     H,MSG_RDERR
   0337   cd 57 06              CALL    PSTR
   033a   cd 6b 06              CALL    CRLF
   033d   c9                    RET
   033e                 CF_MBROK:
   033e   21 9b 0a              LXI     H,BLKBUF+510
   0341   7e                    MOV     A,M
   0342   fe 55                 CPI     55H
   0344   c2 67 03              JNZ     CF_RAW
   0347   23                    INX     H
   0348   7e                    MOV     A,M
   0349   fe aa                 CPI     0AAH
   034b   c2 67 03              JNZ     CF_RAW
                                ; partition 1 LBA start at BLKBUF+446+8 (LE, 4 bytes) -> BLKN (MSB first)
   034e   21 63 0a              LXI     H,BLKBUF+446+8
   0351   7e                    MOV     A,M             ; LBA[0] (LSB)
   0352   32 88 08              STA     BLKN+3
   0355   23                    INX     H
   0356   7e                    MOV     A,M
   0357   32 87 08              STA     BLKN+2
   035a   23                    INX     H
   035b   7e                    MOV     A,M
   035c   32 86 08              STA     BLKN+1
   035f   23                    INX     H
   0360   7e                    MOV     A,M
   0361   32 85 08              STA     BLKN+0
   0364   c3 77 03              JMP     CF_DO
   0367                 CF_RAW:
                                ; no MBR: assume partition starts at LBA 1
   0367   3e 00                 MVI     A,0
   0369   32 85 08              STA     BLKN+0
   036c   32 86 08              STA     BLKN+1
   036f   32 87 08              STA     BLKN+2
   0372   3e 01                 MVI     A,1
   0374   32 88 08              STA     BLKN+3
   0377                 CF_DO:
                                ; fill BLKBUF (512 bytes) with 0xE5 (directory marker).
                                ; NOTE: use a 16-bit count -- a `MVI B,0; DCR B; JNZ` loop wraps and
                                ; fills only 256 bytes, leaving the upper half of each written sector as
                                ; stale garbage (the old MBR tail), which CP/M reads as phantom dir entries.
   0377   21 9d 08              LXI     H,BLKBUF
   037a   01 00 02              LXI     B,512
   037d                 CF_F:
   037d   36 e5                 MVI     M,0E5H
   037f   23                    INX     H
   0380   0b                    DCX     B
   0381   78                    MOV     A,B
   0382   b1                    ORA     C
   0383   c2 7d 03              JNZ     CF_F
                                ; save the region-0 base (partition LBA) so we can compute region 1
   0386   3a 85 08              LDA     BLKN+0
   0389   32 89 08              STA     REGBASE+0
   038c   3a 86 08              LDA     BLKN+1
   038f   32 8a 08              STA     REGBASE+1
   0392   3a 87 08              LDA     BLKN+2
   0395   32 8b 08              STA     REGBASE+2
   0398   3a 88 08              LDA     BLKN+3
   039b   32 8c 08              STA     REGBASE+3
                                ; skip the reserved system area: the directory/data begin at REGBASE+SD_SYS
   039e   cd 2d 06              CALL    BLSYS
                                ; ---- region 0 (drive C): 256 sectors = 128KB directory (4096 entries) ----
V  03a1   16 00                 MVI     D,256
   03a3                 CF_LP:
   03a3   21 9d 08              LXI     H,BLKBUF
   03a6   cd 4d 05              CALL    SD_WRITEBLKN
   03a9   b7                    ORA     A
   03aa   ca b7 03              JZ      CF_WOK
   03ad   21 1b 08              LXI     H,MSG_WERR
   03b0   cd 57 06              CALL    PSTR
   03b3   cd 6b 06              CALL    CRLF
   03b6   c9                    RET
   03b7                 CF_WOK:
   03b7   cd 07 06              CALL    INCBLK          ; advance BLKN by 1 sector
   03ba   15                    DCR     D
   03bb   c2 a3 03              JNZ     CF_LP
                                ; ---- region 1 (drive D): BLKN = region-0 base + 0x4000 (8 MB), 256 sectors
   03be   3a 89 08              LDA     REGBASE+0
   03c1   32 85 08              STA     BLKN+0
   03c4   3a 8a 08              LDA     REGBASE+1
   03c7   32 86 08              STA     BLKN+1
   03ca   3a 8b 08              LDA     REGBASE+2
   03cd   32 87 08              STA     BLKN+2
   03d0   3a 8c 08              LDA     REGBASE+3
   03d3   32 88 08              STA     BLKN+3
   03d6   3a 87 08              LDA     BLKN+2
   03d9   c6 40                 ADI     40H             ; +0x4000 = +16384 SD sectors = +8 MB (region 1)
   03db   32 87 08              STA     BLKN+2
   03de   d2 e9 03              JNC     CF_R1            ; carry into BLKN+1 if it overflowed (partition LBA>0xFF)
   03e1   3a 86 08              LDA     BLKN+1
   03e4   c6 01                 ADI     01H
   03e6   32 86 08              STA     BLKN+1
   03e9                 CF_R1:
   03e9   cd 2d 06              CALL    BLSYS           ; skip the reserved system area for region 1 too
V  03ec   16 00                 MVI     D,256
   03ee                 CF_LP2:
   03ee   21 9d 08              LXI     H,BLKBUF
   03f1   cd 4d 05              CALL    SD_WRITEBLKN
   03f4   b7                    ORA     A
   03f5   ca 02 04              JZ      CF_WOK2
   03f8   21 1b 08              LXI     H,MSG_WERR
   03fb   cd 57 06              CALL    PSTR
   03fe   cd 6b 06              CALL    CRLF
   0401   c9                    RET
   0402                 CF_WOK2:
   0402   cd 07 06              CALL    INCBLK
   0405   15                    DCR     D
   0406   c2 ee 03              JNZ     CF_LP2
   0409   21 55 08              LXI     H,MSG_FMT
   040c   cd 57 06              CALL    PSTR
   040f   cd 6b 06              CALL    CRLF
   0412   c9                    RET
                        
                        ; ---------------- SD driver ----------------
                        ; SDINIT: full init.  A=0 ok / 0FFh fail (same as sdprobe).
   0413                 SDINIT:
   0413   af                    XRA     A
   0414   32 7d 08              STA     ACMDIT
   0417   32 7e 08              STA     ACMDR1
   041a   3e 03                 MVI     A,03H           ; CS high + slow
   041c   d3 54                 OUT     SDCTL
   041e   06 0a                 MVI     B,10
   0420                 SDI_CK:
   0420   3e ff                 MVI     A,0FFH
   0422   d3 53                 OUT     SDDAT
   0424   05                    DCR     B
   0425   c2 20 04              JNZ     SDI_CK
   0428   3e 02                 MVI     A,02H           ; select + slow
   042a   d3 54                 OUT     SDCTL
                                ; CMD0 + capture raw
   042c   21 b3 06              LXI     H,CMD0
   042f   06 06                 MVI     B,6
   0431                 SDI_TX:
   0431   7e                    MOV     A,M
   0432   d3 53                 OUT     SDDAT
   0434   23                    INX     H
   0435   05                    DCR     B
   0436   c2 31 04              JNZ     SDI_TX
   0439   21 75 08              LXI     H,RBUF
   043c   06 08                 MVI     B,8
   043e                 SDI_RX:
   043e   db 53                 IN      SDDAT
   0440   77                    MOV     M,A
   0441   23                    INX     H
   0442   05                    DCR     B
   0443   c2 3e 04              JNZ     SDI_RX
                                ; find first non-FF = R1
   0446   21 75 08              LXI     H,RBUF
   0449   06 08                 MVI     B,8
   044b                 SDI_FR1:
   044b   7e                    MOV     A,M
   044c   fe ff                 CPI     0FFH
   044e   c2 5b 04              JNZ     SDI_HAVE
   0451   23                    INX     H
   0452   05                    DCR     B
   0453   c2 4b 04              JNZ     SDI_FR1
   0456   3e ff                 MVI     A,0FFH
   0458   c3 5c 04              JMP     SDI_ST1
   045b                 SDI_HAVE:
   045b   7e                    MOV     A,M
   045c                 SDI_ST1:
   045c   32 74 08              STA     CMDR1
   045f   fe 01                 CPI     01H
   0461   c2 8c 04              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) required before ACMD41 on SDHC
   0464   21 b9 06              LXI     H,CMD8
   0467   cd af 04              CALL    SD_SEND6
   046a   db 53                 IN      SDDAT
   046c   db 53                 IN      SDDAT
   046e   db 53                 IN      SDDAT
   0470   db 53                 IN      SDDAT
                                ; ACMD41 poll
   0472   16 c8                 MVI     D,200
   0474                 SDI_RDY:
   0474   21 bf 06              LXI     H,CMD55
   0477   cd af 04              CALL    SD_SEND6
   047a   21 c5 06              LXI     H,ACMD41
   047d   cd af 04              CALL    SD_SEND6
   0480   fe 00                 CPI     00H
   0482   ca 8f 04              JZ      SDI_OK
   0485   cd dd 04              CALL    DELAYMS
   0488   15                    DCR     D
   0489   c2 74 04              JNZ     SDI_RDY
   048c                 SDI_FAIL:
   048c   3e ff                 MVI     A,0FFH
   048e   c9                    RET
   048f                 SDI_OK:
   048f   3e 00                 MVI     A,00H
   0491   c9                    RET
                        
                        ; SD_READY: clock 0FFh until the card is NOT busy (MISO high).  A card still
                        ;   programming drives MISO LOW (reads 00h); issuing a command then makes
                        ;   SD_SEND6 accept that 00h as "R1 = OK" and drop the command, desyncing the
                        ;   stream -- the cause of a write that silently no-ops and of 'F' needing a
                        ;   second pass.  Timeout ~260k reads (~0.4 s at 25 MHz).
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   0492                 SD_READY:
   0492   d5                    PUSH    D
   0493   16 04                 MVI     D,04H
   0495                 SDRDY0:
   0495   01 00 00              LXI     B,0000H
   0498                 SDRDY1:
   0498   db 53                 IN      SDDAT
   049a   fe ff                 CPI     0FFH
   049c   ca ac 04              JZ      SDRDY_OK
   049f   0b                    DCX     B
   04a0   78                    MOV     A,B
   04a1   b1                    ORA     C
   04a2   c2 98 04              JNZ     SDRDY1
   04a5   15                    DCR     D
   04a6   c2 95 04              JNZ     SDRDY0
   04a9   d1                    POP     D
   04aa   37                    STC
   04ab   c9                    RET
   04ac                 SDRDY_OK:
   04ac   d1                    POP     D
   04ad   af                    XRA     A
   04ae   c9                    RET
                        
                        ; SD_SEND6: send 6-byte command at (HL), read R1.  A = R1 (0FFh = none).
   04af                 SD_SEND6:
   04af   e5                    PUSH    H
   04b0   cd 92 04              CALL    SD_READY        ; never issue a command into a busy card
   04b3   e1                    POP     H
   04b4   06 06                 MVI     B,6
   04b6                 SD6_TX:
   04b6   7e                    MOV     A,M
   04b7   d3 53                 OUT     SDDAT
   04b9   23                    INX     H
   04ba   05                    DCR     B
   04bb   c2 b6 04              JNZ     SD6_TX
   04be   06 10                 MVI     B,16
   04c0                 SD6_RX:
   04c0   db 53                 IN      SDDAT
   04c2   fe ff                 CPI     0FFH
   04c4   c2 cb 04              JNZ     SD6_DONE
   04c7   05                    DCR     B
   04c8   c2 c0 04              JNZ     SD6_RX
   04cb                 SD6_DONE:
   04cb   c9                    RET
                        
                        ; SD_WAITTKN: clock until 0FEh token.  CY=0 + A=0FEh ok, else CY=1.
   04cc                 SD_WAITTKN:
   04cc   06 ff                 MVI     B,0FFH
   04ce                 SD_WT:
   04ce   db 53                 IN      SDDAT
   04d0   fe fe                 CPI     0FEH
   04d2   ca db 04              JZ      SD_WT_OK
   04d5   05                    DCR     B
   04d6   c2 ce 04              JNZ     SD_WT
   04d9   37                    STC
   04da   c9                    RET
   04db                 SD_WT_OK:
   04db   b7                    ORA     A
   04dc   c9                    RET
                        
                        ; DELAYMS ~3ms busy wait.
   04dd                 DELAYMS:
   04dd   21 d0 07              LXI     H,2000
   04e0                 DLMS:
   04e0   2b                    DCX     H
   04e1   7c                    MOV     A,H
   04e2   b5                    ORA     L
   04e3   c2 e0 04              JNZ     DLMS
   04e6   c9                    RET
                        
                        ; SD_SETBLK0: set the block number to 0.
   04e7                 SD_SETBLK0:
   04e7   af                    XRA     A
   04e8   32 85 08              STA     BLKN+0
   04eb   32 86 08              STA     BLKN+1
   04ee   32 87 08              STA     BLKN+2
   04f1   32 88 08              STA     BLKN+3
   04f4   c9                    RET
                        
                        ; SD_READBLKN: read the 512-byte block BLKN[0..3] (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the dest buffer).
   04f5                 SD_READBLKN:
   04f5   3e 00                 MVI     A,00H
   04f7   d3 54                 OUT     SDCTL           ; select, fast
   04f9   e5                    PUSH    H
                                ; build CMD17
   04fa   3e 51                 MVI     A,51H
   04fc   32 7f 08              STA     CMDBUF
   04ff   3a 85 08              LDA     BLKN+0
   0502   32 80 08              STA     CMDBUF+1
   0505   3a 86 08              LDA     BLKN+1
   0508   32 81 08              STA     CMDBUF+2
   050b   3a 87 08              LDA     BLKN+2
   050e   32 82 08              STA     CMDBUF+3
   0511   3a 88 08              LDA     BLKN+3
   0514   32 83 08              STA     CMDBUF+4
   0517   3e ff                 MVI     A,0FFH
   0519   32 84 08              STA     CMDBUF+5
   051c   21 7f 08              LXI     H,CMDBUF
   051f   cd af 04              CALL    SD_SEND6        ; A = R1
   0522   e1                    POP     H               ; restore dest
   0523   fe 00                 CPI     00H
   0525   c2 46 05              JNZ     SRB_ERR
   0528   cd cc 04              CALL    SD_WAITTKN
   052b   da 46 05              JC      SRB_ERR
   052e   01 00 02              LXI     B,512
   0531                 SRB_LP:
   0531   db 53                 IN      SDDAT
   0533   77                    MOV     M,A
   0534   23                    INX     H
   0535   0b                    DCX     B
   0536   78                    MOV     A,B
   0537   b1                    ORA     C
   0538   c2 31 05              JNZ     SRB_LP
   053b   db 53                 IN      SDDAT           ; 2 CRC bytes
   053d   db 53                 IN      SDDAT
   053f   3e 01                 MVI     A,01H
   0541   d3 54                 OUT     SDCTL           ; release CS
   0543   3e 00                 MVI     A,00H
   0545   c9                    RET
   0546                 SRB_ERR:
   0546   3e 01                 MVI     A,01H
   0548   d3 54                 OUT     SDCTL
   054a   3e ff                 MVI     A,0FFH
   054c   c9                    RET
                        
                        ; SD_WRITEBLKN: write the 512 bytes at (HL) to block BLKN[0..3].
                        ;   A = 0 ok / 0FFh err.  Preserves HL (source buffer).
   054d                 SD_WRITEBLKN:
   054d   3e 00                 MVI     A,00H
   054f   d3 54                 OUT     SDCTL           ; select, fast
   0551   e5                    PUSH    H
                                ; build CMD24
   0552   3e 58                 MVI     A,58H
   0554   32 7f 08              STA     CMDBUF
   0557   3a 85 08              LDA     BLKN+0
   055a   32 80 08              STA     CMDBUF+1
   055d   3a 86 08              LDA     BLKN+1
   0560   32 81 08              STA     CMDBUF+2
   0563   3a 87 08              LDA     BLKN+2
   0566   32 82 08              STA     CMDBUF+3
   0569   3a 88 08              LDA     BLKN+3
   056c   32 83 08              STA     CMDBUF+4
   056f   3e ff                 MVI     A,0FFH
   0571   32 84 08              STA     CMDBUF+5
   0574   21 7f 08              LXI     H,CMDBUF
   0577   cd af 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   057a   e1                    POP     H               ; restore source
   057b   fe 00                 CPI     00H
   057d   c2 b9 05              JNZ     SWB_ERR
   0580   3e fe                 MVI     A,0FEH          ; data start token
   0582   d3 53                 OUT     SDDAT
   0584   01 00 02              LXI     B,512
   0587                 SWB_LP:
   0587   7e                    MOV     A,M
   0588   d3 53                 OUT     SDDAT
   058a   23                    INX     H
   058b   0b                    DCX     B
   058c   78                    MOV     A,B
   058d   b1                    ORA     C
   058e   c2 87 05              JNZ     SWB_LP
   0591   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC off)
   0593   d3 53                 OUT     SDDAT
   0595   d3 53                 OUT     SDDAT
                                ; data-response token: 0FFh filler first, then 0bxxx00101 (05h) = OK
   0597   06 10                 MVI     B,16
   0599                 SWB_RSP:
   0599   db 53                 IN      SDDAT
   059b   fe ff                 CPI     0FFH
   059d   c2 a4 05              JNZ     SWB_GOT
   05a0   05                    DCR     B
   05a1   c2 99 05              JNZ     SWB_RSP
   05a4                 SWB_GOT:
   05a4   e6 1f                 ANI     1FH             ; response bits 0-4; 05h = accepted
   05a6   fe 05                 CPI     05H
   05a8   c2 b9 05              JNZ     SWB_ERR         ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS, so the
                                ; next command is not issued into a busy card
   05ab   cd 92 04              CALL    SD_READY
   05ae   b7                    ORA     A
   05af   c2 b9 05              JNZ     SWB_ERR
   05b2                 SWB_DONE:
   05b2   3e 01                 MVI     A,01H
   05b4   d3 54                 OUT     SDCTL           ; release CS
   05b6   3e 00                 MVI     A,00H
   05b8   c9                    RET
   05b9                 SWB_ERR:
   05b9   3e 01                 MVI     A,01H
   05bb   d3 54                 OUT     SDCTL
   05bd   3e ff                 MVI     A,0FFH
   05bf   c9                    RET
                        
                        ; SDCCS: read OCR (CMD58), return A = 0x40 (SDHC/SDXC) or 0 (SDSC).
   05c0                 SDCCS:
   05c0   21 cb 06              LXI     H,CMD58
   05c3   cd af 04              CALL    SD_SEND6
   05c6   db 53                 IN      SDDAT
   05c8   e6 40                 ANI     40H
   05ca   4f                    MOV     C,A
   05cb   db 53                 IN      SDDAT
   05cd   db 53                 IN      SDDAT
   05cf   db 53                 IN      SDDAT
   05d1   79                    MOV     A,C
   05d2   c9                    RET
                        
                        ; SD_CID: read 16-byte CID via CMD9 into CIDBUF.  A = 0 ok / 0FFh err.
   05d3                 SD_CID:
   05d3   3e 00                 MVI     A,00H
   05d5   d3 54                 OUT     SDCTL           ; select, fast
   05d7   21 d1 06              LXI     H,CMD9
   05da   cd af 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   05dd   fe 00                 CPI     00H
   05df   c2 00 06              JNZ     SDCID_TE
   05e2   cd cc 04              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   05e5   da 00 06              JC      SDCID_TE
   05e8   21 8d 08              LXI     H,CIDBUF
   05eb   06 10                 MVI     B,16
   05ed                 SDCID_L:
   05ed   db 53                 IN      SDDAT
   05ef   77                    MOV     M,A
   05f0   23                    INX     H
   05f1   05                    DCR     B
   05f2   c2 ed 05              JNZ     SDCID_L
   05f5   db 53                 IN      SDDAT           ; 2 CRC bytes
   05f7   db 53                 IN      SDDAT
   05f9   3e 01                 MVI     A,01H
   05fb   d3 54                 OUT     SDCTL           ; release CS
   05fd   3e 00                 MVI     A,00H
   05ff   c9                    RET
   0600                 SDCID_TE:
   0600   3e 01                 MVI     A,01H
   0602   d3 54                 OUT     SDCTL           ; release CS
   0604   3e ff                 MVI     A,0FFH
   0606   c9                    RET
                        
                        ; INCBLK: increment the 32-bit block number BLKN[0..3] by 1.
   0607                 INCBLK:
   0607   3a 88 08              LDA     BLKN+3
   060a   3c                    INR     A
   060b   32 88 08              STA     BLKN+3
   060e   c2 2c 06              JNZ     INCD
   0611   3a 87 08              LDA     BLKN+2
   0614   3c                    INR     A
   0615   32 87 08              STA     BLKN+2
   0618   c2 2c 06              JNZ     INCD
   061b   3a 86 08              LDA     BLKN+1
   061e   3c                    INR     A
   061f   32 86 08              STA     BLKN+1
   0622   c2 2c 06              JNZ     INCD
   0625   3a 85 08              LDA     BLKN+0
   0628   3c                    INR     A
   0629   32 85 08              STA     BLKN+0
   062c                 INCD:
   062c   c9                    RET
                        
                        ; BLSYS: add SD_SYS (the reserved system-area sector count) to the 32-bit BLKN
                        ; (MSB first) so the formatter skips the reserved system area.  Clobbers A.
   062d                 BLSYS:
   062d   3a 88 08              LDA     BLKN+3
   0630   c6 10                 ADI     SD_SYS          ; SD_SYS < 256 (16 in the SD build)
   0632   32 88 08              STA     BLKN+3
   0635   d2 56 06              JNC     BLSYS_DONE
   0638   3a 87 08              LDA     BLKN+2
   063b   c6 01                 ADI     01H
   063d   32 87 08              STA     BLKN+2
   0640   d2 56 06              JNC     BLSYS_DONE
   0643   3a 86 08              LDA     BLKN+1
   0646   c6 01                 ADI     01H
   0648   32 86 08              STA     BLKN+1
   064b   d2 56 06              JNC     BLSYS_DONE
   064e   3a 85 08              LDA     BLKN+0
   0651   c6 01                 ADI     01H
   0653   32 85 08              STA     BLKN+0
   0656                 BLSYS_DONE:
   0656   c9                    RET
                        
                        ; ---------------- console / numeric helpers ----------------
   0657                 PSTR:
