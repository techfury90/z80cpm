                        ; SDTOOL.COM -- Brevia2 SD card partition / format / test tool for CP/M 2.2.
                        ; 8080 assembly, Glitch Works a85.  Loads at 0x0100 (CP/M transient).
                        ;
                        ; Talks to the dedicated SD SPI port (pins 31/32/35/36):
                        ;   IN  0x53 = SD SPI data (r/w byte, CPU wait-stretched -- no busy poll)
                        ;   OUT 0x54 = SD SPI ctl  bit0 = CS# (0 select, 1 release); bit1 = slow clock
                        ;   IN  0x55 = SD SPI status bit0 = busy
                        ;
                        ; Commands:
                        ;   I -- init + info: card type, CID (manufacturer/product/serial), test read.
                        ;   P -- read the MBR (block 0) and print the partition table.
                        ;   C -- create an MBR with one CP/M partition (type 0x53) and write block 0.
                        ;   F -- format the CP/M partition: write the directory area to 0xE5.
                        ;   Q -- quit.
                        ;
                        ; The SD CP/M partition geometry (MUST match the CBIOS DPB):
                        ;   128-byte records, SPT=32, 8KB allocation blocks (BSH=6/BLM=63),
                        ;   DSM=1023 (DOUBLE-DM, 1024 blocks x 8KB = 8 MB per drive = CP/M 2.2 ceiling),
                        ;   DRM=4095 (4096 directory entries = 128KB = 16 blocks, reserved via
                        ;   AL0=0xFF/AL1=0xFF), EXM=3, CKS=0, OFF=0 (data partition, no system tracks).
                        ;   TWO 8 MB logical drives are formatted (C: region 0 at the partition start,
                        ;   D: region 1 at +8 MB): each directory = 128KB = 256 x 512B SD sectors written
                        ;   as 0xE5, the only thing a format must write (the BDOS rebuilds the
                        ;   allocation vector on login).  Partition 1 starts at LBA 1, size 0x00020000
                        ;   sectors (64 MB -- drives C:/D: currently use the first 16 MB of it).
                        ;
                        ; NOTE on BDOS register clobbering: every console-call loop preserves B/HL
                        ; across CPUTC/func-2 with PUSH/POP (func 2 destroys B and HL on this CBIOS).
   0100                         ORG     0100H
                        
                        ; ---------------- constants ----------------
   0053                 SDDAT   EQU     53H
   0054                 SDCTL   EQU     54H
   0055                 SDSTAT  EQU     55H
                        
   0020                 SPT     EQU     32              ; sectors (128B) per track  [geometry]
   0006                 BSH     EQU     6               ; 8KB allocation blocks
   003f                 BLM     EQU     63
   0003                 EXM     EQU     3               ; BLS=8192 & DSM>255 -> double-DM (16-bit block ptrs)
   03ff                 DSM     EQU     1023            ; 8 MB (1024 blocks x 8KB = CP/M 2.2 ceiling)
   0fff                 DRM     EQU     4095            ; 4096 directory entries
   00ff                 AL0V    EQU     0FFH            ; reserve directory blocks 0-7 (MSB-first)
   00ff                 AL1V    EQU     0FFH            ; reserve directory blocks 8-15 (16 blocks = 128KB dir)
                        
   0053                 PMTYPE  EQU     53H             ; CP/M partition type (no standard MBR type exists)
   0001                 PARTLBA0 EQU    01H             ; partition 1 LBA start = 1 (LE byte 0)
   0000                 PARTSEC0 EQU    00H             ; partition size = 0x00020000 (LE: 00 00 02 00)
   0000                 PARTSEC1 EQU    00H
   0002                 PARTSEC2 EQU    02H
   0000                 PARTSEC3 EQU    00H
                        
   0100                 START:
   0100   21 a7 06              LXI     H,BANNER
   0103   cd 27 06              CALL    PSTR
                        
   0106                 MAINLOOP:
   0106   1e 3e                 MVI     E,'>'
   0108   cd 2f 06              CALL    CPUTC
   010b   cd 35 06              CALL    CIN             ; A = command char (echoed by func1)
                                ; fold lower-case a-z -> upper
   010e   fe 61                 CPI     'a'
   0110   da 1a 01              JC      ML1
   0113   fe 7b                 CPI     7BH
   0115   d2 1a 01              JNC     ML1
   0118   d6 20                 SUI     20H
   011a                 ML1:
   011a   fe 49                 CPI     'I'
   011c   c2 25 01              JNZ     ML_P
   011f   cd 55 01              CALL    CMD_INFO
   0122   c3 06 01              JMP     MAINLOOP
   0125                 ML_P:
   0125   fe 50                 CPI     'P'
   0127   c2 30 01              JNZ     ML_C
   012a   cd 01 02              CALL    CMD_PART
   012d   c3 06 01              JMP     MAINLOOP
   0130                 ML_C:
   0130   fe 43                 CPI     'C'
   0132   c2 3b 01              JNZ     ML_F
   0135   cd 9e 02              CALL    CMD_CREATE
   0138   c3 06 01              JMP     MAINLOOP
   013b                 ML_F:
   013b   fe 46                 CPI     'F'
   013d   c2 46 01              JNZ     ML_Q
   0140   cd 16 03              CALL    CMD_FORMAT
   0143   c3 06 01              JMP     MAINLOOP
   0146                 ML_Q:
   0146   fe 51                 CPI     'Q'
   0148   c2 4c 01              JNZ     ML_UNK
   014b   c9                    RET                     ; quit to CP/M (returns to the CCP)
   014c                 ML_UNK:
   014c   21 00 07              LXI     H,MSG_UNK
   014f   cd 27 06              CALL    PSTR
   0152   c3 06 01              JMP     MAINLOOP
                        
                        ; ---------------- I: init + info ----------------
   0155                 CMD_INFO:
   0155   cd 0d 04              CALL    SDINIT
   0158   b7                    ORA     A
   0159   ca 66 01              JZ      CI_OK
   015c   21 04 07              LXI     H,MSG_NOINIT
   015f   cd 27 06              CALL    PSTR
   0162   cd 3b 06              CALL    CRLF
   0165   c9                    RET
   0166                 CI_OK:
   0166   21 1c 07              LXI     H,MSG_INITOK
   0169   cd 27 06              CALL    PSTR
   016c   cd 3b 06              CALL    CRLF
                                ; card type
   016f   cd ba 05              CALL    SDCCS           ; A = 40h if SDHC/SDXC, else 0
   0172   b7                    ORA     A
   0173   ca 7f 01              JZ      CI_SC
   0176   21 24 07              LXI     H,MSG_SDHC
   0179   cd 27 06              CALL    PSTR
   017c   c3 85 01              JMP     CI_AFTTYPE
   017f                 CI_SC:
   017f   21 49 07              LXI     H,MSG_SDSC
   0182   cd 27 06              CALL    PSTR
   0185                 CI_AFTTYPE:
   0185   cd 3b 06              CALL    CRLF
                                ; CID
   0188   cd cd 05              CALL    SD_CID
   018b   b7                    ORA     A
   018c   ca 99 01              JZ      CI_CIDOK
   018f   21 7d 07              LXI     H,MSG_CIDERR
   0192   cd 27 06              CALL    PSTR
   0195   cd 3b 06              CALL    CRLF
   0198   c9                    RET
   0199                 CI_CIDOK:
   0199   21 68 07              LXI     H,MSG_CID
   019c   cd 27 06              CALL    PSTR
   019f   3a 5d 08              LDA     CIDBUF
   01a2   cd 46 06              CALL    PRHEX2
   01a5   1e 20                 MVI     E,' '
   01a7   cd 2f 06              CALL    CPUTC
   01aa   21 60 08              LXI     H,CIDBUF+3
   01ad   06 05                 MVI     B,5
   01af                 CI_NM:
   01af   5e                    MOV     E,M
   01b0   e5                    PUSH    H
   01b1   c5                    PUSH    B
   01b2   cd 2f 06              CALL    CPUTC
   01b5   c1                    POP     B
   01b6   e1                    POP     H
   01b7   23                    INX     H
   01b8   05                    DCR     B
   01b9   c2 af 01              JNZ     CI_NM
   01bc   cd 3b 06              CALL    CRLF
   01bf   21 73 07              LXI     H,MSG_SN
   01c2   cd 27 06              CALL    PSTR
   01c5   3a 66 08              LDA     CIDBUF+9
   01c8   cd 46 06              CALL    PRHEX2
   01cb   3a 67 08              LDA     CIDBUF+10
   01ce   cd 46 06              CALL    PRHEX2
   01d1   3a 68 08              LDA     CIDBUF+11
   01d4   cd 46 06              CALL    PRHEX2
   01d7   3a 69 08              LDA     CIDBUF+12
   01da   cd 46 06              CALL    PRHEX2
   01dd   cd 3b 06              CALL    CRLF
                                ; test read block 0
   01e0   cd e1 04              CALL    SD_SETBLK0
   01e3   21 6d 08              LXI     H,BLKBUF
   01e6   cd ef 04              CALL    SD_READBLKN
   01e9   b7                    ORA     A
   01ea   c2 f7 01              JNZ     CI_BLKERR
   01ed   21 8f 07              LXI     H,MSG_RDOK
   01f0   cd 27 06              CALL    PSTR
   01f3   cd 3b 06              CALL    CRLF
   01f6   c9                    RET
   01f7                 CI_BLKERR:
   01f7   21 a1 07              LXI     H,MSG_RDERR
   01fa   cd 27 06              CALL    PSTR
   01fd   cd 3b 06              CALL    CRLF
   0200   c9                    RET
                        
                        ; ---------------- P: show MBR partitions ----------------
   0201                 CMD_PART:
   0201   cd 0d 04              CALL    SDINIT
   0204   b7                    ORA     A
   0205   ca 12 02              JZ      CP_OK
   0208   21 04 07              LXI     H,MSG_NOINIT
   020b   cd 27 06              CALL    PSTR
   020e   cd 3b 06              CALL    CRLF
   0211   c9                    RET
   0212                 CP_OK:
   0212   cd e1 04              CALL    SD_SETBLK0
   0215   21 6d 08              LXI     H,BLKBUF
   0218   cd ef 04              CALL    SD_READBLKN
   021b   b7                    ORA     A
   021c   ca 29 02              JZ      CP_MBROK
   021f   21 a1 07              LXI     H,MSG_RDERR
   0222   cd 27 06              CALL    PSTR
   0225   cd 3b 06              CALL    CRLF
   0228   c9                    RET
   0229                 CP_MBROK:
                                ; check 55AA
   0229   21 6b 0a              LXI     H,BLKBUF+510
   022c   7e                    MOV     A,M
   022d   fe 55                 CPI     55H
   022f   c2 94 02              JNZ     CP_NOMBR
   0232   23                    INX     H
   0233   7e                    MOV     A,M
   0234   fe aa                 CPI     0AAH
   0236   c2 94 02              JNZ     CP_NOMBR
   0239   21 b5 07              LXI     H,MSG_MBR
   023c   cd 27 06              CALL    PSTR
   023f   cd 3b 06              CALL    CRLF
                                ; print 4 partitions
   0242   21 2b 0a              LXI     H,BLKBUF+446
   0245   22 42 08              SHLD    ENTPTR
   0248   16 04                 MVI     D,4
   024a                 CP_LP:
                                ; status (+0)
   024a   2a 42 08              LHLD    ENTPTR
   024d   7e                    MOV     A,M
   024e   cd 46 06              CALL    PRHEX2
   0251   1e 20                 MVI     E,' '
   0253   cd 2f 06              CALL    CPUTC
                                ; type (+4)
   0256   2a 42 08              LHLD    ENTPTR
   0259   3e 04                 MVI     A,4
   025b   cd 7c 06              CALL    ADDH
   025e   7e                    MOV     A,M
   025f   cd 46 06              CALL    PRHEX2
   0262   1e 20                 MVI     E,' '
   0264   cd 2f 06              CALL    CPUTC
                                ; LBA (+8, 4 bytes LE)
   0267   2a 42 08              LHLD    ENTPTR
   026a   3e 08                 MVI     A,8
   026c   cd 7c 06              CALL    ADDH
   026f   cd 6c 06              CALL    PRHEX32
   0272   1e 20                 MVI     E,' '
   0274   cd 2f 06              CALL    CPUTC
                                ; size (+12, 4 bytes LE)
   0277   2a 42 08              LHLD    ENTPTR
   027a   3e 0c                 MVI     A,12
   027c   cd 7c 06              CALL    ADDH
   027f   cd 6c 06              CALL    PRHEX32
   0282   cd 3b 06              CALL    CRLF
                                ; next entry
   0285   2a 42 08              LHLD    ENTPTR
   0288   01 10 00              LXI     B,16
   028b   09                    DAD     B
   028c   22 42 08              SHLD    ENTPTR
   028f   15                    DCR     D
   0290   c2 4a 02              JNZ     CP_LP
   0293   c9                    RET
   0294                 CP_NOMBR:
   0294   21 d9 07              LXI     H,MSG_NOMBR
   0297   cd 27 06              CALL    PSTR
   029a   cd 3b 06              CALL    CRLF
   029d   c9                    RET
                        
                        ; ---------------- C: create an MBR with one CP/M partition ----------------
   029e                 CMD_CREATE:
   029e   cd 0d 04              CALL    SDINIT
   02a1   b7                    ORA     A
   02a2   ca af 02              JZ      CC_OK
   02a5   21 04 07              LXI     H,MSG_NOINIT
   02a8   cd 27 06              CALL    PSTR
   02ab   cd 3b 06              CALL    CRLF
   02ae   c9                    RET
   02af                 CC_OK:
                                ; zero BLKBUF
   02af   21 6d 08              LXI     H,BLKBUF
   02b2   06 00                 MVI     B,0
   02b4                 CC_Z:
   02b4   36 00                 MVI     M,0
   02b6   23                    INX     H
   02b7   05                    DCR     B
   02b8   c2 b4 02              JNZ     CC_Z
                                ; partition 1 entry at BLKBUF+446
   02bb   21 2b 0a              LXI     H,BLKBUF+446
   02be   36 80                 MVI     M,80H           ; bootable status
   02c0   23                    INX     H
   02c1   36 01                 MVI     M,01H           ; CHS start head
   02c3   23                    INX     H
   02c4   36 01                 MVI     M,01H           ; sector
   02c6   23                    INX     H
   02c7   36 00                 MVI     M,00H           ; cyl
   02c9   23                    INX     H
   02ca   36 53                 MVI     M,PMTYPE        ; type 0x53 (CP/M)
   02cc   23                    INX     H
   02cd   36 ff                 MVI     M,0FFH          ; CHS end head
   02cf   23                    INX     H
   02d0   36 fe                 MVI     M,0FEH          ; sector
   02d2   23                    INX     H
   02d3   36 ff                 MVI     M,0FFH          ; cyl
   02d5   23                    INX     H
   02d6   36 01                 MVI     M,PARTLBA0      ; LBA start LE byte0 = 1
   02d8   23                    INX     H
   02d9   36 00                 MVI     M,00H
   02db   23                    INX     H
   02dc   36 00                 MVI     M,00H
   02de   23                    INX     H
   02df   36 00                 MVI     M,00H
   02e1   23                    INX     H
   02e2   36 00                 MVI     M,PARTSEC0      ; size LE
   02e4   23                    INX     H
   02e5   36 00                 MVI     M,PARTSEC1
   02e7   23                    INX     H
   02e8   36 02                 MVI     M,PARTSEC2
   02ea   23                    INX     H
   02eb   36 00                 MVI     M,PARTSEC3
                                ; signature 55AA
   02ed   21 6b 0a              LXI     H,BLKBUF+510
   02f0   36 55                 MVI     M,55H
   02f2   23                    INX     H
   02f3   36 aa                 MVI     M,0AAH
                                ; write block 0
   02f5   cd e1 04              CALL    SD_SETBLK0
   02f8   21 6d 08              LXI     H,BLKBUF
   02fb   cd 47 05              CALL    SD_WRITEBLKN
   02fe   b7                    ORA     A
   02ff   ca 0c 03              JZ      CC_WOK
   0302   21 eb 07              LXI     H,MSG_WERR
   0305   cd 27 06              CALL    PSTR
   0308   cd 3b 06              CALL    CRLF
   030b   c9                    RET
   030c                 CC_WOK:
   030c   21 fa 07              LXI     H,MSG_WROTE
   030f   cd 27 06              CALL    PSTR
   0312   cd 3b 06              CALL    CRLF
   0315   c9                    RET
                        
                        ; ---------------- F: format the CP/M partition ----------------
   0316                 CMD_FORMAT:
   0316   cd 0d 04              CALL    SDINIT
   0319   b7                    ORA     A
   031a   ca 27 03              JZ      CF_OK
   031d   21 04 07              LXI     H,MSG_NOINIT
   0320   cd 27 06              CALL    PSTR
   0323   cd 3b 06              CALL    CRLF
   0326   c9                    RET
   0327                 CF_OK:
                                ; read MBR to find partition 1 start
   0327   cd e1 04              CALL    SD_SETBLK0
   032a   21 6d 08              LXI     H,BLKBUF
   032d   cd ef 04              CALL    SD_READBLKN
   0330   b7                    ORA     A
   0331   ca 3e 03              JZ      CF_MBROK
   0334   21 a1 07              LXI     H,MSG_RDERR
   0337   cd 27 06              CALL    PSTR
   033a   cd 3b 06              CALL    CRLF
   033d   c9                    RET
   033e                 CF_MBROK:
   033e   21 6b 0a              LXI     H,BLKBUF+510
   0341   7e                    MOV     A,M
   0342   fe 55                 CPI     55H
   0344   c2 67 03              JNZ     CF_RAW
   0347   23                    INX     H
   0348   7e                    MOV     A,M
   0349   fe aa                 CPI     0AAH
   034b   c2 67 03              JNZ     CF_RAW
                                ; partition 1 LBA start at BLKBUF+446+8 (LE, 4 bytes) -> BLKN (MSB first)
   034e   21 33 0a              LXI     H,BLKBUF+446+8
   0351   7e                    MOV     A,M             ; LBA[0] (LSB)
   0352   32 58 08              STA     BLKN+3
   0355   23                    INX     H
   0356   7e                    MOV     A,M
   0357   32 57 08              STA     BLKN+2
   035a   23                    INX     H
   035b   7e                    MOV     A,M
   035c   32 56 08              STA     BLKN+1
   035f   23                    INX     H
   0360   7e                    MOV     A,M
   0361   32 55 08              STA     BLKN+0
   0364   c3 77 03              JMP     CF_DO
   0367                 CF_RAW:
                                ; no MBR: assume partition starts at LBA 1
   0367   3e 00                 MVI     A,0
   0369   32 55 08              STA     BLKN+0
   036c   32 56 08              STA     BLKN+1
   036f   32 57 08              STA     BLKN+2
   0372   3e 01                 MVI     A,1
   0374   32 58 08              STA     BLKN+3
   0377                 CF_DO:
                                ; fill BLKBUF (512 bytes) with 0xE5 (directory marker).
                                ; NOTE: use a 16-bit count -- a `MVI B,0; DCR B; JNZ` loop wraps and
                                ; fills only 256 bytes, leaving the upper half of each written sector as
                                ; stale garbage (the old MBR tail), which CP/M reads as phantom dir entries.
   0377   21 6d 08              LXI     H,BLKBUF
   037a   01 00 02              LXI     B,512
   037d                 CF_F:
   037d   36 e5                 MVI     M,0E5H
   037f   23                    INX     H
   0380   0b                    DCX     B
   0381   78                    MOV     A,B
   0382   b1                    ORA     C
   0383   c2 7d 03              JNZ     CF_F
                                ; save the region-0 base (partition LBA) so we can compute region 1
   0386   3a 55 08              LDA     BLKN+0
   0389   32 59 08              STA     REGBASE+0
   038c   3a 56 08              LDA     BLKN+1
   038f   32 5a 08              STA     REGBASE+1
   0392   3a 57 08              LDA     BLKN+2
   0395   32 5b 08              STA     REGBASE+2
   0398   3a 58 08              LDA     BLKN+3
   039b   32 5c 08              STA     REGBASE+3
                                ; ---- region 0 (drive C): 256 sectors = 128KB directory (4096 entries) ----
V  039e   16 00                 MVI     D,256
   03a0                 CF_LP:
   03a0   21 6d 08              LXI     H,BLKBUF
   03a3   cd 47 05              CALL    SD_WRITEBLKN
   03a6   b7                    ORA     A
   03a7   ca b4 03              JZ      CF_WOK
   03aa   21 eb 07              LXI     H,MSG_WERR
   03ad   cd 27 06              CALL    PSTR
   03b0   cd 3b 06              CALL    CRLF
   03b3   c9                    RET
   03b4                 CF_WOK:
   03b4   cd 01 06              CALL    INCBLK          ; advance BLKN by 1 sector
   03b7   15                    DCR     D
   03b8   c2 a0 03              JNZ     CF_LP
                                ; ---- region 1 (drive D): BLKN = region-0 base + 0x4000 (8 MB), 256 sectors
   03bb   3a 59 08              LDA     REGBASE+0
   03be   32 55 08              STA     BLKN+0
   03c1   3a 5a 08              LDA     REGBASE+1
   03c4   32 56 08              STA     BLKN+1
   03c7   3a 5b 08              LDA     REGBASE+2
   03ca   32 57 08              STA     BLKN+2
   03cd   3a 5c 08              LDA     REGBASE+3
   03d0   32 58 08              STA     BLKN+3
   03d3   3a 57 08              LDA     BLKN+2
   03d6   c6 40                 ADI     40H             ; +0x4000 = +16384 SD sectors = +8 MB (region 1)
   03d8   32 57 08              STA     BLKN+2
   03db   d2 e6 03              JNC     CF_R1            ; carry into BLKN+1 if it overflowed (partition LBA>0xFF)
   03de   3a 56 08              LDA     BLKN+1
   03e1   c6 01                 ADI     01H
   03e3   32 56 08              STA     BLKN+1
   03e6                 CF_R1:
V  03e6   16 00                 MVI     D,256
   03e8                 CF_LP2:
   03e8   21 6d 08              LXI     H,BLKBUF
   03eb   cd 47 05              CALL    SD_WRITEBLKN
   03ee   b7                    ORA     A
   03ef   ca fc 03              JZ      CF_WOK2
   03f2   21 eb 07              LXI     H,MSG_WERR
   03f5   cd 27 06              CALL    PSTR
   03f8   cd 3b 06              CALL    CRLF
   03fb   c9                    RET
   03fc                 CF_WOK2:
   03fc   cd 01 06              CALL    INCBLK
   03ff   15                    DCR     D
   0400   c2 e8 03              JNZ     CF_LP2
   0403   21 25 08              LXI     H,MSG_FMT
   0406   cd 27 06              CALL    PSTR
   0409   cd 3b 06              CALL    CRLF
   040c   c9                    RET
                        
                        ; ---------------- SD driver ----------------
                        ; SDINIT: full init.  A=0 ok / 0FFh fail (same as sdprobe).
   040d                 SDINIT:
   040d   af                    XRA     A
   040e   32 4d 08              STA     ACMDIT
   0411   32 4e 08              STA     ACMDR1
   0414   3e 03                 MVI     A,03H           ; CS high + slow
   0416   d3 54                 OUT     SDCTL
   0418   06 0a                 MVI     B,10
   041a                 SDI_CK:
   041a   3e ff                 MVI     A,0FFH
   041c   d3 53                 OUT     SDDAT
   041e   05                    DCR     B
   041f   c2 1a 04              JNZ     SDI_CK
   0422   3e 02                 MVI     A,02H           ; select + slow
   0424   d3 54                 OUT     SDCTL
                                ; CMD0 + capture raw
   0426   21 83 06              LXI     H,CMD0
   0429   06 06                 MVI     B,6
   042b                 SDI_TX:
   042b   7e                    MOV     A,M
   042c   d3 53                 OUT     SDDAT
   042e   23                    INX     H
   042f   05                    DCR     B
   0430   c2 2b 04              JNZ     SDI_TX
   0433   21 45 08              LXI     H,RBUF
   0436   06 08                 MVI     B,8
   0438                 SDI_RX:
   0438   db 53                 IN      SDDAT
   043a   77                    MOV     M,A
   043b   23                    INX     H
   043c   05                    DCR     B
   043d   c2 38 04              JNZ     SDI_RX
                                ; find first non-FF = R1
   0440   21 45 08              LXI     H,RBUF
   0443   06 08                 MVI     B,8
   0445                 SDI_FR1:
   0445   7e                    MOV     A,M
   0446   fe ff                 CPI     0FFH
   0448   c2 55 04              JNZ     SDI_HAVE
   044b   23                    INX     H
   044c   05                    DCR     B
   044d   c2 45 04              JNZ     SDI_FR1
   0450   3e ff                 MVI     A,0FFH
   0452   c3 56 04              JMP     SDI_ST1
   0455                 SDI_HAVE:
   0455   7e                    MOV     A,M
   0456                 SDI_ST1:
   0456   32 44 08              STA     CMDR1
   0459   fe 01                 CPI     01H
   045b   c2 86 04              JNZ     SDI_FAIL
                                ; CMD8 (SEND_IF_COND) required before ACMD41 on SDHC
   045e   21 89 06              LXI     H,CMD8
   0461   cd a9 04              CALL    SD_SEND6
   0464   db 53                 IN      SDDAT
   0466   db 53                 IN      SDDAT
   0468   db 53                 IN      SDDAT
   046a   db 53                 IN      SDDAT
                                ; ACMD41 poll
   046c   16 c8                 MVI     D,200
   046e                 SDI_RDY:
   046e   21 8f 06              LXI     H,CMD55
   0471   cd a9 04              CALL    SD_SEND6
   0474   21 95 06              LXI     H,ACMD41
   0477   cd a9 04              CALL    SD_SEND6
   047a   fe 00                 CPI     00H
   047c   ca 89 04              JZ      SDI_OK
   047f   cd d7 04              CALL    DELAYMS
   0482   15                    DCR     D
   0483   c2 6e 04              JNZ     SDI_RDY
   0486                 SDI_FAIL:
   0486   3e ff                 MVI     A,0FFH
   0488   c9                    RET
   0489                 SDI_OK:
   0489   3e 00                 MVI     A,00H
   048b   c9                    RET
                        
                        ; SD_READY: clock 0FFh until the card is NOT busy (MISO high).  A card still
                        ;   programming drives MISO LOW (reads 00h); issuing a command then makes
                        ;   SD_SEND6 accept that 00h as "R1 = OK" and drop the command, desyncing the
                        ;   stream -- the cause of a write that silently no-ops and of 'F' needing a
                        ;   second pass.  Timeout ~260k reads (~0.4 s at 25 MHz).
                        ;   Returns A=0 ready / A=0FFh + CY on timeout.  Clobbers A,B,C.  Preserves D,H,L.
   048c                 SD_READY:
   048c   d5                    PUSH    D
   048d   16 04                 MVI     D,04H
   048f                 SDRDY0:
   048f   01 00 00              LXI     B,0000H
   0492                 SDRDY1:
   0492   db 53                 IN      SDDAT
   0494   fe ff                 CPI     0FFH
   0496   ca a6 04              JZ      SDRDY_OK
   0499   0b                    DCX     B
   049a   78                    MOV     A,B
   049b   b1                    ORA     C
   049c   c2 92 04              JNZ     SDRDY1
   049f   15                    DCR     D
   04a0   c2 8f 04              JNZ     SDRDY0
   04a3   d1                    POP     D
   04a4   37                    STC
   04a5   c9                    RET
   04a6                 SDRDY_OK:
   04a6   d1                    POP     D
   04a7   af                    XRA     A
   04a8   c9                    RET
                        
                        ; SD_SEND6: send 6-byte command at (HL), read R1.  A = R1 (0FFh = none).
   04a9                 SD_SEND6:
   04a9   e5                    PUSH    H
   04aa   cd 8c 04              CALL    SD_READY        ; never issue a command into a busy card
   04ad   e1                    POP     H
   04ae   06 06                 MVI     B,6
   04b0                 SD6_TX:
   04b0   7e                    MOV     A,M
   04b1   d3 53                 OUT     SDDAT
   04b3   23                    INX     H
   04b4   05                    DCR     B
   04b5   c2 b0 04              JNZ     SD6_TX
   04b8   06 10                 MVI     B,16
   04ba                 SD6_RX:
   04ba   db 53                 IN      SDDAT
   04bc   fe ff                 CPI     0FFH
   04be   c2 c5 04              JNZ     SD6_DONE
   04c1   05                    DCR     B
   04c2   c2 ba 04              JNZ     SD6_RX
   04c5                 SD6_DONE:
   04c5   c9                    RET
                        
                        ; SD_WAITTKN: clock until 0FEh token.  CY=0 + A=0FEh ok, else CY=1.
   04c6                 SD_WAITTKN:
   04c6   06 ff                 MVI     B,0FFH
   04c8                 SD_WT:
   04c8   db 53                 IN      SDDAT
   04ca   fe fe                 CPI     0FEH
   04cc   ca d5 04              JZ      SD_WT_OK
   04cf   05                    DCR     B
   04d0   c2 c8 04              JNZ     SD_WT
   04d3   37                    STC
   04d4   c9                    RET
   04d5                 SD_WT_OK:
   04d5   b7                    ORA     A
   04d6   c9                    RET
                        
                        ; DELAYMS ~3ms busy wait.
   04d7                 DELAYMS:
   04d7   21 d0 07              LXI     H,2000
   04da                 DLMS:
   04da   2b                    DCX     H
   04db   7c                    MOV     A,H
   04dc   b5                    ORA     L
   04dd   c2 da 04              JNZ     DLMS
   04e0   c9                    RET
                        
                        ; SD_SETBLK0: set the block number to 0.
   04e1                 SD_SETBLK0:
   04e1   af                    XRA     A
   04e2   32 55 08              STA     BLKN+0
   04e5   32 56 08              STA     BLKN+1
   04e8   32 57 08              STA     BLKN+2
   04eb   32 58 08              STA     BLKN+3
   04ee   c9                    RET
                        
                        ; SD_READBLKN: read the 512-byte block BLKN[0..3] (MSB first) into (HL).
                        ;   A = 0 ok / 0FFh err.  Preserves HL (the dest buffer).
   04ef                 SD_READBLKN:
   04ef   3e 00                 MVI     A,00H
   04f1   d3 54                 OUT     SDCTL           ; select, fast
   04f3   e5                    PUSH    H
                                ; build CMD17
   04f4   3e 51                 MVI     A,51H
   04f6   32 4f 08              STA     CMDBUF
   04f9   3a 55 08              LDA     BLKN+0
   04fc   32 50 08              STA     CMDBUF+1
   04ff   3a 56 08              LDA     BLKN+1
   0502   32 51 08              STA     CMDBUF+2
   0505   3a 57 08              LDA     BLKN+2
   0508   32 52 08              STA     CMDBUF+3
   050b   3a 58 08              LDA     BLKN+3
   050e   32 53 08              STA     CMDBUF+4
   0511   3e ff                 MVI     A,0FFH
   0513   32 54 08              STA     CMDBUF+5
   0516   21 4f 08              LXI     H,CMDBUF
   0519   cd a9 04              CALL    SD_SEND6        ; A = R1
   051c   e1                    POP     H               ; restore dest
   051d   fe 00                 CPI     00H
   051f   c2 40 05              JNZ     SRB_ERR
   0522   cd c6 04              CALL    SD_WAITTKN
   0525   da 40 05              JC      SRB_ERR
   0528   01 00 02              LXI     B,512
   052b                 SRB_LP:
   052b   db 53                 IN      SDDAT
   052d   77                    MOV     M,A
   052e   23                    INX     H
   052f   0b                    DCX     B
   0530   78                    MOV     A,B
   0531   b1                    ORA     C
   0532   c2 2b 05              JNZ     SRB_LP
   0535   db 53                 IN      SDDAT           ; 2 CRC bytes
   0537   db 53                 IN      SDDAT
   0539   3e 01                 MVI     A,01H
   053b   d3 54                 OUT     SDCTL           ; release CS
   053d   3e 00                 MVI     A,00H
   053f   c9                    RET
   0540                 SRB_ERR:
   0540   3e 01                 MVI     A,01H
   0542   d3 54                 OUT     SDCTL
   0544   3e ff                 MVI     A,0FFH
   0546   c9                    RET
                        
                        ; SD_WRITEBLKN: write the 512 bytes at (HL) to block BLKN[0..3].
                        ;   A = 0 ok / 0FFh err.  Preserves HL (source buffer).
   0547                 SD_WRITEBLKN:
   0547   3e 00                 MVI     A,00H
   0549   d3 54                 OUT     SDCTL           ; select, fast
   054b   e5                    PUSH    H
                                ; build CMD24
   054c   3e 58                 MVI     A,58H
   054e   32 4f 08              STA     CMDBUF
   0551   3a 55 08              LDA     BLKN+0
   0554   32 50 08              STA     CMDBUF+1
   0557   3a 56 08              LDA     BLKN+1
   055a   32 51 08              STA     CMDBUF+2
   055d   3a 57 08              LDA     BLKN+2
   0560   32 52 08              STA     CMDBUF+3
   0563   3a 58 08              LDA     BLKN+3
   0566   32 53 08              STA     CMDBUF+4
   0569   3e ff                 MVI     A,0FFH
   056b   32 54 08              STA     CMDBUF+5
   056e   21 4f 08              LXI     H,CMDBUF
   0571   cd a9 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   0574   e1                    POP     H               ; restore source
   0575   fe 00                 CPI     00H
   0577   c2 b3 05              JNZ     SWB_ERR
   057a   3e fe                 MVI     A,0FEH          ; data start token
   057c   d3 53                 OUT     SDDAT
   057e   01 00 02              LXI     B,512
   0581                 SWB_LP:
   0581   7e                    MOV     A,M
   0582   d3 53                 OUT     SDDAT
   0584   23                    INX     H
   0585   0b                    DCX     B
   0586   78                    MOV     A,B
   0587   b1                    ORA     C
   0588   c2 81 05              JNZ     SWB_LP
   058b   3e ff                 MVI     A,0FFH          ; 2 CRC bytes (CRC off)
   058d   d3 53                 OUT     SDDAT
   058f   d3 53                 OUT     SDDAT
                                ; data-response token: 0FFh filler first, then 0bxxx00101 (05h) = OK
   0591   06 10                 MVI     B,16
   0593                 SWB_RSP:
   0593   db 53                 IN      SDDAT
   0595   fe ff                 CPI     0FFH
   0597   c2 9e 05              JNZ     SWB_GOT
   059a   05                    DCR     B
   059b   c2 93 05              JNZ     SWB_RSP
   059e                 SWB_GOT:
   059e   e6 1f                 ANI     1FH             ; response bits 0-4; 05h = accepted
   05a0   fe 05                 CPI     05H
   05a2   c2 b3 05              JNZ     SWB_ERR         ; CRC error / write rejected / no response
                                ; wait for the card to finish programming BEFORE releasing CS, so the
                                ; next command is not issued into a busy card
   05a5   cd 8c 04              CALL    SD_READY
   05a8   b7                    ORA     A
   05a9   c2 b3 05              JNZ     SWB_ERR
   05ac                 SWB_DONE:
   05ac   3e 01                 MVI     A,01H
   05ae   d3 54                 OUT     SDCTL           ; release CS
   05b0   3e 00                 MVI     A,00H
   05b2   c9                    RET
   05b3                 SWB_ERR:
   05b3   3e 01                 MVI     A,01H
   05b5   d3 54                 OUT     SDCTL
   05b7   3e ff                 MVI     A,0FFH
   05b9   c9                    RET
                        
                        ; SDCCS: read OCR (CMD58), return A = 0x40 (SDHC/SDXC) or 0 (SDSC).
   05ba                 SDCCS:
   05ba   21 9b 06              LXI     H,CMD58
   05bd   cd a9 04              CALL    SD_SEND6
   05c0   db 53                 IN      SDDAT
   05c2   e6 40                 ANI     40H
   05c4   4f                    MOV     C,A
   05c5   db 53                 IN      SDDAT
   05c7   db 53                 IN      SDDAT
   05c9   db 53                 IN      SDDAT
   05cb   79                    MOV     A,C
   05cc   c9                    RET
                        
                        ; SD_CID: read 16-byte CID via CMD9 into CIDBUF.  A = 0 ok / 0FFh err.
   05cd                 SD_CID:
   05cd   3e 00                 MVI     A,00H
   05cf   d3 54                 OUT     SDCTL           ; select, fast
   05d1   21 a1 06              LXI     H,CMD9
   05d4   cd a9 04              CALL    SD_SEND6        ; A = R1 (should be 00)
   05d7   fe 00                 CPI     00H
   05d9   c2 fa 05              JNZ     SDCID_TE
   05dc   cd c6 04              CALL    SD_WAITTKN      ; wait for the 0FEh data-start token
   05df   da fa 05              JC      SDCID_TE
   05e2   21 5d 08              LXI     H,CIDBUF
   05e5   06 10                 MVI     B,16
   05e7                 SDCID_L:
   05e7   db 53                 IN      SDDAT
   05e9   77                    MOV     M,A
   05ea   23                    INX     H
   05eb   05                    DCR     B
   05ec   c2 e7 05              JNZ     SDCID_L
   05ef   db 53                 IN      SDDAT           ; 2 CRC bytes
   05f1   db 53                 IN      SDDAT
   05f3   3e 01                 MVI     A,01H
   05f5   d3 54                 OUT     SDCTL           ; release CS
   05f7   3e 00                 MVI     A,00H
   05f9   c9                    RET
   05fa                 SDCID_TE:
   05fa   3e 01                 MVI     A,01H
   05fc   d3 54                 OUT     SDCTL           ; release CS
   05fe   3e ff                 MVI     A,0FFH
   0600   c9                    RET
                        
                        ; INCBLK: increment the 32-bit block number BLKN[0..3] by 1.
   0601                 INCBLK:
   0601   3a 58 08              LDA     BLKN+3
   0604   3c                    INR     A
   0605   32 58 08              STA     BLKN+3
   0608   c2 26 06              JNZ     INCD
   060b   3a 57 08              LDA     BLKN+2
   060e   3c                    INR     A
   060f   32 57 08              STA     BLKN+2
   0612   c2 26 06              JNZ     INCD
   0615   3a 56 08              LDA     BLKN+1
   0618   3c                    INR     A
   0619   32 56 08              STA     BLKN+1
   061c   c2 26 06              JNZ     INCD
   061f   3a 55 08              LDA     BLKN+0
   0622   3c                    INR     A
   0623   32 55 08              STA     BLKN+0
   0626                 INCD:
   0626   c9                    RET
                        
                        ; ---------------- console / numeric helpers ----------------
   0627                 PSTR:
   0627   54                    MOV     D,H
   0628   5d                    MOV     E,L
   0629   0e 09                 MVI     C,9
   062b   cd 05 00              CALL    5
   062e   c9                    RET
   062f                 CPUTC:
   062f   0e 02                 MVI     C,2
   0631   cd 05 00              CALL    5
   0634   c9                    RET
   0635                 CIN:
   0635   0e 01                 MVI     C,1
   0637   cd 05 00              CALL    5
   063a   c9                    RET
   063b                 CRLF:
